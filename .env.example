# Optional Compose configuration. Copy to .env only if changing a campaign.
# Use identical limits for every product and record this file with the campaign.
CONTINUUM_NODE_CPUS=1.0
CONTINUUM_NODE_MEMORY=1g
CONTINUUM_ENGINE_CPUS=1.0
CONTINUUM_ENGINE_MEMORY=1g
CONTINUUM_JAVA_OPTIONS=-Xms128m -Xmx768m
CONTINUUM_COMPOSE_BUILD_TIMEOUT=600
CONTINUUM_COMPOSE_TIMEOUT=120
