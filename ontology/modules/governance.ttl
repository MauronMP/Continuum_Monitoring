mc:requirementIdentifier a owl:DatatypeProperty ;
    rdfs:label "requirement identifier" ;
    rdfs:comment "requirement identifier records a literal value. Declared domain: Requirement. Declared range: string. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:Requirement ;
    rdfs:range xsd:string .

