mc:belongsToPolicyCategory a owl:ObjectProperty ;
    rdfs:label "belongs to policy category" ;
    rdfs:comment "Classifies a policy under one or more concerns. Categories may overlap; membership alone does not define precedence or resolve conflicts. SHACL requires at least one category and validates every category type." ;
    rdfs:domain mc:Policy ;
    rdfs:range mc:PolicyCategory .

mc:belongsToQueryCatalog a owl:ObjectProperty ;
