comon:belongsToPolicyCategory a owl:ObjectProperty ;
    rdfs:label "belongs to policy category" ;
    rdfs:comment "Classifies a policy under one or more concerns. Categories may overlap; membership alone does not define precedence or resolve conflicts. The ontology requires at least one category; closed-world category validation is outside the RDFS benchmark." ;
    rdfs:domain comon:Policy ;
    rdfs:range comon:PolicyCategory .

comon:belongsToQueryCatalog a owl:ObjectProperty ;
