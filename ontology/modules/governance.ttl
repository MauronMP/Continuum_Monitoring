<http://example.org/smartcity/modules/governance> a owl:Ontology ;
    rdfs:label "Continuum policy and governance module"@en ;
    owl:imports <http://example.org/smartcity/modules/foundation>,
        <http://example.org/smartcity/modules/observability>,
        <http://example.org/smartcity/modules/topology> ;
    owl:versionInfo "3.0.0" .

ex:AuthorizationOutcome a owl:Class ;
    rdfs:label "Authorization Outcome" .

ex:DataCriticality a owl:Class ;
    rdfs:label "Data Criticality" .

ex:DataSensitivity a owl:Class ;
    rdfs:label "Data Sensitivity" .

ex:OntologyArtifact a owl:Class ;
    rdfs:label "Ontology Artifact" ;
    rdfs:subClassOf ex:Artifact .

ex:PolicyType a owl:Class ;
    rdfs:label "Policy Type" .

ex:PrivacyMechanism a owl:Class ;
    rdfs:label "Privacy Mechanism" .

ex:ProcessingPurpose a owl:Class ;
    rdfs:label "Processing Purpose" ;
    rdfs:comment "Purpose for which data, model parameters or predictions are processed." .

ex:ProcessingScope a owl:Class ;
    rdfs:label "Processing Scope" .

ex:QueryType a owl:Class ;
    rdfs:label "Query Type" .

ex:RequirementsArtifact a owl:Class ;
    rdfs:label "Requirements Artifact" ;
    rdfs:subClassOf ex:Artifact .

ex:ScenarioArtifact a owl:Class ;
    rdfs:label "Scenario Artifact" ;
    rdfs:subClassOf ex:Artifact .

ex:StandardSpecification a owl:Class ;
    rdfs:label "Standard Specification" .

ex:ValidationResult a owl:Class ;
    rdfs:label "Validation Result" .

<urn:continuum:ontology:3.0.0:node:100> a owl:Class ;
    owl:unionOf <urn:continuum:ontology:3.0.0:node:101> .

<urn:continuum:ontology:3.0.0:node:101> rdf:first ex:User ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:102> .

<urn:continuum:ontology:3.0.0:node:102> rdf:first ex:SemanticContract ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:103> .

<urn:continuum:ontology:3.0.0:node:103> rdf:first ex:Policy ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:104> .

<urn:continuum:ontology:3.0.0:node:104> rdf:first ex:FederatedLearningSession ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:105> .

<urn:continuum:ontology:3.0.0:node:105> rdf:first ex:EvaluationState ;
    rdf:rest () .

<urn:continuum:ontology:3.0.0:node:106> a owl:Class ;
    owl:unionOf <urn:continuum:ontology:3.0.0:node:107> .

<urn:continuum:ontology:3.0.0:node:107> rdf:first ex:SemanticContract ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:108> .

<urn:continuum:ontology:3.0.0:node:108> rdf:first ex:Policy ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:109> .

<urn:continuum:ontology:3.0.0:node:109> rdf:first ex:FederatedLearningSession ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:110> .

<urn:continuum:ontology:3.0.0:node:110> rdf:first ex:EvaluationState ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:111> .

<urn:continuum:ontology:3.0.0:node:111> rdf:first ex:Permission ;
    rdf:rest () .

<urn:continuum:ontology:3.0.0:node:83> a owl:Class ;
    owl:unionOf <urn:continuum:ontology:3.0.0:node:84> .

<urn:continuum:ontology:3.0.0:node:84> rdf:first ex:Permission ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:85> .

<urn:continuum:ontology:3.0.0:node:85> rdf:first ex:Policy ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:86> .

<urn:continuum:ontology:3.0.0:node:86> rdf:first ex:Service ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:87> .

<urn:continuum:ontology:3.0.0:node:87> rdf:first ex:ServiceState ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:88> .

<urn:continuum:ontology:3.0.0:node:88> rdf:first ex:AIModel ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:89> .

<urn:continuum:ontology:3.0.0:node:89> rdf:first ex:FederatedLearningSession ;
    rdf:rest <urn:continuum:ontology:3.0.0:node:90> .

<urn:continuum:ontology:3.0.0:node:90> rdf:first ex:EvaluationState ;
    rdf:rest () .

ex:ConflictResolutionStrategy a owl:Class ;
    rdfs:label "Conflict Resolution Strategy" .

ex:DataCategory a owl:Class ;
    rdfs:label "Data Category" ;
    rdfs:comment "Semantic category of information governed by consent, privacy and transmission policies." .

ex:PolicyArtifact a owl:Class ;
    rdfs:label "Policy Artifact" ;
    rdfs:subClassOf ex:Artifact .

ex:PolicyRelationType a owl:Class ;
    rdfs:label "Policy Relation Type" .

ex:QueryCatalog a owl:Class ;
    rdfs:label "Query Catalog" ;
    rdfs:subClassOf ex:Artifact .

ex:Role a owl:Class ;
    rdfs:label "Access Role" .

ex:Scenario a owl:Class ;
    rdfs:label "Scenario" .

ex:ConsentRange a owl:Class ;
    rdfs:label "Consent Range" ;
    rdfs:comment "Maximum processing scope declared by consent/contract. Includes LocalOnly, CommunityAgg, GlobalAgg and Denied/Revoked. Effective authorization is computed independently." .

ex:ConsentRecord a owl:Class ;
    rdfs:label "Consent Record" ;
    rdfs:comment "User-declared consent decision independent from the semantic contract." ;
    rdfs:subClassOf ex:TemporalEntity .

ex:Permission a owl:Class ;
    rdfs:label "Permission" .

ex:PolicyCategory a owl:Class ;
    rdfs:label "Policy Category" .

ex:PolicyCategoryRelation a owl:Class ;
    rdfs:label "Policy Category Relation" .

ex:QuerySpecification a owl:Class ;
    rdfs:label "Query Specification" .

ex:SecurityMechanism a owl:Class ;
    rdfs:label "Security Mechanism" .

ex:SemanticContract a owl:Class ;
    rdfs:label "Semantic Contract" ;
    rdfs:comment "Temporal agreement binding user, processing purpose(s), consent range and governing policies. It is independent from the user-declared ConsentRecord." ;
    rdfs:subClassOf ex:TemporalEntity .

ex:ValidationCampaign a owl:Class ;
    rdfs:label "Validation Campaign" ;
    rdfs:subClassOf ex:Artifact .

ex:AuthorizationDecision a owl:Class ;
    rdfs:label "Authorization Decision" ;
    rdfs:comment "Effective authorization obtained from the intersection of consent record, contract, zone and hard restrictions." ;
    rdfs:subClassOf ex:TemporalEntity .

ex:Identifier a owl:Class ;
    rdfs:label "Identifier" ;
    rdfs:comment "Identifier that may be direct, pseudonymous or anonymous." .

ex:MechanismSpecification a owl:Class ;
    rdfs:label "Mechanism Specification" .

ex:Requirement a owl:Class ;
    rdfs:label "Requirement" .

ex:AcceptanceProfile a owl:Class ;
    rdfs:label "Acceptance Profile" ;
    rdfs:subClassOf ex:Artifact .

ex:Artifact a owl:Class ;
    rdfs:label "Artifact" ;
    rdfs:comment "Versionable project artifact." .

ex:Policy a owl:Class ;
    rdfs:label "Policy" ;
    rdfs:comment "Normative governance rule from POLICIES-REV-01. Policies are specifications, not execution mechanisms." .
