@prefix ex: <http://example.org/smartcity#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:AHP_consistency_threshold a owl:DatatypeProperty ;
    rdfs:label "AHP consistency threshold" ;
    rdfs:domain ex:AcceptanceProfile ;
    rdfs:range xsd:decimal .

ex:AnonymousIdentifier a owl:Class ;
    rdfs:label "Anonymous Identifier" ;
    rdfs:subClassOf ex:Identifier .

ex:D_delegation_max a owl:DatatypeProperty ;
    rdfs:label "maximum delegation depth" ;
