    rdfs:range mc:Policy .

mc:hasActiveConsentRange a owl:ObjectProperty ;
    rdfs:label "has active consent range" ;
    rdfs:comment "Current user-declared range resolved from the active ConsentRecord. It is intentionally independent from the SemanticContract so inconsistencies can be detected." ;
