    rdfs:comment "Validation / Reproducibility Requirement is a governance concept in the monitoring model. It specializes Requirement." ;
    rdfs:subClassOf comon:Requirement .

comon:appliedMechanism a owl:ObjectProperty ;
    rdfs:label "applied mechanism" ;
    rdfs:comment "applied mechanism links resources. Declared domain: Evaluation State. Declared range: Mechanism Specification. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:EvaluationState ;
    rdfs:range comon:MechanismSpecification .

comon:appliedPolicy a owl:ObjectProperty ;
    rdfs:label "applied policy" ;
    rdfs:comment "applied policy links resources. Declared domain: Evaluation State. Declared range: Policy. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:EvaluationState ;
    rdfs:range comon:Policy .

comon:appliedSecurityMechanism a owl:ObjectProperty ;
    rdfs:label "applied security mechanism" ;
    rdfs:comment "applied security mechanism links resources. The domain is intentionally open for reuse across governed resources. Declared range: Security Mechanism. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:range comon:SecurityMechanism .

comon:appliesInZone a owl:ObjectProperty ;
    rdfs:label "applies in zone" ;
    rdfs:comment "applies in zone links resources. Declared domain: Policy. Declared range: City Area. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
