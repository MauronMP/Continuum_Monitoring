comon:T_node_join a owl:DatatypeProperty ;
    rdfs:label "node join threshold" ;
    rdfs:comment "node join threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:decimal .

comon:T_reselection_max a owl:DatatypeProperty ;
    rdfs:label "reselection threshold" ;
    rdfs:comment "reselection threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:decimal .

comon:T_sparql_monitor a owl:DatatypeProperty ;
    rdfs:label "SPARQL monitoring threshold" ;
    rdfs:comment "SPARQL monitoring threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:decimal .

comon:ValidationRequirement a owl:Class ;
