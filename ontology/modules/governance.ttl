@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix mc: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mc:AHP_consistency_threshold a owl:DatatypeProperty ;
    rdfs:label "AHP consistency threshold" ;
    rdfs:comment "AHP consistency threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:AcceptanceProfile ;
    rdfs:range xsd:decimal .

mc:D_delegation_max a owl:DatatypeProperty ;
    rdfs:label "maximum delegation depth" ;
    rdfs:comment "maximum delegation depth records a literal value. Declared domain: Acceptance Profile. Declared range: integer. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:AcceptanceProfile ;
    rdfs:range xsd:integer .

mc:DifferentialPrivacyMechanism a owl:Class ;
    rdfs:label "Differential Privacy Mechanism" ;
    rdfs:comment "Differential Privacy Mechanism is a governance concept in the monitoring model. It specializes Privacy Mechanism." ;
    rdfs:subClassOf mc:PrivacyMechanism .

mc:DirectIdentifier a owl:Class ;
    rdfs:label "Direct Identifier" ;
    rdfs:comment "Direct Identifier is a governance concept in the monitoring model. It specializes Identifier." ;
    rdfs:subClassOf mc:Identifier ;
    owl:disjointWith mc:AnonymousIdentifier,
        mc:PseudonymousIdentifier .

mc:E_device_max a owl:DatatypeProperty ;
    rdfs:label "device energy threshold" ;
    rdfs:comment "device energy threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:AcceptanceProfile ;
    rdfs:range xsd:decimal .

mc:EncryptionMechanism a owl:Class ;
    rdfs:label "Encryption Mechanism" ;
    rdfs:comment "Encryption Mechanism is a governance concept in the monitoring model. It specializes Security Mechanism." ;
    rdfs:subClassOf mc:SecurityMechanism .

mc:FunctionalRequirement a owl:Class ;
    rdfs:label "Functional Requirement" ;
    rdfs:comment "Functional Requirement is a governance concept in the monitoring model. It specializes Requirement." ;
    rdfs:subClassOf mc:Requirement .

mc:N_agents a owl:DatatypeProperty ;
    rdfs:label "concurrent agent target" ;
    rdfs:comment "concurrent agent target records a literal value. Declared domain: Acceptance Profile. Declared range: integer. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:AcceptanceProfile ;
    rdfs:range xsd:integer .

mc:NonFunctionalRequirement a owl:Class ;
