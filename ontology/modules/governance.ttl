    rdfs:comment "decision threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:AcceptanceProfile ;
    rdfs:range xsd:decimal .

mc:T_inference_local a owl:DatatypeProperty ;
    rdfs:label "local inference latency threshold (ms)" ;
    rdfs:comment "local inference latency threshold (ms) records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:AcceptanceProfile ;
    rdfs:range xsd:decimal .

mc:T_migration_max a owl:DatatypeProperty ;
