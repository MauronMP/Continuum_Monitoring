comon:governedBy a owl:ObjectProperty ;
    rdfs:label "governed by" ;
    rdfs:comment "Links users, nodes, services, zones or sessions to the applicable policy according to location and processing context." ;
    rdfs:range comon:Policy .

comon:hasActiveConsentRange a owl:ObjectProperty ;
    rdfs:label "has active consent range" ;
    rdfs:comment "Current user-declared range resolved from the active ConsentRecord. It is intentionally independent from the SemanticContract so inconsistencies can be detected." ;
    rdfs:domain comon:User ;
    rdfs:range comon:ConsentRange .

