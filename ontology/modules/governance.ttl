    rdfs:range comon:CityArea .

comon:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "applies to links resources. Declared domain: Permission. Value restrictions are defined by the application validation shapes. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:Permission .

comon:appliesToZoneType a owl:ObjectProperty ;
    rdfs:label "applies to zone type" ;
