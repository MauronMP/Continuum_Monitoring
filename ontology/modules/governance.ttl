    rdfs:comment "decision threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:decimal .

comon:T_inference_local a owl:DatatypeProperty ;
    rdfs:label "local inference latency threshold (ms)" ;
    rdfs:comment "local inference latency threshold (ms) records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:decimal .

comon:T_migration_max a owl:DatatypeProperty ;
    rdfs:label "migration interruption threshold" ;
    rdfs:comment "migration interruption threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
