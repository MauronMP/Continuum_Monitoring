comon:hasPolicyAction a owl:DatatypeProperty ;
    rdfs:label "has policy action" ;
    rdfs:comment "Policy action is now described by the normative policy statement and linked mechanisms/actions; retained only for compatibility." ;
    rdfs:domain comon:Policy ;
    rdfs:range xsd:string ;
    owl:deprecated true .

