@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

comon:AHP_consistency_threshold a owl:DatatypeProperty ;
    rdfs:label "AHP consistency threshold" ;
    rdfs:comment "AHP consistency threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:decimal .

comon:D_delegation_max a owl:DatatypeProperty ;
    rdfs:label "maximum delegation depth" ;
    rdfs:comment "maximum delegation depth records a literal value. Declared domain: Acceptance Profile. Declared range: integer. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:integer .

comon:DifferentialPrivacyMechanism a owl:Class ;
    rdfs:label "Differential Privacy Mechanism" ;
    rdfs:comment "Differential Privacy Mechanism is a governance concept in the monitoring model. It specializes Privacy Mechanism." ;
    rdfs:subClassOf comon:PrivacyMechanism .

comon:DirectIdentifier a owl:Class ;
    rdfs:label "Direct Identifier" ;
    rdfs:comment "Direct Identifier is a governance concept in the monitoring model. It specializes Identifier." ;
    rdfs:subClassOf comon:Identifier ;
    owl:disjointWith comon:AnonymousIdentifier,
        comon:PseudonymousIdentifier .

comon:E_device_max a owl:DatatypeProperty ;
    rdfs:label "device energy threshold" ;
    rdfs:comment "device energy threshold records a literal value. Declared domain: Acceptance Profile. Declared range: decimal. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:decimal .

comon:EncryptionMechanism a owl:Class ;
    rdfs:label "Encryption Mechanism" ;
    rdfs:comment "Encryption Mechanism is a governance concept in the monitoring model. It specializes Security Mechanism." ;
    rdfs:subClassOf comon:SecurityMechanism .

comon:FunctionalRequirement a owl:Class ;
    rdfs:label "Functional Requirement" ;
    rdfs:comment "Functional Requirement is a governance concept in the monitoring model. It specializes Requirement." ;
    rdfs:subClassOf comon:Requirement .

comon:N_agents a owl:DatatypeProperty ;
    rdfs:label "concurrent agent target" ;
    rdfs:comment "concurrent agent target records a literal value. Declared domain: Acceptance Profile. Declared range: integer. Domain and range axioms support inference; record-completeness validation is outside the RDFS benchmark." ;
    rdfs:domain comon:AcceptanceProfile ;
    rdfs:range xsd:integer .

comon:NonFunctionalRequirement a owl:Class ;
    rdfs:label "Non-functional Requirement" ;
    rdfs:comment "Non-functional Requirement is a governance concept in the monitoring model. It specializes Requirement." ;
    rdfs:subClassOf comon:Requirement .

comon:T_decision_max a owl:DatatypeProperty ;
