    rdfs:range mc:CityArea .

mc:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "applies to links resources. Declared domain: Permission. Value restrictions are defined by the application validation shapes. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
