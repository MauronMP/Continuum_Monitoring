@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

comon:GlobalAggregateData a comon:PrivacyClass .

comon:LocalPrivateData a comon:PrivacyClass .

comon:PublicSemanticSchema a comon:PrivacyClass .

comon:RegionalAnonymizedData a comon:PrivacyClass .

comon:authoritativeFor a owl:ObjectProperty ;
    rdfs:label "authoritative for"@en ;
    rdfs:comment "Relates a deployed fragment to the authority scope responsible for its instance data."@en ;
    rdfs:domain comon:DeploymentFragment ;
    rdfs:range comon:AuthorityScope .

comon:graphIRI a owl:DatatypeProperty ;
    rdfs:label "graph IRI"@en ;
    rdfs:comment "Identifies the graph represented by a deployment fragment."@en ;
    rdfs:domain comon:DeploymentFragment ;
    rdfs:range xsd:anyURI .

comon:hasPrivacyClass a owl:ObjectProperty ;
    rdfs:label "has privacy class"@en ;
    rdfs:comment "Assigns a disclosure classification to a fragment; enforcement remains the responsibility of the deployment and query-routing mechanisms."@en ;
    rdfs:domain comon:DeploymentFragment ;
    rdfs:range comon:PrivacyClass .

comon:hostedAt a owl:ObjectProperty ;
    rdfs:label "hosted at"@en ;
    rdfs:comment "Identifies the physical computational node hosting a deployment fragment."@en ;
    rdfs:domain comon:DeploymentFragment ;
    rdfs:range comon:ComputationalNode .

comon:ontologyDigest a owl:DatatypeProperty ;
    rdfs:label "ontology digest"@en ;
    rdfs:comment "Records a content digest used to detect mismatched semantic profiles."@en ;
    rdfs:domain comon:SemanticNodeProfile ;
    rdfs:range xsd:string .

comon:replicaOf a owl:ObjectProperty ;
    rdfs:label "replica of" ;
    rdfs:comment "Relates a replicated DeploymentFragment to its original fragment; not a generic model or service replica relation." ;
    rdfs:domain comon:DeploymentFragment ;
    rdfs:range comon:DeploymentFragment .

comon:usesEntailmentProfile a owl:DatatypeProperty ;
    rdfs:label "uses entailment profile"@en ;
    rdfs:comment "Names the inference profile selected for a semantic node profile."@en ;
    rdfs:domain comon:SemanticNodeProfile ;
    rdfs:range xsd:string .

<http://example.org/monitoringcontinuum/modules/deployment> a owl:Ontology ;
    rdfs:label "Continuum deployment and fragmentation module"@en ;
    owl:imports <http://example.org/monitoringcontinuum/modules/foundation>,
        <http://example.org/monitoringcontinuum/modules/topology> ;
    owl:versionInfo "4.0.0" .

comon:AuthorityScope a owl:Class ;
    rdfs:label "Authority scope"@en ;
    rdfs:comment "Identifies the administrative or data-ownership boundary responsible for a fragment."@en .

comon:SemanticNodeProfile a owl:Class ;
    rdfs:label "Semantic node profile"@en ;
    rdfs:comment "Defines the selected ontology imports and entailment metadata for a deployment role."@en .

comon:PrivacyClass a owl:Class ;
    rdfs:label "Privacy class"@en ;
    rdfs:comment "A disclosure classification used when assigning instance data to continuum nodes."@en .

comon:DeploymentFragment a owl:Class ;
    rdfs:label "Deployment fragment"@en ;
    rdfs:comment "A placed subset or replica of semantic knowledge with an identified host, authority and privacy classification."@en .
