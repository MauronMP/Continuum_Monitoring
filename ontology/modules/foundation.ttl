@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

comon:MAPESymptom a owl:Class ;
    rdfs:label "MAPE-K Symptom" ;
    rdfs:comment "Symptom detected in the MAPE-K Monitor/Analyse phases and recorded for auditability." .

comon:NonUser a owl:Class ;
    rdfs:label "Non-User" ;
    rdfs:comment "Person in the environment without a wearable or active participation." ;
    rdfs:subClassOf foaf:Person .

comon:ProcessingLevel a owl:Class ;
    rdfs:label "Processing Level" ;
    rdfs:comment "Processing Level is a foundation concept in the monitoring model. Its operational properties are defined by the modules that use it." .

comon:TemporalEntity a owl:Class ;
    rdfs:label "Temporal Entity" ;
    rdfs:comment "Entity with an explicit validity interval. validTo denotes effective closure, never merely planned expiry." .

comon:User a owl:Class ;
    rdfs:label "User" ;
    rdfs:comment "System participant with a wearable device." ;
    rdfs:subClassOf foaf:Person .

<http://example.org/monitoringcontinuum/modules/foundation> a owl:Ontology ;
    rdfs:label "Continuum foundation module"@en ;
    owl:versionInfo "4.0.0" .

dcterms:identifier a owl:AnnotationProperty .

dcterms:language a owl:AnnotationProperty .

dcterms:modified a owl:AnnotationProperty .

dcterms:replaces a owl:AnnotationProperty .

xsd:duration a rdfs:Datatype .












sosa:Observation a owl:Class .

sosa:Platform a owl:Class .

sosa:hasFeatureOfInterest a owl:ObjectProperty .

sosa:hasSimpleResult a owl:DatatypeProperty .

sosa:isHostedBy a owl:ObjectProperty .

sosa:madeBySensor a owl:ObjectProperty .

sosa:observedProperty a owl:ObjectProperty .

sosa:observes a owl:ObjectProperty ;
    rdfs:domain sosa:Sensor ;
    rdfs:range sosa:ObservableProperty .

sosa:resultTime a owl:DatatypeProperty .

foaf:name a owl:DatatypeProperty .

saref:Device a owl:Class .

sosa:ObservableProperty a owl:Class .

sosa:Sensor a owl:Class .

foaf:Person a owl:Class .
