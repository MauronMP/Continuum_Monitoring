    rdfs:label "supersedes model" ;
    rdfs:comment "supersedes model links resources. Declared domain: AI Model. Declared range: AI Model. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:AIModel ;
    rdfs:range mc:AIModel .

mc:transferDestination a owl:ObjectProperty ;
    rdfs:label "transfer destination" ;
    rdfs:comment "Identifies the transfer destination. The intentionally unrestricted range permits nodes, services and payload resources; authorization and allowed kinds are validated separately." ;
    rdfs:domain mc:TransferEvent .

mc:transferSource a owl:ObjectProperty ;
    rdfs:label "transfer source" ;
    rdfs:comment "Identifies the transfer source. The intentionally unrestricted range permits nodes, services and payload resources; authorization and allowed kinds are validated separately." ;
    rdfs:domain mc:TransferEvent .

mc:triggeredByState a owl:ObjectProperty ;
    rdfs:label "triggered by state" ;
    rdfs:comment "triggered by state links resources. Declared domain: one of Delegation Event, EvaluationState. Declared range: State. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain <urn:continuum:ontology:4.0.0:node:91> ;
    rdfs:range mc:State .

mc:usesModel a owl:ObjectProperty ;
    rdfs:label "uses model" ;
    rdfs:comment "Model used by a service. Distinct from hostsModel, whose subject is a ComputationalNode." ;
    rdfs:domain mc:Service ;
    rdfs:range mc:AIModel .

<http://example.org/monitoringcontinuum/modules/orchestration> a owl:Ontology ;
    rdfs:label "Continuum decision and adaptation module"@en ;
    owl:imports <http://example.org/monitoringcontinuum/modules/contracts>,
        <http://example.org/monitoringcontinuum/modules/foundation>,
        <http://example.org/monitoringcontinuum/modules/governance>,
        <http://example.org/monitoringcontinuum/modules/observability>,
        <http://example.org/monitoringcontinuum/modules/topology> ;
    owl:versionInfo "4.0.0" .

geo:Feature a owl:Class .

mc:AdaptabilityLevel a owl:Class ;
    rdfs:label "Adaptability Level" ;
    rdfs:comment "Adaptability Level is a orchestration concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:DecisionMethod a owl:Class ;
    rdfs:label "Decision Method" ;
    rdfs:comment "Decision Method is a orchestration concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:MigrationCostLevel a owl:Class ;
    rdfs:label "Migration Cost Level" ;
    rdfs:comment "Migration Cost Level is a orchestration concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:MigrationTimeLevel a owl:Class ;
    rdfs:label "Migration Time Level" ;
    rdfs:comment "Migration Time Level is a orchestration concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:ModelDegradationCause a owl:Class ;
    rdfs:label "Model Degradation Cause" ;
    rdfs:comment "Model Degradation Cause is a orchestration concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:ProfitabilityLevel a owl:Class ;
    rdfs:label "Profitability Level" ;
    rdfs:comment "Profitability Level is a orchestration concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:RollbackEvent a owl:Class ;
    rdfs:label "Rollback Event" ;
    rdfs:comment "Rollback Event is a orchestration concept in the monitoring model. It specializes Adaptation Action." ;
    rdfs:subClassOf mc:AdaptationAction .

<urn:continuum:ontology:4.0.0:node:91> a owl:Class ;
    owl:unionOf <urn:continuum:ontology:4.0.0:node:92> .

<urn:continuum:ontology:4.0.0:node:92> rdf:first mc:DelegationEvent ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:93> .

<urn:continuum:ontology:4.0.0:node:93> rdf:first mc:EvaluationState ;
    rdf:rest () .

<urn:continuum:ontology:4.0.0:node:94> a owl:Class ;
    owl:unionOf <urn:continuum:ontology:4.0.0:node:95> .

<urn:continuum:ontology:4.0.0:node:95> rdf:first mc:ComputationalNode ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:96> .

<urn:continuum:ontology:4.0.0:node:96> rdf:first mc:DelegationEvent ;
    rdf:rest () .

mc:ReplicationEvent a owl:Class ;
    rdfs:label "Replication Event" ;
    rdfs:comment "Controlled and idempotent replication or synchronization event." ;
    rdfs:subClassOf mc:TemporalEntity .

mc:PairwiseComparison a owl:Class ;
    rdfs:label "Pairwise Comparison" ;
    rdfs:comment "Pairwise Comparison is a orchestration concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:DecisionAlternative a owl:Class ;
    rdfs:label "Decision Alternative" ;
    rdfs:comment "Decision Alternative is a orchestration concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:DelegationEvent a owl:Class ;
    rdfs:label "Delegation Event" ;
    rdfs:comment "Reified temporal delegation that records delegator node, delegate node, cause, validity interval and recovery condition." ;
    rdfs:subClassOf mc:AdaptationAction,
        mc:TemporalEntity .

mc:AdaptationAction a owl:Class ;
    rdfs:label "Adaptation Action" ;
    rdfs:comment "Auditable action produced by an EvaluationState." ;
    rdfs:subClassOf mc:TemporalEntity .
