    rdfs:domain mc:EvaluationState ;
    rdfs:range mc:Service .

mc:evaluationOrder a owl:DatatypeProperty ;
    rdfs:label "evaluation order" ;
    rdfs:comment "evaluation order records a literal value. Declared domain: Policy Category. Declared range: integer. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:PolicyCategory ;
    rdfs:range xsd:integer .

mc:evaluationPurpose a owl:ObjectProperty ;
    rdfs:label "evaluation purpose" ;
    rdfs:comment "evaluation purpose links resources. Declared domain: Evaluation State. Declared range: Processing Purpose. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:EvaluationState ;
