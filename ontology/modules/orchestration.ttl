    rdfs:comment "Use semantic RecoveryCondition together with validTo/plannedExpiry." ;
    rdfs:domain comon:DelegationEvent ;
    rdfs:range comon:ComputationalNode ;
    owl:deprecated true .

comon:hasAHPScore a owl:DatatypeProperty ;
