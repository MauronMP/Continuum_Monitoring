@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

comon:BufferRecord a owl:Class ;
    rdfs:label "Buffer Record" ;
    rdfs:comment "Temporary retained data record governed by authorization and storage policies." ;
    rdfs:subClassOf comon:TemporalEntity .

comon:DegradationEvent a owl:Class ;
    rdfs:label "Degradation Event" ;
    rdfs:comment "Degradation Event is a orchestration concept in the monitoring model. It specializes Adaptation Action." ;
    rdfs:subClassOf comon:AdaptationAction .

comon:MigrationEvent a owl:Class ;
    rdfs:label "Migration Event" ;
    rdfs:comment "Migration Event is a orchestration concept in the monitoring model. It specializes Adaptation Action." ;
    rdfs:subClassOf comon:AdaptationAction .

comon:ModelSelectionAction a owl:Class ;
    rdfs:label "Model Selection Action" ;
    rdfs:comment "Model Selection Action is a orchestration concept in the monitoring model. It specializes Adaptation Action." ;
    rdfs:subClassOf comon:AdaptationAction .

comon:OffloadingEvent a owl:Class ;
    rdfs:label "Offloading Event" ;
    rdfs:comment "Offloading Event is a orchestration concept in the monitoring model. It specializes Adaptation Action." ;
    rdfs:subClassOf comon:AdaptationAction .

comon:ParametrizedData a owl:Class ;
    rdfs:label "Parametrized Data" ;
    rdfs:comment "Pre-computed and aggregated data. Raw physiological data never leaves the device." .

comon:RetentionEvent a owl:Class ;
    rdfs:label "Retention Event" ;
    rdfs:comment "Retention Event is a orchestration concept in the monitoring model. It specializes Adaptation Action." ;
    rdfs:subClassOf comon:AdaptationAction .

comon:ScalingEvent a owl:Class ;
    rdfs:label "Scaling Event" ;
    rdfs:comment "Scaling Event is a orchestration concept in the monitoring model. It specializes Adaptation Action." ;
    rdfs:subClassOf comon:AdaptationAction .

comon:SynchronizationEvent a owl:Class ;
    rdfs:label "Synchronization Event" ;
    rdfs:comment "Synchronization Event is a orchestration concept in the monitoring model. It specializes Adaptation Action." ;
    rdfs:subClassOf comon:AdaptationAction .

comon:actionOriginNode a owl:ObjectProperty ;
    rdfs:label "action origin node" ;
    rdfs:comment "action origin node links resources. Declared domain: Adaptation Action. Declared range: Computational Node. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:AdaptationAction ;
    rdfs:range comon:ComputationalNode .

comon:actionTargetNode a owl:ObjectProperty ;
    rdfs:label "action target node" ;
    rdfs:comment "action target node links resources. Declared domain: Adaptation Action. Declared range: Computational Node. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:AdaptationAction ;
    rdfs:range comon:ComputationalNode .

comon:affectsModel a owl:ObjectProperty ;
    rdfs:label "affects model" ;
    rdfs:comment "affects model links resources. Declared domain: Adaptation Action. Declared range: AI Model. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:AdaptationAction ;
    rdfs:range comon:AIModel .

comon:affectsService a owl:ObjectProperty ;
    rdfs:label "affects service" ;
    rdfs:comment "affects service links resources. Declared domain: Adaptation Action. Declared range: Service. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:AdaptationAction ;
    rdfs:range comon:Service .

comon:alternativeModelTier a owl:ObjectProperty ;
    rdfs:label "alternative model tier" ;
    rdfs:comment "alternative model tier links resources. Declared domain: Decision Alternative. Declared range: Model Tier. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:DecisionAlternative ;
    rdfs:range comon:ModelTier .

comon:appliesPolicy a owl:ObjectProperty ;
    rdfs:label "applies policy" ;
    rdfs:comment "Deprecated in v4.0.0; use comon:appliedPolicy.",
        "Use appliedPolicy" ;
    rdfs:domain comon:EvaluationState ;
    rdfs:range comon:Policy ;
    owl:deprecated true .

comon:auditsContract a owl:ObjectProperty ;
    rdfs:label "audits contract" ;
    rdfs:comment "audits contract links resources. Declared domain: Evaluation State. Declared range: Semantic Contract. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:EvaluationState ;
    rdfs:range comon:SemanticContract .

comon:authorizedByEvaluation a owl:ObjectProperty ;
    rdfs:label "authorized by evaluation" ;
    rdfs:comment "authorized by evaluation links resources. Declared domain: Adaptation Action. Declared range: Evaluation State. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:AdaptationAction ;
    rdfs:range comon:EvaluationState .

comon:carriesData a owl:ObjectProperty ;
    rdfs:label "carries data" ;
    rdfs:comment "Identifies the carries data. The intentionally unrestricted range permits nodes, services and payload resources; authorization and allowed kinds are validated separately." ;
    rdfs:domain comon:TransferEvent .

comon:criterionA a owl:ObjectProperty ;
    rdfs:label "criterion A" ;
    rdfs:comment "criterion A links resources. Declared domain: Pairwise Comparison. Value restrictions are defined by the application validation shapes. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:PairwiseComparison .

comon:criterionB a owl:ObjectProperty ;
    rdfs:label "criterion B" ;
    rdfs:comment "criterion B links resources. Declared domain: Pairwise Comparison. Value restrictions are defined by the application validation shapes. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:PairwiseComparison .

comon:delegatedBy a owl:ObjectProperty ;
    rdfs:label "delegated by" ;
    rdfs:comment "delegated by links resources. Declared domain: Delegation Event. Declared range: Computational Node. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:DelegationEvent ;
    rdfs:range comon:ComputationalNode .

comon:delegatesTo a owl:ObjectProperty ;
    rdfs:label "delegates requests to" ;
    rdfs:comment "Used when a node is saturated or disconnected. For temporal delegation, use an comon:DelegationEvent with comon:validFrom/comon:validTo and comon:delegatedBy." ;
    rdfs:domain <urn:continuum:ontology:4.0.0:node:94> ;
    rdfs:range comon:ComputationalNode .

comon:delegationDepth a owl:DatatypeProperty ;
    rdfs:label "delegation depth" ;
    rdfs:comment "delegation depth records a literal value. Declared domain: Delegation Event. Declared range: integer. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:DelegationEvent ;
    rdfs:range xsd:integer .

comon:derivedFrom a owl:ObjectProperty ;
    rdfs:label "derived from" ;
    rdfs:comment "SOSA observation that originated this state and provides its timestamp." ;
    rdfs:domain comon:State ;
    rdfs:range sosa:Observation .

comon:eligibilityReason a owl:DatatypeProperty ;
    rdfs:label "eligibility reason" ;
    rdfs:comment "eligibility reason records a literal value. Declared domain: Decision Alternative. Declared range: string. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:DecisionAlternative ;
    rdfs:range xsd:string .

comon:estimatedPredictionError a owl:DatatypeProperty ;
