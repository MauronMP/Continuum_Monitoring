@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

comon:ModelGradientUpdate a owl:Class ;
    rdfs:label "Model Gradient Update" ;
    rdfs:comment "Federated learning update that may leave a mobile device only after anonymization and noise addition." ;
    rdfs:subClassOf comon:ParametrizedData .

comon:aggregatesData a owl:ObjectProperty ;
    rdfs:label "aggregates data" ;
    rdfs:comment "aggregates data links resources. Declared domain: Computational Node. Declared range: Parametrized Data. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:ComputationalNode ;
    rdfs:range comon:ParametrizedData .

comon:budgetForContract a owl:ObjectProperty ;
    rdfs:label "budget for contract" ;
    rdfs:comment "budget for contract links resources. Declared domain: Privacy Budget Account. Declared range: Semantic Contract. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:PrivacyBudgetAccount ;
    rdfs:range comon:SemanticContract .

comon:budgetForPurpose a owl:ObjectProperty ;
    rdfs:label "budget for purpose" ;
    rdfs:comment "budget for purpose links resources. Declared domain: Privacy Budget Account. Declared range: Processing Purpose. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:PrivacyBudgetAccount ;
    rdfs:range comon:ProcessingPurpose .

comon:containsIndividualizedGradients a owl:DatatypeProperty ;
    rdfs:label "contains individualized gradients" ;
    rdfs:comment "contains individualized gradients records a literal value. Declared domain: Federated Learning Session. Declared range: boolean. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range xsd:boolean .

comon:hasAnonymizationApplied a owl:DatatypeProperty ;
    rdfs:label "has anonymization applied" ;
    rdfs:comment "has anonymization applied records a literal value. Declared domain: Parametrized Data. Declared range: boolean. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:ParametrizedData ;
    rdfs:range xsd:boolean .

comon:hasNoiseApplied a owl:DatatypeProperty ;
    rdfs:label "has noise applied" ;
    rdfs:comment "has noise applied records a literal value. Declared domain: Parametrized Data. Declared range: boolean. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:ParametrizedData ;
    rdfs:range xsd:boolean .

comon:hasPayloadType a owl:ObjectProperty ;
    rdfs:label "has payload type" ;
    rdfs:comment "has payload type links resources. Declared domain: Federated Learning Session. Declared range: Payload Type. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range comon:PayloadType .

comon:hasPrivacyBudget a owl:DatatypeProperty ;
    rdfs:label "has privacy budget" ;
    rdfs:comment "Differential privacy epsilon value for the FL session." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range xsd:decimal .

comon:hasPrivacyBudgetAccount a owl:ObjectProperty ;
    rdfs:label "has privacy budget account" ;
    rdfs:comment "has privacy budget account links resources. Declared domain: Federated Learning Session. Declared range: Privacy Budget Account. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range comon:PrivacyBudgetAccount .

comon:hasPrivacyMechanism a owl:ObjectProperty ;
    rdfs:label "has privacy mechanism" ;
    rdfs:comment "has privacy mechanism links resources. Declared domain: one of FederatedLearningSession, ParametrizedData. Declared range: Privacy Mechanism. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain <urn:continuum:ontology:4.0.0:node:97> ;
    rdfs:range comon:PrivacyMechanism .

comon:involvedNode a owl:ObjectProperty ;
    rdfs:label "involved node" ;
    rdfs:comment "involved node links resources. Declared domain: Federated Learning Session. Declared range: Computational Node. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range comon:ComputationalNode .

comon:isRedundant a owl:DatatypeProperty ;
    rdfs:label "is redundant" ;
    rdfs:comment "Redundant or repetitive data — candidate for elimination to reduce traffic." ;
    rdfs:domain comon:ParametrizedData ;
    rdfs:range xsd:boolean .

comon:noiseLevel a owl:DatatypeProperty ;
    rdfs:label "noise level" ;
    rdfs:comment "Magnitude of noise injected into gradients or model parameters before transfer." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range xsd:decimal .

comon:originatesFromDevice a owl:ObjectProperty ;
    rdfs:label "originates from device" ;
    rdfs:comment "originates from device links resources. Declared domain: Parametrized Data. Declared range: Mobile Device. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:ParametrizedData ;
    rdfs:range comon:MobileDevice .

comon:privacyBudgetConsumed a owl:DatatypeProperty ;
    rdfs:label "privacy budget consumed" ;
    rdfs:comment "privacy budget consumed records a literal value. Declared domain: Privacy Budget Account. Declared range: decimal. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:PrivacyBudgetAccount ;
    rdfs:range xsd:decimal .

comon:privacyBudgetMaximum a owl:DatatypeProperty ;
    rdfs:label "privacy budget maximum" ;
    rdfs:comment "privacy budget maximum records a literal value. Declared domain: Privacy Budget Account. Declared range: decimal. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:PrivacyBudgetAccount ;
    rdfs:range xsd:decimal .

comon:privacyBudgetRemaining a owl:DatatypeProperty ;
    rdfs:label "privacy budget remaining" ;
    rdfs:comment "privacy budget remaining records a literal value. Declared domain: Privacy Budget Account. Declared range: decimal. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:PrivacyBudgetAccount ;
    rdfs:range xsd:decimal .

comon:sendTimestamp a owl:DatatypeProperty ;
    rdfs:label "send timestamp" ;
    rdfs:comment "send timestamp records a literal value. Declared domain: Parametrized Data. Declared range: dateTime. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:ParametrizedData ;
    rdfs:range xsd:dateTime .

comon:sentToNode a owl:ObjectProperty ;
    rdfs:label "sent to node" ;
    rdfs:comment "sent to node links resources. Declared domain: Parametrized Data. Declared range: Computational Node. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:ParametrizedData ;
    rdfs:range comon:ComputationalNode .

comon:sessionTime a owl:DatatypeProperty ;
    rdfs:label "session time" ;
    rdfs:comment "session time records a literal value. Declared domain: Federated Learning Session. Declared range: dateTime. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range xsd:dateTime .

comon:transfersData a owl:ObjectProperty ;
    rdfs:label "transfers data" ;
    rdfs:comment "transfers data links resources. Declared domain: Federated Learning Session. Declared range: Parametrized Data. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range comon:ParametrizedData .

comon:updatesModel a owl:ObjectProperty ;
    rdfs:label "updates model" ;
    rdfs:comment "updates model links resources. Declared domain: Federated Learning Session. Declared range: AI Model. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain comon:FederatedLearningSession ;
    rdfs:range comon:AIModel .

<http://example.org/monitoringcontinuum/modules/federation> a owl:Ontology ;
    rdfs:label "Continuum federated learning module"@en ;
    owl:imports <http://example.org/monitoringcontinuum/modules/contracts>,
        <http://example.org/monitoringcontinuum/modules/foundation>,
        <http://example.org/monitoringcontinuum/modules/governance>,
        <http://example.org/monitoringcontinuum/modules/orchestration> ;
    owl:versionInfo "4.0.0" .

<urn:continuum:ontology:4.0.0:node:97> a owl:Class ;
    owl:unionOf <urn:continuum:ontology:4.0.0:node:98> .

<urn:continuum:ontology:4.0.0:node:98> rdf:first comon:FederatedLearningSession ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:99> .

<urn:continuum:ontology:4.0.0:node:99> rdf:first comon:ParametrizedData ;
    rdf:rest () .

comon:PrivacyBudgetAccount a owl:Class ;
    rdfs:label "Privacy Budget Account" ;
    rdfs:comment "Privacy Budget Account is a federation concept in the monitoring model. Its operational properties are defined by the modules that use it." .
