@prefix ex: <http://example.org/smartcity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

ex:AccelerometerSensor a owl:Class ;
    rdfs:label "Accelerometer Sensor" ;
    rdfs:comment "Determines user mobility and physical activity." ;
    rdfs:subClassOf ex:PhysiologicalSensor .

ex:EDASensor a owl:Class ;
    rdfs:label "EDA Sensor" ;
    rdfs:comment "Electrodermal activity sensor." ;
    rdfs:subClassOf ex:PhysiologicalSensor .

ex:HeartRateSensor a owl:Class ;
    rdfs:label "Heart Rate Sensor" ;
    rdfs:subClassOf ex:PhysiologicalSensor .

ex:PhysiologicalObservation a owl:Class ;
    rdfs:label "Physiological Observation" ;
    rdfs:subClassOf sosa:Observation .

ex:PhysiologicalParametrizedData a owl:Class ;
    rdfs:label "Physiological Parametrized Data" ;
    rdfs:comment "EDA, HR, SpO2, etc. Sent during the day or at night when conditions allow." ;
    rdfs:subClassOf ex:ParametrizedData .

ex:SleepObservation a owl:Class ;
    rdfs:label "Sleep Observation" ;
    rdfs:subClassOf sosa:Observation .

ex:SleepParametrizedData a owl:Class ;
    rdfs:label "Sleep Parametrized Data" ;
    rdfs:comment "Sleep quality and phase durations. Generated when the user wakes up." ;
    rdfs:subClassOf ex:ParametrizedData .

ex:SleepSensor a owl:Class ;
    rdfs:label "Sleep Sensor" ;
    rdfs:comment "Captures total duration, phases (REM, deep, light) and sleep quality." ;
    rdfs:subClassOf ex:PhysiologicalSensor .

ex:SmartBand a owl:Class ;
    rdfs:label "Smart Band" ;
    rdfs:subClassOf ex:Wearable .

ex:SmartRing a owl:Class ;
    rdfs:label "Smart Ring" ;
    rdfs:subClassOf ex:Wearable .

ex:SmartWatch a owl:Class ;
    rdfs:label "Smart Watch" ;
    rdfs:subClassOf ex:Wearable .

ex:SpO2Sensor a owl:Class ;
    rdfs:label "SpO2 Sensor" ;
    rdfs:comment "Blood oxygen saturation sensor." ;
    rdfs:subClassOf ex:PhysiologicalSensor .

ex:StressObservation a owl:Class ;
    rdfs:label "Stress Observation" ;
    rdfs:comment "Output of the stress prediction model." ;
    rdfs:subClassOf sosa:Observation .

ex:TemperatureSensor a owl:Class ;
    rdfs:label "Skin Temperature Sensor" ;
    rdfs:comment "Skin temperature — used as stress indicator." ;
    rdfs:subClassOf ex:PhysiologicalSensor .

ex:generatedBy a owl:ObjectProperty ;
    rdfs:label "generated by" ;
    rdfs:domain ex:ParametrizedData ;
    rdfs:range ex:Wearable .

ex:hasPersonStatus a owl:ObjectProperty ;
    rdfs:label "has person status" ;
    rdfs:domain ex:UserState ;
    rdfs:range ex:PersonStatus .

ex:hasPredictedStressLevel a owl:ObjectProperty ;
    rdfs:label "has predicted stress level" ;
    rdfs:domain ex:UserState ;
    rdfs:range ex:StressLevel .

ex:hasWearable a owl:ObjectProperty ;
    rdfs:label "has wearable" ;
    rdfs:domain ex:User ;
    rdfs:range ex:Wearable .

<http://example.org/smartcity/modules/wellbeing> a owl:Ontology ;
    rdfs:label "Optional wellbeing monitoring profile"@en ;
    owl:imports <http://example.org/smartcity/modules/foundation>,
        <http://example.org/smartcity/modules/observability> ;
    owl:versionInfo "3.0.0" .

ex:PersonStatus a owl:Class ;
    rdfs:label "Person Status" .

ex:StressLevel a owl:Class ;
    rdfs:label "Stress Level" .

ex:Wearable a owl:Class ;
    rdfs:label "Wearable" ;
    rdfs:comment "Personal IoT device (smartwatch, smart ring, smart band)." ;
    rdfs:subClassOf saref:Device .

ex:PhysiologicalSensor a owl:Class ;
    rdfs:label "Physiological Sensor" ;
    rdfs:subClassOf sosa:Sensor .
