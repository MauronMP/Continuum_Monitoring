@prefix mc: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix saref: <https://saref.etsi.org/core/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mc:AccelerometerSensor a owl:Class ;
    rdfs:label "Accelerometer Sensor" ;
    rdfs:comment "Determines user mobility and physical activity." ;
    rdfs:subClassOf mc:PhysiologicalSensor .

mc:EDASensor a owl:Class ;
    rdfs:label "EDA Sensor" ;
    rdfs:comment "Electrodermal activity sensor." ;
    rdfs:subClassOf mc:PhysiologicalSensor .

mc:HeartRateSensor a owl:Class ;
    rdfs:label "Heart Rate Sensor" ;
    rdfs:comment "Heart Rate Sensor is a schema concept in the monitoring model. It specializes Physiological Sensor." ;
    rdfs:subClassOf mc:PhysiologicalSensor .

mc:PhysiologicalObservation a owl:Class ;
    rdfs:label "Physiological Observation" ;
    rdfs:comment "Physiological Observation is a schema concept in the monitoring model. It specializes http://www.w3.org/ns/sosa/Observation." ;
    rdfs:subClassOf sosa:Observation .

mc:PhysiologicalParametrizedData a owl:Class ;
    rdfs:label "Physiological Parametrized Data" ;
    rdfs:comment "EDA, HR, SpO2, etc. Sent during the day or at night when conditions allow." ;
    rdfs:subClassOf mc:ParametrizedData .

mc:SleepObservation a owl:Class ;
    rdfs:label "Sleep Observation" ;
    rdfs:comment "Sleep Observation is a schema concept in the monitoring model. It specializes http://www.w3.org/ns/sosa/Observation." ;
    rdfs:subClassOf sosa:Observation .

mc:SleepParametrizedData a owl:Class ;
    rdfs:label "Sleep Parametrized Data" ;
    rdfs:comment "Sleep quality and phase durations. Generated when the user wakes up." ;
    rdfs:subClassOf mc:ParametrizedData .

mc:SleepSensor a owl:Class ;
    rdfs:label "Sleep Sensor" ;
    rdfs:comment "Captures total duration, phases (REM, deep, light) and sleep quality." ;
    rdfs:subClassOf mc:PhysiologicalSensor .

mc:SmartBand a owl:Class ;
    rdfs:label "Smart Band" ;
    rdfs:comment "Smart Band is a schema concept in the monitoring model. It specializes Wearable." ;
    rdfs:subClassOf mc:Wearable .

mc:SmartRing a owl:Class ;
    rdfs:label "Smart Ring" ;
    rdfs:comment "Smart Ring is a schema concept in the monitoring model. It specializes Wearable." ;
    rdfs:subClassOf mc:Wearable .

mc:SmartWatch a owl:Class ;
    rdfs:label "Smart Watch" ;
    rdfs:comment "Smart Watch is a schema concept in the monitoring model. It specializes Wearable." ;
    rdfs:subClassOf mc:Wearable .

mc:SpO2Sensor a owl:Class ;
    rdfs:label "SpO2 Sensor" ;
    rdfs:comment "Blood oxygen saturation sensor." ;
    rdfs:subClassOf mc:PhysiologicalSensor .

mc:StressObservation a owl:Class ;
    rdfs:label "Stress Observation" ;
    rdfs:comment "Output of the stress prediction model." ;
    rdfs:subClassOf sosa:Observation .

mc:TemperatureSensor a owl:Class ;
    rdfs:label "Skin Temperature Sensor" ;
    rdfs:comment "Skin temperature — used as stress indicator." ;
    rdfs:subClassOf mc:PhysiologicalSensor .

mc:generatedBy a owl:ObjectProperty ;
    rdfs:label "generated by" ;
    rdfs:comment "generated by links resources. Declared domain: Parametrized Data. Declared range: Wearable. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:ParametrizedData ;
    rdfs:range mc:Wearable .

mc:hasDeviceState a owl:ObjectProperty ;
    rdfs:label "has device state" ;
    rdfs:comment "has device state links resources. Declared domain: Wearable. Declared range: Device State. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:Wearable ;
    rdfs:range mc:DeviceState .

mc:hasMeasurementUnit a owl:ObjectProperty ;
    rdfs:label "has Measurement Unit" ;
    rdfs:comment "has Measurement Unit links resources. Declared domain: http://www.w3.org/ns/sosa/Observation. Declared range: Measurement unit. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain sosa:Observation ;
    rdfs:range mc:MeasurementUnit .

mc:hasPersonStatus a owl:ObjectProperty ;
    rdfs:label "has person status" ;
    rdfs:comment "has person status links resources. Declared domain: User State. Declared range: Person Status. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:UserState ;
    rdfs:range mc:PersonStatus .

mc:hasPredictedStressLevel a owl:ObjectProperty ;
    rdfs:label "has predicted stress level" ;
    rdfs:comment "has predicted stress level links resources. Declared domain: User State. Declared range: Stress Level. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:UserState ;
    rdfs:range mc:StressLevel .

mc:hasWearable a owl:ObjectProperty ;
    rdfs:label "has wearable" ;
    rdfs:comment "has wearable links resources. Declared domain: User. Declared range: Wearable. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain mc:User ;
    rdfs:range mc:Wearable .

mc:measurementUnitStatus a owl:DatatypeProperty ;
    rdfs:label "measurement Unit Status" ;
    rdfs:comment "measurement Unit Status records a literal value. Declared domain: http://www.w3.org/ns/sosa/Observation. Declared range: string. Domain and range axioms support inference; SHACL supplies record-completeness checks." ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:string .

<http://example.org/monitoringcontinuum/modules/wellbeing> a owl:Ontology ;
    rdfs:label "Optional wellbeing monitoring profile"@en ;
    owl:imports <http://example.org/monitoringcontinuum/modules/foundation>,
        <http://example.org/monitoringcontinuum/modules/observability>,
        <http://example.org/monitoringcontinuum/modules/orchestration> ;
    owl:versionInfo "4.0.0" .

mc:MeasurementUnit a owl:Class ;
    rdfs:label "Measurement unit" ;
    rdfs:comment "Measurement unit is a schema concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:PersonStatus a owl:Class ;
    rdfs:label "Person Status" ;
    rdfs:comment "Person Status is a schema concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:StressLevel a owl:Class ;
    rdfs:label "Stress Level" ;
    rdfs:comment "Stress Level is a schema concept in the monitoring model. Its operational properties are defined by the modules that use it." .

mc:PhysiologicalSensor a owl:Class ;
    rdfs:label "Physiological Sensor" ;
    rdfs:comment "Physiological Sensor is a schema concept in the monitoring model. It specializes http://www.w3.org/ns/sosa/Sensor." ;
    rdfs:subClassOf sosa:Sensor .

mc:Wearable a owl:Class ;
    rdfs:label "Wearable" ;
    rdfs:comment "Personal IoT device (smartwatch, smart ring, smart band)." ;
    rdfs:subClassOf saref:Device .
