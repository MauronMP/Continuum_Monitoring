@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix s4ehaw: <https://saref.etsi.org/saref4ehaw/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

comon:AccelerometerSensor a owl:Class ;
    rdfs:label "Accelerometer Sensor" ;
    rdfs:comment "Health sensor that determines user mobility and physical activity." ;
    rdfs:subClassOf s4ehaw:HealthSensor, sosa:Sensor .

comon:EDASensor a owl:Class ;
    rdfs:label "EDA Sensor" ;
    rdfs:comment "Health sensor that measures electrodermal activity." ;
    rdfs:subClassOf s4ehaw:HealthSensor, sosa:Sensor .

comon:HeartRateSensor a owl:Class ;
    rdfs:label "Heart Rate Sensor" ;
    rdfs:comment "Health sensor that observes heart rate." ;
    rdfs:subClassOf s4ehaw:HealthSensor, sosa:Sensor .

comon:PhysiologicalObservation a owl:Class ;
    rdfs:label "Physiological Observation" ;
    rdfs:comment "Application profile for SOSA observations of physiological properties." ;
    rdfs:subClassOf sosa:Observation .

comon:PhysiologicalParametrizedData a owl:Class ;
    rdfs:label "Physiological Parametrized Data" ;
    rdfs:comment "EDA, heart-rate and oxygen-saturation data prepared for policy-controlled transfer." ;
    rdfs:subClassOf comon:ParametrizedData .

comon:SleepObservation a owl:Class ;
    rdfs:label "Sleep Observation" ;
    rdfs:comment "Application profile for SOSA observations of sleep properties." ;
    rdfs:subClassOf sosa:Observation .

comon:SleepParametrizedData a owl:Class ;
    rdfs:label "Sleep Parametrized Data" ;
    rdfs:comment "Sleep quality and phase durations prepared after the user wakes up." ;
    rdfs:subClassOf comon:ParametrizedData .

comon:SleepSensor a owl:Class ;
    rdfs:label "Sleep Sensor" ;
    rdfs:comment "Health sensor that captures sleep duration, phases and quality." ;
    rdfs:subClassOf s4ehaw:HealthSensor, sosa:Sensor .

comon:SmartBand a owl:Class ;
    rdfs:label "Smart Band" ;
    rdfs:comment "Health wearable implemented as a smart band." ;
    rdfs:subClassOf s4ehaw:HealthWearable .

comon:SmartRing a owl:Class ;
    rdfs:label "Smart Ring" ;
    rdfs:comment "Health wearable implemented as a smart ring." ;
    rdfs:subClassOf s4ehaw:HealthWearable .

comon:SmartWatch a owl:Class ;
    rdfs:label "Smart Watch" ;
    rdfs:comment "Health wearable implemented as a smart watch." ;
    rdfs:subClassOf s4ehaw:HealthWearable .

comon:SpO2Sensor a owl:Class ;
    rdfs:label "SpO2 Sensor" ;
    rdfs:comment "Health sensor that measures blood oxygen saturation." ;
    rdfs:subClassOf s4ehaw:HealthSensor, sosa:Sensor .

comon:StressObservation a owl:Class ;
    rdfs:label "Stress Observation" ;
    rdfs:comment "Application-level SOSA observation produced by the stress prediction model." ;
    rdfs:subClassOf sosa:Observation .

comon:TemperatureSensor a owl:Class ;
    rdfs:label "Skin Temperature Sensor" ;
    rdfs:comment "Health sensor that measures skin temperature as a possible stress indicator." ;
    rdfs:subClassOf s4ehaw:HealthSensor, sosa:Sensor .

comon:generatedBy a owl:ObjectProperty ;
    rdfs:label "generated by" ;
    rdfs:comment "Links parametrized data to the health wearable that generated it." ;
    rdfs:domain comon:ParametrizedData ;
    rdfs:range s4ehaw:HealthWearable .

comon:hasDeviceState a owl:ObjectProperty ;
    rdfs:label "has device state" ;
    rdfs:comment "Links a health wearable to its dynamic device state." ;
    rdfs:domain s4ehaw:HealthWearable ;
    rdfs:range comon:DeviceState .

comon:hasPersonStatus a owl:ObjectProperty ;
    rdfs:label "has person status" ;
    rdfs:comment "Links a user state to the application-specific person status used by monitoring policies." ;
    rdfs:domain comon:UserState ;
    rdfs:range comon:PersonStatus .

comon:hasPredictedStressLevel a owl:ObjectProperty ;
    rdfs:label "has predicted stress level" ;
    rdfs:comment "Links a user state to the stress level produced by the configured prediction model." ;
    rdfs:domain comon:UserState ;
    rdfs:range comon:StressLevel .

comon:measurementUnitStatus a owl:DatatypeProperty ;
    rdfs:label "measurement unit status" ;
    rdfs:comment "Records why a source observation has no QUDT quantity value and unit." ;
    rdfs:domain sosa:Observation ;
    rdfs:range xsd:string .

<http://example.org/monitoringcontinuum/modules/wellbeing> a owl:Ontology ;
    rdfs:label "Optional wellbeing monitoring profile"@en ;
    owl:imports <http://example.org/monitoringcontinuum/alignments/health-vocabularies>,
        <http://example.org/monitoringcontinuum/modules/foundation>,
        <http://example.org/monitoringcontinuum/modules/observability>,
        <http://example.org/monitoringcontinuum/modules/orchestration> ;
    owl:versionInfo "4.0.0" .

comon:User rdfs:subClassOf s4ehaw:HealthActor .

comon:PersonStatus a owl:Class ;
    rdfs:label "Person Status" ;
    rdfs:comment "Application status used to interpret a monitored person's current context." .

comon:StressLevel a owl:Class ;
    rdfs:label "Stress Level" ;
    rdfs:comment "Application-specific classification produced by a configured stress model." .
