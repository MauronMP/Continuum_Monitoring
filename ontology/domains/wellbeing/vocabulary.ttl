@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

comon:Agitated a comon:PersonStatus,
        owl:NamedIndividual ;
    rdfs:label "Agitated" .

comon:Asleep a comon:PersonStatus,
        owl:NamedIndividual ;
    rdfs:label "Asleep" .

comon:Calm a comon:PersonStatus,
        owl:NamedIndividual ;
    rdfs:label "Calm" .

comon:EDAProperty a sosa:ObservableProperty .

comon:HeartRateProperty a sosa:ObservableProperty .

comon:SleepQualityProperty a sosa:ObservableProperty .

comon:StressCritical a comon:StressLevel,
        owl:NamedIndividual ;
    rdfs:label "Critical" .

comon:StressHigh a comon:StressLevel,
        owl:NamedIndividual ;
    rdfs:label "High" .

comon:StressLow a comon:StressLevel,
        owl:NamedIndividual ;
    rdfs:label "Low" .

comon:StressMedium a comon:StressLevel,
        owl:NamedIndividual ;
    rdfs:label "Medium" .

<http://example.org/monitoringcontinuum/modules/wellbeing-vocabulary> a owl:Ontology ;
    rdfs:label "Wellbeing controlled vocabulary"@en ;
    owl:imports <http://example.org/monitoringcontinuum/modules/wellbeing> ;
    owl:versionInfo "4.0.0" .
