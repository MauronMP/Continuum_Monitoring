@prefix mc: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

mc:Agitated a mc:PersonStatus,
        owl:NamedIndividual ;
    rdfs:label "Agitated" .

mc:Asleep a mc:PersonStatus,
        owl:NamedIndividual ;
    rdfs:label "Asleep" .

mc:Calm a mc:PersonStatus,
        owl:NamedIndividual ;
    rdfs:label "Calm" .

mc:EDAProperty a sosa:ObservableProperty .

mc:HeartRateProperty a sosa:ObservableProperty .

mc:SleepQualityProperty a sosa:ObservableProperty .

mc:StressCritical a mc:StressLevel,
        owl:NamedIndividual ;
    rdfs:label "Critical" .

mc:StressHigh a mc:StressLevel,
        owl:NamedIndividual ;
    rdfs:label "High" .

mc:StressLow a mc:StressLevel,
        owl:NamedIndividual ;
    rdfs:label "Low" .

mc:StressMedium a mc:StressLevel,
        owl:NamedIndividual ;
    rdfs:label "Medium" .

<http://example.org/monitoringcontinuum/modules/wellbeing-vocabulary> a owl:Ontology ;
    rdfs:label "Wellbeing controlled vocabulary"@en ;
    owl:imports <http://example.org/monitoringcontinuum/modules/wellbeing> ;
    owl:versionInfo "4.0.0" .
