mc:AIModelShape_v3 a sh:NodeShape ;
    rdfs:label "AI model versioning" ;
    sh:property <urn:continuum:ontology:4.0.0:node:1>,
        <urn:continuum:ontology:4.0.0:node:2>,
        <urn:continuum:ontology:4.0.0:node:3> ;
    sh:targetClass mc:AIModel .

