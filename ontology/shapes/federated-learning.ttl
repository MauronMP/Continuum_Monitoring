@prefix ex: <http://example.org/smartcity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:FederatedLearningSessionShape a sh:NodeShape ;
    sh:property [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:message "Federated learning sessions should declare at most one privacy budget epsilon." ;
            sh:path ex:hasPrivacyBudget ],
        [ sh:datatype xsd:decimal ;
            sh:minCount 1 ;
            sh:maxCount 1 ;
            sh:minInclusive 0 ;
            sh:message "Federated learning sessions should declare at most one noise level." ;
            sh:path ex:noiseLevel ] ;
    sh:sparql [ a sh:SPARQLConstraint ;
            sh:message "Model gradients leaving a mobile device must have ex:hasNoiseApplied true and ex:hasAnonymizationApplied true before transfer." ;
            sh:select """
            PREFIX ex: <http://example.org/smartcity#>
            SELECT $this
            WHERE {
                $this ex:dataType "model_gradients" .
                $this ex:transfersData ?gradient .
                ?gradient ex:originatesFromDevice ?device .
                ?device a ex:MobileDevice .
                FILTER (
                    NOT EXISTS { $this ex:hasNoiseApplied true }
                    || NOT EXISTS { $this ex:hasAnonymizationApplied true }
                )
            }
        """ ] ;
    sh:targetClass ex:FederatedLearningSession .

<http://example.org/smartcity/shapes/federated-learning> a owl:Ontology ;
    rdfs:label "Federated Learning Compliance Shapes"@en ;
    rdfs:comment "SHACL constraints retained from the v2.1 ontology."@en ;
    owl:imports <http://example.org/smartcity> ;
    owl:versionInfo "2.3.0" .
