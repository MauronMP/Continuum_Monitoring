@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

comon:FederatedLearningSessionShape_v3 a sh:NodeShape ;
    rdfs:label "Federated learning session structure" ;
    sh:property <urn:continuum:ontology:4.0.0:node:50>,
        <urn:continuum:ontology:4.0.0:node:51>,
        <urn:continuum:ontology:4.0.0:node:52> ;
    sh:targetClass comon:FederatedLearningSession .

comon:ModelGradientUpdateShape_v3 a sh:NodeShape ;
    rdfs:label "Gradient privacy structure" ;
    sh:property <urn:continuum:ontology:4.0.0:node:60>,
        <urn:continuum:ontology:4.0.0:node:61>,
        <urn:continuum:ontology:4.0.0:node:62> ;
    sh:targetClass comon:ModelGradientUpdate .

<http://example.org/monitoringcontinuum/shapes/federated-learning> a owl:Ontology ;
    rdfs:label "Continuum v3 federated-learning compliance shapes"@en ;
    owl:imports <http://example.org/monitoringcontinuum/modules/federation> ;
    owl:versionInfo "4.0.0" .

<urn:continuum:ontology:4.0.0:node:50> sh:class comon:ComputationalNode ;
    sh:minCount 1 ;
    sh:path comon:involvedNode .

<urn:continuum:ontology:4.0.0:node:51> sh:datatype xsd:dateTime ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path comon:sessionTime .

<urn:continuum:ontology:4.0.0:node:52> sh:class comon:PayloadType ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path comon:hasPayloadType .

<urn:continuum:ontology:4.0.0:node:60> sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path comon:hasNoiseApplied .

<urn:continuum:ontology:4.0.0:node:61> sh:datatype xsd:boolean ;
    sh:maxCount 1 ;
    sh:minCount 1 ;
    sh:path comon:hasAnonymizationApplied .

<urn:continuum:ontology:4.0.0:node:62> sh:class comon:PrivacyMechanism ;
    sh:minCount 1 ;
    sh:path comon:hasPrivacyMechanism .
