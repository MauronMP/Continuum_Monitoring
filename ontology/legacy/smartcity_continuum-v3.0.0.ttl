:P-ADAPT-01
    a
        :Policy ,
        owl:NamedIndividual ;
    rdfs:label "Decisión de migración multicondición" ;
    :belongsToPolicyCategory :PolicyCategory_ADAPT ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "La migración u offloading debe decidirse considerando conjuntamente causa de adaptación, autorización efectiva, estado del origen, elegibilidad de destinos, latencia, coste, energía y continuidad del servicio. No debe activarse únicamente por una métrica aislada salvo que una política de seguridad la convierta en restricción dura."@es ;
