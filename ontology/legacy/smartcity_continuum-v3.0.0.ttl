.

:P-CONS-01
    a
        :Policy ,
        owl:NamedIndividual ;
    rdfs:label "Consentimiento por rangos y revocación" ;
    :belongsToPolicyCategory :PolicyCategory_CONS ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "El consentimiento debe expresarse mediante rangos de procesamiento que contemplen al menos ámbito local, agregación comunitaria, agregación global y denegación/revocación. Deben poder especificarse categorías de datos, propósito, intervalo de validez y rango máximo autorizado."@es ;
    :hasPolicyType :ObligationPolicyType ;
    :policyIdentifier "P-CONS-01" ;
    :policyVersion "POLICIES-REV-01" ;
    :recommendedMechanism :M-CONS-01 ;
    :relatedRequirement :RF-32 ;
.

:P-CONS-02
    a
        :Policy ,
        owl:NamedIndividual ;
    rdfs:label "Contrato efectivo único por usuario y propósito" ;
    :belongsToPolicyCategory :PolicyCategory_CONS ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "No pueden coexistir dos contratos semánticos efectivos para el mismo usuario, propósito e instante. Se permiten contratos históricos o contratos simultáneos para propósitos diferentes siempre que sus intervalos no produzcan ambigüedad para el mismo propósito."@es ;
    :hasPolicyType :ProhibitionPolicyType ;
    :policyIdentifier "P-CONS-02" ;
    :policyVersion "POLICIES-REV-01" ;
    :recommendedMechanism
        :M-CONS-01 ,
        :M-TIME-01 ;
    :relatedRequirement
        :RF-33 ,
        :RNF-36 ;
.

