    rdfs:label "Trust updates and double counting" ;
    :belongsToPolicyCategory :PolicyCategory_NODE ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "The trust-update rule may consider failures, disconnections, saturation and policy violations, but must not cause the same latency or load effect to be counted again as an independent criterion in a subsequent decision without explicit justification." ;
