:RF-07
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-07" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-07" ;
    :requirementStatement "The system must manage preprocessing and energy strategy according to context. When connectivity is limited or effective consent restricts processing to the local scope, data must be preprocessed on the device itself or in the Mist tier. When the battery is low, the system must reduce model complexity and non-critical transmissions; when the battery is critical, it must prioritize offloading to the highest authorized tier only if sufficient connectivity exists and consent, the contract and zone policy allow it. If the battery is critical and transfer is not authorized, it must apply local degradation and temporary retention." ;
    :tracedToMechanism
        :M-ADAPT-02 ,
        :M-BUFFER-01 ,
        :M-DEVICE-01 ;
    :tracedToPolicy
        :P-ADAPT-02 ,
        :P-DATA-06 ;
.

:RF-09
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-09" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-09" ;
    :requirementStatement "The system must tag data with operational context: time, location, signal quality, device state, node state, processing level and purpose of use." ;
    :tracedToMechanism
        :M-DATA-02 ,
        :M-TIME-01 ,
        :M-TX-01 ;
    :tracedToPolicy
        :P-DATA-04 ,
        :P-DATA-10 ;
.

:RF-18
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-18" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-18" ;
    :requirementStatement "The system must support computation offloading to nearby devices or Edge/Fog nodes when feasible and when it does not violate consent, zone policies or minimum trust requirements." ;
    :tracedToMechanism
        :M-ADAPT-01 ,
        :M-CONS-02 ,
        :M-NODE-02 ,
        :M-ZONE-01 ;
    :tracedToPolicy
        :P-ADAPT-01 ,
        :P-NODE-02 ;
.

:RF-19
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-19" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-19" ;
    :requirementStatement "The system must support controlled replication and synchronization of critical data, models and federated parameters, distinguishing intentional replicas from accidental duplicates and ensuring synchronization versioning and idempotency." ;
    :tracedToMechanism
        :M-DELEG-02 ,
        :M-REPL-01 ,
        :M-TX-01 ,
        :M-TX-02 ;
    :tracedToPolicy
        :P-ADAPT-08 ,
        :P-DATA-08 ;
.

