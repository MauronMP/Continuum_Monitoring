        owl:NamedIndividual ;
    rdfs:label "RF-60" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-60" ;
    :requirementStatement "The system must prevent raw physiological observations from leaving the local scope defined in RF-10; therefore, they must not be transmitted to Edge, Fog or Cloud nodes. Only authorized parameterized data or model updates may leave the local scope." ;
