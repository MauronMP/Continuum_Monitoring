        owl:NamedIndividual ;
    rdfs:label "RF-30" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-30" ;
    :requirementStatement "The system must correlate physiological metrics with system metrics to study interactions between human stress, computational load, energy and connectivity, using common temporal and contextual references to determine which states and observations coexisted." ;
    :tracedToMechanism
        :M-DATA-02 ,
        :M-METRIC-01 ,
