    rdfs:label "Absence of trustworthy alternatives" ;
    :belongsToPolicyCategory :PolicyCategory_NODE ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "If no external node meets minimum eligibility and trust requirements, the system must not force a higher tier. It must prefer retention, local degradation or deferral and record the absence of alternatives." ;
