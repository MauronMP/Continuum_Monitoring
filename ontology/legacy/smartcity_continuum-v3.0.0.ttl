.

:RF-02
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-02" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-02" ;
    :requirementStatement "The system must identify the agent's approximate location and the architecture node to which the agent is connected: Mist, Edge, Fog or Cloud." ;
.

:RF-06
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-06" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-06" ;
    :requirementStatement "The system must capture physiological metrics relevant to stress and sleep, including heart rate, HRV, activity, sleep, movement, SpO2, temperature and electrodermal activity when the sensors are available." ;
.

:RF-11
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-11" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-11" ;
    :requirementStatement "The system must execute personalized inference models on the device or at nearby tiers to estimate stress and sleep quality." ;
.

:RF-12
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-12" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-12" ;
    :requirementStatement "The system must maintain a global general model trained in the Cloud tier, represented through general model and tier concepts rather than a specific instance." ;
.

:RF-13
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-13" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-13" ;
    :requirementStatement "The system must allow the general model to be adapted into personalized or degraded models at lower tiers." ;
.

