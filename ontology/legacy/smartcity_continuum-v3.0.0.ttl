    rdfs:label "Privacy priority" ;
    :belongsToPolicyCategory :PolicyCategory_MODEL ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "When privacy is the dominant criterion or effective consent limits aggregation, the decision must favor local or Edge tiers only if Edge remains authorized. A hard constraint always takes precedence over a quality score." ;
