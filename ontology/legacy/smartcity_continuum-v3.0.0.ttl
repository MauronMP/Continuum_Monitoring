:RF-23
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-23" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-23" ;
    :requirementStatement "The system must redistribute updated models to lower tiers without extending the current consent range, provided that the downstream flow complies with the semantic contract and active policies and does not carry personal data or individualized gradients." ;
    :tracedToMechanism
        :M-CONS-02 ,
        :M-FL-02 ,
        :M-ZONE-01 ;
    :tracedToPolicy
        :P-CONS-06 ,
