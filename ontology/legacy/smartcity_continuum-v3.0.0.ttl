:RF-28
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-28" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-28" ;
    :requirementStatement "The system must prioritize critical data over secondary data, retaining redundant or non-transmissible data locally. Criticality must be represented through a generic classification applicable to any data; `StressCritical` may be used for stress but must not be the only prioritization mechanism." ;
    :tracedToMechanism
        :M-BUFFER-01 ,
        :M-REPL-01 ,
        :M-TX-01 ,
        :M-TX-03 ;
    :tracedToPolicy
        :P-DATA-08 ,
        :P-DATA-09 ;
.

