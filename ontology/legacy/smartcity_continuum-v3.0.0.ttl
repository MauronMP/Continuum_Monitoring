:SemanticContractShape_v3
    a sh:NodeShape ;
    rdfs:label "Semantic contract completeness" ;
    sh:property 
        [
            sh:class :User ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :contractSubject ;
        ] ,
        [
            sh:class :ProcessingPurpose ;
            sh:minCount 1 ;
            sh:path :hasProcessingPurpose ;
        ] ,
        [
            sh:class :ConsentRange ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :hasConsentRange ;
        ] ,
        [
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :validFrom ;
        ] ,
        [
            sh:class :Policy ;
            sh:minCount 1 ;
            sh:path :governedBy ;
        ] ;
    sh:targetClass :SemanticContract ;
.

