        owl:NamedIndividual ;
    rdfs:label "RF-39" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-39" ;
    :requirementStatement "The system must represent policies as explicit, queryable semantic entities." ;
    :tracedToMechanism :M-GOV-01 ;
    :tracedToPolicy :P-GOV-01 ;
.

:RF-40
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-40" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-40" ;
    :requirementStatement "Every formal policy must be classified under exactly one semantic type: obligation, abstention or prohibition. In this model, an obligation requires an action to be performed; an abstention requires an optional action not to be performed unless explicitly enabled; a prohibition declares an action impermissible. The three types must be distinguishable and disjoint in validation." ;
    :tracedToMechanism :M-GOV-01 ;
    :tracedToPolicy :P-GOV-01 ;
.

