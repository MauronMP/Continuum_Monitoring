.

:RF-21
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-21" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-21" ;
    :requirementStatement "El sistema debe permitir enviar modelos personalizados, parámetros o gradientes a capas superiores para entrenamiento adicional cuando el consentimiento, la zona y la privacidad lo permitan."@es ;
    :tracedToMechanism
        :M-CONS-02 ,
        :M-FL-01 ,
        :M-NODE-02 ,
        :M-ZONE-01 ;
    :tracedToPolicy
        :P-FL-01 ,
