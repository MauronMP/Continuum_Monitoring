:TrustAssessmentShape_v3
    a sh:NodeShape ;
    rdfs:label "Trust reproducibility" ;
    sh:property 
        [
            sh:class :NodeState ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :trustAssessmentForState ;
        ] ,
        [
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Historical trust window start is required for reproducible v3 trust." ;
            sh:minCount 1 ;
            sh:path :trustWindowStart ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :trustRuleVersion ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :hasTrustScore ;
        ] ,
        [
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Historical trust window end is required for reproducible v3 trust." ;
            sh:minCount 1 ;
            sh:path :trustWindowEnd ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass :TrustAssessment ;
.

