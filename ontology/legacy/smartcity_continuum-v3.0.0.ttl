:RF-23
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-23" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-23" ;
    :requirementStatement "El sistema debe redistribuir modelos actualizados hacia capas inferiores sin ampliar el rango de consentimiento vigente, siempre que el flujo descendente cumpla el contrato semántico y las políticas activas y no transporte datos personales ni gradientes individualizados."@es ;
    :tracedToMechanism
        :M-CONS-02 ,
        :M-FL-02 ,
        :M-ZONE-01 ;
    :tracedToPolicy
        :P-CONS-06 ,
        :P-FL-06 ;
.

