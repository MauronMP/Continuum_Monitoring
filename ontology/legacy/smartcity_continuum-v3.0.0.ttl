.

:RF-22
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-22" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-22" ;
    :requirementStatement "El sistema debe soportar aprendizaje federado o jerárquico entre dispositivos y nodos Edge, Fog y Cloud."@es ;
    :tracedToMechanism
        :M-ADAPT-03 ,
