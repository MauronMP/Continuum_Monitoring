        [
            sh:class :ProcessingPurpose ;
            sh:minCount 1 ;
            sh:path :hasProcessingPurpose ;
        ] ,
        [
            sh:class :ConsentRange ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :hasConsentRange ;
        ] ,
        [
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :validFrom ;
        ] ,
        [
            sh:class :Policy ;
            sh:minCount 1 ;
            sh:path :governedBy ;
        ] ;
    sh:targetClass :SemanticContract ;
