:P-MODEL-08
    a
        :Policy ,
        owl:NamedIndividual ;
    rdfs:label "Separation of observed quality and decision weights" ;
    :belongsToPolicyCategory :PolicyCategory_MODEL ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "Prediction confidence, estimated error, local feedback and observed model quality must be recorded as independent evaluation metrics. AHP weights must not substitute for these metrics." ;
