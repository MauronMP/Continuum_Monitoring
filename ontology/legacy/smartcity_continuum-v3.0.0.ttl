    rdfs:label "Energy management for processing and transmission" ;
    :belongsToPolicyCategory :PolicyCategory_DATA ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "Low battery requires reduced model complexity and fewer non-critical transmissions. Critical battery requires attempting offloading only to an authorized tier with sufficient connectivity; if no authorized external option exists, local degradation and temporary retention must be applied." ;
