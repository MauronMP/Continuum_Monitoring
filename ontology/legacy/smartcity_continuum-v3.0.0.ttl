        :Policy ,
        owl:NamedIndividual ;
    rdfs:label "Ciclo temporal de estados" ;
    :belongsToPolicyCategory :PolicyCategory_GOV ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "Todo estado debe modelarse como una entidad temporal de primera clase. Debe registrar `validFrom` al crearse y `validTo` únicamente cuando finalice. Cuando el estado derive de una observación, debe conservar un enlace explícito a la evidencia de origen. Una expiración planificada no debe reutilizar `validTo` antes del cierre efectivo."@es ;
    :hasPolicyType :ObligationPolicyType ;
    :policyIdentifier "P-GOV-05" ;
    :policyVersion "POLICIES-REV-01" ;
    :recommendedMechanism :M-TIME-01 ;
    :relatedRequirement
