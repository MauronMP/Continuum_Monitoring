        :Policy ,
        owl:NamedIndividual ;
    rdfs:label "Determinismo y versionado de políticas" ;
    :belongsToPolicyCategory :PolicyCategory_GOV ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "Las políticas de adaptación deben estar versionadas. Dado el mismo estado de entrada, consentimiento, contrato, zona y versión de políticas, el sistema debe obtener la misma decisión de elegibilidad y registrar la versión aplicada. Durante una campaña de aceptación no debe alterarse una política sin cambiar explícitamente la versión del artefacto."@es ;
