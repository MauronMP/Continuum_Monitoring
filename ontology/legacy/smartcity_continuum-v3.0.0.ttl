        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RNF-15" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RNF-15" ;
    :requirementStatement "Los datos sensibles deben cifrarse en tránsito y en reposo conforme a la línea base de seguridad versionada del despliegue; la campaña de aceptación debe verificar que ningún canal o almacenamiento clasificado como sensible opera fuera de dicha línea base."@es ;
    :tracedToMechanism
        :M-SEC-01 ,
        :M-VAL-04 ;
    :tracedToPolicy :P-DATA-03 ;
.

