:RF-01
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-01" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-01" ;
    :requirementStatement "El sistema debe registrar y gestionar dispositivos vestibles asociados a un individuo/agente, incluyendo al menos relojes inteligentes, anillos inteligentes y bandas inteligentes."@es ;
.

:RF-02
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-02" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-02" ;
    :requirementStatement "El sistema debe identificar la localización aproximada del agente y el nodo de la arquitectura al que está conectado: mist, edge, fog o cloud."@es ;
.

:RF-06
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-06" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-06" ;
    :requirementStatement "El sistema debe capturar métricas fisiológicas relevantes para estrés y sueño, incluyendo frecuencia cardíaca, HRV, actividad, sueño, movimiento, SpO2, temperatura y actividad electrodérmica cuando los sensores estén disponibles."@es ;
.

:RF-11
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-11" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-11" ;
    :requirementStatement "El sistema debe ejecutar modelos de inferencia personalizados en el dispositivo o en capas cercanas para estimar estrés y calidad del sueño."@es ;
.

:RF-12
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-12" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-12" ;
    :requirementStatement "El sistema debe mantener un modelo general global entrenado en la capa cloud, representado mediante conceptos generales de modelo y tier y no mediante una instancia concreta."@es ;
.

:RF-13
    a
        :FunctionalRequirement ,
        :Requirement ,
        owl:NamedIndividual ;
    rdfs:label "RF-13" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-13" ;
    :requirementStatement "El sistema debe permitir la adaptación del modelo general a modelos personalizados o degradados en capas inferiores."@es ;
.

