    rdfs:label "RF-34" ;
    :definedInArtifact :RequirementsArtifact_Revised ;
    :requirementIdentifier "RF-34" ;
    :requirementStatement "The semantic contract must link the user, consent range, processing purpose and policies governing the processing." ;
    :tracedToMechanism
        :M-CONS-01 ,
        :M-GOV-02 ;
    :tracedToPolicy :P-CONS-03 ;
.

:RF-37
    a
        :FunctionalRequirement ,
