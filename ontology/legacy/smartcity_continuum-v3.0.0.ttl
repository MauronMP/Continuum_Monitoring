PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

<http://example.org/smartcity>
    a owl:Ontology ;
    rdfs:label "SmartCity Continuum Stress Ontology v3.0.0" ;
    dcterms:modified "2026-08-28"^^xsd:date ;
    dcterms:language "en" ;
    dcterms:identifier "3.0.0-en-datatypes-v1" ;
    dcterms:replaces "2.1.1" ;
    rdfs:comment "Major semantic revision aligned with RF-01–RF-72, RNF-01–RNF-39, RV-01–RV-05 and POLICIES-REV-01. Queries are intentionally not assigned in this version." ;
    owl:versionIRI <http://example.org/smartcity/3.0.0> ;
    owl:versionInfo "3.0.0" ;
.

dcterms:modified a owl:AnnotationProperty .
dcterms:replaces a owl:AnnotationProperty .
dcterms:language a owl:AnnotationProperty .
dcterms:identifier a owl:AnnotationProperty .

# Explicit declarations keep the embedded validation metadata OWL 2 DL-safe.
# SHACL constraints are still interpreted by SHACL, not by the OWL reasoner.
sh:NodeShape a owl:Class .
sh:class a owl:AnnotationProperty .
sh:datatype a owl:AnnotationProperty .
sh:maxCount a owl:AnnotationProperty .
sh:message a owl:AnnotationProperty .
sh:minCount a owl:AnnotationProperty .
sh:or a owl:AnnotationProperty .
sh:path a owl:AnnotationProperty .
sh:property a owl:AnnotationProperty .
sh:severity a owl:AnnotationProperty .
sh:targetClass a owl:AnnotationProperty .
foaf:name a owl:DatatypeProperty .
xsd:duration a rdfs:Datatype .

# Class/individual punning represents policy targets without using the reserved
# owl:Class IRI as an object-property range. Existing zone IRIs are unchanged.
:ZoneType a owl:Class ;
    rdfs:label "Zone type" ;
    rdfs:comment "A zone classification referenced by policies. UrbanZone, RuralZone and RestrictedZone are both OWL classes and named ZoneType individuals; OWL 2 DL treats their class and individual interpretations separately." .
:UrbanZone a owl:NamedIndividual, :ZoneType .
:RuralZone a owl:NamedIndividual, :ZoneType .
:RestrictedZone a owl:NamedIndividual, :ZoneType .

:AHPDecisionMethod
    a
        :DecisionMethod ,
        owl:NamedIndividual ;
    rdfs:label "Analytic Hierarchy Process (AHP)" ;
.

:AIModelShape_v3
    a sh:NodeShape ;
    rdfs:label "AI model versioning" ;
    sh:property 
        [
            sh:datatype xsd:dateTime ;
            sh:maxCount 1 ;
            sh:message "Every deployable model version should have lastUpdated for reproducibility." ;
            sh:minCount 1 ;
            sh:path :lastUpdated ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:class :ModelTier ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :hasModelTier ;
        ] ,
        [
            sh:datatype xsd:string ;
            sh:maxCount 1 ;
            sh:message "Every deployable model version should have a modelVersion." ;
            sh:minCount 1 ;
            sh:path :modelVersion ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass :AIModel ;
.

:AccelSensorA
    a
        :AccelerometerSensor ,
        owl:NamedIndividual ;
    rdfs:label "Accelerometer - Watch A" ;
    sosa:isHostedBy :WatchA ;
.

:AcceptanceProfileShape_v3
    a sh:NodeShape ;
    rdfs:label "Acceptance profile completeness" ;
    sh:property 
        [
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :N_agents ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :T_inference_local ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :T_reselection_max ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :T_node_join ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :T_sparql_monitor ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :T_migration_max ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:integer ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :D_delegation_max ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :T_decision_max ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :E_device_max ;
            sh:severity sh:Warning ;
        ] ,
        [
            sh:datatype xsd:decimal ;
            sh:maxCount 1 ;
            sh:message "Acceptance threshold must be configured before a validation campaign." ;
            sh:minCount 1 ;
            sh:path :AHP_consistency_threshold ;
            sh:severity sh:Warning ;
        ] ;
    sh:targetClass :AcceptanceProfile ;
.

:AcceptanceProfile_v3_Draft
    a
        :AcceptanceProfile ,
        owl:NamedIndividual ;
    rdfs:label "Acceptance profile v3 - draft" ;
    :T_inference_local 100.0 ;
    :artifactIdentifier "ACCEPTANCE-PROFILE-V3-DRAFT" ;
    :artifactStatus "draft-incomplete" ;
    rdfs:comment "Only T_inference_local=100 ms is explicitly fixed by the requirements source. Remaining thresholds, including AHP consistency threshold, must be configured before an acceptance campaign; no values are fabricated here." ;
.

:AdminRole
    a
        :Role ,
        owl:NamedIndividual ;
    rdfs:label "Administrator" ;
    :hasPermission
        :ManageInfrastructure ,
        :ReadPhysiologicalData ,
        :ReadSleepData ,
        :TrainGlobalModel ;
.

:AnonymousIdentifier
    a owl:Class ;
    rdfs:label "Anonymous Identifier" ;
    rdfs:subClassOf :Identifier ;
.

:AuthorizationBlocked
    a
        :AuthorizationOutcome ,
        owl:NamedIndividual ;
    rdfs:label "Authorization blocked" ;
.

:AuthorizationDecisionShape_v3
    a sh:NodeShape ;
    rdfs:label "Effective authorization completeness" ;
    sh:property 
        [
            sh:class :CityArea ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :basedOnZone ;
        ] ,
        [
            sh:class :ConsentRange ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :hasEffectiveConsentRange ;
        ] ,
        [
            sh:class :AuthorizationOutcome ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :hasAuthorizationOutcome ;
        ] ,
        [
            sh:class :ConsentRecord ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :basedOnConsentRecord ;
        ] ,
        [
            sh:class :SemanticContract ;
            sh:maxCount 1 ;
            sh:minCount 1 ;
            sh:path :basedOnContract ;
        ] ;
    sh:targetClass :AuthorizationDecision ;
.

:AuthorizationInconsistent
    a
        :AuthorizationOutcome ,
        owl:NamedIndividual ;
    rdfs:label "Authorization inconsistent" ;
.

:BatteryVeryLow
    a
        :BatteryLevel ,
        owl:NamedIndividual ;
    rdfs:label "Very Low" ;
.

:BufferRecord
    a owl:Class ;
    rdfs:label "Buffer Record" ;
    rdfs:comment "Temporary retained data record governed by authorization and storage policies." ;
    rdfs:subClassOf :TemporalEntity ;
.

