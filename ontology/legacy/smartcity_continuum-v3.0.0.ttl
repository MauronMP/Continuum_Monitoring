    :belongsToPolicyCategory :PolicyCategory_DATA ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "Los flujos pendientes no deben reanudarse simplemente por recuperar conectividad. La sincronización o transmisión solo puede reiniciarse cuando exista simultáneamente conectividad suficiente, autorización efectiva, destino elegible y condiciones de energía compatibles."@es ;
