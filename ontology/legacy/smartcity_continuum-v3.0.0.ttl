    rdfs:label "Extensibility without breaking the conceptual core" ;
    :belongsToPolicyCategory :PolicyCategory_INT ;
    :definedInArtifact :PolicyArtifact_POLICIES_REV_01 ;
    :hasPolicyStatement "Adding new users, nodes, sensors, models, policies, contracts or wearable types must not require changing central conceptual abstractions already used by reference scenarios, unless an incompatible major-version change is explicitly declared." ;
