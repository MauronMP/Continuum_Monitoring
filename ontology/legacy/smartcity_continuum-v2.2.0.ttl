@prefix :     <http://example.org/smartcity#> .
@prefix ex:   <http://example.org/smartcity#> .
@prefix geo:  <http://www.opengis.net/ont/geosparql#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix ssn:  <http://www.w3.org/ns/ssn/> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .
@prefix saref:<https://saref.etsi.org/core/> .
@base <http://example.org/smartcity> .

# ================================================================
#  ONTOLOGY: SmartCity Continuum Stress Prediction System
#  Version : 2.2
#  Language: English (labels, comments, individuals)
#  Covers  :
#    - Continuum infrastructure  (Mist / Edge / Fog / Cloud)
#    - Wearable devices & physiological sensors
#    - Users with / without consent
#    - Urban context  (zone types, density, connectivity)
#    - Automatic temporal states  (derived from sosa:Observation)
#    - Horizontal Federated Learning  (HFL)
#    - AI model tiers, degradation & migration
#    - RBAC access control
#    - Consent-aware semantic contracts
#    - Trust-based node selection and AHP evaluation
#    - Differential privacy metadata and FL data-flow constraints
#    - Obligation / abstention policies and temporal delegation
#    - 8 operational scenarios
# ================================================================

<http://example.org/smartcity>
    a owl:Ontology ;
    rdfs:label   "Continuum Monitoring Ontology with Wellbeing Profile" ;
    rdfs:comment "Reusable ontology for policy-aware monitoring across the computing continuum. Stress and sleep concepts are maintained as an optional wellbeing domain profile." ;
    owl:versionInfo "2.2.0" ;
    rdfs:seeAlso "Version 2.2.0 modularizes the core and wellbeing profile, normalizes all four AHP weights, completes temporal state metadata, and adds reproducible cumulative and scalability benchmarks." .


# ================================================================
# ANNOTATION PROPERTIES
# ================================================================

foaf:name rdf:type owl:AnnotationProperty .


# ================================================================
# 1. OBJECT PROPERTIES
# ================================================================

ex:aggregatesData a owl:ObjectProperty ;
    rdfs:domain ex:ComputationalNode ;
    rdfs:range  ex:ParametrizedData ;
    rdfs:label  "aggregates data" .

ex:appliesTo a owl:ObjectProperty ;
    rdfs:domain ex:Permission ;
    rdfs:label  "applies to" .

ex:belongsToCommunity a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:Community ;
    rdfs:label  "belongs to community" .

ex:connectsTo a owl:ObjectProperty ;
    rdfs:domain saref:Device ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "connects to" .

ex:coversArea a owl:ObjectProperty ;
    rdfs:domain ex:ComputationalNode ;
    rdfs:range  ex:CityArea ;
    rdfs:label  "covers area" .

ex:delegatesTo a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:ComputationalNode ex:DelegationEvent )
    ] ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "delegates requests to" ;
    rdfs:comment "Used when a node is saturated or disconnected. For temporal delegation, use an ex:DelegationEvent with ex:validFrom/ex:validTo and ex:delegatedBy." .

ex:derivedFrom a owl:ObjectProperty ;
    rdfs:domain ex:State ;
    rdfs:range  sosa:Observation ;
    rdfs:label  "derived from" ;
    rdfs:comment "SOSA observation that originated this state and provides its timestamp." .

ex:evaluatesNode a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "evaluates node" .

ex:evaluatesService a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:Service ;
    rdfs:label  "evaluates service" .

ex:generatedBy a owl:ObjectProperty ;
    rdfs:domain ex:ParametrizedData ;
    rdfs:range  ex:Wearable ;
    rdfs:label  "generated by" .

ex:hasAdaptability a owl:ObjectProperty ;
    rdfs:domain ex:ServiceState ;
    rdfs:range  ex:AdaptabilityLevel ;
    rdfs:label  "has adaptability" .

ex:hasAvailability a owl:ObjectProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  ex:AvailabilityLevel ;
    rdfs:label  "has availability" .

ex:hasBatteryLevel a owl:ObjectProperty ;
    rdfs:domain ex:DeviceState ;
    rdfs:range  ex:BatteryLevel ;
    rdfs:label  "has battery level" .

ex:hasCommunication a owl:ObjectProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  ex:CommunicationLevel ;
    rdfs:label  "has communication level" .

ex:hasConnectionStatus a owl:ObjectProperty ;
    rdfs:domain ex:DeviceState ;
    rdfs:range  ex:DeviceConnectionStatus ;
    rdfs:label  "has connection status" .

ex:hasConsent a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:ConsentStatus ;
    rdfs:label  "has consent" .

ex:hasDegradationCause a owl:ObjectProperty ;
    rdfs:domain ex:AIModel ;
    rdfs:range  ex:ModelDegradationCause ;
    rdfs:label  "has degradation cause" .

ex:hasDeviceState a owl:ObjectProperty ;
    rdfs:domain saref:Device ;
    rdfs:range  ex:DeviceState ;
    rdfs:label  "has device state" ;
    rdfs:comment "Links any SAREF device to its temporal state; domain profiles may specialize the device type." .

ex:hasDistance a owl:ObjectProperty ;
    rdfs:domain ex:NodeUserRelation ;
    rdfs:range  ex:DistanceLevel ;
    rdfs:label  "has distance" .

ex:hasEnergyLevel a owl:ObjectProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  ex:EnergyLevel ;
    rdfs:label  "has energy level" .

ex:hasGeometry a owl:ObjectProperty ;
    rdfs:subPropertyOf geo:hasGeometry ;
    rdfs:domain ex:CityArea ;
    rdfs:range  geo:Geometry ;
    rdfs:label  "has geometry" .

ex:hasMigrationCost a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:MigrationCostLevel ;
    rdfs:label  "has migration cost" .

ex:hasMigrationTime a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:MigrationTimeLevel ;
    rdfs:label  "has migration time" .

ex:hasMobileDevice a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:MobileDevice ;
    rdfs:label  "has mobile device" .

ex:hasMobility a owl:ObjectProperty ;
    rdfs:domain ex:UserState ;
    rdfs:range  ex:MobilityLevel ;
    rdfs:label  "has mobility" .

ex:hasModelTier a owl:ObjectProperty ;
    rdfs:domain ex:AIModel ;
    rdfs:range  ex:ModelTier ;
    rdfs:label  "has model tier" .

ex:hasNeighborNode a owl:ObjectProperty ;
    rdfs:domain ex:ComputationalNode ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "has neighbor node" ;
    rdfs:comment "Adjacent node to which requests can be delegated." .

ex:hasNodeState a owl:ObjectProperty ;
    rdfs:domain ex:ComputationalNode ;
    rdfs:range  ex:NodeState ;
    rdfs:label  "has node state" .

ex:hasOperationalStatus a owl:ObjectProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  ex:OperationalStatus ;
    rdfs:label  "has operational status" .

ex:hasPerformance a owl:ObjectProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  ex:PerformanceLevel ;
    rdfs:label  "has performance" .

ex:hasPermission a owl:ObjectProperty ;
    rdfs:domain ex:Role ;
    rdfs:range  ex:Permission ;
    rdfs:label  "has permission" .

ex:hasPersonStatus a owl:ObjectProperty ;
    rdfs:domain ex:UserState ;
    rdfs:range  ex:PersonStatus ;
    rdfs:label  "has person status" .

ex:hasPopulationDensity a owl:ObjectProperty ;
    rdfs:domain ex:CityArea ;
    rdfs:range  ex:PopulationDensity ;
    rdfs:label  "has population density" .

ex:hasPredictedStressLevel a owl:ObjectProperty ;
    rdfs:domain ex:UserState ;
    rdfs:range  ex:StressLevel ;
    rdfs:label  "has predicted stress level" .

ex:hasProcessingLevel a owl:ObjectProperty ;
    rdfs:domain ex:ServiceState ;
    rdfs:range  ex:ProcessingLevel ;
    rdfs:label  "has processing level" .

ex:hasProfitability a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:ProfitabilityLevel ;
    rdfs:label  "has profitability" .

ex:hasResidualCapacity a owl:ObjectProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  ex:ResidualCapacity ;
    rdfs:label  "has residual capacity" .

ex:hasRole a owl:ObjectProperty ;
    rdfs:domain foaf:Person ;
    rdfs:range  ex:Role ;
    rdfs:label  "has role" .

ex:hasServiceState a owl:ObjectProperty ;
    rdfs:domain ex:Service ;
    rdfs:range  ex:ServiceState ;
    rdfs:label  "has service state" .

ex:hasUserState a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:UserState ;
    rdfs:label  "has user state" .

ex:hasWearable a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:Wearable ;
    rdfs:label  "has wearable" .

ex:hasWorkload a owl:ObjectProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  ex:WorkloadLevel ;
    rdfs:label  "has workload" .

ex:hostedOnNode a owl:ObjectProperty ;
    rdfs:domain ex:AIModel ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "hosted on node" .

ex:hostsModel a owl:ObjectProperty ;
    rdfs:domain ex:ComputationalNode ;
    rdfs:range  ex:AIModel ;
    rdfs:label  "hosts model" .

ex:hostsService a owl:ObjectProperty ;
    rdfs:domain ex:ComputationalNode ;
    rdfs:range  ex:Service ;
    rdfs:label  "hosts service" .

ex:involvedNode a owl:ObjectProperty ;
    rdfs:domain ex:FederatedLearningSession ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "involved node" .

ex:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in" .

ex:locatedInZone a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:CityArea ;
    rdfs:label  "located in zone" .

ex:relatesNode a owl:ObjectProperty ;
    rdfs:domain ex:NodeUserRelation ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "relates node" .

ex:relatesUser a owl:ObjectProperty ;
    rdfs:domain ex:NodeUserRelation ;
    rdfs:range  ex:User ;
    rdfs:label  "relates user" .

ex:sentToNode a owl:ObjectProperty ;
    rdfs:domain ex:ParametrizedData ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "sent to node" .

ex:updatesModel a owl:ObjectProperty ;
    rdfs:domain ex:FederatedLearningSession ;
    rdfs:range  ex:AIModel ;
    rdfs:label  "updates model" .

# SOSA / GEO external properties
geo:hasGeometry  a owl:ObjectProperty .
sosa:hasFeatureOfInterest a owl:ObjectProperty .
sosa:isHostedBy  a owl:ObjectProperty .
sosa:madeBySensor a owl:ObjectProperty .
sosa:observedProperty a owl:ObjectProperty .


# ================================================================
# 2. DATATYPE PROPERTIES
# ================================================================

ex:anonymizedID a owl:DatatypeProperty ;
    rdfs:domain ex:User ;
    rdfs:range  xsd:string ;
    rdfs:label  "anonymized ID" .

ex:dataType a owl:DatatypeProperty ;
    rdfs:domain ex:FederatedLearningSession ;
    rdfs:range  xsd:string ;
    rdfs:label  "data type sent" ;
    rdfs:comment "E.g.: model_parameters, gradients, parametrized_sleep_data." .

ex:hasElasticity a owl:DatatypeProperty ;
    rdfs:domain ex:ComputationalNode ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "has elasticity" .

ex:isPreferredNode a owl:DatatypeProperty ;
    rdfs:domain ex:NodeUserRelation ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "is preferred node" ;
    rdfs:comment "Historical preferred node for this user based on zone and load." .

ex:isRedundant a owl:DatatypeProperty ;
    rdfs:domain ex:ParametrizedData ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "is redundant" ;
    rdfs:comment "Redundant or repetitive data — candidate for elimination to reduce traffic." .

ex:lastUpdated a owl:DatatypeProperty ;
    rdfs:domain ex:AIModel ;
    rdfs:range  xsd:dateTime ;
    rdfs:label  "last updated" .

ex:modelVersion a owl:DatatypeProperty ;
    rdfs:domain ex:AIModel ;
    rdfs:range  xsd:string ;
    rdfs:label  "model version" .

ex:parametrizedDataReady a owl:DatatypeProperty ;
    rdfs:domain ex:DeviceState ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "parametrized data ready" .

ex:queuedRequests a owl:DatatypeProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  xsd:integer ;
    rdfs:label  "queued requests" .

ex:requiresConsent a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:Permission ex:Policy ex:Service ex:ServiceState ex:AIModel ex:FederatedLearningSession ex:EvaluationState )
    ] ;
    rdfs:range  xsd:boolean ;
    rdfs:label  "requires consent" ;
    rdfs:comment "Boolean marker used by RBAC and by continuum processing policies. The required consent scope is expressed with ex:requiresConsentRange." .

ex:resourceUsagePercent a owl:DatatypeProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "resource usage (%)" .

ex:sendTimestamp a owl:DatatypeProperty ;
    rdfs:domain ex:ParametrizedData ;
    rdfs:range  xsd:dateTime ;
    rdfs:label  "send timestamp" .

ex:sessionTime a owl:DatatypeProperty ;
    rdfs:domain ex:FederatedLearningSession ;
    rdfs:range  xsd:dateTime ;
    rdfs:label  "session time" .

ex:stateDuration a owl:DatatypeProperty ;
    rdfs:domain ex:State ;
    rdfs:range  xsd:duration ;
    rdfs:label  "state duration" ;
    rdfs:comment "Computed as validTo - validFrom." .

ex:userFeedbackScore a owl:DatatypeProperty ;
    rdfs:domain ex:UserState ;
    rdfs:range  xsd:integer ;
    rdfs:label  "user feedback score" ;
    rdfs:comment "User rating of the previous day's prediction (local model without consent)." .

ex:validFrom a owl:DatatypeProperty ;
    rdfs:domain ex:State ;
    rdfs:range  xsd:dateTime ;
    rdfs:label  "valid from" ;
    rdfs:comment "State start. Automatically derived from the originating observation." .

ex:validTo a owl:DatatypeProperty ;
    rdfs:domain ex:State ;
    rdfs:range  xsd:dateTime ;
    rdfs:label  "valid to" ;
    rdfs:comment "State end. Closed when a new observation produces a different state." .

sosa:hasSimpleResult a owl:DatatypeProperty .
sosa:resultTime      a owl:DatatypeProperty .


# ================================================================
# 3. CLASSES
# ================================================================

# --- External bases ---
foaf:Person      a owl:Class .
saref:Device     a owl:Class .
sosa:Observation a owl:Class .
sosa:Platform    a owl:Class .
sosa:Sensor      a owl:Class .
geo:Feature      a owl:Class .
geo:Geometry     a owl:Class .

# --- Infrastructure ---
ex:ComputationalNode a owl:Class ;
    rdfs:subClassOf saref:Device ;
    rdfs:label   "Computational Node" ;
    rdfs:comment "Continuum architecture node capable of hosting models and processing data." .

ex:MistNode a owl:Class ;
    rdfs:subClassOf ex:ComputationalNode ;
    rdfs:label   "Mist Node" ;
    rdfs:comment "Closest node to the user. Minimal capacity, very low latency." .

ex:EdgeNode a owl:Class ;
    rdfs:subClassOf ex:ComputationalNode ;
    rdfs:label   "Edge Node" ;
    rdfs:comment "Edge node. Processes locally. No resource elasticity." .

ex:FogNode a owl:Class ;
    rdfs:subClassOf ex:ComputationalNode ;
    rdfs:label   "Fog Node" ;
    rdfs:comment "Fog node. Aggregates community/zone data. No resource elasticity." .

ex:CloudNode a owl:Class ;
    rdfs:subClassOf ex:ComputationalNode ;
    rdfs:label   "Cloud Node" ;
    rdfs:comment "Cloud node. Global model. Dynamic elasticity and scalability." .

# --- User devices ---
ex:Wearable a owl:Class ;
    rdfs:subClassOf saref:Device ;
    rdfs:label   "Wearable" ;
    rdfs:comment "Personal IoT device (smartwatch, smart ring, smart band)." .

ex:SmartWatch a owl:Class ;
    rdfs:subClassOf ex:Wearable ;
    rdfs:label "Smart Watch" .

ex:SmartRing a owl:Class ;
    rdfs:subClassOf ex:Wearable ;
    rdfs:label "Smart Ring" .

ex:SmartBand a owl:Class ;
    rdfs:subClassOf ex:Wearable ;
    rdfs:label "Smart Band" .

ex:MobileDevice a owl:Class ;
    rdfs:subClassOf ex:MistNode ;
    rdfs:label   "Mobile Device" ;
    rdfs:comment "User smartphone. Acts as a personal Mist/Edge node." .

# --- Sensors ---
ex:PhysiologicalSensor a owl:Class ;
    rdfs:subClassOf sosa:Sensor ;
    rdfs:label "Physiological Sensor" .

ex:EDASensor a owl:Class ;
    rdfs:subClassOf ex:PhysiologicalSensor ;
    rdfs:label   "EDA Sensor" ;
    rdfs:comment "Electrodermal activity sensor." .

ex:HeartRateSensor a owl:Class ;
    rdfs:subClassOf ex:PhysiologicalSensor ;
    rdfs:label "Heart Rate Sensor" .

ex:SleepSensor a owl:Class ;
    rdfs:subClassOf ex:PhysiologicalSensor ;
    rdfs:label   "Sleep Sensor" ;
    rdfs:comment "Captures total duration, phases (REM, deep, light) and sleep quality." .

ex:AccelerometerSensor a owl:Class ;
    rdfs:subClassOf ex:PhysiologicalSensor ;
    rdfs:label   "Accelerometer Sensor" ;
    rdfs:comment "Determines user mobility and physical activity." .

ex:SpO2Sensor a owl:Class ;
    rdfs:subClassOf ex:PhysiologicalSensor ;
    rdfs:label   "SpO2 Sensor" ;
    rdfs:comment "Blood oxygen saturation sensor." .

ex:TemperatureSensor a owl:Class ;
    rdfs:subClassOf ex:PhysiologicalSensor ;
    rdfs:label   "Skin Temperature Sensor" ;
    rdfs:comment "Skin temperature — used as stress indicator." .

# --- Observations ---
ex:PhysiologicalObservation a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "Physiological Observation" .

ex:SleepObservation a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label "Sleep Observation" .

ex:StressObservation a owl:Class ;
    rdfs:subClassOf sosa:Observation ;
    rdfs:label   "Stress Observation" ;
    rdfs:comment "Output of the stress prediction model." .

# --- Persons ---
ex:User a owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label   "User" ;
    rdfs:comment "System participant with a wearable device." .

ex:NonUser a owl:Class ;
    rdfs:subClassOf foaf:Person ;
    rdfs:label   "Non-User" ;
    rdfs:comment "Person in the environment without a wearable or active participation." .

# --- Consent ---
ex:ConsentStatus a owl:Class ;
    rdfs:label   "Consent Status" ;
    rdfs:comment "Determines whether the user allows their data to be used for model training." .

# --- Urban context ---
ex:UrbanEnvironment a owl:Class ;
    rdfs:label   "Urban Environment" ;
    rdfs:comment "Geographic and density context that conditions system connectivity and behaviour." .

ex:CityArea a owl:Class ;
    rdfs:subClassOf ex:UrbanEnvironment ;
    rdfs:label "City Area" .

ex:UrbanZone a owl:Class ;
    rdfs:subClassOf ex:CityArea ;
    rdfs:label   "Urban Zone" ;
    rdfs:comment "High node and user density. More communication options." .

ex:RuralZone a owl:Class ;
    rdfs:subClassOf ex:CityArea ;
    rdfs:label   "Rural Zone" ;
    rdfs:comment "Few nodes. Predominance of local retention and controlled transmission." .

ex:RestrictedZone a owl:Class ;
    rdfs:subClassOf ex:CityArea ;
    rdfs:label   "Restricted Zone" ;
    rdfs:comment "No external internet. Internally centralized architecture (care home, hospital)." .

ex:Community a owl:Class ;
    rdfs:label   "Community" ;
    rdfs:comment "Group of users with similar mobility patterns and routines (neighbourhood, floor, hospital ward)." .

ex:PopulationDensity a owl:Class ;
    rdfs:label "Population Density" .

# --- Node–User relation ---
ex:NodeUserRelation a owl:Class ;
    rdfs:label   "Node-User Relation" ;
    rdfs:comment "Captures distance and connectivity between a node and a user at a given instant." .

# --- States (root) ---
ex:State a owl:Class ;
    rdfs:label   "State" ;
    rdfs:comment "Dynamic state of any entity. Temporally bounded and automatically derived." .

ex:NodeState a owl:Class ;
    rdfs:subClassOf ex:State ;
    rdfs:label "Node State" .

ex:UserState a owl:Class ;
    rdfs:subClassOf ex:State ;
    rdfs:label "User State" .

ex:DeviceState a owl:Class ;
    rdfs:subClassOf ex:State ;
    rdfs:label "Device State" .

ex:ServiceState a owl:Class ;
    rdfs:subClassOf ex:State ;
    rdfs:label "Service State" .

ex:EvaluationState a owl:Class ;
    rdfs:subClassOf ex:State ;
    rdfs:label   "Evaluation State" ;
    rdfs:comment "Derived by reasoning over NodeState + UserState + NodeUserRelation." .

# --- Enumeration classes ---
ex:EnergyLevel        a owl:Class ; rdfs:label "Energy Level" .
ex:AvailabilityLevel  a owl:Class ; rdfs:label "Availability Level" .
ex:PerformanceLevel   a owl:Class ; rdfs:label "Performance Level" .
ex:WorkloadLevel      a owl:Class ; rdfs:label "Workload Level" .
ex:CommunicationLevel a owl:Class ; rdfs:label "Communication Level" .
ex:ResidualCapacity   a owl:Class ; rdfs:label "Residual Capacity" .
ex:OperationalStatus  a owl:Class ; rdfs:label "Operational Status" .
ex:MobilityLevel      a owl:Class ; rdfs:label "Mobility Level" .
ex:PersonStatus       a owl:Class ; rdfs:label "Person Status" .
ex:StressLevel        a owl:Class ; rdfs:label "Stress Level" .
ex:BatteryLevel       a owl:Class ; rdfs:label "Battery Level" .
ex:DeviceConnectionStatus a owl:Class ; rdfs:label "Device Connection Status" .
ex:ProcessingLevel    a owl:Class ; rdfs:label "Processing Level" .
ex:AdaptabilityLevel  a owl:Class ; rdfs:label "Adaptability Level" .
ex:ProfitabilityLevel a owl:Class ; rdfs:label "Profitability Level" .
ex:MigrationTimeLevel a owl:Class ; rdfs:label "Migration Time Level" .
ex:MigrationCostLevel a owl:Class ; rdfs:label "Migration Cost Level" .
ex:DistanceLevel      a owl:Class ; rdfs:label "Distance Level" .

# --- AI Model ---
ex:AIModel a owl:Class ;
    rdfs:label   "AI Model" ;
    rdfs:comment "Stress prediction model. Exists at different quality levels per continuum layer." .

ex:ModelTier a owl:Class ;
    rdfs:label "Model Tier" .

ex:ModelDegradationCause a owl:Class ;
    rdfs:label "Model Degradation Cause" .

ex:FederatedLearningSession a owl:Class ;
    rdfs:label   "Federated Learning Session" ;
    rdfs:comment "Event of parameter/model transfer between continuum layers (HFL)." .

# --- Service ---
ex:Service a owl:Class ;
    rdfs:label   "Service" ;
    rdfs:comment "Stress prediction or any other continuum service." .

# --- Parametrized data ---
ex:ParametrizedData a owl:Class ;
    rdfs:label   "Parametrized Data" ;
    rdfs:comment "Pre-computed and aggregated data. Raw physiological data never leaves the device." .

ex:SleepParametrizedData a owl:Class ;
    rdfs:subClassOf ex:ParametrizedData ;
    rdfs:label   "Sleep Parametrized Data" ;
    rdfs:comment "Sleep quality and phase durations. Generated when the user wakes up." .

ex:PhysiologicalParametrizedData a owl:Class ;
    rdfs:subClassOf ex:ParametrizedData ;
    rdfs:label   "Physiological Parametrized Data" ;
    rdfs:comment "EDA, HR, SpO2, etc. Sent during the day or at night when conditions allow." .

ex:TrafficWindow a owl:Class ;
    rdfs:label   "Traffic Window" ;
    rdfs:comment "Time interval with high demand (morning: wake-up; night: physiological data upload)." .

# --- RBAC ---
ex:Role       a owl:Class ; rdfs:label "Access Role" .
ex:Permission a owl:Class ; rdfs:label "Permission" .


# ================================================================
# 4. INDIVIDUALS — Enumeration values
# ================================================================

# Energy Level
ex:VeryLowEnergy  a owl:NamedIndividual, ex:EnergyLevel ; rdfs:label "Very Low" .
ex:LowEnergy      a owl:NamedIndividual, ex:EnergyLevel ; rdfs:label "Low" .
ex:MediumEnergy   a owl:NamedIndividual, ex:EnergyLevel ; rdfs:label "Medium" .
ex:HighEnergy     a owl:NamedIndividual, ex:EnergyLevel ; rdfs:label "High" .

# Availability Level
ex:Available    a owl:NamedIndividual, ex:AvailabilityLevel ; rdfs:label "Available" .
ex:Partial      a owl:NamedIndividual, ex:AvailabilityLevel ; rdfs:label "Partial" .
ex:NotAvailable a owl:NamedIndividual, ex:AvailabilityLevel ; rdfs:label "Not Available" .

# Performance Level
ex:Optimal    a owl:NamedIndividual, ex:PerformanceLevel ; rdfs:label "Optimal" .
ex:Acceptable a owl:NamedIndividual, ex:PerformanceLevel ; rdfs:label "Acceptable" .
ex:Deficient  a owl:NamedIndividual, ex:PerformanceLevel ; rdfs:label "Deficient" .

# Workload Level
ex:NoWorkload       a owl:NamedIndividual, ex:WorkloadLevel ; rdfs:label "No Workload" .
ex:LowWorkload      a owl:NamedIndividual, ex:WorkloadLevel ; rdfs:label "Low" .
ex:MediumWorkload   a owl:NamedIndividual, ex:WorkloadLevel ; rdfs:label "Medium" .
ex:HighWorkload     a owl:NamedIndividual, ex:WorkloadLevel ; rdfs:label "High" .
ex:SaturatedWorkload a owl:NamedIndividual, ex:WorkloadLevel ; rdfs:label "Saturated" .

# Communication Level
ex:StableComm       a owl:NamedIndividual, ex:CommunicationLevel ; rdfs:label "Stable" .
ex:VariableComm     a owl:NamedIndividual, ex:CommunicationLevel ; rdfs:label "Variable" .
ex:IntermittentComm a owl:NamedIndividual, ex:CommunicationLevel ; rdfs:label "Intermittent" .
ex:NoConnectionComm a owl:NamedIndividual, ex:CommunicationLevel ; rdfs:label "No Connection" .

# Residual Capacity
ex:HighResidual     a owl:NamedIndividual, ex:ResidualCapacity ; rdfs:label "High" .
ex:MediumResidual   a owl:NamedIndividual, ex:ResidualCapacity ; rdfs:label "Medium" .
ex:LowResidual      a owl:NamedIndividual, ex:ResidualCapacity ; rdfs:label "Low" .
ex:CriticalResidual a owl:NamedIndividual, ex:ResidualCapacity ; rdfs:label "Critical" .

# Operational Status
ex:Operational  a owl:NamedIndividual, ex:OperationalStatus ;
    rdfs:label "Operational" .
ex:ComputeOnly  a owl:NamedIndividual, ex:OperationalStatus ;
    rdfs:label   "Compute Only" ;
    rdfs:comment "Disconnected node but still computing. Receives internal delegations." .
ex:Inoperative  a owl:NamedIndividual, ex:OperationalStatus ;
    rdfs:label   "Inoperative" ;
    rdfs:comment "Total failure. Cannot process or receive requests." .

# Mobility Level
ex:Still        a owl:NamedIndividual, ex:MobilityLevel ; rdfs:label "Still" .
ex:Walking      a owl:NamedIndividual, ex:MobilityLevel ; rdfs:label "Walking" .
ex:Running      a owl:NamedIndividual, ex:MobilityLevel ; rdfs:label "Running" .
ex:InTransport  a owl:NamedIndividual, ex:MobilityLevel ; rdfs:label "In Transport" .

# Person Status
ex:Asleep  a owl:NamedIndividual, ex:PersonStatus ; rdfs:label "Asleep" .
ex:Calm    a owl:NamedIndividual, ex:PersonStatus ; rdfs:label "Calm" .
ex:Agitated a owl:NamedIndividual, ex:PersonStatus ; rdfs:label "Agitated" .

# Stress Level
ex:StressLow      a owl:NamedIndividual, ex:StressLevel ; rdfs:label "Low" .
ex:StressMedium   a owl:NamedIndividual, ex:StressLevel ; rdfs:label "Medium" .
ex:StressHigh     a owl:NamedIndividual, ex:StressLevel ; rdfs:label "High" .
ex:StressCritical a owl:NamedIndividual, ex:StressLevel ; rdfs:label "Critical" .

# Battery Level
ex:BatteryVeryLow a owl:NamedIndividual, ex:BatteryLevel ; rdfs:label "Very Low" .
ex:BatteryLow     a owl:NamedIndividual, ex:BatteryLevel ; rdfs:label "Low" .
ex:BatteryMedium  a owl:NamedIndividual, ex:BatteryLevel ; rdfs:label "Medium" .
ex:BatteryHigh    a owl:NamedIndividual, ex:BatteryLevel ; rdfs:label "High" .

# Device Connection Status
ex:Connected    a owl:NamedIndividual, ex:DeviceConnectionStatus ; rdfs:label "Connected" .
ex:Disconnected a owl:NamedIndividual, ex:DeviceConnectionStatus ; rdfs:label "Disconnected" .
ex:AirplaneMode a owl:NamedIndividual, ex:DeviceConnectionStatus ;
    rdfs:label   "Airplane Mode" ;
    rdfs:comment "No communication. Most basic local model active." .

# Processing Level
ex:FullProcessing    a owl:NamedIndividual, ex:ProcessingLevel ; rdfs:label "Full" .
ex:ReducedProcessing a owl:NamedIndividual, ex:ProcessingLevel ; rdfs:label "Reduced" .
ex:MinimalProcessing a owl:NamedIndividual, ex:ProcessingLevel ; rdfs:label "Minimal" .

# Adaptability Level
ex:Migratable          a owl:NamedIndividual, ex:AdaptabilityLevel ; rdfs:label "Migratable" .
ex:Scalable            a owl:NamedIndividual, ex:AdaptabilityLevel ; rdfs:label "Scalable" .
ex:MigratableAndScalable a owl:NamedIndividual, ex:AdaptabilityLevel ; rdfs:label "Migratable and Scalable" .
ex:NotAdaptable        a owl:NamedIndividual, ex:AdaptabilityLevel ; rdfs:label "Not Adaptable" .

# Profitability Level
ex:Adequate    a owl:NamedIndividual, ex:ProfitabilityLevel ; rdfs:label "Adequate" .
ex:NotAdequate a owl:NamedIndividual, ex:ProfitabilityLevel ; rdfs:label "Not Adequate" .

# Migration Time Level
ex:TimingVeryLow  a owl:NamedIndividual, ex:MigrationTimeLevel ; rdfs:label "Very Low" .
ex:TimingLow      a owl:NamedIndividual, ex:MigrationTimeLevel ; rdfs:label "Low" .
ex:TimingMedium   a owl:NamedIndividual, ex:MigrationTimeLevel ; rdfs:label "Medium" .
ex:TimingHigh     a owl:NamedIndividual, ex:MigrationTimeLevel ; rdfs:label "High" .
ex:TimingVeryHigh a owl:NamedIndividual, ex:MigrationTimeLevel ; rdfs:label "Very High" .

# Migration Cost Level
ex:CostVeryLow  a owl:NamedIndividual, ex:MigrationCostLevel ; rdfs:label "Very Low" .
ex:CostLow      a owl:NamedIndividual, ex:MigrationCostLevel ; rdfs:label "Low" .
ex:CostMedium   a owl:NamedIndividual, ex:MigrationCostLevel ; rdfs:label "Medium" .
ex:CostHigh     a owl:NamedIndividual, ex:MigrationCostLevel ; rdfs:label "High" .
ex:CostVeryHigh a owl:NamedIndividual, ex:MigrationCostLevel ; rdfs:label "Very High" .

# Distance Level
ex:VeryClose  a owl:NamedIndividual, ex:DistanceLevel ; rdfs:label "Very Close" .
ex:Close      a owl:NamedIndividual, ex:DistanceLevel ; rdfs:label "Close" .
ex:Near       a owl:NamedIndividual, ex:DistanceLevel ; rdfs:label "Near" .
ex:Far        a owl:NamedIndividual, ex:DistanceLevel ; rdfs:label "Far" .
ex:VeryFar    a owl:NamedIndividual, ex:DistanceLevel ; rdfs:label "Very Far" .

# Population Density
ex:HighDensity   a owl:NamedIndividual, ex:PopulationDensity ; rdfs:label "High Density" .
ex:MediumDensity a owl:NamedIndividual, ex:PopulationDensity ; rdfs:label "Medium Density" .
ex:LowDensity    a owl:NamedIndividual, ex:PopulationDensity ; rdfs:label "Low Density" .

# Consent Status
ex:ConsentGiven a owl:NamedIndividual, ex:ConsentStatus ;
    rdfs:label   "Consent Given" ;
    rdfs:comment "Anonymized data can be uploaded to the continuum for global HFL training." .

ex:ConsentDenied a owl:NamedIndividual, ex:ConsentStatus ;
    rdfs:label   "Consent Denied" ;
    rdfs:comment "Local training only. Data does not leave the person–device–edge area." .

# Model Tier
ex:LocalModelTier a owl:NamedIndividual, ex:ModelTier ;
    rdfs:label   "Local (Mist/Device)" ;
    rdfs:comment "Minimal model. No third-party data. For users without consent or connectivity." .

ex:EdgeModelTier a owl:NamedIndividual, ex:ModelTier ;
    rdfs:label   "Edge" ;
    rdfs:comment "Low-level model. Lower accuracy. For degradation or low-latency scenarios." .

ex:FogModelTier a owl:NamedIndividual, ex:ModelTier ;
    rdfs:label   "Fog / Community" ;
    rdfs:comment "Community/zone model. Aggregated data from nearby users." .

ex:CloudModelTier a owl:NamedIndividual, ex:ModelTier ;
    rdfs:label   "Cloud / Global" ;
    rdfs:comment "Global model. Highest accuracy. Anonymized data from all consenting users." .

# Model Degradation Causes
ex:CommunicationLoss  a owl:NamedIndividual, ex:ModelDegradationCause ; rdfs:label "Communication Loss" .
ex:LowBattery         a owl:NamedIndividual, ex:ModelDegradationCause ; rdfs:label "Low Battery" .
ex:NoNearbyNodes      a owl:NamedIndividual, ex:ModelDegradationCause ; rdfs:label "No Nearby Nodes" .
ex:InfrastructureOverload a owl:NamedIndividual, ex:ModelDegradationCause ; rdfs:label "Infrastructure Overload" .

# Traffic Windows
ex:MorningWindow a owl:NamedIndividual, ex:TrafficWindow ;
    rdfs:label   "Morning Window" ;
    rdfs:comment "High demand on wake-up: sleep calculation + daily stress prediction." .

ex:NightWindow a owl:NamedIndividual, ex:TrafficWindow ;
    rdfs:label   "Night Window" ;
    rdfs:comment "High demand at night: physiological parametrized data upload to continuum." .

# RBAC — Roles
ex:AdminRole        a owl:NamedIndividual, ex:Role ; rdfs:label "Administrator" .
ex:DoctorRole       a owl:NamedIndividual, ex:Role ; rdfs:label "Doctor" .
ex:ResearcherRole   a owl:NamedIndividual, ex:Role ; rdfs:label "Researcher" .
ex:EndUserRole      a owl:NamedIndividual, ex:Role ; rdfs:label "End User" .

# RBAC — Permissions
ex:ReadPhysiologicalData a owl:NamedIndividual, ex:Permission ;
    rdfs:label "Read Physiological Data" ;
    ex:requiresConsent "true"^^xsd:boolean .

ex:ReadSleepData a owl:NamedIndividual, ex:Permission ;
    rdfs:label "Read Sleep Data" ;
    ex:requiresConsent "true"^^xsd:boolean .

ex:ReadStressPrediction a owl:NamedIndividual, ex:Permission ;
    rdfs:label "Read Stress Prediction" ;
    ex:requiresConsent "false"^^xsd:boolean .

ex:TrainGlobalModel a owl:NamedIndividual, ex:Permission ;
    rdfs:label "Train Global Model" ;
    ex:requiresConsent "true"^^xsd:boolean .

ex:ManageInfrastructure a owl:NamedIndividual, ex:Permission ;
    rdfs:label "Manage Infrastructure" ;
    ex:requiresConsent "false"^^xsd:boolean .

# Role–Permission assignments
ex:AdminRole      ex:hasPermission ex:ManageInfrastructure, ex:ReadPhysiologicalData,
                                   ex:ReadSleepData, ex:TrainGlobalModel .
ex:DoctorRole     ex:hasPermission ex:ReadPhysiologicalData, ex:ReadSleepData,
                                   ex:ReadStressPrediction .
ex:ResearcherRole ex:hasPermission ex:TrainGlobalModel, ex:ReadStressPrediction .
ex:EndUserRole    ex:hasPermission ex:ReadStressPrediction .


# ================================================================
# 5. INFRASTRUCTURE INSTANCES
# ================================================================

ex:EdgeNode1 a owl:NamedIndividual, ex:EdgeNode ;
    rdfs:label       "Edge Node 1 - City Centre" ;
    ex:locatedIn     ex:CityCentreZone ;
    ex:coversArea    ex:CityCentreZone ;
    ex:hasElasticity "false"^^xsd:boolean ;
    ex:hasNeighborNode ex:EdgeNode2 ;
    ex:hostsModel    ex:ModelEdge1 ;
    ex:hostsService  ex:StressService1 .

ex:EdgeNode2 a owl:NamedIndividual, ex:EdgeNode ;
    rdfs:label       "Edge Node 2 - City Centre" ;
    ex:locatedIn     ex:CityCentreZone ;
    ex:hasElasticity "false"^^xsd:boolean ;
    ex:hasNeighborNode ex:EdgeNode1 .

ex:FogNode1 a owl:NamedIndividual, ex:FogNode ;
    rdfs:label       "Fog Node 1 - Centre Zone" ;
    ex:coversArea    ex:CityCentreZone ;
    ex:hasElasticity "false"^^xsd:boolean ;
    ex:hostsModel    ex:ModelFog1 .

ex:CloudNode1 a owl:NamedIndividual, ex:CloudNode ;
    rdfs:label       "Cloud Node - Global" ;
    ex:hasElasticity "true"^^xsd:boolean ;
    ex:hostsModel    ex:ModelCloud1 .


# ================================================================
# 6. URBAN CONTEXT INSTANCES
# ================================================================

ex:CityCentreZone a owl:NamedIndividual, ex:UrbanZone ;
    rdfs:label              "City Centre" ;
    ex:hasPopulationDensity ex:HighDensity .

ex:NorthRuralZone a owl:NamedIndividual, ex:RuralZone ;
    rdfs:label              "North Rural Zone" ;
    ex:hasPopulationDensity ex:LowDensity .

ex:CareFacility1 a owl:NamedIndividual, ex:RestrictedZone ;
    rdfs:label              "Senior Care Facility A" ;
    ex:hasPopulationDensity ex:MediumDensity .

ex:CentreNeighbourhood a owl:NamedIndividual, ex:Community ;
    rdfs:label "Centre Neighbourhood Community" .

ex:CareFacilityCommunity a owl:NamedIndividual, ex:Community ;
    rdfs:label "Care Facility A Community" ;
    rdfs:comment "Community of residents of Senior Care Facility A." .


# ================================================================
# 7. USER INSTANCES
# ================================================================

# User A — consent given, smartwatch + mobile
ex:UserA a owl:NamedIndividual, ex:User ;
    foaf:name            "Participant A" ;
    ex:anonymizedID      "USR-A001" ;
    ex:hasConsent        ex:ConsentGiven ;
    ex:hasWearable       ex:WatchA ;
    ex:hasMobileDevice   ex:MobileA ;
    ex:locatedInZone     ex:CityCentreZone ;
    ex:belongsToCommunity ex:CentreNeighbourhood ;
    ex:hasRole           ex:EndUserRole .

# User B — consent denied, smart ring only
ex:UserB a owl:NamedIndividual, ex:User ;
    foaf:name        "Participant B" ;
    ex:anonymizedID  "USR-B002" ;
    ex:hasConsent    ex:ConsentDenied ;
    ex:hasWearable   ex:RingB ;
    ex:hasRole       ex:EndUserRole .

# User C — consent given, rural zone, smart band
ex:UserC a owl:NamedIndividual, ex:User ;
    foaf:name            "Participant C" ;
    ex:anonymizedID      "USR-C003" ;
    ex:hasConsent        ex:ConsentGiven ;
    ex:hasWearable       ex:BandC ;
    ex:hasMobileDevice   ex:MobileC ;
    ex:locatedInZone     ex:NorthRuralZone ;
    ex:hasRole           ex:EndUserRole .

# User D — care facility, consent given, no mobile
ex:UserD a owl:NamedIndividual, ex:User ;
    foaf:name            "Participant D" ;
    ex:anonymizedID      "USR-D004" ;
    ex:hasConsent        ex:ConsentGiven ;
    ex:hasWearable       ex:WatchD ;
    ex:locatedInZone     ex:CareFacility1 ;
    ex:belongsToCommunity ex:CareFacilityCommunity ;
    ex:hasRole           ex:EndUserRole .


# ================================================================
# 8. WEARABLE & MOBILE DEVICE INSTANCES
# ================================================================

ex:WatchA a owl:NamedIndividual, ex:SmartWatch ;
    rdfs:label     "Smart Watch A1" ;
    ex:connectsTo  ex:EdgeNode1 .

ex:RingB a owl:NamedIndividual, ex:SmartRing, ex:MistNode ;
    rdfs:label "Smart Ring B1" ;
    rdfs:comment "Acts as a personal Mist node for local-only model execution (UserB, no consent)." .

ex:BandC a owl:NamedIndividual, ex:SmartBand ;
    rdfs:label "Smart Band C1" .

ex:WatchD a owl:NamedIndividual, ex:SmartWatch ;
    rdfs:label    "Smart Watch D1" ;
    ex:connectsTo ex:EdgeNode1 .

ex:MobileA a owl:NamedIndividual, ex:MobileDevice ;
    rdfs:label    "Mobile Device - Participant A" ;
    ex:connectsTo ex:EdgeNode1 .

ex:MobileC a owl:NamedIndividual, ex:MobileDevice ;
    rdfs:label "Mobile Device - Participant C" .


# ================================================================
# 9. SENSOR INSTANCES
# ================================================================

ex:HRSensorA a owl:NamedIndividual, ex:HeartRateSensor ;
    rdfs:label      "HR Sensor - Watch A" ;
    sosa:isHostedBy ex:WatchA .

ex:EDASensorA a owl:NamedIndividual, ex:EDASensor ;
    rdfs:label      "EDA Sensor - Watch A" ;
    sosa:isHostedBy ex:WatchA .

ex:SleepSensorA a owl:NamedIndividual, ex:SleepSensor ;
    rdfs:label      "Sleep Sensor - Watch A" ;
    sosa:isHostedBy ex:WatchA .

ex:AccelSensorA a owl:NamedIndividual, ex:AccelerometerSensor ;
    rdfs:label      "Accelerometer - Watch A" ;
    sosa:isHostedBy ex:WatchA .

ex:SpO2SensorA a owl:NamedIndividual, ex:SpO2Sensor ;
    rdfs:label      "SpO2 Sensor - Watch A" ;
    sosa:isHostedBy ex:WatchA .


# ================================================================
# 10. AI MODEL INSTANCES
# ================================================================

ex:ModelLocal1 a owl:NamedIndividual, ex:AIModel ;
    rdfs:label       "Local Model - Mobile A" ;
    ex:hasModelTier  ex:LocalModelTier ;
    ex:hostedOnNode  ex:MobileA ;
    ex:modelVersion  "0.9.0" ;
    ex:lastUpdated   "2026-05-04T00:00:00"^^xsd:dateTime .

ex:ModelEdge1 a owl:NamedIndividual, ex:AIModel ;
    rdfs:label       "Edge Model - Edge Node 1" ;
    ex:hasModelTier  ex:EdgeModelTier ;
    ex:hostedOnNode  ex:EdgeNode1 ;
    ex:modelVersion  "1.2.0" ;
    ex:lastUpdated   "2026-05-04T08:00:00"^^xsd:dateTime .

ex:ModelFog1 a owl:NamedIndividual, ex:AIModel ;
    rdfs:label       "Fog Model - Community Centre" ;
    ex:hasModelTier  ex:FogModelTier ;
    ex:hostedOnNode  ex:FogNode1 ;
    ex:modelVersion  "1.8.0" ;
    ex:lastUpdated   "2026-05-04T06:00:00"^^xsd:dateTime .

ex:ModelCloud1 a owl:NamedIndividual, ex:AIModel ;
    rdfs:label       "Global Cloud Model" ;
    ex:hasModelTier  ex:CloudModelTier ;
    ex:hostedOnNode  ex:CloudNode1 ;
    ex:modelVersion  "2.1.0" ;
    ex:lastUpdated   "2026-05-04T03:10:00"^^xsd:dateTime .


# ================================================================
# 11. SERVICE INSTANCE
# ================================================================

ex:StressService1 a owl:NamedIndividual, ex:Service ;
    rdfs:label       "Stress Prediction Service" ;
    ex:hostsModel    ex:ModelEdge1 .


ex:HeartRateProperty a owl:NamedIndividual ;
    rdfs:label "Heart Rate" ;
    rdfs:comment "Observable property: heart rate in bpm." .

ex:EDAProperty a owl:NamedIndividual ;
    rdfs:label "Electrodermal Activity" ;
    rdfs:comment "Observable property: electrodermal activity in µS." .

ex:SleepQualityProperty a owl:NamedIndividual ;
    rdfs:label "Sleep Quality" ;
    rdfs:comment "Observable property: sleep quality score (0–100)." .


# ================================================================
# 12. BASE OBSERVATION
# ================================================================

ex:Obs_HR_A1 a owl:NamedIndividual, ex:PhysiologicalObservation ;
    sosa:madeBySensor          ex:HRSensorA ;
    sosa:hasFeatureOfInterest  ex:UserA ;
    sosa:observedProperty      ex:HeartRateProperty ;
    sosa:hasSimpleResult       "78" ;
    sosa:resultTime            "2026-05-04T10:01:00"^^xsd:dateTime .

ex:Obs_Sleep_A1 a owl:NamedIndividual, ex:SleepObservation ;
    sosa:madeBySensor          ex:SleepSensorA ;
    sosa:hasFeatureOfInterest  ex:UserA ;
    sosa:observedProperty      ex:SleepQualityProperty ;
    sosa:hasSimpleResult       "82" ;
    sosa:resultTime            "2026-05-04T07:00:00"^^xsd:dateTime .

ex:Obs_EDA_A1 a owl:NamedIndividual, ex:PhysiologicalObservation ;
    sosa:madeBySensor          ex:EDASensorA ;
    sosa:hasFeatureOfInterest  ex:UserA ;
    sosa:observedProperty      ex:EDAProperty ;
    sosa:hasSimpleResult       "3.2" ;
    sosa:resultTime            "2026-05-04T10:01:00"^^xsd:dateTime .


# ================================================================
# 13. PARAMETRIZED DATA INSTANCES
# ================================================================

ex:SleepDataA1 a owl:NamedIndividual, ex:SleepParametrizedData ;
    ex:generatedBy    ex:WatchA ;
    ex:sentToNode     ex:EdgeNode1 ;
    ex:isRedundant    "false"^^xsd:boolean ;
    ex:sendTimestamp  "2026-05-04T07:15:00"^^xsd:dateTime .

ex:PhysioDataA1 a owl:NamedIndividual, ex:PhysiologicalParametrizedData ;
    ex:generatedBy    ex:WatchA ;
    ex:sentToNode     ex:EdgeNode1 ;
    ex:isRedundant    "false"^^xsd:boolean ;
    ex:sendTimestamp  "2026-05-04T22:30:00"^^xsd:dateTime .


# ================================================================
#
#  OPERATIONAL SCENARIOS
#
# ================================================================


# ----------------------------------------------------------------
# SCENARIO 1 — Normal balanced state
# ----------------------------------------------------------------
# Description: Low user load, stable communication, optimal node.
#              Full model active. Migration not needed.
# ----------------------------------------------------------------

ex:UserState_S1_A a owl:NamedIndividual, ex:UserState ;
    rdfs:label               "User State S1 - Participant A" ;
    ex:hasMobility           ex:Still ;
    ex:hasPersonStatus       ex:Calm ;
    ex:hasPredictedStressLevel ex:StressLow ;
    ex:userFeedbackScore     5 ;
    ex:derivedFrom           ex:Obs_HR_A1 ;
    ex:validFrom             "2026-05-04T09:00:00"^^xsd:dateTime .

ex:UserA ex:hasUserState ex:UserState_S1_A .

ex:DeviceState_S1_WatchA a owl:NamedIndividual, ex:DeviceState ;
    rdfs:label                "Device State S1 - Watch A" ;
    ex:hasBatteryLevel        ex:BatteryHigh ;
    ex:hasConnectionStatus    ex:Connected ;
    ex:parametrizedDataReady  "true"^^xsd:boolean ;
    ex:derivedFrom            ex:Obs_HR_A1 ;
    ex:validFrom              "2026-05-04T09:00:00"^^xsd:dateTime .

ex:WatchA ex:hasDeviceState ex:DeviceState_S1_WatchA .

ex:NodeState_S1_Edge1 a owl:NamedIndividual, ex:NodeState ;
    rdfs:label              "Node State S1 - Edge1 Normal" ;
    ex:hasAvailability      ex:Available ;
    ex:hasCommunication     ex:StableComm ;
    ex:hasEnergyLevel       ex:HighEnergy ;
    ex:hasPerformance       ex:Optimal ;
    ex:hasWorkload          ex:LowWorkload ;
    ex:hasResidualCapacity  ex:HighResidual ;
    ex:hasOperationalStatus ex:Operational ;
    ex:resourceUsagePercent "30.0"^^xsd:decimal ;
    ex:queuedRequests       1 ;
    ex:derivedFrom          ex:Obs_HR_A1 ;
    ex:validFrom            "2026-05-04T09:00:00"^^xsd:dateTime .

ex:EdgeNode1 ex:hasNodeState ex:NodeState_S1_Edge1 .

ex:ServiceState_S1 a owl:NamedIndividual, ex:ServiceState ;
    rdfs:label              "Service State S1 - Normal" ;
    ex:hasAdaptability      ex:MigratableAndScalable ;
    ex:hasProcessingLevel   ex:FullProcessing ;
    ex:validFrom            "2026-05-04T09:00:00"^^xsd:dateTime .

ex:StressService1 ex:hasServiceState ex:ServiceState_S1 .

ex:NodeUserRel_S1_Edge1_UserA a owl:NamedIndividual, ex:NodeUserRelation ;
    rdfs:label         "Node-User Relation S1 - Edge1/UserA" ;
    ex:relatesNode     ex:EdgeNode1 ;
    ex:relatesUser     ex:UserA ;
    ex:hasDistance     ex:Close ;
    ex:isPreferredNode "true"^^xsd:boolean ;
    ex:validFrom       "2026-05-04T09:00:00"^^xsd:dateTime .

ex:Eval_S1 a owl:NamedIndividual, ex:EvaluationState ;
    rdfs:label          "Evaluation S1 - Normal" ;
    ex:evaluatesNode    ex:EdgeNode1 ;
    ex:evaluatesService ex:StressService1 ;
    ex:hasProfitability ex:Adequate ;
    ex:hasMigrationTime ex:TimingLow ;
    ex:hasMigrationCost ex:CostLow ;
    ex:validFrom        "2026-05-04T09:05:00"^^xsd:dateTime .


# ----------------------------------------------------------------
# SCENARIO 2 — Urban saturation (mass event)
# ----------------------------------------------------------------
# Description: Large number of simultaneous requests. Edge saturated.
#              Service degrades. Fog node as fallback candidate.
# ----------------------------------------------------------------

ex:UserState_S2 a owl:NamedIndividual, ex:UserState ;
    rdfs:label               "User State S2 - Mass Event" ;
    ex:hasMobility           ex:Walking ;
    ex:hasPersonStatus       ex:Agitated ;
    ex:hasPredictedStressLevel ex:StressHigh ;
    ex:userFeedbackScore     2 ;
    ex:validFrom             "2026-05-04T11:00:00"^^xsd:dateTime .

ex:NodeState_S2_Edge1 a owl:NamedIndividual, ex:NodeState ;
    rdfs:label              "Node State S2 - Edge1 Saturated" ;
    ex:hasAvailability      ex:Partial ;
    ex:hasCommunication     ex:VariableComm ;
    ex:hasEnergyLevel       ex:MediumEnergy ;
    ex:hasPerformance       ex:Acceptable ;
    ex:hasWorkload          ex:SaturatedWorkload ;
    ex:hasResidualCapacity  ex:LowResidual ;
    ex:hasOperationalStatus ex:Operational ;
    ex:resourceUsagePercent "92.0"^^xsd:decimal ;
    ex:queuedRequests       15 ;
    ex:validFrom            "2026-05-04T11:00:00"^^xsd:dateTime .

ex:EdgeNode1 ex:hasNodeState ex:NodeState_S2_Edge1 .

ex:NodeState_S2_Fog1 a owl:NamedIndividual, ex:NodeState ;
    rdfs:label              "Node State S2 - Fog1 Available" ;
    ex:hasAvailability      ex:Available ;
    ex:hasCommunication     ex:StableComm ;
    ex:hasEnergyLevel       ex:HighEnergy ;
    ex:hasPerformance       ex:Optimal ;
    ex:hasWorkload          ex:MediumWorkload ;
    ex:hasResidualCapacity  ex:MediumResidual ;
    ex:hasOperationalStatus ex:Operational ;
    ex:resourceUsagePercent "55.0"^^xsd:decimal ;
    ex:queuedRequests       4 ;
    ex:validFrom            "2026-05-04T11:00:00"^^xsd:dateTime .

ex:FogNode1 ex:hasNodeState ex:NodeState_S2_Fog1 .

ex:ServiceState_S2 a owl:NamedIndividual, ex:ServiceState ;
    rdfs:label            "Service State S2 - Degraded at Edge" ;
    ex:hasAdaptability    ex:Migratable ;
    ex:hasProcessingLevel ex:ReducedProcessing ;
    ex:validFrom          "2026-05-04T11:00:00"^^xsd:dateTime .

ex:Eval_S2 a owl:NamedIndividual, ex:EvaluationState ;
    rdfs:label          "Evaluation S2 - Saturation" ;
    ex:evaluatesNode    ex:EdgeNode1 ;
    ex:evaluatesService ex:StressService1 ;
    ex:hasProfitability ex:NotAdequate ;
    ex:hasMigrationTime ex:TimingMedium ;
    ex:hasMigrationCost ex:CostMedium ;
    ex:validFrom        "2026-05-04T11:05:00"^^xsd:dateTime .


# ----------------------------------------------------------------
# SCENARIO 3 — Edge → Fog migration
# ----------------------------------------------------------------
# Description: Edge saturated (Scenario 2). Migration to Fog is
#              triggered. Federated session transfers gradients.
#              Service resumes at Fog with reduced processing.
# ----------------------------------------------------------------

ex:FL_S3_EdgeToFog a owl:NamedIndividual, ex:FederatedLearningSession ;
    rdfs:label       "FL Session S3 - Edge to Fog" ;
    ex:involvedNode  ex:EdgeNode1 ;
    ex:involvedNode  ex:FogNode1 ;
    ex:updatesModel  ex:ModelFog1 ;
    ex:dataType      "model_gradients" ;
    ex:sessionTime   "2026-05-04T11:10:00"^^xsd:dateTime .

ex:ServiceState_S3_Fog a owl:NamedIndividual, ex:ServiceState ;
    rdfs:label            "Service State S3 - Migrated to Fog" ;
    ex:hasAdaptability    ex:Migratable ;
    ex:hasProcessingLevel ex:ReducedProcessing ;
    ex:validFrom          "2026-05-04T11:10:00"^^xsd:dateTime .

ex:EdgeNode1 ex:delegatesTo ex:FogNode1 .

ex:Eval_S3 a owl:NamedIndividual, ex:EvaluationState ;
    rdfs:label          "Evaluation S3 - Migration to Fog" ;
    ex:evaluatesNode    ex:FogNode1 ;
    ex:evaluatesService ex:StressService1 ;
    ex:hasProfitability ex:Adequate ;
    ex:hasMigrationTime ex:TimingLow ;
    ex:hasMigrationCost ex:CostLow ;
    ex:validFrom        "2026-05-04T11:12:00"^^xsd:dateTime .


# ----------------------------------------------------------------
# SCENARIO 4 — Communication failure & model degradation
# ----------------------------------------------------------------
# Description: Edge Node 2 loses connectivity. Transitions to
#              ComputeOnly state. Remaining nodes take over.
#              Model degrades. User in transport with no signal.
# ----------------------------------------------------------------

ex:UserState_S4 a owl:NamedIndividual, ex:UserState ;
    rdfs:label               "User State S4 - No Signal" ;
    ex:hasMobility           ex:InTransport ;
    ex:hasPersonStatus       ex:Agitated ;
    ex:hasPredictedStressLevel ex:StressCritical ;
    ex:validFrom             "2026-05-04T12:00:00"^^xsd:dateTime .

ex:DeviceState_S4_WatchA a owl:NamedIndividual, ex:DeviceState ;
    rdfs:label                "Device State S4 - Watch A Low Battery" ;
    ex:hasBatteryLevel        ex:BatteryLow ;
    ex:hasConnectionStatus    ex:AirplaneMode ;
    ex:parametrizedDataReady  "false"^^xsd:boolean ;
    ex:validFrom              "2026-05-04T12:00:00"^^xsd:dateTime .

ex:NodeState_S4_Edge2 a owl:NamedIndividual, ex:NodeState ;
    rdfs:label              "Node State S4 - Edge2 Disconnected" ;
    ex:hasAvailability      ex:NotAvailable ;
    ex:hasCommunication     ex:NoConnectionComm ;
    ex:hasEnergyLevel       ex:LowEnergy ;
    ex:hasPerformance       ex:Deficient ;
    ex:hasWorkload          ex:SaturatedWorkload ;
    ex:hasResidualCapacity  ex:CriticalResidual ;
    ex:hasOperationalStatus ex:ComputeOnly ;
    ex:resourceUsagePercent "99.0"^^xsd:decimal ;
    ex:queuedRequests       25 ;
    ex:validFrom            "2026-05-04T12:00:00"^^xsd:dateTime .

ex:EdgeNode2 ex:hasNodeState ex:NodeState_S4_Edge2 .
ex:EdgeNode2 ex:delegatesTo  ex:EdgeNode1 .

ex:ModelEdge1 ex:hasDegradationCause ex:CommunicationLoss .

ex:Eval_S4 a owl:NamedIndividual, ex:EvaluationState ;
    rdfs:label          "Evaluation S4 - Communication Failure" ;
    ex:evaluatesNode    ex:EdgeNode2 ;
    ex:evaluatesService ex:StressService1 ;
    ex:hasProfitability ex:NotAdequate ;
    ex:hasMigrationTime ex:TimingVeryHigh ;
    ex:hasMigrationCost ex:CostVeryHigh ;
    ex:validFrom        "2026-05-04T12:05:00"^^xsd:dateTime .


# ----------------------------------------------------------------
# SCENARIO 5 — User without consent (local-only model)
# ----------------------------------------------------------------
# Description: User B has denied consent. Data does not leave the
#              device. Local model only. Feedback loop active.
#              Model improves can be received from HFL (downward).
# ----------------------------------------------------------------

ex:UserState_S5_B a owl:NamedIndividual, ex:UserState ;
    rdfs:label               "User State S5 - User B Local" ;
    ex:hasMobility           ex:Still ;
    ex:hasPersonStatus       ex:Calm ;
    ex:hasPredictedStressLevel ex:StressLow ;
    ex:userFeedbackScore     4 ;
    ex:validFrom             "2026-05-04T09:00:00"^^xsd:dateTime .

ex:UserB ex:hasUserState ex:UserState_S5_B .

ex:DeviceState_S5_RingB a owl:NamedIndividual, ex:DeviceState ;
    rdfs:label                "Device State S5 - Ring B" ;
    ex:hasBatteryLevel        ex:BatteryMedium ;
    ex:hasConnectionStatus    ex:Connected ;
    ex:parametrizedDataReady  "true"^^xsd:boolean ;
    ex:validFrom              "2026-05-04T09:00:00"^^xsd:dateTime .

ex:RingB ex:hasDeviceState ex:DeviceState_S5_RingB .

ex:ModelLocalB a owl:NamedIndividual, ex:AIModel ;
    rdfs:label       "Local Model - Ring B (No Consent)" ;
    ex:hasModelTier  ex:LocalModelTier ;
    ex:hostedOnNode  ex:RingB ;
    ex:modelVersion  "0.8.0" ;
    ex:lastUpdated   "2026-05-04T00:00:00"^^xsd:dateTime ;
    ex:hasDegradationCause ex:NoNearbyNodes .

ex:Eval_S5 a owl:NamedIndividual, ex:EvaluationState ;
    rdfs:label          "Evaluation S5 - Local Only" ;
    ex:evaluatesNode    ex:MobileA ;
    ex:evaluatesService ex:StressService1 ;
    ex:hasProfitability ex:Adequate ;
    ex:hasMigrationTime ex:TimingLow ;
    ex:hasMigrationCost ex:CostLow ;
    ex:validFrom        "2026-05-04T09:05:00"^^xsd:dateTime .


# ----------------------------------------------------------------
# SCENARIO 6 — Successful global federated learning
# ----------------------------------------------------------------
# Description: Night window. All consenting users' parametrized
#              data has been uploaded. FL session propagates from
#              Edge → Fog → Cloud. Cloud model updated.
#              Improved model pushed back down to Edge/Fog/Local.
# ----------------------------------------------------------------

ex:FL_S6_EdgeToCloud a owl:NamedIndividual, ex:FederatedLearningSession ;
    rdfs:label       "FL Session S6 - Global Update" ;
    ex:involvedNode  ex:CloudNode1 ;
    ex:involvedNode  ex:FogNode1 ;
    ex:involvedNode  ex:EdgeNode1 ;
    ex:updatesModel  ex:ModelCloud1 ;
    ex:dataType      "global_model_parameters" ;
    ex:sessionTime   "2026-05-04T03:00:00"^^xsd:dateTime .

ex:FL_S6_DownloadToEdge a owl:NamedIndividual, ex:FederatedLearningSession ;
    rdfs:label       "FL Session S6 - Download to Edge" ;
    ex:involvedNode  ex:CloudNode1 ;
    ex:involvedNode  ex:EdgeNode1 ;
    ex:updatesModel  ex:ModelEdge1 ;
    ex:dataType      "improved_model_parameters" ;
    ex:sessionTime   "2026-05-04T04:00:00"^^xsd:dateTime .

ex:NodeState_S6_Cloud a owl:NamedIndividual, ex:NodeState ;
    rdfs:label              "Node State S6 - Cloud Normal" ;
    ex:hasAvailability      ex:Available ;
    ex:hasCommunication     ex:StableComm ;
    ex:hasEnergyLevel       ex:HighEnergy ;
    ex:hasPerformance       ex:Optimal ;
    ex:hasWorkload          ex:LowWorkload ;
    ex:hasResidualCapacity  ex:HighResidual ;
    ex:hasOperationalStatus ex:Operational ;
    ex:resourceUsagePercent "25.0"^^xsd:decimal ;
    ex:queuedRequests       0 ;
    ex:validFrom            "2026-05-04T03:00:00"^^xsd:dateTime .

ex:CloudNode1 ex:hasNodeState ex:NodeState_S6_Cloud .

ex:Eval_S6 a owl:NamedIndividual, ex:EvaluationState ;
    rdfs:label          "Evaluation S6 - Global FL" ;
    ex:evaluatesNode    ex:CloudNode1 ;
    ex:evaluatesService ex:StressService1 ;
    ex:hasProfitability ex:Adequate ;
    ex:hasMigrationTime ex:TimingVeryLow ;
    ex:hasMigrationCost ex:CostVeryLow ;
    ex:validFrom        "2026-05-04T03:10:00"^^xsd:dateTime .


# ----------------------------------------------------------------
# SCENARIO 7 — Rural zone: low connectivity, data retention
# ----------------------------------------------------------------
# Description: User C in rural zone. Few nearby nodes.
#              Data retained locally. Controlled upload when
#              communication window opens.
# ----------------------------------------------------------------

ex:UserState_S7_C a owl:NamedIndividual, ex:UserState ;
    rdfs:label               "User State S7 - User C Rural" ;
    ex:hasMobility           ex:Walking ;
    ex:hasPersonStatus       ex:Calm ;
    ex:hasPredictedStressLevel ex:StressMedium ;
    ex:userFeedbackScore     3 ;
    ex:validFrom             "2026-05-04T10:00:00"^^xsd:dateTime .

ex:UserC ex:hasUserState ex:UserState_S7_C .

ex:DeviceState_S7_BandC a owl:NamedIndividual, ex:DeviceState ;
    rdfs:label                "Device State S7 - Band C Rural" ;
    ex:hasBatteryLevel        ex:BatteryMedium ;
    ex:hasConnectionStatus    ex:Disconnected ;
    ex:parametrizedDataReady  "true"^^xsd:boolean ;
    ex:validFrom              "2026-05-04T10:00:00"^^xsd:dateTime .

ex:BandC ex:hasDeviceState ex:DeviceState_S7_BandC .

ex:MobileC_NodeState_S7 a owl:NamedIndividual, ex:NodeState ;
    rdfs:label              "Node State S7 - Mobile C Rural" ;
    ex:hasAvailability      ex:Partial ;
    ex:hasCommunication     ex:IntermittentComm ;
    ex:hasEnergyLevel       ex:MediumEnergy ;
    ex:hasPerformance       ex:Acceptable ;
    ex:hasWorkload          ex:LowWorkload ;
    ex:hasResidualCapacity  ex:MediumResidual ;
    ex:hasOperationalStatus ex:Operational ;
    ex:resourceUsagePercent "40.0"^^xsd:decimal ;
    ex:queuedRequests       0 ;
    ex:validFrom            "2026-05-04T10:00:00"^^xsd:dateTime .

ex:MobileC ex:hasNodeState ex:MobileC_NodeState_S7 .

ex:ModelLocal_C a owl:NamedIndividual, ex:AIModel ;
    rdfs:label       "Local Model - Mobile C Rural" ;
    ex:hasModelTier  ex:LocalModelTier ;
    ex:hostedOnNode  ex:MobileC ;
    ex:modelVersion  "1.0.0" ;
    ex:hasDegradationCause ex:NoNearbyNodes .

ex:Eval_S7 a owl:NamedIndividual, ex:EvaluationState ;
    rdfs:label          "Evaluation S7 - Rural Retention" ;
    ex:evaluatesNode    ex:MobileC ;
    ex:evaluatesService ex:StressService1 ;
    ex:hasProfitability ex:Adequate ;
    ex:hasMigrationTime ex:TimingHigh ;
    ex:hasMigrationCost ex:CostHigh ;
    ex:validFrom        "2026-05-04T10:05:00"^^xsd:dateTime .


# ----------------------------------------------------------------
# SCENARIO 8 — Restricted zone: care facility, internal only
# ----------------------------------------------------------------
# Description: User D in a senior care facility (RestrictedZone).
#              No external internet. Internal centralized topology.
#              Data governance — data never leaves the facility.
# ----------------------------------------------------------------

ex:UserState_S8_D a owl:NamedIndividual, ex:UserState ;
    rdfs:label               "User State S8 - User D Care Facility" ;
    ex:hasMobility           ex:Still ;
    ex:hasPersonStatus       ex:Asleep ;
    ex:hasPredictedStressLevel ex:StressLow ;
    ex:validFrom             "2026-05-04T02:00:00"^^xsd:dateTime .

ex:UserD ex:hasUserState ex:UserState_S8_D .

ex:InternalEdgeFacility a owl:NamedIndividual, ex:EdgeNode ;
    rdfs:label       "Internal Edge - Care Facility A" ;
    ex:locatedIn     ex:CareFacility1 ;
    ex:coversArea    ex:CareFacility1 ;
    ex:hasElasticity "false"^^xsd:boolean .

ex:NodeState_S8_Internal a owl:NamedIndividual, ex:NodeState ;
    rdfs:label              "Node State S8 - Internal Edge Facility" ;
    ex:hasAvailability      ex:Available ;
    ex:hasCommunication     ex:StableComm ;
    ex:hasEnergyLevel       ex:HighEnergy ;
    ex:hasPerformance       ex:Optimal ;
    ex:hasWorkload          ex:LowWorkload ;
    ex:hasResidualCapacity  ex:HighResidual ;
    ex:hasOperationalStatus ex:Operational ;
    ex:resourceUsagePercent "20.0"^^xsd:decimal ;
    ex:queuedRequests       2 ;
    ex:validFrom            "2026-05-04T02:00:00"^^xsd:dateTime .

ex:InternalEdgeFacility ex:hasNodeState ex:NodeState_S8_Internal .

ex:WatchD ex:connectsTo ex:InternalEdgeFacility .

ex:Eval_S8 a owl:NamedIndividual, ex:EvaluationState ;
    rdfs:label          "Evaluation S8 - Restricted Zone" ;
    ex:evaluatesNode    ex:InternalEdgeFacility ;
    ex:evaluatesService ex:StressService1 ;
    ex:hasProfitability ex:Adequate ;
    ex:hasMigrationTime ex:TimingVeryLow ;
    ex:hasMigrationCost ex:CostVeryLow ;
    ex:validFrom        "2026-05-04T02:05:00"^^xsd:dateTime .



# ================================================================
# 14. EXTENSIONS v2.1 — Consent-aware, trust, AHP, DP & policies
# ================================================================

# ----------------------------------------------------------------
# 14.1 Consent-aware semantic contracts
# ----------------------------------------------------------------

ex:ConsentRange a owl:Class ;
    rdfs:label   "Consent Range" ;
    rdfs:comment "Consent scope replacing the previous binary-only interpretation. It controls where and how data/model updates may be processed across the continuum." .

ex:SemanticContract a owl:Class ;
    rdfs:subClassOf ex:State ;
    rdfs:label   "Semantic Contract" ;
    rdfs:comment "Formal agreement between a user and the system, binding the user, an active consent range, permitted purposes, policies and temporal validity." .

ex:ProcessingPurpose a owl:Class ;
    rdfs:label   "Processing Purpose" ;
    rdfs:comment "Purpose for which data, model parameters or predictions are processed." .

ex:hasSemanticContract a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:SemanticContract ;
    rdfs:label  "has semantic contract" .

ex:contractSubject a owl:ObjectProperty ;
    rdfs:domain ex:SemanticContract ;
    rdfs:range  ex:User ;
    rdfs:label  "contract subject" .

ex:hasActiveConsentRange a owl:ObjectProperty ;
    rdfs:domain ex:User ;
    rdfs:range  ex:ConsentRange ;
    rdfs:label  "has active consent range" ;
    rdfs:comment "Current consent-aware scope inferred from the active semantic contract." .

ex:hasConsentRange a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:User ex:SemanticContract ex:Policy ex:FederatedLearningSession ex:EvaluationState )
    ] ;
    rdfs:range  ex:ConsentRange ;
    rdfs:label  "has consent range" .

ex:requiresConsentRange a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:Permission ex:Policy ex:Service ex:ServiceState ex:AIModel ex:FederatedLearningSession ex:EvaluationState )
    ] ;
    rdfs:range  ex:ConsentRange ;
    rdfs:label  "requires consent range" ;
    rdfs:comment "Minimum consent-aware processing scope required for an action, policy, model tier or FL session." .

ex:hasProcessingPurpose a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:SemanticContract ex:Policy ex:FederatedLearningSession ex:EvaluationState ex:Permission )
    ] ;
    rdfs:range  ex:ProcessingPurpose ;
    rdfs:label  "has processing purpose" .

# Consent range individuals
ex:RangeLocalOnly a owl:NamedIndividual, ex:ConsentRange ;
    rdfs:label   "Local Only" ;
    rdfs:comment "Processing is limited to the wearable/mobile device and raw physiological data must not leave the personal area." .

ex:RangeCommunityAgg a owl:NamedIndividual, ex:ConsentRange ;
    rdfs:label   "Community Aggregation" ;
    rdfs:comment "Aggregated or noisy updates may be processed at edge/fog/community level; no global aggregation is authorised." .

ex:RangeGlobalAgg a owl:NamedIndividual, ex:ConsentRange ;
    rdfs:label   "Global Aggregation" ;
    rdfs:comment "Anonymized and privacy-protected updates may participate in global/cloud federated learning." .

# Processing purpose individuals
ex:PurposeLocalPrediction a owl:NamedIndividual, ex:ProcessingPurpose ;
    rdfs:label "Local stress prediction" .

ex:PurposeClinicalMonitoring a owl:NamedIndividual, ex:ProcessingPurpose ;
    rdfs:label "Clinical monitoring" .

ex:PurposeCommunityFederatedLearning a owl:NamedIndividual, ex:ProcessingPurpose ;
    rdfs:label "Community federated learning" .

ex:PurposeGlobalFederatedLearning a owl:NamedIndividual, ex:ProcessingPurpose ;
    rdfs:label "Global federated learning" .

ex:PurposeInfrastructureAdaptation a owl:NamedIndividual, ex:ProcessingPurpose ;
    rdfs:label "Infrastructure adaptation" .

# Semantic contract instances and backward-compatible consent scopes
ex:Contract_UserA_Global a owl:NamedIndividual, ex:SemanticContract ;
    rdfs:label              "Semantic Contract - Participant A Global" ;
    ex:contractSubject      ex:UserA ;
    ex:hasConsentRange      ex:RangeGlobalAgg ;
    ex:hasProcessingPurpose ex:PurposeLocalPrediction, ex:PurposeGlobalFederatedLearning ;
    ex:governedBy           ex:ConsentAwareProcessingPolicy, ex:FLGradientDifferentialPrivacyPolicy ;
    ex:validFrom            "2026-05-04T00:00:00"^^xsd:dateTime .

ex:Contract_UserB_LocalOnly a owl:NamedIndividual, ex:SemanticContract ;
    rdfs:label              "Semantic Contract - Participant B Local Only" ;
    ex:contractSubject      ex:UserB ;
    ex:hasConsentRange      ex:RangeLocalOnly ;
    ex:hasProcessingPurpose ex:PurposeLocalPrediction ;
    ex:governedBy           ex:ConsentAwareProcessingPolicy ;
    ex:validFrom            "2026-05-04T00:00:00"^^xsd:dateTime .

ex:Contract_UserC_Community a owl:NamedIndividual, ex:SemanticContract ;
    rdfs:label              "Semantic Contract - Participant C Community" ;
    ex:contractSubject      ex:UserC ;
    ex:hasConsentRange      ex:RangeCommunityAgg ;
    ex:hasProcessingPurpose ex:PurposeLocalPrediction, ex:PurposeCommunityFederatedLearning ;
    ex:governedBy           ex:RuralLocalRetentionPolicy, ex:FLGradientDifferentialPrivacyPolicy ;
    ex:validFrom            "2026-05-04T00:00:00"^^xsd:dateTime .

ex:Contract_UserD_RestrictedFacility a owl:NamedIndividual, ex:SemanticContract ;
    rdfs:label              "Semantic Contract - Participant D Restricted Facility" ;
    ex:contractSubject      ex:UserD ;
    ex:hasConsentRange      ex:RangeCommunityAgg ;
    ex:hasProcessingPurpose ex:PurposeLocalPrediction, ex:PurposeClinicalMonitoring ;
    ex:governedBy           ex:RestrictedZoneNoExternalTransferPolicy ;
    ex:validFrom            "2026-05-04T00:00:00"^^xsd:dateTime .

ex:UserA ex:hasSemanticContract ex:Contract_UserA_Global ;
    ex:hasActiveConsentRange ex:RangeGlobalAgg .

ex:UserB ex:hasSemanticContract ex:Contract_UserB_LocalOnly ;
    ex:hasActiveConsentRange ex:RangeLocalOnly .

ex:UserC ex:hasSemanticContract ex:Contract_UserC_Community ;
    ex:hasActiveConsentRange ex:RangeCommunityAgg .

ex:UserD ex:hasSemanticContract ex:Contract_UserD_RestrictedFacility ;
    ex:hasActiveConsentRange ex:RangeCommunityAgg .

# Consent-aware permission and service extensions
ex:ReadPhysiologicalData ex:requiresConsentRange ex:RangeLocalOnly ;
    ex:hasProcessingPurpose ex:PurposeClinicalMonitoring .

ex:ReadSleepData ex:requiresConsentRange ex:RangeLocalOnly ;
    ex:hasProcessingPurpose ex:PurposeClinicalMonitoring .

ex:ReadStressPrediction ex:requiresConsentRange ex:RangeLocalOnly ;
    ex:hasProcessingPurpose ex:PurposeLocalPrediction .

ex:TrainGlobalModel ex:requiresConsentRange ex:RangeGlobalAgg ;
    ex:hasProcessingPurpose ex:PurposeGlobalFederatedLearning .

ex:StressService1 ex:requiresConsent "false"^^xsd:boolean ;
    ex:requiresConsentRange ex:RangeLocalOnly ;
    ex:hasProcessingPurpose ex:PurposeLocalPrediction .

# ----------------------------------------------------------------
# 14.2 Trust-based dynamic weights for MAPE-K analysis
# ----------------------------------------------------------------

ex:hasTrustScore a owl:DatatypeProperty ;
    rdfs:domain ex:NodeState ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "has trust score" ;
    rdfs:comment "Historical reliability score in the [0,1] range, computed from previous failures, latency instability and availability." .

ex:hasTrustWeight a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:NodeState ex:EvaluationState )
    ] ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "has trust weight" ;
    rdfs:comment "Dynamic weight consulted during the MAPE-K Analyse phase to prefer reliable nodes over saturated or unstable nodes." .

ex:NodeState_S1_Edge1 ex:hasTrustScore "0.93"^^xsd:decimal ;
    ex:hasTrustWeight "0.35"^^xsd:decimal .

ex:NodeState_S2_Edge1 ex:hasTrustScore "0.71"^^xsd:decimal ;
    ex:hasTrustWeight "0.20"^^xsd:decimal .

ex:NodeState_S2_Fog1 ex:hasTrustScore "0.88"^^xsd:decimal ;
    ex:hasTrustWeight "0.35"^^xsd:decimal .

ex:NodeState_S4_Edge2 ex:hasTrustScore "0.30"^^xsd:decimal ;
    ex:hasTrustWeight "0.10"^^xsd:decimal .

ex:MobileC_NodeState_S7 ex:hasTrustScore "0.78"^^xsd:decimal ;
    ex:hasTrustWeight "0.25"^^xsd:decimal .

ex:NodeState_S8_Internal ex:hasTrustScore "0.91"^^xsd:decimal ;
    ex:hasTrustWeight "0.40"^^xsd:decimal .

ex:NodeState_S6_Cloud ex:hasTrustScore "0.96"^^xsd:decimal ;
    ex:hasTrustWeight "0.30"^^xsd:decimal .

# ----------------------------------------------------------------
# 14.3 Multicriteria AHP support in EvaluationState
# ----------------------------------------------------------------

ex:hasLatencyWeight a owl:DatatypeProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "has latency weight" .

ex:hasPrivacyWeight a owl:DatatypeProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "has privacy weight" .

ex:hasModelQualityWeight a owl:DatatypeProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "has model quality weight" .

ex:hasAHPScore a owl:DatatypeProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "has AHP score" .

ex:hasSelectionJustification a owl:DatatypeProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  xsd:string ;
    rdfs:label  "has selection justification" .

ex:hasEvaluationTicketID a owl:DatatypeProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  xsd:string ;
    rdfs:label  "has evaluation ticket ID" .

ex:selectedModelTier a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:ModelTier ;
    rdfs:label  "selected model tier" ;
    rdfs:comment "Model tier selected by the AHP-style decision balance." .

# ----------------------------------------------------------------
# 14.4 Differential privacy and secure FL data flows
# ----------------------------------------------------------------

ex:PrivacyMechanism a owl:Class ;
    rdfs:label "Privacy Mechanism" .

ex:DifferentialPrivacyMechanism a owl:Class ;
    rdfs:subClassOf ex:PrivacyMechanism ;
    rdfs:label "Differential Privacy Mechanism" .

ex:ModelGradientUpdate a owl:Class ;
    rdfs:subClassOf ex:ParametrizedData ;
    rdfs:label   "Model Gradient Update" ;
    rdfs:comment "Federated learning update that may leave a mobile device only after anonymization and noise addition." .

ex:hasPrivacyMechanism a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:FederatedLearningSession ex:ParametrizedData )
    ] ;
    rdfs:range  ex:PrivacyMechanism ;
    rdfs:label  "has privacy mechanism" .

ex:transfersData a owl:ObjectProperty ;
    rdfs:domain ex:FederatedLearningSession ;
    rdfs:range  ex:ParametrizedData ;
    rdfs:label  "transfers data" .

ex:originatesFromDevice a owl:ObjectProperty ;
    rdfs:domain ex:ParametrizedData ;
    rdfs:range  ex:MobileDevice ;
    rdfs:label  "originates from device" .

ex:hasPrivacyBudget a owl:DatatypeProperty ;
    rdfs:domain ex:FederatedLearningSession ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "has privacy budget" ;
    rdfs:comment "Differential privacy epsilon value for the FL session." .

ex:noiseLevel a owl:DatatypeProperty ;
    rdfs:domain ex:FederatedLearningSession ;
    rdfs:range  xsd:decimal ;
    rdfs:label  "noise level" ;
    rdfs:comment "Magnitude of noise injected into gradients or model parameters before transfer." .

ex:hasNoiseApplied a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:FederatedLearningSession ex:ParametrizedData )
    ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "has noise applied" .

ex:hasAnonymizationApplied a owl:DatatypeProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:FederatedLearningSession ex:ParametrizedData )
    ] ;
    rdfs:range xsd:boolean ;
    rdfs:label "has anonymization applied" .

ex:DifferentialPrivacy a owl:NamedIndividual, ex:DifferentialPrivacyMechanism ;
    rdfs:label "Differential Privacy" .

ex:GaussianNoiseMechanism a owl:NamedIndividual, ex:DifferentialPrivacyMechanism ;
    rdfs:label "Gaussian Noise Mechanism" .

ex:LaplaceNoiseMechanism a owl:NamedIndividual, ex:DifferentialPrivacyMechanism ;
    rdfs:label "Laplace Noise Mechanism" .

ex:LocalAnonymizationMechanism a owl:NamedIndividual, ex:PrivacyMechanism ;
    rdfs:label "Local Anonymization Mechanism" .

ex:GradientUpdate_S3_A a owl:NamedIndividual, ex:ModelGradientUpdate ;
    rdfs:label                   "Gradient Update S3 - Participant A" ;
    ex:originatesFromDevice      ex:MobileA ;
    ex:sentToNode                ex:FogNode1 ;
    ex:hasPrivacyMechanism       ex:DifferentialPrivacy, ex:GaussianNoiseMechanism, ex:LocalAnonymizationMechanism ;
    ex:hasNoiseApplied           "true"^^xsd:boolean ;
    ex:hasAnonymizationApplied   "true"^^xsd:boolean ;
    ex:sendTimestamp             "2026-05-04T11:09:30"^^xsd:dateTime .

ex:GradientUpdate_S6_A a owl:NamedIndividual, ex:ModelGradientUpdate ;
    rdfs:label                   "Gradient Update S6 - Participant A Global" ;
    ex:originatesFromDevice      ex:MobileA ;
    ex:sentToNode                ex:CloudNode1 ;
    ex:hasPrivacyMechanism       ex:DifferentialPrivacy, ex:GaussianNoiseMechanism, ex:LocalAnonymizationMechanism ;
    ex:hasNoiseApplied           "true"^^xsd:boolean ;
    ex:hasAnonymizationApplied   "true"^^xsd:boolean ;
    ex:sendTimestamp             "2026-05-04T02:59:30"^^xsd:dateTime .

ex:FL_S3_EdgeToFog ex:hasPrivacyBudget "2.00"^^xsd:decimal ;
    ex:noiseLevel                "0.15"^^xsd:decimal ;
    ex:hasNoiseApplied           "true"^^xsd:boolean ;
    ex:hasAnonymizationApplied   "true"^^xsd:boolean ;
    ex:hasPrivacyMechanism       ex:DifferentialPrivacy, ex:GaussianNoiseMechanism ;
    ex:transfersData             ex:GradientUpdate_S3_A ;
    ex:requiresConsent           "true"^^xsd:boolean ;
    ex:requiresConsentRange      ex:RangeCommunityAgg ;
    ex:hasConsentRange           ex:RangeGlobalAgg ;
    ex:hasProcessingPurpose      ex:PurposeCommunityFederatedLearning ;
    ex:governedBy                ex:FLGradientDifferentialPrivacyPolicy .

ex:FL_S6_EdgeToCloud ex:hasPrivacyBudget "1.50"^^xsd:decimal ;
    ex:noiseLevel                "0.20"^^xsd:decimal ;
    ex:hasNoiseApplied           "true"^^xsd:boolean ;
    ex:hasAnonymizationApplied   "true"^^xsd:boolean ;
    ex:hasPrivacyMechanism       ex:DifferentialPrivacy, ex:GaussianNoiseMechanism ;
    ex:transfersData             ex:GradientUpdate_S6_A ;
    ex:requiresConsent           "true"^^xsd:boolean ;
    ex:requiresConsentRange      ex:RangeGlobalAgg ;
    ex:hasConsentRange           ex:RangeGlobalAgg ;
    ex:hasProcessingPurpose      ex:PurposeGlobalFederatedLearning ;
    ex:governedBy                ex:FLGradientDifferentialPrivacyPolicy .

ex:FL_S6_DownloadToEdge ex:hasPrivacyBudget "1.50"^^xsd:decimal ;
    ex:noiseLevel                "0.00"^^xsd:decimal ;
    ex:hasNoiseApplied           "false"^^xsd:boolean ;
    ex:hasAnonymizationApplied   "true"^^xsd:boolean ;
    ex:hasPrivacyMechanism       ex:LocalAnonymizationMechanism ;
    ex:requiresConsent           "false"^^xsd:boolean ;
    ex:requiresConsentRange      ex:RangeLocalOnly ;
    ex:hasProcessingPurpose      ex:PurposeLocalPrediction .

# SHACL validation shape used as an operational rule for secure FL flows.
# A model gradient that originates from a mobile device must be anonymized and noise-protected before transfer.
ex:FederatedLearningSessionShape a sh:NodeShape ;
    sh:targetClass ex:FederatedLearningSession ;
    sh:property [
        sh:path ex:hasPrivacyBudget ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:message "Federated learning sessions should declare at most one privacy budget epsilon." ;
    ] ;
    sh:property [
        sh:path ex:noiseLevel ;
        sh:datatype xsd:decimal ;
        sh:maxCount 1 ;
        sh:message "Federated learning sessions should declare at most one noise level." ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Model gradients leaving a mobile device must have ex:hasNoiseApplied true and ex:hasAnonymizationApplied true before transfer." ;
        sh:select """
            SELECT $this
            WHERE {
                $this ex:dataType "model_gradients" .
                $this ex:transfersData ?gradient .
                ?gradient ex:originatesFromDevice ?device .
                ?device a ex:MobileDevice .
                FILTER (
                    NOT EXISTS { $this ex:hasNoiseApplied true }
                    || NOT EXISTS { $this ex:hasAnonymizationApplied true }
                )
            }
        """ ;
    ] .

# ----------------------------------------------------------------
# 14.5 Obligation / abstention policies and geographic governance
# ----------------------------------------------------------------

ex:Policy a owl:Class ;
    rdfs:label   "Policy" ;
    rdfs:comment "Governance rule that can represent obligations, abstentions or prohibitions over nodes, users, data flows and zones." .

ex:PolicyType a owl:Class ;
    rdfs:label "Policy Type" .

ex:MAPESymptom a owl:Class ;
    rdfs:label   "MAPE-K Symptom" ;
    rdfs:comment "Symptom detected in the MAPE-K Monitor/Analyse phases and recorded for auditability." .

ex:hasPolicyType a owl:ObjectProperty ;
    rdfs:domain ex:Policy ;
    rdfs:range  ex:PolicyType ;
    rdfs:label  "has policy type" .

ex:governedBy a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:User ex:ComputationalNode ex:CityArea ex:Service ex:FederatedLearningSession ex:SemanticContract )
    ] ;
    rdfs:range  ex:Policy ;
    rdfs:label  "governed by" ;
    rdfs:comment "Links users, nodes, services, zones or sessions to the applicable policy according to location and processing context." .

ex:appliesInZone a owl:ObjectProperty ;
    rdfs:domain ex:Policy ;
    rdfs:range  ex:CityArea ;
    rdfs:label  "applies in zone" .

ex:appliesPolicy a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:Policy ;
    rdfs:label  "applies policy" .

ex:hasDetectedSymptom a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:MAPESymptom ;
    rdfs:label  "has detected symptom" .

ex:auditsContract a owl:ObjectProperty ;
    rdfs:domain ex:EvaluationState ;
    rdfs:range  ex:SemanticContract ;
    rdfs:label  "audits contract" .

ex:hasPolicyStatement a owl:DatatypeProperty ;
    rdfs:domain ex:Policy ;
    rdfs:range  xsd:string ;
    rdfs:label  "has policy statement" .

ex:hasPolicyAction a owl:DatatypeProperty ;
    rdfs:domain ex:Policy ;
    rdfs:range  xsd:string ;
    rdfs:label  "has policy action" .

# Policy type enumeration
ex:ObligationPolicyType a owl:NamedIndividual, ex:PolicyType ;
    rdfs:label "Obligation Policy" .

ex:AbstentionPolicyType a owl:NamedIndividual, ex:PolicyType ;
    rdfs:label "Abstention Policy" .

ex:ProhibitionPolicyType a owl:NamedIndividual, ex:PolicyType ;
    rdfs:label "Prohibition Policy" .

# MAPE-K symptoms
ex:SymptomNone a owl:NamedIndividual, ex:MAPESymptom ;
    rdfs:label "No relevant symptom" .

ex:SymptomSaturatedWorkload a owl:NamedIndividual, ex:MAPESymptom ;
    rdfs:label "Saturated workload" .

ex:SymptomCommunicationLoss a owl:NamedIndividual, ex:MAPESymptom ;
    rdfs:label "Communication loss" .

ex:SymptomConsentLocalOnly a owl:NamedIndividual, ex:MAPESymptom ;
    rdfs:label "Consent local only" .

ex:SymptomRuralLowConnectivity a owl:NamedIndividual, ex:MAPESymptom ;
    rdfs:label "Rural low connectivity" .

ex:SymptomRestrictedZoneBoundary a owl:NamedIndividual, ex:MAPESymptom ;
    rdfs:label "Restricted zone boundary" .

ex:SymptomNodeRecoveryPending a owl:NamedIndividual, ex:MAPESymptom ;
    rdfs:label "Node recovery pending" .

# Policy instances
ex:ConsentAwareProcessingPolicy a owl:NamedIndividual, ex:Policy ;
    rdfs:label             "Consent-Aware Processing Policy" ;
    ex:hasPolicyType       ex:ObligationPolicyType ;
    ex:hasPolicyAction     "select_processing_layer_from_active_semantic_contract" ;
    ex:hasPolicyStatement  "The MAPE-K planner must constrain processing to the active consent range encoded in the user's semantic contract." ;
    ex:requiresConsent     "false"^^xsd:boolean .

ex:DefaultUrbanAggregationPolicy a owl:NamedIndividual, ex:Policy ;
    rdfs:label             "Default Urban Aggregation Policy" ;
    ex:hasPolicyType       ex:ObligationPolicyType ;
    ex:appliesInZone       ex:CityCentreZone ;
    ex:hasPolicyAction     "prefer_edge_or_fog_when_latency_and_trust_are_sufficient" ;
    ex:hasPolicyStatement  "Urban zones may use edge/fog processing when consent range and trust score allow it." ;
    ex:requiresConsent     "true"^^xsd:boolean ;
    ex:requiresConsentRange ex:RangeCommunityAgg .

ex:RuralLocalRetentionPolicy a owl:NamedIndividual, ex:Policy ;
    rdfs:label             "Rural Local Retention Policy" ;
    ex:hasPolicyType       ex:ObligationPolicyType ;
    ex:appliesInZone       ex:NorthRuralZone ;
    ex:hasPolicyAction     "retain_data_locally_until_controlled_upload_window" ;
    ex:hasPolicyStatement  "In rural zones, parametrized data must be retained locally until a safe connectivity window opens." ;
    ex:requiresConsent     "true"^^xsd:boolean ;
    ex:requiresConsentRange ex:RangeCommunityAgg .

ex:RestrictedZoneNoExternalTransferPolicy a owl:NamedIndividual, ex:Policy ;
    rdfs:label             "Restricted Zone No External Transfer Policy" ;
    ex:hasPolicyType       ex:ProhibitionPolicyType ;
    ex:appliesInZone       ex:CareFacility1 ;
    ex:hasPolicyAction     "prohibit_external_transfer_outside_restricted_zone" ;
    ex:hasPolicyStatement  "Data generated inside a restricted zone must not be sent outside that zone; processing remains internal." ;
    ex:requiresConsent     "true"^^xsd:boolean ;
    ex:requiresConsentRange ex:RangeCommunityAgg .

ex:FLGradientDifferentialPrivacyPolicy a owl:NamedIndividual, ex:Policy ;
    rdfs:label             "FL Gradient Differential Privacy Policy" ;
    ex:hasPolicyType       ex:ObligationPolicyType ;
    ex:hasPolicyAction     "apply_anonymization_and_noise_before_gradient_transfer" ;
    ex:hasPolicyStatement  "Federated model gradients must be anonymized and noise-protected before leaving a mobile device." ;
    ex:requiresConsent     "true"^^xsd:boolean ;
    ex:requiresConsentRange ex:RangeCommunityAgg .

ex:TrustBasedNodeSelectionPolicy a owl:NamedIndividual, ex:Policy ;
    rdfs:label             "Trust-Based Node Selection Policy" ;
    ex:hasPolicyType       ex:ObligationPolicyType ;
    ex:hasPolicyAction     "prioritize_high_trust_nodes_over_saturated_nodes" ;
    ex:hasPolicyStatement  "During MAPE-K analysis, node selection must include trust score and trust weight in addition to workload and latency." ;
    ex:requiresConsent     "false"^^xsd:boolean .

ex:RestrictedExternalTransferAbstentionPolicy a owl:NamedIndividual, ex:Policy ;
    rdfs:label             "Restricted External Transfer Abstention Policy" ;
    ex:hasPolicyType       ex:AbstentionPolicyType ;
    ex:appliesInZone       ex:CareFacility1 ;
    ex:hasPolicyAction     "abstain_from_cloud_training_when_restricted_zone_active" ;
    ex:hasPolicyStatement  "The planner abstains from cloud/global training whenever the active user or node is in a restricted zone." ;
    ex:requiresConsent     "true"^^xsd:boolean ;
    ex:requiresConsentRange ex:RangeGlobalAgg .

# Geographic governance links
ex:CityCentreZone ex:governedBy ex:DefaultUrbanAggregationPolicy .
ex:NorthRuralZone ex:governedBy ex:RuralLocalRetentionPolicy .
ex:CareFacility1 ex:governedBy ex:RestrictedZoneNoExternalTransferPolicy, ex:RestrictedExternalTransferAbstentionPolicy .

ex:UserA ex:governedBy ex:DefaultUrbanAggregationPolicy, ex:ConsentAwareProcessingPolicy .
ex:UserB ex:governedBy ex:ConsentAwareProcessingPolicy .
ex:UserC ex:governedBy ex:RuralLocalRetentionPolicy, ex:ConsentAwareProcessingPolicy .
ex:UserD ex:governedBy ex:RestrictedZoneNoExternalTransferPolicy, ex:RestrictedExternalTransferAbstentionPolicy, ex:ConsentAwareProcessingPolicy .

ex:EdgeNode1 ex:governedBy ex:DefaultUrbanAggregationPolicy, ex:TrustBasedNodeSelectionPolicy .
ex:EdgeNode2 ex:governedBy ex:TrustBasedNodeSelectionPolicy .
ex:FogNode1 ex:governedBy ex:DefaultUrbanAggregationPolicy, ex:TrustBasedNodeSelectionPolicy .
ex:MobileC ex:governedBy ex:RuralLocalRetentionPolicy .
ex:InternalEdgeFacility ex:governedBy ex:RestrictedZoneNoExternalTransferPolicy, ex:TrustBasedNodeSelectionPolicy .

# ----------------------------------------------------------------
# 14.6 Temporal delegation and semantic audit tickets
# ----------------------------------------------------------------

ex:DelegationEvent a owl:Class ;
    rdfs:subClassOf ex:State ;
    rdfs:label   "Delegation Event" ;
    rdfs:comment "Reified temporal delegation that records delegator node, delegate node, cause, validity interval and recovery condition." .

ex:hasDelegation a owl:ObjectProperty ;
    rdfs:domain ex:ComputationalNode ;
    rdfs:range  ex:DelegationEvent ;
    rdfs:label  "has delegation" .

ex:delegatedBy a owl:ObjectProperty ;
    rdfs:domain ex:DelegationEvent ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "delegated by" .

ex:triggeredByState a owl:ObjectProperty ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( ex:DelegationEvent ex:EvaluationState )
    ] ;
    rdfs:range  ex:State ;
    rdfs:label  "triggered by state" .

ex:expiresOnRecoveryOf a owl:ObjectProperty ;
    rdfs:domain ex:DelegationEvent ;
    rdfs:range  ex:ComputationalNode ;
    rdfs:label  "expires on recovery of" .

ex:hasRecoveryCondition a owl:DatatypeProperty ;
    rdfs:domain ex:DelegationEvent ;
    rdfs:range  xsd:string ;
    rdfs:label  "has recovery condition" .

ex:Delegation_S3_Edge1_To_Fog1 a owl:NamedIndividual, ex:DelegationEvent ;
    rdfs:label              "Temporal Delegation S3 - Edge1 to Fog1" ;
    ex:delegatedBy          ex:EdgeNode1 ;
    ex:delegatesTo          ex:FogNode1 ;
    ex:triggeredByState     ex:NodeState_S2_Edge1 ;
    ex:expiresOnRecoveryOf  ex:EdgeNode1 ;
    ex:hasRecoveryCondition "Ends when EdgeNode1 no longer has ex:SaturatedWorkload and reaches at least ex:MediumResidual capacity." ;
    ex:validFrom            "2026-05-04T11:10:00"^^xsd:dateTime ;
    ex:validTo              "2026-05-04T12:30:00"^^xsd:dateTime .

ex:Delegation_S4_Edge2_To_Edge1 a owl:NamedIndividual, ex:DelegationEvent ;
    rdfs:label              "Temporal Delegation S4 - Edge2 to Edge1" ;
    ex:delegatedBy          ex:EdgeNode2 ;
    ex:delegatesTo          ex:EdgeNode1 ;
    ex:triggeredByState     ex:NodeState_S4_Edge2 ;
    ex:expiresOnRecoveryOf  ex:EdgeNode2 ;
    ex:hasRecoveryCondition "Ends when EdgeNode2 communication changes from ex:NoConnectionComm to ex:StableComm or ex:VariableComm." ;
    ex:validFrom            "2026-05-04T12:00:00"^^xsd:dateTime .

ex:EdgeNode1 ex:hasDelegation ex:Delegation_S3_Edge1_To_Fog1 .
ex:EdgeNode2 ex:hasDelegation ex:Delegation_S4_Edge2_To_Edge1 .

# EvaluationState audit-ticket enrichment.
# Every EvaluationState individual now connects: MAPE-K symptom, policy, active consent range and selection rationale.
ex:Eval_S1 ex:hasEvaluationTicketID "AUD-S1-20260504-0905" ;
    ex:hasDetectedSymptom       ex:SymptomNone ;
    ex:appliesPolicy            ex:DefaultUrbanAggregationPolicy, ex:ConsentAwareProcessingPolicy ;
    ex:auditsContract           ex:Contract_UserA_Global ;
    ex:hasConsentRange          ex:RangeGlobalAgg ;
    ex:hasLatencyWeight         "0.30"^^xsd:decimal ;
    ex:hasPrivacyWeight         "0.20"^^xsd:decimal ;
    ex:hasModelQualityWeight    "0.25"^^xsd:decimal ;
    ex:hasTrustWeight           "0.25"^^xsd:decimal ;
    ex:hasAHPScore              "0.91"^^xsd:decimal ;
    ex:selectedModelTier        ex:EdgeModelTier ;
    ex:hasSelectionJustification "Edge tier selected because latency and node trust are sufficient and no migration symptom is active." .

ex:Eval_S2 ex:hasEvaluationTicketID "AUD-S2-20260504-1105" ;
    ex:hasDetectedSymptom       ex:SymptomSaturatedWorkload ;
    ex:appliesPolicy            ex:TrustBasedNodeSelectionPolicy, ex:DefaultUrbanAggregationPolicy ;
    ex:auditsContract           ex:Contract_UserA_Global ;
    ex:hasConsentRange          ex:RangeGlobalAgg ;
    ex:triggeredByState         ex:NodeState_S2_Edge1 ;
    ex:hasLatencyWeight         "0.30"^^xsd:decimal ;
    ex:hasPrivacyWeight         "0.20"^^xsd:decimal ;
    ex:hasModelQualityWeight    "0.20"^^xsd:decimal ;
    ex:hasTrustWeight           "0.30"^^xsd:decimal ;
    ex:hasAHPScore              "0.52"^^xsd:decimal ;
    ex:selectedModelTier        ex:FogModelTier ;
    ex:hasSelectionJustification "Edge tier is not adequate because workload is saturated; fog tier offers a better trust/capacity balance." .

ex:Eval_S3 ex:hasEvaluationTicketID "AUD-S3-20260504-1112" ;
    ex:hasDetectedSymptom       ex:SymptomSaturatedWorkload ;
    ex:appliesPolicy            ex:TrustBasedNodeSelectionPolicy, ex:FLGradientDifferentialPrivacyPolicy ;
    ex:auditsContract           ex:Contract_UserA_Global ;
    ex:hasConsentRange          ex:RangeGlobalAgg ;
    ex:triggeredByState         ex:NodeState_S2_Edge1 ;
    ex:hasLatencyWeight         "0.25"^^xsd:decimal ;
    ex:hasPrivacyWeight         "0.20"^^xsd:decimal ;
    ex:hasModelQualityWeight    "0.20"^^xsd:decimal ;
    ex:hasTrustWeight           "0.35"^^xsd:decimal ;
    ex:hasAHPScore              "0.84"^^xsd:decimal ;
    ex:selectedModelTier        ex:FogModelTier ;
    ex:hasSelectionJustification "Fog tier selected after saturation because it preserves community aggregation, applies DP to gradients and has higher trust than the saturated edge state." .

ex:Eval_S4 ex:hasEvaluationTicketID "AUD-S4-20260504-1205" ;
    ex:hasDetectedSymptom       ex:SymptomCommunicationLoss ;
    ex:appliesPolicy            ex:TrustBasedNodeSelectionPolicy, ex:ConsentAwareProcessingPolicy ;
    ex:auditsContract           ex:Contract_UserA_Global ;
    ex:hasConsentRange          ex:RangeGlobalAgg ;
    ex:triggeredByState         ex:NodeState_S4_Edge2 ;
    ex:hasLatencyWeight         "0.40"^^xsd:decimal ;
    ex:hasPrivacyWeight         "0.20"^^xsd:decimal ;
    ex:hasModelQualityWeight    "0.15"^^xsd:decimal ;
    ex:hasTrustWeight           "0.25"^^xsd:decimal ;
    ex:hasAHPScore              "0.38"^^xsd:decimal ;
    ex:selectedModelTier        ex:EdgeModelTier ;
    ex:hasSelectionJustification "EdgeNode2 is compute-only and low-trust; delegation to EdgeNode1 keeps low latency while avoiding a disconnected node." .

ex:Eval_S5 ex:hasEvaluationTicketID "AUD-S5-20260504-0905" ;
    ex:hasDetectedSymptom       ex:SymptomConsentLocalOnly ;
    ex:appliesPolicy            ex:ConsentAwareProcessingPolicy ;
    ex:auditsContract           ex:Contract_UserB_LocalOnly ;
    ex:hasConsentRange          ex:RangeLocalOnly ;
    ex:hasLatencyWeight         "0.20"^^xsd:decimal ;
    ex:hasPrivacyWeight         "0.55"^^xsd:decimal ;
    ex:hasModelQualityWeight    "0.15"^^xsd:decimal ;
    ex:hasTrustWeight           "0.10"^^xsd:decimal ;
    ex:hasAHPScore              "0.89"^^xsd:decimal ;
    ex:selectedModelTier        ex:LocalModelTier ;
    ex:hasSelectionJustification "Local tier selected because the active semantic contract only authorizes local processing." .

ex:Eval_S6 ex:hasEvaluationTicketID "AUD-S6-20260504-0310" ;
    ex:hasDetectedSymptom       ex:SymptomNone ;
    ex:appliesPolicy            ex:FLGradientDifferentialPrivacyPolicy, ex:ConsentAwareProcessingPolicy ;
    ex:auditsContract           ex:Contract_UserA_Global ;
    ex:hasConsentRange          ex:RangeGlobalAgg ;
    ex:hasLatencyWeight         "0.10"^^xsd:decimal ;
    ex:hasPrivacyWeight         "0.25"^^xsd:decimal ;
    ex:hasModelQualityWeight    "0.40"^^xsd:decimal ;
    ex:hasTrustWeight           "0.25"^^xsd:decimal ;
    ex:hasAHPScore              "0.93"^^xsd:decimal ;
    ex:selectedModelTier        ex:CloudModelTier ;
    ex:hasSelectionJustification "Cloud tier selected because global consent is active, privacy budget is declared and model quality dominates during the night FL window." .

ex:Eval_S7 ex:hasEvaluationTicketID "AUD-S7-20260504-1005" ;
    ex:hasDetectedSymptom       ex:SymptomRuralLowConnectivity ;
    ex:appliesPolicy            ex:RuralLocalRetentionPolicy, ex:ConsentAwareProcessingPolicy ;
    ex:auditsContract           ex:Contract_UserC_Community ;
    ex:hasConsentRange          ex:RangeCommunityAgg ;
    ex:triggeredByState         ex:MobileC_NodeState_S7 ;
    ex:hasLatencyWeight         "0.15"^^xsd:decimal ;
    ex:hasPrivacyWeight         "0.40"^^xsd:decimal ;
    ex:hasModelQualityWeight    "0.20"^^xsd:decimal ;
    ex:hasTrustWeight           "0.25"^^xsd:decimal ;
    ex:hasAHPScore              "0.80"^^xsd:decimal ;
    ex:selectedModelTier        ex:LocalModelTier ;
    ex:hasSelectionJustification "Local tier selected temporarily because rural connectivity is intermittent; community aggregation is deferred until a controlled upload window." .

ex:Eval_S8 ex:hasEvaluationTicketID "AUD-S8-20260504-0205" ;
    ex:hasDetectedSymptom       ex:SymptomRestrictedZoneBoundary ;
    ex:appliesPolicy            ex:RestrictedZoneNoExternalTransferPolicy, ex:RestrictedExternalTransferAbstentionPolicy ;
    ex:auditsContract           ex:Contract_UserD_RestrictedFacility ;
    ex:hasConsentRange          ex:RangeCommunityAgg ;
    ex:triggeredByState         ex:NodeState_S8_Internal ;
    ex:hasLatencyWeight         "0.25"^^xsd:decimal ;
    ex:hasPrivacyWeight         "0.40"^^xsd:decimal ;
    ex:hasModelQualityWeight    "0.10"^^xsd:decimal ;
    ex:hasTrustWeight           "0.25"^^xsd:decimal ;
    ex:hasAHPScore              "0.88"^^xsd:decimal ;
    ex:selectedModelTier        ex:EdgeModelTier ;
    ex:hasSelectionJustification "Internal edge tier selected because the restricted zone policy prohibits external transfer, while the local facility node has high trust." .


