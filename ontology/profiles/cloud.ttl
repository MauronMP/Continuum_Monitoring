@prefix ex: <http://example.org/smartcity#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/smartcity/profiles/cloud>
    a owl:Ontology, ex:SemanticNodeProfile ;
    rdfs:label "Cloud semantic profile"@en ;
    owl:imports
        <http://example.org/smartcity>,
        <http://example.org/smartcity/modules/core-vocabulary>,
        <http://example.org/smartcity/modules/deployment> ;
    ex:usesEntailmentProfile "owlrl" ;
    owl:versionInfo "2.3.0" .
