@prefix comon: <http://example.org/monitoringcontinuum#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<http://example.org/monitoringcontinuum/profiles/fog> a comon:SemanticNodeProfile,
        owl:Ontology ;
    rdfs:label "Fog semantic profile"@en ;
    owl:imports <http://example.org/monitoringcontinuum>,
        <http://example.org/monitoringcontinuum/modules/core-vocabulary> ;
    owl:versionInfo "4.0.0" .
