        owl:NamedIndividual ;
    rdfs:label "Federated learning and model lifecycle" ;
    ex:categoryCode "FL" ;
    ex:evaluationOrder 5 .

ex:PolicyCategory_GOV a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Governance, precedence and lifecycle" ;
    ex:categoryCode "GOV" ;
    ex:evaluationOrder 1 .

ex:PolicyCategory_INT a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Interoperability and semantic extensibility" ;
    ex:categoryCode "INT" ;
    ex:evaluationOrder 0 .

ex:PolicyCategory_MODEL a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Model selection and AHP" ;
    ex:categoryCode "MODEL" ;
    ex:evaluationOrder 4 .

ex:PolicyCategory_NODE a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Nodes and dynamic trust" ;
    ex:categoryCode "NODE" ;
