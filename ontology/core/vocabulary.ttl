ex:PolicyCategory_OPS a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Operations, scalability and QoS" ;
    ex:categoryCode "OPS" ;
    ex:evaluationOrder 3 .

ex:PolicyCategory_VAL a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Validation, reproducibility and maintainability" ;
    ex:categoryCode "VAL" ;
    ex:evaluationOrder 7 .

ex:PolicyCategory_ZONE a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Zones and georestriction" ;
    ex:categoryCode "ZONE" ;
    ex:evaluationOrder 2 .

ex:PolicyRelationType_CO a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Consistent Overlap" ;
    ex:relationCode "CO" ;
    rdfs:comment "Policies overlap and can be satisfied simultaneously." .

ex:PolicyRelationType_CON a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Contradiction / Direct Conflict" ;
    ex:relationCode "CON" ;
    rdfs:comment "Policies require incompatible effects in the same scope." .

ex:PolicyRelationType_COR a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Correlation / Partial Conflict" ;
    ex:relationCode "COR" ;
    rdfs:comment "Policies partially overlap with different effects in the intersection." .

ex:PolicyRelationType_DEP a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Policy Dependency / Order Dependency" ;
    ex:relationCode "DEP" ;
    rdfs:comment "One policy requires the result of another before evaluation/execution." .

ex:PolicyRelationType_GEN a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Generalization / Exception Conflict" ;
    ex:relationCode "GEN" ;
    rdfs:comment "A specific policy is an exception/restriction to a more general policy." .

ex:PolicyRelationType_IND a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Independent / Disjoint" ;
    ex:relationCode "IND" ;
    rdfs:comment "Policies regulate independent scopes/actions." .

ex:PolicyRelationType_IRR a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Irrelevance" ;
    ex:relationCode "IRR" ;
    rdfs:comment "Policy cannot activate in any valid state or governs no reachable resource/action." .

ex:PolicyRelationType_RED a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Redundancy" ;
    ex:relationCode "RED" ;
    rdfs:comment "One policy adds no observable effect beyond another." .

ex:PolicyRelationType_SHD a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Shadowing / Override" ;
    ex:relationCode "SHD" ;
    rdfs:comment "A higher-priority policy makes another ineffective within the overlap." .

ex:PolicyRelationType_SUB a ex:PolicyRelationType,
        owl:NamedIndividual ;
    rdfs:label "Subsumption / Specialization" ;
    ex:relationCode "SUB" ;
    rdfs:comment "One policy scope is contained in another and adds compatible restrictions." .

