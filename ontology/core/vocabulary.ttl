<http://example.org/monitoringcontinuum/modules/core-vocabulary> a owl:Ontology ;
    rdfs:label "Continuum controlled vocabulary"@en ;
    owl:imports <http://example.org/monitoringcontinuum> ;
    owl:versionInfo "4.0.0" .

<urn:continuum:ontology:4.0.0:node:112> a owl:AllDifferent ;
    owl:distinctMembers <urn:continuum:ontology:4.0.0:node:113> .

<urn:continuum:ontology:4.0.0:node:117> a owl:AllDifferent ;
    owl:distinctMembers <urn:continuum:ontology:4.0.0:node:118> .

<urn:continuum:ontology:4.0.0:node:122> a owl:AllDifferent ;
    owl:distinctMembers <urn:continuum:ontology:4.0.0:node:123> .

mc:AbstentionPolicyType a mc:PolicyType,
        owl:NamedIndividual ;
    rdfs:label "Abstention" .

mc:CloudModelTier a mc:ModelTier,
        owl:NamedIndividual ;
    rdfs:label "Cloud / Global" ;
    mc:continuumLevel 3 ;
    mc:hasProcessingScope mc:ExternalProcessingScope ;
    mc:requiresConsentRange mc:RangeGlobalAgg ;
    rdfs:comment "Cloud/global processing tier. Eligibility depends on effective authorization, zone, node status and active policies." .

mc:EdgeModelTier a mc:ModelTier,
        owl:NamedIndividual ;
    rdfs:label "Edge" ;
    mc:continuumLevel 1 ;
    mc:hasProcessingScope mc:ExternalProcessingScope ;
    mc:requiresConsentRange mc:RangeCommunityAgg ;
    rdfs:comment "Edge processing tier. Eligibility depends on authorization, zone, node status and active policies." .

mc:FogModelTier a mc:ModelTier,
        owl:NamedIndividual ;
    rdfs:label "Fog / Community" ;
    mc:continuumLevel 2 ;
    mc:hasProcessingScope mc:ExternalProcessingScope ;
    mc:requiresConsentRange mc:RangeCommunityAgg ;
    rdfs:comment "Fog/community processing tier. Eligibility depends on authorization, zone, node status and active policies." .

mc:LocalModelTier a mc:ModelTier,
        owl:NamedIndividual ;
    rdfs:label "Local / Mist" ;
    mc:continuumLevel 0 ;
    mc:hasProcessingScope mc:LocalProcessingScope ;
    mc:requiresConsentRange mc:RangeLocalOnly ;
    rdfs:comment "Tier executed on the wearable/mobile device or an authorised personal Mist node. Tier order is not a quality preference." .

mc:LocalProcessingScope a mc:ProcessingScope,
        owl:NamedIndividual ;
    rdfs:label "Local processing scope" .

mc:ObligationPolicyType a mc:PolicyType,
        owl:NamedIndividual ;
    rdfs:label "Obligation" .

mc:ProhibitionPolicyType a mc:PolicyType,
        owl:NamedIndividual ;
    rdfs:label "Prohibition" .

mc:RangeDenied a mc:ConsentRange,
        owl:NamedIndividual ;
    rdfs:label "Denied / Revoked" ;
    rdfs:comment "No external processing is authorised. Any strictly local functionality must still be allowed by purpose and active contract/policy." .

<urn:continuum:ontology:4.0.0:node:113> rdf:first mc:LocalModelTier ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:114> .

<urn:continuum:ontology:4.0.0:node:114> rdf:first mc:EdgeModelTier ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:115> .

<urn:continuum:ontology:4.0.0:node:115> rdf:first mc:FogModelTier ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:116> .

<urn:continuum:ontology:4.0.0:node:116> rdf:first mc:CloudModelTier ;
    rdf:rest () .

<urn:continuum:ontology:4.0.0:node:118> rdf:first mc:RangeDenied ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:119> .

<urn:continuum:ontology:4.0.0:node:119> rdf:first mc:RangeLocalOnly ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:120> .

<urn:continuum:ontology:4.0.0:node:120> rdf:first mc:RangeCommunityAgg ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:121> .

<urn:continuum:ontology:4.0.0:node:121> rdf:first mc:RangeGlobalAgg ;
    rdf:rest () .

<urn:continuum:ontology:4.0.0:node:123> rdf:first mc:ObligationPolicyType ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:124> .

<urn:continuum:ontology:4.0.0:node:124> rdf:first mc:AbstentionPolicyType ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:125> .

<urn:continuum:ontology:4.0.0:node:125> rdf:first mc:ProhibitionPolicyType ;
    rdf:rest () .

mc:RangeGlobalAgg a mc:ConsentRange,
        owl:NamedIndividual ;
    rdfs:label "Global Aggregation" ;
    rdfs:comment "Authorises eligible global/cloud processing for permitted data categories and purposes, subject to zone, privacy and other hard constraints." .

mc:RangeLocalOnly a mc:ConsentRange,
        owl:NamedIndividual ;
    rdfs:label "Local Only" ;
    rdfs:comment "Processing limited to wearable/mobile device and, when authorised, personal Mist. Edge, Fog and Cloud are external to local scope." .

mc:ExternalProcessingScope a mc:ProcessingScope,
        owl:NamedIndividual ;
    rdfs:label "External processing scope" .

mc:RangeCommunityAgg a mc:ConsentRange,
        owl:NamedIndividual ;
    rdfs:label "Community Aggregation" ;
    rdfs:comment "Authorises eligible community processing such as Edge/Fog for permitted data categories and purposes, subject to zone and other hard constraints." .
