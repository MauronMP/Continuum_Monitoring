ex:PolicyCategory_ADAPT a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Migration, offloading, degradation and continuity" ;
    ex:categoryCode "ADAPT" ;
    ex:evaluationOrder 5 .

ex:PolicyCategory_AUD a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Temporal delegation, MAPE-K and audit" ;
    ex:categoryCode "AUD" ;
    ex:evaluationOrder 6 .

ex:PolicyCategory_CONS a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Consent and semantic contracts" ;
    ex:categoryCode "CONS" ;
    ex:evaluationOrder 2 .

ex:PolicyCategory_DATA a ex:PolicyCategory,
        owl:NamedIndividual ;
    rdfs:label "Data, privacy, identity and transmission" ;
    ex:categoryCode "DATA" ;
    ex:evaluationOrder 2 .

