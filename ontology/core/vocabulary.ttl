    owl:distinctMembers <urn:continuum:ontology:4.0.0:node:123> .

comon:AbstentionPolicyType a comon:PolicyType,
        owl:NamedIndividual ;
    rdfs:label "Abstention" .

comon:CloudModelTier a comon:ModelTier,
        owl:NamedIndividual ;
    rdfs:label "Cloud / Global" ;
    comon:continuumLevel 3 ;
    comon:hasProcessingScope comon:ExternalProcessingScope ;
    comon:requiresConsentRange comon:RangeGlobalAgg ;
    rdfs:comment "Cloud/global processing tier. Eligibility depends on effective authorization, zone, node status and active policies." .

comon:EdgeModelTier a comon:ModelTier,
        owl:NamedIndividual ;
    rdfs:label "Edge" ;
    comon:continuumLevel 1 ;
    comon:hasProcessingScope comon:ExternalProcessingScope ;
    comon:requiresConsentRange comon:RangeCommunityAgg ;
    rdfs:comment "Edge processing tier. Eligibility depends on authorization, zone, node status and active policies." .

comon:FogModelTier a comon:ModelTier,
        owl:NamedIndividual ;
    rdfs:label "Fog / Community" ;
    comon:continuumLevel 2 ;
    comon:hasProcessingScope comon:ExternalProcessingScope ;
    comon:requiresConsentRange comon:RangeCommunityAgg ;
    rdfs:comment "Fog/community processing tier. Eligibility depends on authorization, zone, node status and active policies." .

comon:LocalModelTier a comon:ModelTier,
        owl:NamedIndividual ;
    rdfs:label "Local / Mist" ;
    comon:continuumLevel 0 ;
    comon:hasProcessingScope comon:LocalProcessingScope ;
    comon:requiresConsentRange comon:RangeLocalOnly ;
    rdfs:comment "Tier executed on the wearable/mobile device or an authorised personal Mist node. Tier order is not a quality preference." .

comon:LocalProcessingScope a comon:ProcessingScope,
        owl:NamedIndividual ;
    rdfs:label "Local processing scope" .

comon:ObligationPolicyType a comon:PolicyType,
        owl:NamedIndividual ;
    rdfs:label "Obligation" .

comon:ProhibitionPolicyType a comon:PolicyType,
        owl:NamedIndividual ;
    rdfs:label "Prohibition" .

comon:RangeDenied a comon:ConsentRange,
        owl:NamedIndividual ;
    rdfs:label "Denied / Revoked" ;
    rdfs:comment "No external processing is authorised. Any strictly local functionality must still be allowed by purpose and active contract/policy." .

<urn:continuum:ontology:4.0.0:node:113> rdf:first comon:LocalModelTier ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:114> .

<urn:continuum:ontology:4.0.0:node:114> rdf:first comon:EdgeModelTier ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:115> .

<urn:continuum:ontology:4.0.0:node:115> rdf:first comon:FogModelTier ;
    rdf:rest <urn:continuum:ontology:4.0.0:node:116> .

<urn:continuum:ontology:4.0.0:node:116> rdf:first comon:CloudModelTier ;
    rdf:rest () .

