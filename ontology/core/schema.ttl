@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<http://example.org/monitoringcontinuum> a owl:Ontology ;
    rdfs:label "Monitoring Continuum Ontology v4.0.0" ;
    dcterms:identifier "4.0.0-monitoringcontinuum-v1" ;
    dcterms:language "en" ;
    dcterms:modified "2026-10-06"^^xsd:date ;
    dcterms:replaces <http://example.org/smartcity/3.0.0> ;
    rdfs:comment "Domain-neutral policy-driven continuum monitoring core. Application profiles explicitly add wellbeing, federation, vocabulary and validation shapes. Version 4 changes the entity namespace and resolves module dependencies." ;
    owl:imports <http://example.org/monitoringcontinuum/modules/contracts>,
        <http://example.org/monitoringcontinuum/modules/deployment>,
        <http://example.org/monitoringcontinuum/modules/foundation>,
        <http://example.org/monitoringcontinuum/modules/governance>,
        <http://example.org/monitoringcontinuum/modules/observability>,
        <http://example.org/monitoringcontinuum/modules/orchestration>,
        <http://example.org/monitoringcontinuum/modules/topology> ;
    owl:versionIRI <http://example.org/monitoringcontinuum/4.0.0> ;
    owl:versionInfo "4.0.0" .
