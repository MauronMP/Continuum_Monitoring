digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#DCE7E9" CELLPADDING="5"><FONT POINT-SIZE="9">Shared contracts</FONT></TD><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD></TR><TR><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/monitoringcontinuum#CityArea" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:CityArea</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#CityArea"];
  "http://example.org/monitoringcontinuum#CloudNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:CloudNode</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#CloudNode"];
  "http://example.org/monitoringcontinuum#Community" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:Community</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#Community"];
  "http://example.org/monitoringcontinuum#ComputationalNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:ComputationalNode</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasElasticity"><FONT POINT-SIZE="9">comon:hasElasticity: xsd:boolean</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#ComputationalNode"];
  "http://example.org/monitoringcontinuum#DistanceLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:DistanceLevel</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#DistanceLevel"];
  "http://example.org/monitoringcontinuum#EdgeNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:EdgeNode</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#EdgeNode"];
  "http://example.org/monitoringcontinuum#FogNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:FogNode</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#FogNode"];
  "http://example.org/monitoringcontinuum#MistNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:MistNode</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#MistNode"];
  "http://example.org/monitoringcontinuum#MobileDevice" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:MobileDevice</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#MobileDevice"];
  "http://example.org/monitoringcontinuum#ModelTier" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:ModelTier</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#continuumLevel"><FONT POINT-SIZE="9">comon:continuumLevel: xsd:integer</FONT></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ModelTier", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#NodeUserRelation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:NodeUserRelation</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#isPreferredNode"><FONT POINT-SIZE="9">comon:isPreferredNode: xsd:boolean</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#NodeUserRelation"];
  "http://example.org/monitoringcontinuum#PopulationDensity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:PopulationDensity</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#PopulationDensity"];
  "http://example.org/monitoringcontinuum#RestrictedZone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:RestrictedZone</B><BR/><FONT POINT-SIZE="8">class / individual (punning)</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#RestrictedZone"];
  "http://example.org/monitoringcontinuum#RuralZone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:RuralZone</B><BR/><FONT POINT-SIZE="8">class / individual (punning)</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#RuralZone"];
  "http://example.org/monitoringcontinuum#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:TemporalEntity</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#TemporalEntity", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#UrbanEnvironment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:UrbanEnvironment</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#UrbanEnvironment"];
  "http://example.org/monitoringcontinuum#UrbanZone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:UrbanZone</B><BR/><FONT POINT-SIZE="8">class / individual (punning)</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#UrbanZone"];
  "http://example.org/monitoringcontinuum#User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:User</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#User", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#ZoneType" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>comon:ZoneType</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/monitoringcontinuum#ZoneType"];
  "http://www.opengis.net/ont/geosparql#Geometry" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>geo:Geometry</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://www.opengis.net/ont/geosparql#Geometry", style="rounded,dashed,filled"];
  "http://xmlns.com/foaf/0.1/Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>foaf:Person</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://xmlns.com/foaf/0.1/Person", style="rounded,dashed,filled"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="https://saref.etsi.org/core/Device", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#User" -> "http://example.org/monitoringcontinuum#Community" [label="comon:belongsToCommunity", tooltip="http://example.org/monitoringcontinuum#belongsToCommunity"];
  "https://saref.etsi.org/core/Device" -> "http://example.org/monitoringcontinuum#ComputationalNode" [label="comon:connectsTo", tooltip="http://example.org/monitoringcontinuum#connectsTo"];
  "http://example.org/monitoringcontinuum#ComputationalNode" -> "http://example.org/monitoringcontinuum#CityArea" [label="comon:coversArea", tooltip="http://example.org/monitoringcontinuum#coversArea"];
  "http://example.org/monitoringcontinuum#NodeUserRelation" -> "http://example.org/monitoringcontinuum#DistanceLevel" [label="comon:hasDistance", tooltip="http://example.org/monitoringcontinuum#hasDistance"];
  "http://example.org/monitoringcontinuum#CityArea" -> "http://www.opengis.net/ont/geosparql#Geometry" [label="comon:hasGeometry", tooltip="http://example.org/monitoringcontinuum#hasGeometry"];
  "http://example.org/monitoringcontinuum#User" -> "http://example.org/monitoringcontinuum#MobileDevice" [label="comon:hasMobileDevice", tooltip="http://example.org/monitoringcontinuum#hasMobileDevice"];
  "http://example.org/monitoringcontinuum#ComputationalNode" -> "http://example.org/monitoringcontinuum#ComputationalNode" [label="comon:hasNeighborNode", tooltip="http://example.org/monitoringcontinuum#hasNeighborNode"];
  "http://example.org/monitoringcontinuum#CityArea" -> "http://example.org/monitoringcontinuum#PopulationDensity" [label="comon:hasPopulationDensity", tooltip="http://example.org/monitoringcontinuum#hasPopulationDensity"];
  "http://example.org/monitoringcontinuum#User" -> "http://example.org/monitoringcontinuum#CityArea" [label="comon:locatedInZone", tooltip="http://example.org/monitoringcontinuum#locatedInZone"];
  "http://example.org/monitoringcontinuum#NodeUserRelation" -> "http://example.org/monitoringcontinuum#ComputationalNode" [label="comon:relatesNode", tooltip="http://example.org/monitoringcontinuum#relatesNode"];
  "http://example.org/monitoringcontinuum#NodeUserRelation" -> "http://example.org/monitoringcontinuum#User" [label="comon:relatesUser", tooltip="http://example.org/monitoringcontinuum#relatesUser"];
  "http://example.org/monitoringcontinuum#UrbanEnvironment" -> "http://example.org/monitoringcontinuum#CityArea" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#ComputationalNode" -> "http://example.org/monitoringcontinuum#CloudNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "https://saref.etsi.org/core/Device" -> "http://example.org/monitoringcontinuum#ComputationalNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#ComputationalNode" -> "http://example.org/monitoringcontinuum#EdgeNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#ComputationalNode" -> "http://example.org/monitoringcontinuum#FogNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#ComputationalNode" -> "http://example.org/monitoringcontinuum#MistNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#MistNode" -> "http://example.org/monitoringcontinuum#MobileDevice" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#TemporalEntity" -> "http://example.org/monitoringcontinuum#NodeUserRelation" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#CityArea" -> "http://example.org/monitoringcontinuum#RestrictedZone" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#CityArea" -> "http://example.org/monitoringcontinuum#RuralZone" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#CityArea" -> "http://example.org/monitoringcontinuum#UrbanZone" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://xmlns.com/foaf/0.1/Person" -> "http://example.org/monitoringcontinuum#User" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "registry:Additional schema axioms" [style="filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><B>Additional schema axioms</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">comon:hasGeometry subproperty<BR ALIGN="LEFT"/>geo:hasGeometry</FONT></TD></TR></TABLE>>];
  "registry:Object properties with undeclared domain and range" [style="filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><B>Object properties with undeclared domain<BR ALIGN="LEFT"/>and range</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#locatedIn"><FONT POINT-SIZE="9">comon:locatedIn</FONT></TD></TR></TABLE>>];
}
