digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD><TD BGCOLOR="#E1F3FB" CELLPADDING="5"><FONT POINT-SIZE="9">Observability</FONT></TD></TR><TR><TD BGCOLOR="#F1E3EF" CELLPADDING="5"><FONT POINT-SIZE="9">Orchestration</FONT></TD><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/smartcity#CityArea" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:CityArea</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#CityArea"];
  "http://example.org/smartcity#CloudNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:CloudNode</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#CloudNode"];
  "http://example.org/smartcity#Community" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:Community</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#Community"];
  "http://example.org/smartcity#ComputationalNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:ComputationalNode</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#hasElasticity"><FONT POINT-SIZE="9">ex:hasElasticity: xsd:boolean</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#ComputationalNode"];
  "http://example.org/smartcity#DistanceLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:DistanceLevel</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#DistanceLevel"];
  "http://example.org/smartcity#EdgeNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:EdgeNode</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#EdgeNode"];
  "http://example.org/smartcity#FogNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:FogNode</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#FogNode"];
  "http://example.org/smartcity#MistNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:MistNode</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#MistNode"];
  "http://example.org/smartcity#MobileDevice" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:MobileDevice</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#MobileDevice"];
  "http://example.org/smartcity#ModelTier" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:ModelTier</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#continuumLevel"><FONT POINT-SIZE="9">ex:continuumLevel: xsd:integer</FONT></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#ModelTier", style="rounded,dashed,filled"];
  "http://example.org/smartcity#NodeUserRelation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:NodeUserRelation</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#isPreferredNode"><FONT POINT-SIZE="9">ex:isPreferredNode: xsd:boolean</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#NodeUserRelation"];
  "http://example.org/smartcity#PopulationDensity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:PopulationDensity</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#PopulationDensity"];
  "http://example.org/smartcity#RestrictedZone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:RestrictedZone</B><BR/><FONT POINT-SIZE="8">class / individual (punning)</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#RestrictedZone"];
  "http://example.org/smartcity#RuralZone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:RuralZone</B><BR/><FONT POINT-SIZE="8">class / individual (punning)</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#RuralZone"];
  "http://example.org/smartcity#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:TemporalEntity</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#TemporalEntity", style="rounded,dashed,filled"];
  "http://example.org/smartcity#UrbanEnvironment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:UrbanEnvironment</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#UrbanEnvironment"];
  "http://example.org/smartcity#UrbanZone" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:UrbanZone</B><BR/><FONT POINT-SIZE="8">class / individual (punning)</FONT></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#UrbanZone"];
  "http://example.org/smartcity#User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:User</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#User", style="rounded,dashed,filled"];
  "http://example.org/smartcity#ZoneType" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E2F1EC" ALIGN="LEFT"><B>ex:ZoneType</B></TD></TR></TABLE>>, fillcolor="#E2F1EC", tooltip="http://example.org/smartcity#ZoneType"];
  "http://www.opengis.net/ont/geosparql#Geometry" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>geo:Geometry</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://www.opengis.net/ont/geosparql#Geometry", style="rounded,dashed,filled"];
  "http://xmlns.com/foaf/0.1/Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>foaf:Person</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://xmlns.com/foaf/0.1/Person", style="rounded,dashed,filled"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="https://saref.etsi.org/core/Device", style="rounded,dashed,filled"];
  "http://example.org/smartcity#User" -> "http://example.org/smartcity#Community" [label="ex:belongsToCommunity", tooltip="http://example.org/smartcity#belongsToCommunity"];
  "https://saref.etsi.org/core/Device" -> "http://example.org/smartcity#ComputationalNode" [label="ex:connectsTo", tooltip="http://example.org/smartcity#connectsTo"];
  "http://example.org/smartcity#ComputationalNode" -> "http://example.org/smartcity#CityArea" [label="ex:coversArea", tooltip="http://example.org/smartcity#coversArea"];
  "http://example.org/smartcity#NodeUserRelation" -> "http://example.org/smartcity#DistanceLevel" [label="ex:hasDistance", tooltip="http://example.org/smartcity#hasDistance"];
  "http://example.org/smartcity#CityArea" -> "http://www.opengis.net/ont/geosparql#Geometry" [label="ex:hasGeometry", tooltip="http://example.org/smartcity#hasGeometry"];
  "http://example.org/smartcity#ComputationalNode" -> "http://example.org/smartcity#ComputationalNode" [label="ex:hasNeighborNode", tooltip="http://example.org/smartcity#hasNeighborNode"];
  "http://example.org/smartcity#CityArea" -> "http://example.org/smartcity#PopulationDensity" [label="ex:hasPopulationDensity", tooltip="http://example.org/smartcity#hasPopulationDensity"];
  "http://example.org/smartcity#User" -> "http://example.org/smartcity#CityArea" [label="ex:locatedInZone", tooltip="http://example.org/smartcity#locatedInZone"];
  "http://example.org/smartcity#NodeUserRelation" -> "http://example.org/smartcity#ComputationalNode" [label="ex:relatesNode", tooltip="http://example.org/smartcity#relatesNode"];
  "http://example.org/smartcity#NodeUserRelation" -> "http://example.org/smartcity#User" [label="ex:relatesUser", tooltip="http://example.org/smartcity#relatesUser"];
  "http://example.org/smartcity#UrbanEnvironment" -> "http://example.org/smartcity#CityArea" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#ComputationalNode" -> "http://example.org/smartcity#CloudNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "https://saref.etsi.org/core/Device" -> "http://example.org/smartcity#ComputationalNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#ComputationalNode" -> "http://example.org/smartcity#EdgeNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#ComputationalNode" -> "http://example.org/smartcity#FogNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#ComputationalNode" -> "http://example.org/smartcity#MistNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#MistNode" -> "http://example.org/smartcity#MobileDevice" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#TemporalEntity" -> "http://example.org/smartcity#NodeUserRelation" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#CityArea" -> "http://example.org/smartcity#RestrictedZone" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#CityArea" -> "http://example.org/smartcity#RuralZone" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/smartcity#CityArea" -> "http://example.org/smartcity#UrbanZone" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://xmlns.com/foaf/0.1/Person" -> "http://example.org/smartcity#User" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "registry:Additional schema axioms" [style="filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><B>Additional schema axioms</B></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="9">ex:hasGeometry subproperty<BR ALIGN="LEFT"/>geo:hasGeometry</FONT></TD></TR></TABLE>>];
  "registry:Object properties with undeclared domain and range" [style="filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><B>Object properties with undeclared domain<BR ALIGN="LEFT"/>and range</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#locatedIn"><FONT POINT-SIZE="9">ex:locatedIn</FONT></TD></TR></TABLE>>];
}
