digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#DCE7E9" CELLPADDING="5"><FONT POINT-SIZE="9">Shared contracts</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/monitoringcontinuum#AIModel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:AIModel</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#AIModel"];
  "http://example.org/monitoringcontinuum#Artifact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:Artifact</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#Artifact"];
  "http://example.org/monitoringcontinuum#EvaluationState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:EvaluationState</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#EvaluationState"];
  "http://example.org/monitoringcontinuum#FederatedLearningSession" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:FederatedLearningSession</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#FederatedLearningSession"];
  "http://example.org/monitoringcontinuum#ModelTier" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:ModelTier</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#ModelTier"];
  "http://example.org/monitoringcontinuum#PayloadType" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:PayloadType</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#PayloadType"];
  "http://example.org/monitoringcontinuum#ProcessingPurpose" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:ProcessingPurpose</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#ProcessingPurpose"];
  "http://example.org/monitoringcontinuum#RecoveryCondition" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:RecoveryCondition</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#RecoveryCondition"];
  "http://example.org/monitoringcontinuum#Service" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:Service</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#Service"];
  "http://example.org/monitoringcontinuum#ServiceState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:ServiceState</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#ServiceState"];
  "http://example.org/monitoringcontinuum#State" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:State</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#State"];
  "http://example.org/monitoringcontinuum#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:TemporalEntity</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#TemporalEntity", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#TransferEvent" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:TransferEvent</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#TransferEvent"];
  "http://example.org/monitoringcontinuum#ValidationCampaign" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:ValidationCampaign</B></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#ValidationCampaign"];
  "http://example.org/monitoringcontinuum#State" -> "http://example.org/monitoringcontinuum#EvaluationState" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#State" -> "http://example.org/monitoringcontinuum#ServiceState" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#TemporalEntity" -> "http://example.org/monitoringcontinuum#State" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#TemporalEntity" -> "http://example.org/monitoringcontinuum#TransferEvent" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#Artifact" -> "http://example.org/monitoringcontinuum#ValidationCampaign" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
}
