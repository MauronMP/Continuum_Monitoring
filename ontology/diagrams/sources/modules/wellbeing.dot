  "http://www.w3.org/ns/sosa/Sensor" -> "http://example.org/monitoringcontinuum#PhysiologicalSensor" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://www.w3.org/ns/sosa/Observation" -> "http://example.org/monitoringcontinuum#SleepObservation" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#ParametrizedData" -> "http://example.org/monitoringcontinuum#SleepParametrizedData" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#PhysiologicalSensor" -> "http://example.org/monitoringcontinuum#SleepSensor" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
