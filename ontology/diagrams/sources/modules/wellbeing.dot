  "http://www.w3.org/ns/sosa/Sensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>sosa:Sensor</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://www.w3.org/ns/sosa/Sensor", style="rounded,dashed,filled"];
