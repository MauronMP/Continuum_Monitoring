digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#DCE7E9" CELLPADDING="5"><FONT POINT-SIZE="9">Shared contracts</FONT></TD><TD BGCOLOR="#E1F3FB" CELLPADDING="5"><FONT POINT-SIZE="9">Observability</FONT></TD></TR><TR><TD BGCOLOR="#F1E3EF" CELLPADDING="5"><FONT POINT-SIZE="9">Orchestration</FONT></TD><TD BGCOLOR="#E9E4F4" CELLPADDING="5"><FONT POINT-SIZE="9">Wellbeing (optional)</FONT></TD><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/monitoringcontinuum#AccelerometerSensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:AccelerometerSensor</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#AccelerometerSensor"];
  "http://example.org/monitoringcontinuum#DeviceState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:DeviceState</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#DeviceState", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#EDASensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:EDASensor</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#EDASensor"];
  "http://example.org/monitoringcontinuum#HeartRateSensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:HeartRateSensor</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#HeartRateSensor"];
  "http://example.org/monitoringcontinuum#MeasurementUnit" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:MeasurementUnit</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#MeasurementUnit"];
  "http://example.org/monitoringcontinuum#ParametrizedData" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:ParametrizedData</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ParametrizedData", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#PersonStatus" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:PersonStatus</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#PersonStatus"];
  "http://example.org/monitoringcontinuum#PhysiologicalObservation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:PhysiologicalObservation</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#PhysiologicalObservation"];
  "http://example.org/monitoringcontinuum#PhysiologicalParametrizedData" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:PhysiologicalParametrizedDa<BR ALIGN="LEFT"/>ta</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#PhysiologicalParametrizedData"];
  "http://example.org/monitoringcontinuum#PhysiologicalSensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:PhysiologicalSensor</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#PhysiologicalSensor"];
  "http://example.org/monitoringcontinuum#SleepObservation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:SleepObservation</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#SleepObservation"];
  "http://example.org/monitoringcontinuum#SleepParametrizedData" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:SleepParametrizedData</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#SleepParametrizedData"];
  "http://example.org/monitoringcontinuum#SleepSensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:SleepSensor</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#SleepSensor"];
  "http://example.org/monitoringcontinuum#SmartBand" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:SmartBand</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#SmartBand"];
  "http://example.org/monitoringcontinuum#SmartRing" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:SmartRing</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#SmartRing"];
  "http://example.org/monitoringcontinuum#SmartWatch" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:SmartWatch</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#SmartWatch"];
  "http://example.org/monitoringcontinuum#SpO2Sensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:SpO2Sensor</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#SpO2Sensor"];
  "http://example.org/monitoringcontinuum#State" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:State</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#State", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#StressLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:StressLevel</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#StressLevel"];
  "http://example.org/monitoringcontinuum#StressObservation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:StressObservation</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#StressObservation"];
  "http://example.org/monitoringcontinuum#TemperatureSensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:TemperatureSensor</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#TemperatureSensor"];
  "http://example.org/monitoringcontinuum#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:TemporalEntity</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#TemporalEntity", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:User</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#User", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#UserState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:UserState</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#UserState", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#Wearable" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E9E4F4" ALIGN="LEFT"><B>comon:Wearable</B></TD></TR></TABLE>>, fillcolor="#E9E4F4", tooltip="http://example.org/monitoringcontinuum#Wearable"];
  "http://www.w3.org/ns/sosa/Observation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>sosa:Observation</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#measurementUnitStatus"><FONT POINT-SIZE="9">comon:measurementUnitStatus: xsd:string</FONT></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://www.w3.org/ns/sosa/Observation", style="rounded,dashed,filled"];
  "http://www.w3.org/ns/sosa/Sensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>sosa:Sensor</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://www.w3.org/ns/sosa/Sensor", style="rounded,dashed,filled"];
  "http://xmlns.com/foaf/0.1/Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>foaf:Person</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://xmlns.com/foaf/0.1/Person", style="rounded,dashed,filled"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="https://saref.etsi.org/core/Device", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#ParametrizedData" -> "http://example.org/monitoringcontinuum#Wearable" [label="comon:generatedBy", tooltip="http://example.org/monitoringcontinuum#generatedBy"];
  "http://example.org/monitoringcontinuum#Wearable" -> "http://example.org/monitoringcontinuum#DeviceState" [label="comon:hasDeviceState", tooltip="http://example.org/monitoringcontinuum#hasDeviceState"];
  "http://www.w3.org/ns/sosa/Observation" -> "http://example.org/monitoringcontinuum#MeasurementUnit" [label="comon:hasMeasurementUnit", tooltip="http://example.org/monitoringcontinuum#hasMeasurementUnit"];
  "http://example.org/monitoringcontinuum#UserState" -> "http://example.org/monitoringcontinuum#PersonStatus" [label="comon:hasPersonStatus", tooltip="http://example.org/monitoringcontinuum#hasPersonStatus"];
  "http://example.org/monitoringcontinuum#UserState" -> "http://example.org/monitoringcontinuum#StressLevel" [label="comon:hasPredictedStressLevel", tooltip="http://example.org/monitoringcontinuum#hasPredictedStressLevel"];
  "http://example.org/monitoringcontinuum#User" -> "http://example.org/monitoringcontinuum#Wearable" [label="comon:hasWearable", tooltip="http://example.org/monitoringcontinuum#hasWearable"];
  "http://example.org/monitoringcontinuum#PhysiologicalSensor" -> "http://example.org/monitoringcontinuum#AccelerometerSensor" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#State" -> "http://example.org/monitoringcontinuum#DeviceState" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#PhysiologicalSensor" -> "http://example.org/monitoringcontinuum#EDASensor" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#PhysiologicalSensor" -> "http://example.org/monitoringcontinuum#HeartRateSensor" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://www.w3.org/ns/sosa/Observation" -> "http://example.org/monitoringcontinuum#PhysiologicalObservation" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
