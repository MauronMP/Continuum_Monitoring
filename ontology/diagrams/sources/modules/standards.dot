digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://www.opengis.net/ont/geosparql#Feature" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" ALIGN="LEFT"><B>geo:Feature</B></TD></TR></TABLE>>, fillcolor="#ECEFF1", tooltip="http://www.opengis.net/ont/geosparql#Feature"];
  "http://www.opengis.net/ont/geosparql#Geometry" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" ALIGN="LEFT"><B>geo:Geometry</B></TD></TR></TABLE>>, fillcolor="#ECEFF1", tooltip="http://www.opengis.net/ont/geosparql#Geometry"];
  "http://www.w3.org/ns/shacl#NodeShape" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" ALIGN="LEFT"><B>sh:NodeShape</B></TD></TR></TABLE>>, fillcolor="#ECEFF1", tooltip="http://www.w3.org/ns/shacl#NodeShape"];
  "http://www.w3.org/ns/sosa/Observation" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" ALIGN="LEFT"><B>sosa:Observation</B></TD></TR></TABLE>>, fillcolor="#ECEFF1", tooltip="http://www.w3.org/ns/sosa/Observation"];
  "http://www.w3.org/ns/sosa/Platform" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" ALIGN="LEFT"><B>sosa:Platform</B></TD></TR></TABLE>>, fillcolor="#ECEFF1", tooltip="http://www.w3.org/ns/sosa/Platform"];
  "http://www.w3.org/ns/sosa/Sensor" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" ALIGN="LEFT"><B>sosa:Sensor</B></TD></TR></TABLE>>, fillcolor="#ECEFF1", tooltip="http://www.w3.org/ns/sosa/Sensor"];
  "http://xmlns.com/foaf/0.1/Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" ALIGN="LEFT"><B>foaf:Person</B></TD></TR></TABLE>>, fillcolor="#ECEFF1", tooltip="http://xmlns.com/foaf/0.1/Person"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#ECEFF1" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#ECEFF1", tooltip="https://saref.etsi.org/core/Device"];
  "diagram:undeclared:standards:domain" [style="dashed,filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD><I>Domain not declared</I></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/sosa/hasSimpleResult"><FONT POINT-SIZE="9">sosa:hasSimpleResult: not declared</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/sosa/resultTime"><FONT POINT-SIZE="9">sosa:resultTime: not declared</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://xmlns.com/foaf/0.1/name"><FONT POINT-SIZE="9">foaf:name: not declared</FONT></TD></TR></TABLE>>];
  "registry:Annotation properties" [style="filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><B>Annotation properties</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://purl.org/dc/terms/identifier"><FONT POINT-SIZE="9">dcterms:identifier</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://purl.org/dc/terms/language"><FONT POINT-SIZE="9">dcterms:language</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://purl.org/dc/terms/modified"><FONT POINT-SIZE="9">dcterms:modified</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://purl.org/dc/terms/replaces"><FONT POINT-SIZE="9">dcterms:replaces</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#class"><FONT POINT-SIZE="9">sh:class</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#datatype"><FONT POINT-SIZE="9">sh:datatype</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#maxCount"><FONT POINT-SIZE="9">sh:maxCount</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#message"><FONT POINT-SIZE="9">sh:message</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#minCount"><FONT POINT-SIZE="9">sh:minCount</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#or"><FONT POINT-SIZE="9">sh:or</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#path"><FONT POINT-SIZE="9">sh:path</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#property"><FONT POINT-SIZE="9">sh:property</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#severity"><FONT POINT-SIZE="9">sh:severity</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/shacl#targetClass"><FONT POINT-SIZE="9">sh:targetClass</FONT></TD></TR></TABLE>>];
  "registry:Object properties with undeclared domain and range" [style="filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD ALIGN="LEFT"><B>Object properties with undeclared domain<BR ALIGN="LEFT"/>and range</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.opengis.net/ont/geosparql#hasGeometry"><FONT POINT-SIZE="9">geo:hasGeometry</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/sosa/hasFeatureOfInterest"><FONT POINT-SIZE="9">sosa:hasFeatureOfInterest</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/sosa/isHostedBy"><FONT POINT-SIZE="9">sosa:isHostedBy</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/sosa/madeBySensor"><FONT POINT-SIZE="9">sosa:madeBySensor</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://www.w3.org/ns/sosa/observedProperty"><FONT POINT-SIZE="9">sosa:observedProperty</FONT></TD></TR></TABLE>>];
}
