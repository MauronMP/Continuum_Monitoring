  "http://example.org/monitoringcontinuum#EvaluationState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:EvaluationState</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#estimatedPredictionError"><FONT POINT-SIZE="9">comon:estimatedPredictionError: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasConsistencyRatio"><FONT POINT-SIZE="9">comon:hasConsistencyRatio: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasConsistencyThreshold"><FONT POINT-SIZE="9">comon:hasConsistencyThreshold: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasEvaluationTicketID"><FONT POINT-SIZE="9">comon:hasEvaluationTicketID: xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasLatencyWeight"><FONT POINT-SIZE="9">comon:hasLatencyWeight: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasModelQualityWeight"><FONT POINT-SIZE="9">comon:hasModelQualityWeight: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasPrivacyWeight"><FONT POINT-SIZE="9">comon:hasPrivacyWeight: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasSelectionJustification"><FONT POINT-SIZE="9">comon:hasSelectionJustification: xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasTrustWeight"><FONT POINT-SIZE="9">comon:hasTrustWeight: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#legacyDecisionScore"><FONT POINT-SIZE="9">comon:legacyDecisionScore: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#observedModelQuality"><FONT POINT-SIZE="9">comon