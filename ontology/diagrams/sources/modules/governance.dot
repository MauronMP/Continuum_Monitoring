digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD><TD BGCOLOR="#E1F3FB" CELLPADDING="5"><FONT POINT-SIZE="9">Observability</FONT></TD></TR><TR><TD BGCOLOR="#FCEDD2" CELLPADDING="5"><FONT POINT-SIZE="9">Governance</FONT></TD><TD BGCOLOR="#F1E3EF" CELLPADDING="5"><FONT POINT-SIZE="9">Orchestration</FONT></TD><TD BGCOLOR="#F9E7DE" CELLPADDING="5"><FONT POINT-SIZE="9">Federated learning</FONT></TD></TR><TR><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/smartcity#AIModel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:AIModel</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#AIModel", style="rounded,dashed,filled"];
  "http://example.org/smartcity#AcceptanceProfile" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#FCEDD2" ALIGN="LEFT"><B>ex:AcceptanceProfile</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#AHP_consistency_threshold"><FONT POINT-SIZE="9">ex:AHP_consistency_threshold:<BR ALIGN="LEFT"/>xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#D_delegation_max"><FONT POINT-SIZE="9">ex:D_delegation_max: xsd:integer</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#E_device_max"><FONT POINT-SIZE="9">ex:E_device_max: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#N_agents"><FONT POINT-SIZE="9">ex:N_agents: xsd:integer</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#T_decision_max"><FONT POINT-SIZE="9">ex:T_decision_max: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#T_inference_local"><FONT POINT-SIZE="9">ex:T_inference_local: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#T_migration_max"><FONT POINT-SIZE="9">ex:T_migration_max: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#T_node_join"><FONT POINT-SIZE="9">ex:T_node_join: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#T_reselection_max"><FONT POINT-SIZE="9">ex:T_reselection_max: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#T_sparql_monitor"><FONT POINT-SIZE="9">ex:T_sparql_monitor: xsd:decimal</FONT></TD></TR></TABLE>>, fillcolor="#FCEDD2", tooltip="http://example.org/smartcity#AcceptanceProfile"];
