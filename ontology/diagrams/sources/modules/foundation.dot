digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/monitoringcontinuum#MAPESymptom" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7" ALIGN="LEFT"><B>mc:MAPESymptom</B></TD></TR></TABLE>>, fillcolor="#DDEBF7", tooltip="http://example.org/monitoringcontinuum#MAPESymptom"];
  "http://example.org/monitoringcontinuum#NonUser" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7" ALIGN="LEFT"><B>mc:NonUser</B></TD></TR></TABLE>>, fillcolor="#DDEBF7", tooltip="http://example.org/monitoringcontinuum#NonUser"];
  "http://example.org/monitoringcontinuum#ProcessingLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7" ALIGN="LEFT"><B>mc:ProcessingLevel</B></TD></TR></TABLE>>, fillcolor="#DDEBF7", tooltip="http://example.org/monitoringcontinuum#ProcessingLevel"];
  "http://example.org/monitoringcontinuum#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7" ALIGN="LEFT"><B>mc:TemporalEntity</B></TD></TR></TABLE>>, fillcolor="#DDEBF7", tooltip="http://example.org/monitoringcontinuum#TemporalEntity"];
  "http://example.org/monitoringcontinuum#User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DDEBF7" ALIGN="LEFT"><B>mc:User</B></TD></TR></TABLE>>, fillcolor="#DDEBF7", tooltip="http://example.org/monitoringcontinuum#User"];
  "http://xmlns.com/foaf/0.1/Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>foaf:Person</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://xmlns.com/foaf/0.1/Person", style="rounded,dashed,filled"];
  "http://xmlns.com/foaf/0.1/Person" -> "http://example.org/monitoringcontinuum#NonUser" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://xmlns.com/foaf/0.1/Person" -> "http://example.org/monitoringcontinuum#User" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
}
