digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD><TD BGCOLOR="#E1F3FB" CELLPADDING="5"><FONT POINT-SIZE="9">Observability</FONT></TD><TD BGCOLOR="#FCEDD2" CELLPADDING="5"><FONT POINT-SIZE="9">Governance</FONT></TD></TR><TR><TD BGCOLOR="#F1E3EF" CELLPADDING="5"><FONT POINT-SIZE="9">Orchestration</FONT></TD><TD BGCOLOR="#F9E7DE" CELLPADDING="5"><FONT POINT-SIZE="9">Federated learning</FONT></TD><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/smartcity#AIModel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:AIModel</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#AIModel", style="rounded,dashed,filled"];
  "http://example.org/smartcity#ComputationalNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:ComputationalNode</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#ComputationalNode", style="rounded,dashed,filled"];
  "http://example.org/smartcity#FederatedLearningSession" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F9E7DE" ALIGN="LEFT"><B>ex:FederatedLearningSession</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#containsIndividualizedGradients"><FONT POINT-SIZE="9">ex:containsIndividualizedGradients:<BR ALIGN="LEFT"/>xsd:boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#hasPrivacyBudget"><FONT POINT-SIZE="9">ex:hasPrivacyBudget: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#noiseLevel"><FONT POINT-SIZE="9">ex:noiseLevel: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#sessionTime"><FONT POINT-SIZE="9">ex:sessionTime: xsd:dateTime</FONT></TD></TR></TABLE>>, fillcolor="#F9E7DE", tooltip="http://example.org/smartcity#FederatedLearningSession"];
  "http://example.org/smartcity#MistNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:MistNode</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#MistNode", style="rounded,dashed,filled"];
  "http://example.org/smartcity#MobileDevice" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:MobileDevice</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#MobileDevice", style="rounded,dashed,filled"];
  "http://example.org/smartcity#ModelGradientUpdate" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F9E7DE" ALIGN="LEFT"><B>ex:ModelGradientUpdate</B></TD></TR></TABLE>>, fillcolor="#F9E7DE", tooltip="http://example.org/smartcity#ModelGradientUpdate"];
  "http://example.org/smartcity#ParametrizedData" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:ParametrizedData</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#hasAnonymizationApplied"><FONT POINT-SIZE="9">ex:hasAnonymizationApplied: xsd:boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#hasNoiseApplied"><FONT POINT-SIZE="9">ex:hasNoiseApplied: xsd:boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#isRedundant"><FONT POINT-SIZE="9">ex:isRedundant: xsd:boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#sendTimestamp"><FONT POINT-SIZE="9">ex:sendTimestamp: xsd:dateTime</FONT></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#ParametrizedData", style="rounded,dashed,filled"];
  "http://example.org/smartcity#PayloadType" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F9E7DE" ALIGN="LEFT"><B>ex:PayloadType</B></TD></TR></TABLE>>, fillcolor="#F9E7DE", tooltip="http://example.org/smartcity#PayloadType"];
  "http://example.org/smartcity#PrivacyBudgetAccount" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F9E7DE" ALIGN="LEFT"><B>ex:PrivacyBudgetAccount</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#privacyBudgetConsumed"><FONT POINT-SIZE="9">ex:privacyBudgetConsumed: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#privacyBudgetMaximum"><FONT POINT-SIZE="9">ex:privacyBudgetMaximum: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#privacyBudgetRemaining"><FONT POINT-SIZE="9">ex:privacyBudgetRemaining: xsd:decimal</FONT></TD></TR></TABLE>>, fillcolor="#F9E7DE", tooltip="http://example.org/smartcity#PrivacyBudgetAccount"];
  "http://example.org/smartcity#PrivacyMechanism" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:PrivacyMechanism</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#PrivacyMechanism", style="rounded,dashed,filled"];
  "http://example.org/smartcity#ProcessingPurpose" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:ProcessingPurpose</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#ProcessingPurpose", style="rounded,dashed,filled"];
  "http://example.org/smartcity#SemanticContract" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:SemanticContract</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#SemanticContract", style="rounded,dashed,filled"];
  "http://example.org/smartcity#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:TemporalEntity</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#TemporalEntity", style="rounded,dashed,filled"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="https://saref.etsi.org/core/Device", style="rounded,dashed,filled"];
  "urn:continuum:ontology:3.0.0:node:97" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F9E7DE" ALIGN="LEFT"><B>OR</B></TD></TR></TABLE>>, fillcolor="#F9E7DE", tooltip="urn:continuum:ontology:3.0.0:node:97"];
  "http://example.org/smartcity#ComputationalNode" -> "http://example.org/smartcity#ParametrizedData" [label="ex:aggregatesData", tooltip="http://example.org/smartcity#aggregatesData"];
  "http://example.org/smartcity#PrivacyBudgetAccount" -> "http://example.org/smartcity#SemanticContract" [label="ex:budgetForContract", tooltip="http://example.org/smartcity#budgetForContract"];
  "http://example.org/smartcity#PrivacyBudgetAccount" -> "http://example.org/smartcity#ProcessingPurpose" [label="ex:budgetForPurpose", tooltip="http://example.org/smartcity#budgetForPurpose"];
  "http://example.org/smartcity#FederatedLearningSession" -> "http://example.org/smartcity#PayloadType" [label="ex:hasPayloadType", tooltip="http://example.org/smartcity#hasPayloadType"];
  "http://example.org/smartcity#FederatedLearningSession" -> "http://example.org/smartcity#PrivacyBudgetAccount" [label="ex:hasPrivacyBudgetAccount", tooltip="http://example.org/smartcity#hasPrivacyBudgetAccount"];
  "urn:continuum:ontology:3.0.0:node:97" -> "http://example.org/smartcity#PrivacyMechanism" [label="ex:hasPrivacyMechanism", tooltip="http://example.org/smartcity#hasPrivacyMechanism"];
