digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#DCE7E9" CELLPADDING="5"><FONT POINT-SIZE="9">Shared contracts</FONT></TD><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD></TR><TR><TD BGCOLOR="#FCEDD2" CELLPADDING="5"><FONT POINT-SIZE="9">Governance</FONT></TD><TD BGCOLOR="#F1E3EF" CELLPADDING="5"><FONT POINT-SIZE="9">Orchestration</FONT></TD><TD BGCOLOR="#F9E7DE" CELLPADDING="5"><FONT POINT-SIZE="9">Federated learning</FONT></TD></TR><TR><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/monitoringcontinuum#AIModel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:AIModel</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#AIModel", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#ComputationalNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:ComputationalNode</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ComputationalNode", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#FederatedLearningSession" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:FederatedLearningSession</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#containsIndividualizedGradients"><FONT POINT-SIZE="9">mc:containsIndividualizedGradients:<BR ALIGN="LEFT"/>xsd:boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasPrivacyBudget"><FONT POINT-SIZE="9">mc:hasPrivacyBudget: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#noiseLevel"><FONT POINT-SIZE="9">mc:noiseLevel: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#sessionTime"><FONT POINT-SIZE="9">mc:sessionTime: xsd:dateTime</FONT></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#FederatedLearningSession", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#MistNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:MistNode</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#MistNode", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#MobileDevice" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:MobileDevice</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#MobileDevice", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#ModelGradientUpdate" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F9E7DE" ALIGN="LEFT"><B>mc:ModelGradientUpdate</B></TD></TR></TABLE>>, fillcolor="#F9E7DE", tooltip="http://example.org/monitoringcontinuum#ModelGradientUpdate"];
  "http://example.org/monitoringcontinuum#ParametrizedData" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:ParametrizedData</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasAnonymizationApplied"><FONT POINT-SIZE="9">mc:hasAnonymizationApplied: xsd:boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasNoiseApplied"><FONT POINT-SIZE="9">mc:hasNoiseApplied: xsd:boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#isRedundant"><FONT POINT-SIZE="9">mc:isRedundant: xsd:boolean</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#sendTimestamp"><FONT POINT-SIZE="9">mc:sendTimestamp: xsd:dateTime</FONT></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ParametrizedData", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#PayloadType" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:PayloadType</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#PayloadType", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#PrivacyBudgetAccount" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F9E7DE" ALIGN="LEFT"><B>mc:PrivacyBudgetAccount</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#privacyBudgetConsumed"><FONT POINT-SIZE="9">mc:privacyBudgetConsumed: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#privacyBudgetMaximum"><FONT POINT-SIZE="9">mc:privacyBudgetMaximum: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#privacyBudgetRemaining"><FONT POINT-SIZE="9">mc:privacyBudgetRemaining: xsd:decimal</FONT></TD></TR></TABLE>>, fillcolor="#F9E7DE", tooltip="http://example.org/monitoringcontinuum#PrivacyBudgetAccount"];
  "http://example.org/monitoringcontinuum#PrivacyMechanism" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:PrivacyMechanism</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#PrivacyMechanism", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#ProcessingPurpose" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:ProcessingPurpose</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ProcessingPurpose", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#SemanticContract" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:SemanticContract</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#SemanticContract", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:TemporalEntity</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#TemporalEntity", style="rounded,dashed,filled"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="https://saref.etsi.org/core/Device", style="rounded,dashed,filled"];
  "urn:continuum:ontology:4.0.0:node:97" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F9E7DE" ALIGN="LEFT"><B>OR</B></TD></TR></TABLE>>, fillcolor="#F9E7DE", tooltip="urn:continuum:ontology:4.0.0:node:97"];
  "http://example.org/monitoringcontinuum#ComputationalNode" -> "http://example.org/monitoringcontinuum#ParametrizedData" [label="mc:aggregatesData", tooltip="http://example.org/monitoringcontinuum#aggregatesData"];
  "http://example.org/monitoringcontinuum#PrivacyBudgetAccount" -> "http://example.org/monitoringcontinuum#SemanticContract" [label="mc:budgetForContract", tooltip="http://example.org/monitoringcontinuum#budgetForContract"];
  "http://example.org/monitoringcontinuum#PrivacyBudgetAccount" -> "http://example.org/monitoringcontinuum#ProcessingPurpose" [label="mc:budgetForPurpose", tooltip="http://example.org/monitoringcontinuum#budgetForPurpose"];
  "http://example.org/monitoringcontinuum#FederatedLearningSession" -> "http://example.org/monitoringcontinuum#PayloadType" [label="mc:hasPayloadType", tooltip="http://example.org/monitoringcontinuum#hasPayloadType"];
  "http://example.org/monitoringcontinuum#FederatedLearningSession" -> "http://example.org/monitoringcontinuum#PrivacyBudgetAccount" [label="mc:hasPrivacyBudgetAccount", tooltip="http://example.org/monitoringcontinuum#hasPrivacyBudgetAccount"];
  "urn:continuum:ontology:4.0.0:node:97" -> "http://example.org/monitoringcontinuum#PrivacyMechanism" [label="mc:hasPrivacyMechanism", tooltip="http://example.org/monitoringcontinuum#hasPrivacyMechanism"];
  "http://example.org/monitoringcontinuum#FederatedLearningSession" -> "http://example.org/monitoringcontinuum#ComputationalNode" [label="mc:involvedNode", tooltip="http://example.org/monitoringcontinuum#involvedNode"];
  "http://example.org/monitoringcontinuum#ParametrizedData" -> "http://example.org/monitoringcontinuum#MobileDevice" [label="mc:originatesFromDevice", tooltip="http://example.org/monitoringcontinuum#originatesFromDevice"];
  "http://example.org/monitoringcontinuum#ParametrizedData" -> "http://example.org/monitoringcontinuum#ComputationalNode" [label="mc:sentToNode", tooltip="http://example.org/monitoringcontinuum#sentToNode"];
  "http://example.org/monitoringcontinuum#FederatedLearningSession" -> "http://example.org/monitoringcontinuum#ParametrizedData" [label="mc:transfersData", tooltip="http://example.org/monitoringcontinuum#transfersData"];
  "http://example.org/monitoringcontinuum#FederatedLearningSession" -> "http://example.org/monitoringcontinuum#AIModel" [label="mc:updatesModel", tooltip="http://example.org/monitoringcontinuum#updatesModel"];
  "https://saref.etsi.org/core/Device" -> "http://example.org/monitoringcontinuum#ComputationalNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#ComputationalNode" -> "http://example.org/monitoringcontinuum#MistNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#MistNode" -> "http://example.org/monitoringcontinuum#MobileDevice" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#ParametrizedData" -> "http://example.org/monitoringcontinuum#ModelGradientUpdate" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "http://example.org/monitoringcontinuum#TemporalEntity" -> "http://example.org/monitoringcontinuum#SemanticContract" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "urn:continuum:ontology:4.0.0:node:97" -> "http://example.org/monitoringcontinuum#FederatedLearningSession" [style=dotted, arrowhead=none, color="#8A939B"];
  "urn:continuum:ontology:4.0.0:node:97" -> "http://example.org/monitoringcontinuum#ParametrizedData" [style=dotted, arrowhead=none, color="#8A939B"];
}
