digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD><TD BGCOLOR="#EFEDCC" CELLPADDING="5"><FONT POINT-SIZE="9">Deployment</FONT></TD><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/monitoringcontinuum#AuthorityScope" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFEDCC" ALIGN="LEFT"><B>mc:AuthorityScope</B></TD></TR></TABLE>>, fillcolor="#EFEDCC", tooltip="http://example.org/monitoringcontinuum#AuthorityScope"];
  "http://example.org/monitoringcontinuum#ComputationalNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>mc:ComputationalNode</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ComputationalNode", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#DeploymentFragment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFEDCC" ALIGN="LEFT"><B>mc:DeploymentFragment</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#graphIRI"><FONT POINT-SIZE="9">mc:graphIRI: xsd:anyURI</FONT></TD></TR></TABLE>>, fillcolor="#EFEDCC", tooltip="http://example.org/monitoringcontinuum#DeploymentFragment"];
  "http://example.org/monitoringcontinuum#PrivacyClass" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFEDCC" ALIGN="LEFT"><B>mc:PrivacyClass</B></TD></TR></TABLE>>, fillcolor="#EFEDCC", tooltip="http://example.org/monitoringcontinuum#PrivacyClass"];
  "http://example.org/monitoringcontinuum#SemanticNodeProfile" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#EFEDCC" ALIGN="LEFT"><B>mc:SemanticNodeProfile</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#ontologyDigest"><FONT POINT-SIZE="9">mc:ontologyDigest: xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#usesEntailmentProfile"><FONT POINT-SIZE="9">mc:usesEntailmentProfile: xsd:string</FONT></TD></TR></TABLE>>, fillcolor="#EFEDCC", tooltip="http://example.org/monitoringcontinuum#SemanticNodeProfile"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="https://saref.etsi.org/core/Device", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#DeploymentFragment" -> "http://example.org/monitoringcontinuum#AuthorityScope" [label="mc:authoritativeFor", tooltip="http://example.org/monitoringcontinuum#authoritativeFor"];
  "http://example.org/monitoringcontinuum#DeploymentFragment" -> "http://example.org/monitoringcontinuum#PrivacyClass" [label="mc:hasPrivacyClass", tooltip="http://example.org/monitoringcontinuum#hasPrivacyClass"];
  "http://example.org/monitoringcontinuum#DeploymentFragment" -> "http://example.org/monitoringcontinuum#ComputationalNode" [label="mc:hostedAt", tooltip="http://example.org/monitoringcontinuum#hostedAt"];
  "http://example.org/monitoringcontinuum#DeploymentFragment" -> "http://example.org/monitoringcontinuum#DeploymentFragment" [label="mc:replicaOf", tooltip="http://example.org/monitoringcontinuum#replicaOf"];
  "https://saref.etsi.org/core/Device" -> "http://example.org/monitoringcontinuum#ComputationalNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
}
