digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD><TD BGCOLOR="#E1F3FB" CELLPADDING="5"><FONT POINT-SIZE="9">Observability</FONT></TD></TR><TR><TD BGCOLOR="#FCEDD2" CELLPADDING="5"><FONT POINT-SIZE="9">Governance</FONT></TD><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/smartcity#Artifact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:Artifact</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#Artifact", style="rounded,dashed,filled"];
  "http://example.org/smartcity#AvailabilityLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:AvailabilityLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#AvailabilityLevel"];
  "http://example.org/smartcity#BatteryLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:BatteryLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#BatteryLevel"];
  "http://example.org/smartcity#CityArea" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:CityArea</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#CityArea", style="rounded,dashed,filled"];
  "http://example.org/smartcity#CommunicationLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:CommunicationLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#CommunicationLevel"];
  "http://example.org/smartcity#ComplianceMetric" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:ComplianceMetric</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#ComplianceMetric"];
  "http://example.org/smartcity#ComputationalNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:ComputationalNode</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#ComputationalNode", style="rounded,dashed,filled"];
  "http://example.org/smartcity#DataContext" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:DataContext</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#DataContext"];
  "http://example.org/smartcity#DeviceConnectionStatus" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:DeviceConnectionStatus</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#DeviceConnectionStatus"];
  "http://example.org/smartcity#DeviceState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:DeviceState</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#parametrizedDataReady"><FONT POINT-SIZE="9">ex:parametrizedDataReady: xsd:boolean</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#DeviceState"];
  "http://example.org/smartcity#EnergyLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:EnergyLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#EnergyLevel"];
  "http://example.org/smartcity#MobilityLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:MobilityLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#MobilityLevel"];
  "http://example.org/smartcity#NodeState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:NodeState</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#queuedRequests"><FONT POINT-SIZE="9">ex:queuedRequests: xsd:integer</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#resourceUsagePercent"><FONT POINT-SIZE="9">ex:resourceUsagePercent: xsd:decimal</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#NodeState"];
  "http://example.org/smartcity#OperationalStatus" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:OperationalStatus</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#OperationalStatus"];
  "http://example.org/smartcity#PerformanceLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:PerformanceLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#PerformanceLevel"];
  "http://example.org/smartcity#ProcessingLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:ProcessingLevel</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#ProcessingLevel", style="rounded,dashed,filled"];
  "http://example.org/smartcity#ProcessingPurpose" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:ProcessingPurpose</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#ProcessingPurpose", style="rounded,dashed,filled"];
  "http://example.org/smartcity#ResidualCapacity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:ResidualCapacity</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#ResidualCapacity"];
  "http://example.org/smartcity#State" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:State</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#stateDuration"><FONT POINT-SIZE="9">ex:stateDuration: xsd:duration</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#State"];
  "http://example.org/smartcity#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:TemporalEntity</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#validFrom"><FONT POINT-SIZE="9">ex:validFrom: xsd:dateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#validTo"><FONT POINT-SIZE="9">ex:validTo: xsd:dateTime</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#TemporalEntity"];
  "http://example.org/smartcity#TrafficWindow" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:TrafficWindow</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#TrafficWindow"];
  "http://example.org/smartcity#TrustAssessment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:TrustAssessment</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#trustRuleVersion"><FONT POINT-SIZE="9">ex:trustRuleVersion: xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#trustWindowEnd"><FONT POINT-SIZE="9">ex:trustWindowEnd: xsd:dateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#trustWindowStart"><FONT POINT-SIZE="9">ex:trustWindowStart: xsd:dateTime</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#TrustAssessment"];
  "http://example.org/smartcity#TrustEvidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:TrustEvidence</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#evidenceContribution"><FONT POINT-SIZE="9">ex:evidenceContribution: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#evidenceFactor"><FONT POINT-SIZE="9">ex:evidenceFactor: xsd:string</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#TrustEvidence"];
  "http://example.org/smartcity#UrbanEnvironment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:UrbanEnvironment</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#UrbanEnvironment", style="rounded,dashed,filled"];
  "http://example.org/smartcity#User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:User</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#User", style="rounded,dashed,filled"];
  "http://example.org/smartcity#UserState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:UserState</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#userFeedbackScore"><FONT POINT-SIZE="9">ex:userFeedbackScore: xsd:integer</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#UserState"];
  "http://example.org/smartcity#ValidationCampaign" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>ex:ValidationCampaign</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/smartcity#ValidationCampaign", style="rounded,dashed,filled"];
  "http://example.org/smartcity#WorkloadLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>ex:WorkloadLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/smartcity#WorkloadLevel"];
  "http://xmlns.com/foaf/0.1/Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>foaf:Person</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://xmlns.com/foaf/0.1/Person", style="rounded,dashed,filled"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="https://saref.etsi.org/core/Device", style="rounded,dashed,filled"];
  "diagram:undeclared:observability:domain" [style="dashed,filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD><I>Domain not declared</I></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#hasTrustScore"><FONT POINT-SIZE="9">ex:hasTrustScore: xsd:decimal</FONT></TD></TR></TABLE>>];
  "http://example.org/smartcity#DataContext" -> "http://example.org/smartcity#DeviceState" [label="ex:contextDeviceState", tooltip="http://example.org/smartcity#contextDeviceState"];
  "http://example.org/smartcity#DataContext" -> "http://example.org/smartcity#NodeState" [label="ex:contextNodeState", tooltip="http://example.org/smartcity#contextNodeState"];
