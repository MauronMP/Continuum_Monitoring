  "http://example.org/monitoringcontinuum#NodeState" -> "http://example.org/monitoringcontinuum#WorkloadLevel" [label="comon:hasWorkload", tooltip="http://example.org/monitoringcontinuum#hasWorkload"];
  "http://example.org/monitoringcontinuum#TrustAssessment" -> "http://example.org/monitoringcontinuum#NodeState" [label="comon:trustAssessmentForState", tooltip="http://example.org/monitoringcontinuum#trustAssessmentForState"];
  "http://example.org/monitoringcontinuum#UrbanEnvironment" -> "http://example.org/monitoringcontinuum#CityArea" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
  "https://saref.etsi.org/core/Device" -> "http://example.org/monitoringcontinuum#ComputationalNode" [dir=back, arrowtail=empty, style=dashed, color="#8A939B", weight=2];
