  "http://example.org/monitoringcontinuum#DeviceState" -> "http://example.org/monitoringcontinuum#DeviceConnectionStatus" [label="comon:hasConnectionStatus", tooltip="http://example.org/monitoringcontinuum#hasConnectionStatus"];
