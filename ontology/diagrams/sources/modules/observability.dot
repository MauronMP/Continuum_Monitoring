digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#DCE7E9" CELLPADDING="5"><FONT POINT-SIZE="9">Shared contracts</FONT></TD><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD></TR><TR><TD BGCOLOR="#E1F3FB" CELLPADDING="5"><FONT POINT-SIZE="9">Observability</FONT></TD><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Dashed gray class boxes: cross-module context</FONT></TD></TR></TABLE>>;
  "http://example.org/monitoringcontinuum#Artifact" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:Artifact</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#Artifact", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#AvailabilityLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:AvailabilityLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#AvailabilityLevel"];
  "http://example.org/monitoringcontinuum#BatteryLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:BatteryLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#BatteryLevel"];
  "http://example.org/monitoringcontinuum#CityArea" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:CityArea</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#CityArea", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#CommunicationLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:CommunicationLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#CommunicationLevel"];
  "http://example.org/monitoringcontinuum#ComplianceMetric" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:ComplianceMetric</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#ComplianceMetric"];
  "http://example.org/monitoringcontinuum#ComputationalNode" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:ComputationalNode</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ComputationalNode", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#DataContext" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:DataContext</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#DataContext"];
  "http://example.org/monitoringcontinuum#DeviceConnectionStatus" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:DeviceConnectionStatus</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#DeviceConnectionStatus"];
  "http://example.org/monitoringcontinuum#DeviceState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:DeviceState</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#parametrizedDataReady"><FONT POINT-SIZE="9">comon:parametrizedDataReady: xsd:boolean</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#DeviceState"];
  "http://example.org/monitoringcontinuum#EnergyLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:EnergyLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#EnergyLevel"];
  "http://example.org/monitoringcontinuum#MobilityLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:MobilityLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#MobilityLevel"];
  "http://example.org/monitoringcontinuum#NodeState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:NodeState</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#queuedRequests"><FONT POINT-SIZE="9">comon:queuedRequests: xsd:integer</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#resourceUsagePercent"><FONT POINT-SIZE="9">comon:resourceUsagePercent: xsd:decimal</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#NodeState"];
  "http://example.org/monitoringcontinuum#OperationalStatus" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:OperationalStatus</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#OperationalStatus"];
  "http://example.org/monitoringcontinuum#PerformanceLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:PerformanceLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#PerformanceLevel"];
  "http://example.org/monitoringcontinuum#ProcessingLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:ProcessingLevel</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ProcessingLevel", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#ProcessingPurpose" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:ProcessingPurpose</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ProcessingPurpose", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#ResidualCapacity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:ResidualCapacity</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#ResidualCapacity"];
  "http://example.org/monitoringcontinuum#State" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:State</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#stateDuration"><FONT POINT-SIZE="9">comon:stateDuration: xsd:duration</FONT></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#State", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#TemporalEntity" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:TemporalEntity</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#validFrom"><FONT POINT-SIZE="9">comon:validFrom: xsd:dateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#validTo"><FONT POINT-SIZE="9">comon:validTo: xsd:dateTime</FONT></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#TemporalEntity", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#TrafficWindow" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:TrafficWindow</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#TrafficWindow"];
  "http://example.org/monitoringcontinuum#TrustAssessment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:TrustAssessment</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#trustRuleVersion"><FONT POINT-SIZE="9">comon:trustRuleVersion: xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#trustWindowEnd"><FONT POINT-SIZE="9">comon:trustWindowEnd: xsd:dateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#trustWindowStart"><FONT POINT-SIZE="9">comon:trustWindowStart: xsd:dateTime</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#TrustAssessment"];
  "http://example.org/monitoringcontinuum#TrustEvidence" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:TrustEvidence</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#evidenceContribution"><FONT POINT-SIZE="9">comon:evidenceContribution: xsd:decimal</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#evidenceFactor"><FONT POINT-SIZE="9">comon:evidenceFactor: xsd:string</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#TrustEvidence"];
  "http://example.org/monitoringcontinuum#UrbanEnvironment" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:UrbanEnvironment</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#UrbanEnvironment", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#User" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:User</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#User", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#UserState" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:UserState</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#userFeedbackScore"><FONT POINT-SIZE="9">comon:userFeedbackScore: xsd:integer</FONT></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#UserState"];
  "http://example.org/monitoringcontinuum#ValidationCampaign" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>comon:ValidationCampaign</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://example.org/monitoringcontinuum#ValidationCampaign", style="rounded,dashed,filled"];
  "http://example.org/monitoringcontinuum#WorkloadLevel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#E1F3FB" ALIGN="LEFT"><B>comon:WorkloadLevel</B></TD></TR></TABLE>>, fillcolor="#E1F3FB", tooltip="http://example.org/monitoringcontinuum#WorkloadLevel"];
  "http://xmlns.com/foaf/0.1/Person" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>foaf:Person</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="http://xmlns.com/foaf/0.1/Person", style="rounded,dashed,filled"];
  "https://saref.etsi.org/core/Device" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F5F5F5" ALIGN="LEFT"><B>saref:Device</B></TD></TR></TABLE>>, fillcolor="#F5F5F5", tooltip="https://saref.etsi.org/core/Device", style="rounded,dashed,filled"];
  "diagram:undeclared:observability:domain" [style="dashed,filled", fillcolor="#F4F4F4", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="5"><TR><TD><I>Domain not declared</I></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#hasTrustScore"><FONT POINT-SIZE="9">comon:hasTrustScore: xsd:decimal</FONT></TD></TR></TABLE>>];
