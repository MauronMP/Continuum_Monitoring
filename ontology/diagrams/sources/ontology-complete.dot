digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD><TD BGCOLOR="#E1F3FB" CELLPADDING="5"><FONT POINT-SIZE="9">Observability</FONT></TD></TR><TR><TD BGCOLOR="#FCEDD2" CELLPADDING="5"><FONT POINT-SIZE="9">Governance</FONT></TD><TD BGCOLOR="#F1E3EF" CELLPADDING="5"><FONT POINT-SIZE="9">Orchestration</FONT></TD><TD BGCOLOR="#F9E7DE" CELLPADDING="5"><FONT POINT-SIZE="9">Federated learning</FONT></TD></TR><TR><TD BGCOLOR="#EFEDCC" CELLPADDING="5"><FONT POINT-SIZE="9">Deployment</FONT></TD><TD BGCOLOR="#E9E4F4" CELLPADDING="5"><FONT POINT-SIZE="9">Wellbeing (optional)</FONT></TD><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR></TABLE>>;
  "http://example.org/smartcity#AIModel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#F1E3EF" ALIGN="LEFT"><B>ex:AIModel</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#lastUpdated"><FONT POINT-SIZE="9">ex:lastUpdated: xsd:dateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#modelLineageStatus"><FONT POINT-SIZE="9">ex:modelLineageStatus: xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/smartcity#modelVersion"><FONT POINT-SIZE="9">ex:modelVersion: xsd:string</FONT></TD></TR></TABLE>>, fillcolor="#F1E3EF", tooltip="http://example.org/smartcity#AIModel"];
