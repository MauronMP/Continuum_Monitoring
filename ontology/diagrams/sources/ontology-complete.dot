digraph ontology {
  graph [rankdir=TB, bgcolor="white", margin=0, pad="0.20", nodesep="0.28",
         ranksep="0.65", splines=polyline, outputorder=edgesfirst,
         fontname="Helvetica", fontnames="svg", labelloc=b, labeljust=c];
  node [shape=box, style="rounded,filled", color="#52606D",
        fillcolor="white", fontcolor="#17212B", fontname="Helvetica",
        fontsize=11, margin="0.10,0.07", penwidth=1.0];
  edge [color="#64717D", fontcolor="#26323C", fontname="Helvetica",
        fontsize=9, arrowsize=0.65, penwidth=0.8];
  label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="3"><TR><TD BGCOLOR="#DDEBF7" CELLPADDING="5"><FONT POINT-SIZE="9">Foundation</FONT></TD><TD BGCOLOR="#DCE7E9" CELLPADDING="5"><FONT POINT-SIZE="9">Shared contracts</FONT></TD><TD BGCOLOR="#E2F1EC" CELLPADDING="5"><FONT POINT-SIZE="9">Topology</FONT></TD></TR><TR><TD BGCOLOR="#E1F3FB" CELLPADDING="5"><FONT POINT-SIZE="9">Observability</FONT></TD><TD BGCOLOR="#FCEDD2" CELLPADDING="5"><FONT POINT-SIZE="9">Governance</FONT></TD><TD BGCOLOR="#F1E3EF" CELLPADDING="5"><FONT POINT-SIZE="9">Orchestration</FONT></TD></TR><TR><TD BGCOLOR="#F9E7DE" CELLPADDING="5"><FONT POINT-SIZE="9">Federated learning</FONT></TD><TD BGCOLOR="#EFEDCC" CELLPADDING="5"><FONT POINT-SIZE="9">Deployment</FONT></TD><TD BGCOLOR="#E9E4F4" CELLPADDING="5"><FONT POINT-SIZE="9">Wellbeing (optional)</FONT></TD></TR><TR><TD BGCOLOR="#ECEFF1" CELLPADDING="5"><FONT POINT-SIZE="9">External standards / SHACL</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Solid: object property | Hollow arrow: subclass | Dotted: OR/AND membership</FONT></TD></TR><TR><TD COLSPAN="3"><FONT POINT-SIZE="9">Attributes: datatype properties | Registries: unscoped properties / metadata</FONT></TD></TR></TABLE>>;
  "http://example.org/monitoringcontinuum#AIModel" [label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5"><TR><TD BGCOLOR="#DCE7E9" ALIGN="LEFT"><B>mc:AIModel</B></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#lastUpdated"><FONT POINT-SIZE="9">mc:lastUpdated: xsd:dateTime</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#modelLineageStatus"><FONT POINT-SIZE="9">mc:modelLineageStatus: xsd:string</FONT></TD></TR><TR><TD ALIGN="LEFT" TOOLTIP="http://example.org/monitoringcontinuum#modelVersion"><FONT POINT-SIZE="9">mc:modelVersion: xsd:string</FONT></TD></TR></TABLE>>, fillcolor="#DCE7E9", tooltip="http://example.org/monitoringcontinuum#AIModel"];
