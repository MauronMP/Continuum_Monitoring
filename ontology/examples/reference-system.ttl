comon:RF-03 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-03" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-03" ;
    comon:requirementStatement "The system must detect changes in the agent's context, including movement, loss of connectivity, zone changes, changes in the proximity of nodes and transitions between urban, rural or restricted areas." ;
    comon:tracedToMechanism comon:M-CTX-01,
        comon:M-MODEL-04 ;
    comon:tracedToPolicy comon:P-ZONE-04 .

comon:RF-04 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-04" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-04" ;
    comon:requirementStatement "The system must monitor device state: battery, connectivity, active sensors, availability of parameterized data and local preprocessing capacity." ;
    comon:tracedToMechanism comon:M-DATA-02,
        comon:M-TX-01 ;
    comon:tracedToPolicy comon:P-DATA-04 .

comon:RF-05 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-05" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-05" ;
    comon:requirementStatement "The system must record the operational state of continuum nodes, including availability, load, communication, residual capacity, resource usage, request queues and operating status. `ComputeOnly` or `Inoperative` states must be explicitly detected so that orchestration can decide whether to delegate, isolate or exclude the node." ;
    comon:tracedToMechanism comon:M-NODE-01,
        comon:M-NODE-02 ;
    comon:tracedToPolicy comon:P-NODE-01 .

comon:RF-10 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-10" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-10" ;
    comon:requirementStatement "The system must distinguish between raw physiological observations and transmissible parameterized data. For these requirements, the local scope is limited to the mobile/wearable device and, when policy permits, the associated Mist tier; raw physiological observations must not be transmitted to Edge, Fog or Cloud." ;
    comon:tracedToMechanism comon:M-DATA-01,
        comon:M-TX-01 ;
    comon:tracedToPolicy comon:P-DATA-01 .

comon:RF-14 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-14" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-14" ;
    comon:requirementStatement "The system must evaluate prediction quality and separately record prediction confidence, estimated error, local feedback and the observed quality of the model used. Weights used for multicriteria selection must not substitute for observed quality metrics." ;
    comon:tracedToMechanism comon:M-AUD-01,
        comon:M-METRIC-01 ;
    comon:tracedToPolicy comon:P-MODEL-08 .

comon:RF-24 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-24" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-24" ;
    comon:requirementStatement "The system must version models, record their update dates and support rollback to previous versions in the event of degradation, errors or policy non-compliance." ;
    comon:tracedToMechanism comon:M-MODEL-05,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-FL-08 .

comon:RF-29 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-29" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-29" ;
    comon:requirementStatement "The system must collect system metrics for computational stress studies, including resource usage, load, queues, latency, residual capacity and migration cost." ;
    comon:tracedToMechanism comon:M-METRIC-01,
        comon:M-TIME-01 ;
    comon:tracedToPolicy comon:P-OPS-05 .

comon:RF-31 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-31" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-31" ;
    comon:requirementStatement "The system must support simulation of urban scenarios with high mobility, high load, loss of connectivity, rural zones, restricted zones, Edge saturation and Edge-to-Fog migration. Scenarios S1–S17 must be defined in an unambiguously referenced, versioned artifact or annex to make this requirement reproducible." ;
    comon:tracedToMechanism comon:M-VAL-04,
        comon:M-VAL-06 ;
    comon:tracedToPolicy comon:P-VAL-07 .

comon:RF-32 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-32" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-32" ;
    comon:requirementStatement "The system must represent consent through a consent-aware model based on processing ranges, including local consent, community aggregation, global aggregation and explicit denial/revocation. Users must be able to grant or revoke authorization for data categories, purposes, validity intervals and the maximum permitted continuum range." ;
    comon:tracedToMechanism comon:M-CONS-01 ;
    comon:tracedToPolicy comon:P-CONS-01 .

comon:RF-33 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-33" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-33" ;
    comon:requirementStatement "Every user must be linked to exactly one effective semantic contract per processing purpose at any given time. Historical contracts and contracts for different purposes are allowed, but their validity intervals must not result in more than one effective contract for the same user and purpose at the same instant." ;
    comon:tracedToMechanism comon:M-CONS-01,
        comon:M-TIME-01 ;
    comon:tracedToPolicy comon:P-CONS-02 .

comon:RF-34 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-34" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-34" ;
    comon:requirementStatement "The semantic contract must link the user, consent range, processing purpose and policies governing the processing." ;
    comon:tracedToMechanism comon:M-CONS-01,
        comon:M-GOV-02 ;
    comon:tracedToPolicy comon:P-CONS-03 .

comon:RF-37 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-37" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-37" ;
    comon:requirementStatement "Every resource, policy, permission, model, service or session requiring consent must declare the minimum required range through `requiresConsentRange`." ;
    comon:tracedToMechanism comon:M-CONS-03 ;
    comon:tracedToPolicy comon:P-CONS-05 .

comon:RF-39 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-39" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-39" ;
    comon:requirementStatement "The system must represent policies as explicit, queryable semantic entities." ;
    comon:tracedToMechanism comon:M-GOV-01 ;
    comon:tracedToPolicy comon:P-GOV-01 .

comon:RF-40 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-40" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-40" ;
    comon:requirementStatement "Every formal policy must be classified under exactly one semantic type: obligation, abstention or prohibition. In this model, an obligation requires an action to be performed; an abstention requires an optional action not to be performed unless explicitly enabled; a prohibition declares an action impermissible. The three types must be distinguishable and disjoint in validation." ;
    comon:tracedToMechanism comon:M-GOV-01 ;
    comon:tracedToPolicy comon:P-GOV-01 .

comon:RF-45 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-45" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-45" ;
    comon:requirementStatement "Every `NodeState` used in MAPE-K decisions must record a historical trust value." ;
    comon:tracedToMechanism comon:M-TRUST-01,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-NODE-03 .

comon:RF-57 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-57" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-57" ;
    comon:requirementStatement "Every model gradient leaving a mobile device must have undergone anonymization and noise addition." ;
    comon:tracedToMechanism comon:M-FL-03,
        comon:M-ID-01 ;
    comon:tracedToPolicy comon:P-FL-03 .

comon:RF-58 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-58" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-58" ;
    comon:requirementStatement "Every protected FL session must be linked to an explicit privacy or anonymization mechanism." ;
    comon:tracedToMechanism comon:M-FL-03,
        comon:M-ID-01 ;
    comon:tracedToPolicy comon:P-FL-05 .

comon:RF-60 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-60" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-60" ;
    comon:requirementStatement "The system must prevent raw physiological observations from leaving the local scope defined in RF-10; therefore, they must not be transmitted to Edge, Fog or Cloud nodes. Only authorized parameterized data or model updates may leave the local scope." ;
    comon:tracedToMechanism comon:M-DATA-01,
        comon:M-TX-01 ;
    comon:tracedToPolicy comon:P-DATA-01 .

comon:RF-61 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-61" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-61" ;
    comon:requirementStatement "All parameterized data, gradients or updates transmitted outside the local scope must use pseudonymous or anonymized identifiers. Direct personal identifiers must not accompany parameterized data, gradients or federated updates, and a violation query must be available to detect any breach of this rule." ;
    comon:tracedToMechanism comon:M-ID-01,
        comon:M-TX-01 ;
    comon:tracedToPolicy comon:P-DATA-02 .

comon:RF-63 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-63" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-63" ;
    comon:requirementStatement "The delegation event must record the source, destination, cause, start of validity and recovery condition. `validTo` must represent the effective closure of the delegation and may remain unset while it is active. If a planned expiration differs from the actual closure, it must be represented by an additional explicit temporal limit rather than ambiguously reusing `validTo`." ;
    comon:tracedToMechanism comon:M-DELEG-01,
        comon:M-TIME-01 ;
    comon:tracedToPolicy comon:P-AUD-02 .

comon:RF-64 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-64" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-64" ;
    comon:requirementStatement "The system must close or invalidate a delegation when the source node's recovery condition is met or its planned expiration is reached. At that point, it must record `validTo` as the effective closure time." ;
    comon:tracedToMechanism comon:M-DELEG-02 ;
    comon:tracedToPolicy comon:P-AUD-03 .

comon:RF-65 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-65" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-65" ;
    comon:requirementStatement "The system must represent detected MAPE-K symptoms and link them to policies and evaluations." ;
    comon:tracedToMechanism comon:M-AUD-02 ;
    comon:tracedToPolicy comon:P-AUD-05 .

comon:RF-69 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-69" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-69" ;
    comon:requirementStatement "Physical workers must execute registered query identifiers from the versioned SPARQL catalogue through the project worker protocol. Arbitrary client-supplied SPARQL and a public SPARQL 1.1 HTTP endpoint are outside this release." ;
    comon:tracedToMechanism comon:M-VAL-01 ;
    comon:tracedToPolicy comon:P-VAL-01 .

comon:RF-70 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-70" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-70" ;
    comon:requirementStatement "The system must provide inspection queries to list users, devices, nodes, models, states, policies, contracts, FL sessions and delegations." ;
    comon:tracedToMechanism comon:M-VAL-02 ;
    comon:tracedToPolicy comon:P-VAL-02 .

comon:RF-72 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-72" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-72" ;
    comon:requirementStatement "The system must support validation of operational and scientific scenarios through reproducible SPARQL queries, using the versioned scenario artifact required by RF-31 and the reference environment defined in RF-69." ;
    comon:tracedToMechanism comon:M-VAL-04,
        comon:M-VAL-06 ;
    comon:tracedToPolicy comon:P-VAL-07 .

comon:RNF-01 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-01" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-01" ;
    comon:requirementStatement "Local inference latency on the device or Mist tier must be ≤100 ms at the 95th percentile under the reference hardware/model profile. If a deployment requires a different value, it must explicitly declare `T_inference_local` before validation and must not change it during the acceptance campaign." ;
    comon:tracedToMechanism comon:M-OPS-01,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-OPS-01 .

comon:RNF-04 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-04" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-04" ;
    comon:requirementStatement "Basic monitoring SPARQL queries used by the MAPE-K cycle must complete within `T_sparql_monitor` at the 95th percentile over the reference dataset." ;
    comon:tracedToMechanism comon:M-OPS-01,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-OPS-01 .

comon:RNF-07 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-07" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-07" ;
    comon:requirementStatement "The architecture must allow horizontal scaling in Cloud and, when Fog infrastructure is available, in Fog, without modifying the central conceptual model." ;
    comon:tracedToMechanism comon:M-OPS-02 ;
    comon:tracedToPolicy comon:P-OPS-02 .

comon:RNF-08 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-08" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-08" ;
    comon:requirementStatement "The concurrency target must be expressed through the explicit value `N_agents` rather than ambiguous terms such as 'thousands of agents'; the load campaign must demonstrate concurrent operation with at least that number." ;
    comon:tracedToMechanism comon:M-OPS-01,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-OPS-01 .

comon:RNF-11 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-11" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-11" ;
    comon:requirementStatement "Query catalogue extensions must be introduced as versioned source changes that update the query inventory, routing plan, expectations and reference documentation together. The loader must reject inconsistent metadata; runtime insertion of arbitrary query identifiers is not supported." ;
    comon:tracedToMechanism comon:M-VAL-04,
        comon:M-VAL-05 ;
    comon:tracedToPolicy comon:P-VAL-05 .

comon:RNF-15 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-15" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-15" ;
    comon:requirementStatement "Sensitive data must be encrypted in transit and at rest according to the deployment's versioned security baseline; the acceptance campaign must verify that no channel or storage classified as sensitive operates outside that baseline." ;
    comon:tracedToMechanism comon:M-SEC-01,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-DATA-03 .

