ex:RF-01 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-01" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-01" ;
    ex:requirementStatement "El sistema debe registrar y gestionar dispositivos vestibles asociados a un individuo/agente, incluyendo al menos relojes inteligentes, anillos inteligentes y bandas inteligentes."@es .

ex:RF-02 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-02" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-02" ;
    ex:requirementStatement "El sistema debe identificar la localización aproximada del agente y el nodo de la arquitectura al que está conectado: mist, edge, fog o cloud."@es .

ex:RF-06 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-06" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-06" ;
    ex:requirementStatement "El sistema debe capturar métricas fisiológicas relevantes para estrés y sueño, incluyendo frecuencia cardíaca, HRV, actividad, sueño, movimiento, SpO2, temperatura y actividad electrodérmica cuando los sensores estén disponibles."@es .

ex:RF-11 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-11" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-11" ;
    ex:requirementStatement "El sistema debe ejecutar modelos de inferencia personalizados en el dispositivo o en capas cercanas para estimar estrés y calidad del sueño."@es .

ex:RF-12 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-12" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-12" ;
    ex:requirementStatement "El sistema debe mantener un modelo general global entrenado en la capa cloud, representado mediante conceptos generales de modelo y tier y no mediante una instancia concreta."@es .

ex:RF-13 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-13" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-13" ;
    ex:requirementStatement "El sistema debe permitir la adaptación del modelo general a modelos personalizados o degradados en capas inferiores."@es .

