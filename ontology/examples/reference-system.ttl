ex:AccelSensorA a ex:AccelerometerSensor,
        owl:NamedIndividual ;
    rdfs:label "Accelerometer - Watch A" ;
    sosa:isHostedBy ex:WatchA .

ex:AcceptanceProfile_v3_Draft a ex:AcceptanceProfile,
        owl:NamedIndividual ;
    rdfs:label "Acceptance profile v3 - draft" ;
    ex:T_inference_local 100.0 ;
    ex:artifactIdentifier "ACCEPTANCE-PROFILE-V3-DRAFT" ;
    ex:artifactStatus "draft-incomplete" ;
    rdfs:comment "Only T_inference_local=100 ms is explicitly fixed by the requirements source. Remaining thresholds, including AHP consistency threshold, must be configured before an acceptance campaign; no values are fabricated here." .

ex:AdminRole a ex:Role,
        owl:NamedIndividual ;
    rdfs:label "Administrator" ;
    ex:hasPermission ex:ManageInfrastructure,
        ex:ReadPhysiologicalData,
        ex:ReadSleepData,
        ex:TrainGlobalModel .

