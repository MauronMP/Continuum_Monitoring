mc:FL_S6_DownloadToEdge a mc:FederatedLearningSession,
        owl:NamedIndividual ;
    rdfs:label "FL Session S6 - Download to Edge" ;
    mc:containsIndividualizedGradients false ;
    mc:containsPersistentIdentifier false ;
    mc:containsPersonalData false ;
    mc:hasPayloadType mc:ImprovedModelParametersPayload ;
    mc:hasProcessingPurpose mc:PurposeLocalPrediction ;
    mc:involvedNode mc:CloudNode1,
        mc:EdgeNode1 ;
    mc:partOfScenario mc:S6 ;
    mc:requiresConsentRange mc:RangeLocalOnly ;
    mc:sessionTime "2026-05-04T04:00:00"^^xsd:dateTime ;
    mc:updatesModel mc:ModelEdge1 .

mc:FL_S6_EdgeToCloud a mc:FederatedLearningSession,
        owl:NamedIndividual ;
    rdfs:label "FL Session S6 - Global Update" ;
    mc:containsIndividualizedGradients true ;
    mc:containsPersistentIdentifier false ;
    mc:containsPersonalData false ;
    mc:hasConsentRange mc:RangeGlobalAgg ;
    mc:hasPayloadType mc:ModelGradientsPayload ;
    mc:hasPrivacyBudget 1.50 ;
    mc:hasPrivacyBudgetAccount mc:PrivacyBudgetAccount_UserA_Global ;
    mc:hasPrivacyMechanism mc:DifferentialPrivacy,
        mc:GaussianNoiseMechanism ;
    mc:hasProcessingPurpose mc:PurposeGlobalFederatedLearning ;
    mc:involvedNode mc:CloudNode1,
        mc:EdgeNode1,
        mc:FogNode1 ;
    mc:noiseLevel 0.20 ;
    mc:partOfScenario mc:S6 ;
    mc:requiresConsentRange mc:RangeGlobalAgg ;
    mc:sessionTime "2026-05-04T03:00:00"^^xsd:dateTime ;
    mc:transfersData mc:GradientUpdate_S6_A ;
    mc:updatesModel mc:ModelCloud1 .

