ex:P-MODEL-01 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Selección por adecuación, no por tier máximo" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_MODEL ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
