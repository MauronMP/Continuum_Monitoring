        owl:NamedIndividual ;
    rdfs:label "RF-47" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-47" ;
    comon:requirementStatement "Node selection must first apply eligibility constraints for availability, connectivity, consent, zone and minimum capacity. Among eligible nodes, the system must prioritize those with higher trust and avoid saturated, unstable or historically unreliable nodes." ;
