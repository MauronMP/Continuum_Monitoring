    ex:supportsPolicy ex:P-GOV-01 .

ex:M-INT-01 a ex:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Verificador de interoperabilidad semántica" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Comprobar que los artefactos utilizan los estándares declarados y registrar las alineaciones o justificaciones de conceptos propios frente a vocabularios existentes."@es ;
    ex:mechanismIdentifier "M-INT-01" ;
