        owl:NamedIndividual ;
    rdfs:label "Reevaluation of the current selection" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_MODEL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "When context, consent, contract, zone, connectivity, load or trust changes and the current selection becomes invalid, a new evaluation must start and complete within the configured reselection limit." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-MODEL-09" ;
