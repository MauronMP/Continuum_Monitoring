        owl:NamedIndividual ;
    rdfs:label "High" .

mc:LaplaceNoiseMechanism a mc:DifferentialPrivacyMechanism,
        owl:NamedIndividual ;
    rdfs:label "Laplace Noise Mechanism" .

mc:ModelLocal1 a mc:AIModel,
        owl:NamedIndividual ;
    rdfs:label "Local Model - Mobile A" ;
    mc:hasModelTier mc:LocalModelTier ;
    mc:hostedOnNode mc:MobileA ;
    mc:lastUpdated "2026-05-04T00:00:00"^^xsd:dateTime ;
    mc:modelLineageStatus "legacy-version-string-migrated; predecessor relation unavailable unless explicitly stated in source" ;
    mc:modelVersion "0.9.0" .

mc:NoWorkload a mc:WorkloadLevel,
        owl:NamedIndividual ;
    rdfs:label "No Workload" .

mc:NodeUserRel_S1_Edge1_UserA a mc:NodeUserRelation,
        owl:NamedIndividual ;
    rdfs:label "Node-User Relation S1 - Edge1/UserA" ;
    mc:hasDistance mc:Close ;
    mc:isPreferredNode true ;
