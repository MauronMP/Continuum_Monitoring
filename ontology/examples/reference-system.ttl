        mc:RNF-17,
        mc:RNF-19 .

mc:P-FL-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Upstream federated-flow authorization" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_FL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "No parameter, personalized model or gradient may be sent to higher tiers if effective authorization, the zone or privacy policies do not permit that flow type." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-FL-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-02,
        mc:M-FL-01,
        mc:M-ZONE-01 ;
    mc:relatedRequirement mc:RF-21,
