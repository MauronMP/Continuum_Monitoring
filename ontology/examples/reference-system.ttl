    mc:belongsToPolicyCategory mc:PolicyCategory_MODEL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Cloud must not be selected until effective consent, the contract, zone, node eligibility and trust have been checked. Differential privacy is additionally required when the operation involves federated learning, gradients or updates subject to that protection, but not as a generic condition for all inference." ;
    mc:hasPolicyType mc:AbstentionPolicyType ;
    mc:policyIdentifier "P-MODEL-07" ;
