    rdfs:label "Entorno de validación SPARQL" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Cargar el dataset y ejecutar la batería sobre Fuseki como referencia, permitiendo comparar endpoints equivalentes."@es ;
    ex:mechanismIdentifier "M-VAL-01" ;
    ex:supportsPolicy ex:P-VAL-01 .

ex:P-ADAPT-04 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Criterios de destino y coste de migración" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Una migración no debe ejecutarse hacia un nodo no elegible ni cuando el tiempo/coste estimado exceda los límites configurados y exista una alternativa local o de degradación que preserve mejor la continuidad. La razón de la abstención debe registrarse."@es ;
    ex:hasPolicyType ex:AbstentionPolicyType ;
    ex:policyIdentifier "P-ADAPT-04" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-ADAPT-01,
        ex:M-AUD-01,
        ex:M-NODE-02 ;
    ex:relatedRequirement ex:RF-16,
        ex:RF-17,
        ex:RNF-02 .

ex:P-ADAPT-05 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Separación de migración, delegación y aprendizaje federado" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Una migración o delegación no debe crear automáticamente una sesión de aprendizaje federado ni un intercambio de gradientes. Las sesiones FL solo se crean cuando la operación sea realmente de aprendizaje federado y satisfaga sus políticas específicas."@es ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-ADAPT-05" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-ADAPT-03,
        ex:M-FL-01 ;
    ex:relatedRequirement ex:RF-16,
        ex:RF-22,
        ex:RF-25,
        ex:RF-62 .

ex:P-ADAPT-06 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Registro de degradación y acción ejecutada" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Toda degradación de modelo o servicio debe registrar una causa explícita y vincularse a la evaluación que la provocó y a la acción finalmente ejecutada."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-ADAPT-06" ;
