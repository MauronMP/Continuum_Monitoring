ex:P-DATA-09 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Criticality-based prioritization" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_DATA ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Transmission scheduling must prioritize critical data over secondary data using a generic criticality classification. Non-transmissible or redundant data must remain retained under the applicable policy and must not displace critical data from a limited transmission window." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-DATA-09" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-BUFFER-01,
        ex:M-TX-03 ;
    ex:relatedRequirement ex:RF-27,
        ex:RF-28 .

ex:P-GOV-05 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Temporal state lifecycle" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_GOV ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Every state must be modeled as a first-class temporal entity. It must record `validFrom` upon creation and `validTo` only when it ends. A state derived from an observation must retain an explicit link to its source evidence. Planned expiration must not reuse `validTo` before effective closure." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-GOV-05" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-TIME-01 ;
    ex:relatedRequirement ex:RNF-35,
        ex:RNF-36,
        ex:RNF-37 .

ex:P-VAL-03 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Preconditions for interpreting zero rows" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_VAL ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "A zero-row result from a violation query must not be considered evidence of compliance unless correct dataset loading, the expected ontology version, minimum coverage and successful query execution have been checked first." ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-VAL-03" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-VAL-03 ;
