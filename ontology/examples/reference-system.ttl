    ex:supportsPolicy ex:P-DATA-06 .

ex:M-GOV-01 a ex:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Clasificador de tipo de política" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Validar al crear o cargar una política que tenga exactamente un tipo formal y que dicho tipo sea uno de los permitidos."@es ;
