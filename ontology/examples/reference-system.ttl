mc:AccelSensorA a mc:AccelerometerSensor,
        owl:NamedIndividual ;
    rdfs:label "Accelerometer - Watch A" ;
    sosa:isHostedBy mc:WatchA .

mc:AcceptanceProfile_v3_Draft a mc:AcceptanceProfile,
        owl:NamedIndividual ;
    rdfs:label "Acceptance profile v3 - draft" ;
    mc:T_inference_local 100.0 ;
    mc:artifactIdentifier "ACCEPTANCE-PROFILE-V3-DRAFT" ;
    mc:artifactStatus "draft-incomplete" ;
    rdfs:comment "Only T_inference_local=100 ms is explicitly fixed by the requirements source. Remaining thresholds, including AHP consistency threshold, must be configured before an acceptance campaign; no values are fabricated here." .

mc:AdminRole a mc:Role,
        owl:NamedIndividual ;
    rdfs:label "Administrator" ;
    mc:hasPermission mc:ManageInfrastructure,
        mc:ReadPhysiologicalData,
        mc:ReadSleepData,
        mc:TrainGlobalModel .

