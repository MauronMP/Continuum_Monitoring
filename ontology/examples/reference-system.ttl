comon:RF-08 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-08" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-08" ;
    comon:requirementStatement "The system must temporarily store data at the highest authorized tier when transmission is prevented by connectivity, energy, saturation, zone restrictions or consent. If effective consent or zone policy does not allow external storage, data must be retained exclusively on the device or within the authorized local scope until a safe transmission window becomes available." ;
