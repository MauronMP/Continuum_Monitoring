    mc:belongsToPolicyCategory mc:PolicyCategory_OPS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Evaluation scenarios must record the metrics needed to measure latency, energy consumption, model quality/accuracy, sleep/stress quality, migration cost, load, residual capacity and node trust." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
