        owl:NamedIndividual ;
    rdfs:label "DelegationEvent creation" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Create a delegation event with source, destination, cause, validFrom, recovery condition and planned expiration where present, leaving validTo unset while active." ;
