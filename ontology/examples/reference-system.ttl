    mc:belongsToPolicyCategory mc:PolicyCategory_VAL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "The ontology must be exposed through SPARQL 1.1. Apache Jena Fuseki is the reference environment for reproducibility; other endpoints are equivalent only if they support the features used and pass the same validation battery." ;
