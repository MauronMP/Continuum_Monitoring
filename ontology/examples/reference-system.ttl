ex:P-ZONE-02 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Rural zone: retention by default" ;
    ex:appliesInZone ex:NorthRuralZone ;
    ex:appliesToZoneType ex:RuralZone ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ZONE ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "In a rural zone, pending data must be retained locally by default and transmitted only during a safe window satisfying connectivity, energy, effective authorization and destination eligibility requirements." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-ZONE-02" ;
