    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-10" ;
    comon:requirementStatement "The maintained synthetic workload must add supported user and related instance records deterministically, without changing the ontology schema. Module import closure must remain valid. Other instance types or specializations require explicit validation before they enter the baseline." ;
    comon:tracedToMechanism comon:M-INT-02,
