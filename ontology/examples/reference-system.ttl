    ex:appliesToZoneType ex:UrbanZone ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ZONE ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "The presence of urban infrastructure does not itself authorize Edge/Fog aggregation or selection of higher tiers. Aggregation is permitted only when effective consent, the contract, active policy and destination eligibility allow it." ;
    ex:hasPolicyType ex:AbstentionPolicyType ;
    ex:policyIdentifier "P-ZONE-03" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-CONS-02,
        ex:M-NODE-02,
