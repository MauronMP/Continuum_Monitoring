    mc:belongsToPolicyCategory mc:PolicyCategory_FL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Improved models distributed to lower tiers must not include personal data, raw observations, individualized gradients or persistent user-derived identifiers. The flow must respect the contract, zone and active policies." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-FL-06" ;
    mc:policyVersion "POLICIES-REV-01" ;
