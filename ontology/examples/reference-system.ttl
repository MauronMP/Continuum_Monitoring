mc:M-DATA-01 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Raw/parameterized data classification" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Classify data before any transfer and block raw physiological observations from leaving the local scope." ;
    mc:mechanismIdentifier "M-DATA-01" ;
    mc:supportsPolicy mc:P-DATA-01 .

mc:M-DELEG-02 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Delegation closure" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Close the delegation when recovery or expiration occurs and record validTo as the effective closure." ;
    mc:mechanismIdentifier "M-DELEG-02" ;
    mc:supportsPolicy mc:P-ADAPT-08,
        mc:P-AUD-03 .

mc:P-ADAPT-03 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Overload-driven degradation" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ADAPT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Under overload, the system must apply controlled processing degradation, migration or delegation according to eligible alternatives. Scaling to higher tiers is allowed only when consent, zone, capacity and trust policies are satisfied." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-ADAPT-03" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ADAPT-01,
        mc:M-ADAPT-02,
        mc:M-OPS-02 ;
    mc:relatedRequirement mc:RF-17,
        mc:RF-20,
        mc:RNF-03 .

mc:P-CONS-03 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Minimum contract content" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_CONS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every effective semantic contract must identify the user, processing purpose, consent range, validity interval and policies governing the processing." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-CONS-03" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-01,
        mc:M-GOV-02 ;
    mc:relatedRequirement mc:RF-34,
        mc:RF-41 .

mc:P-MODEL-03 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Trust as an external criterion" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_MODEL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "The trust score or trust weight must not be included as a fourth weight in AHP normalization. It may serve as a filter, ranking criterion or documented external adjustment after eligibility is established." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-MODEL-03" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-MODEL-02,
        mc:M-TRUST-02 ;
    mc:relatedRequirement mc:RF-46,
        mc:RF-50,
        mc:RF-55,
        mc:RNF-05,
        mc:RNF-33 .

mc:P-ZONE-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Restricted zone: local confinement" ;
    mc:appliesInZone mc:CareFacility1 ;
    mc:appliesToZoneType mc:RestrictedZone ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ZONE ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "When processing originates in a restricted zone, user data and associated processing must not leave the local scope: Edge, Fog and Cloud are excluded. Receiving a generic model not derived from the user may be allowed only if an explicit zone policy authorizes inbound traffic and no user information is extracted." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-ZONE-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-02,
        mc:M-ZONE-01 ;
    mc:relatedRequirement mc:RF-42,
        mc:RF-43,
        mc:RF-53,
        mc:RNF-22 .

mc:P-ZONE-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Rural zone: retention by default" ;
    mc:appliesInZone mc:NorthRuralZone ;
    mc:appliesToZoneType mc:RuralZone ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ZONE ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "In a rural zone, pending data must be retained locally by default and transmitted only during a safe window satisfying connectivity, energy, effective authorization and destination eligibility requirements." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-ZONE-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-BUFFER-01,
        mc:M-TX-02,
        mc:M-ZONE-01 ;
    mc:relatedRequirement mc:RF-08,
        mc:RF-26,
        mc:RF-42 .

mc:P-ZONE-03 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Urban zone: conditional aggregation" ;
    mc:appliesInZone mc:CityCentreZone ;
    mc:appliesToZoneType mc:UrbanZone ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ZONE ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "The presence of urban infrastructure does not itself authorize Edge/Fog aggregation or selection of higher tiers. Aggregation is permitted only when effective consent, the contract, active policy and destination eligibility allow it." ;
    mc:hasPolicyType mc:AbstentionPolicyType ;
    mc:policyIdentifier "P-ZONE-03" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-02,
        mc:M-NODE-02,
        mc:M-ZONE-01 ;
    mc:relatedRequirement mc:RF-15,
        mc:RF-36,
        mc:RF-42 .

mc:RF-17 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-17" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-17" ;
    mc:requirementStatement "The system must migrate data, services or models when it detects low battery, excessive latency, loss of connectivity, saturation, a zone change or low trust in the current node, always within the constraints of RF-07, RF-35 and RF-42. Nodes in the `Inoperative` state must be excluded; `ComputeOnly` nodes may only be used for operations compatible with that state and must otherwise trigger delegation or isolation." ;
    mc:tracedToMechanism mc:M-ADAPT-01,
        mc:M-ADAPT-02,
        mc:M-AUD-01,
        mc:M-BUFFER-01,
        mc:M-CTX-01,
        mc:M-MODEL-04,
        mc:M-NODE-01,
        mc:M-NODE-02,
        mc:M-OPS-02 ;
    mc:tracedToPolicy mc:P-ADAPT-01,
        mc:P-ADAPT-02,
        mc:P-ADAPT-03,
        mc:P-ADAPT-04,
        mc:P-MODEL-09,
        mc:P-NODE-01,
        mc:P-OPS-02,
        mc:P-ZONE-04 .

mc:M-DELEG-01 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "DelegationEvent creation" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Create a delegation event with source, destination, cause, validFrom, recovery condition and planned expiration where present, leaving validTo unset while active." ;
    mc:mechanismIdentifier "M-DELEG-01" ;
    mc:supportsPolicy mc:P-ADAPT-07,
        mc:P-AUD-01,
        mc:P-AUD-02 .

mc:M-MODEL-02 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "AHP normalization" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Validate that latency, privacy and quality weights are normalized and that trust is not mixed into them." ;
    mc:mechanismIdentifier "M-MODEL-02" ;
    mc:supportsPolicy mc:P-MODEL-02,
        mc:P-MODEL-03 .

mc:M-NODE-01 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "NodeState monitoring" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Read node availability, load, communication, residual capacity, queue, operating status and trust." ;
    mc:mechanismIdentifier "M-NODE-01" ;
    mc:supportsPolicy mc:P-NODE-01,
        mc:P-OPS-03 .

mc:M-OPS-02 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Elasticity and load manager" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Apply horizontal scaling wherever compatible capacity exists and record degradation/migration when scaling is impossible or unauthorized." ;
    mc:mechanismIdentifier "M-OPS-02" ;
    mc:supportsPolicy mc:P-ADAPT-03,
        mc:P-OPS-02 .

mc:M-VAL-05 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Traceability matrix" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Maintain the individual links between requirements, policies, mechanisms, semantic support, queries and acceptance criteria." ;
    mc:mechanismIdentifier "M-VAL-05" ;
    mc:supportsPolicy mc:P-VAL-05,
        mc:P-VAL-06 .

mc:P-ADAPT-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Multi-condition migration decision" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ADAPT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Migration or offloading must be decided by jointly considering the adaptation cause, effective authorization, source state, destination eligibility, latency, cost, energy and service continuity. It must not be triggered solely by an isolated metric unless a safety policy makes that metric a hard constraint." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-ADAPT-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ADAPT-01,
        mc:M-NODE-02 ;
    mc:relatedRequirement mc:RF-16,
        mc:RF-17,
        mc:RF-18,
