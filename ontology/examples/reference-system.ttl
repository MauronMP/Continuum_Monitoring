    ex:belongsToPolicyCategory ex:PolicyCategory_FL ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "The epsilon budget must be controlled per operation or session according to the purpose, contract and active policy and must not exceed the maximum authorized for that context. The applied value and its consumption rule must be auditable." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-FL-04" ;
    ex:policyVersion "POLICIES-REV-01" ;
