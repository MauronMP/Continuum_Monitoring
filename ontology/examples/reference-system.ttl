    mc:supportsPolicy mc:P-MODEL-08,
        mc:P-OPS-05 .

mc:M-REPL-01 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Controlled idempotent replication" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Identify intentional replicas, version them, detect accidental duplicates and make repeated synchronization executions idempotent." ;
    mc:mechanismIdentifier "M-REPL-01" ;
    mc:supportsPolicy mc:P-ADAPT-08,
        mc:P-DATA-08 .

mc:M-TRUST-01 a mc:MechanismSpecification,
        owl:NamedIndividual ;
