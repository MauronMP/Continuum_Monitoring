    mc:tracedToMechanism mc:M-VAL-04,
        mc:M-VAL-06 ;
    mc:tracedToPolicy mc:P-VAL-07 .

mc:RNF-01 a mc:NonFunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-01" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RNF-01" ;
    mc:requirementStatement "Local inference latency on the device or Mist tier must be ≤100 ms at the 95th percentile under the reference hardware/model profile. If a deployment requires a different value, it must explicitly declare `T_inference_local` before validation and must not change it during the acceptance campaign." ;
    mc:tracedToMechanism mc:M-OPS-01,
        mc:M-VAL-04 ;
    mc:tracedToPolicy mc:P-OPS-01 .

mc:RNF-04 a mc:NonFunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-04" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RNF-04" ;
    mc:requirementStatement "Basic monitoring SPARQL queries used by the MAPE-K cycle must complete within `T_sparql_monitor` at the 95th percentile over the reference dataset." ;
    mc:tracedToMechanism mc:M-OPS-01,
        mc:M-VAL-04 ;
    mc:tracedToPolicy mc:P-OPS-01 .

mc:RNF-07 a mc:NonFunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-07" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RNF-07" ;
    mc:requirementStatement "The architecture must allow horizontal scaling in Cloud and, when Fog infrastructure is available, in Fog, without modifying the central conceptual model." ;
    mc:tracedToMechanism mc:M-OPS-02 ;
    mc:tracedToPolicy mc:P-OPS-02 .

mc:RNF-08 a mc:NonFunctionalRequirement,
