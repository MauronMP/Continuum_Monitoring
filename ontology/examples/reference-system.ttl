    ex:belongsToPolicyCategory ex:PolicyCategory_MODEL ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Cloud no debe seleccionarse hasta verificar consentimiento efectivo, contrato, zona, elegibilidad del nodo y confianza. La privacidad diferencial se exige adicionalmente cuando la operación implique aprendizaje federado, gradientes o actualizaciones sujetas a dicha protección, pero no como condición genérica para toda inferencia."@es ;
