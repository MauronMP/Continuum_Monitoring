ex:RF-01 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-01" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-01" ;
    ex:requirementStatement "The system must register and manage wearable devices associated with an individual/agent, including at least smartwatches, smart rings and smart bands." .

ex:RF-02 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-02" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-02" ;
    ex:requirementStatement "The system must identify the agent's approximate location and the architecture node to which the agent is connected: Mist, Edge, Fog or Cloud." .

ex:RF-06 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-06" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-06" ;
    ex:requirementStatement "The system must capture physiological metrics relevant to stress and sleep, including heart rate, HRV, activity, sleep, movement, SpO2, temperature and electrodermal activity when the sensors are available." .

ex:RF-11 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-11" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-11" ;
    ex:requirementStatement "The system must execute personalized inference models on the device or at nearby tiers to estimate stress and sleep quality." .

ex:RF-12 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-12" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-12" ;
    ex:requirementStatement "The system must maintain a global general model trained in the Cloud tier, represented through general model and tier concepts rather than a specific instance." .

ex:RF-13 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-13" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-13" ;
    ex:requirementStatement "The system must allow the general model to be adapted into personalized or degraded models at lower tiers." .

