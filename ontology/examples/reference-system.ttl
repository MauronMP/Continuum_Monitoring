    comon:belongsToPolicyCategory comon:PolicyCategory_ZONE ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "In a rural zone, pending data must be retained locally by default and transmitted only during a safe window satisfying connectivity, energy, effective authorization and destination eligibility requirements." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-ZONE-02" ;
    comon:policyVersion "POLICIES-REV-02" ;
