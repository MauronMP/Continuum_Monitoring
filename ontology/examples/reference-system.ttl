    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Apply horizontal scaling wherever compatible capacity exists and record degradation/migration when scaling is impossible or unauthorized." ;
    ex:mechanismIdentifier "M-OPS-02" ;
