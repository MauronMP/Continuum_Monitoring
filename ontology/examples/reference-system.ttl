mc:P-DATA-06 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Energy management for processing and transmission" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Low battery requires reduced model complexity and fewer non-critical transmissions. Critical battery requires attempting offloading only to an authorized tier with sufficient connectivity; if no authorized external option exists, local degradation and temporary retention must be applied." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-DATA-06" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ADAPT-02,
        mc:M-BUFFER-01,
        mc:M-DEVICE-01 ;
    mc:relatedRequirement mc:RF-07,
        mc:RF-27,
