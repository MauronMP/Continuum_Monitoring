mc:P-ADAPT-04 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Destination and migration-cost criteria" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ADAPT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "A migration must not target an ineligible node or proceed when estimated time/cost exceeds configured limits and a local or degraded alternative better preserves continuity. The reason for abstention must be recorded." ;
    mc:hasPolicyType mc:AbstentionPolicyType ;
    mc:policyIdentifier "P-ADAPT-04" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ADAPT-01,
        mc:M-AUD-01,
        mc:M-NODE-02 ;
    mc:relatedRequirement mc:RF-16,
        mc:RF-17,
        mc:RNF-02 .

mc:P-ADAPT-05 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Separation of migration, delegation and federated learning" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ADAPT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Migration or delegation must not automatically create a federated-learning session or gradient exchange. FL sessions are created only when the operation actually involves federated learning and satisfies its specific policies." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-ADAPT-05" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ADAPT-03,
        mc:M-FL-01 ;
    mc:relatedRequirement mc:RF-16,
        mc:RF-22,
        mc:RF-25,
        mc:RF-62 .

mc:P-ADAPT-06 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Degradation and executed-action recording" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ADAPT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every model or service degradation must record an explicit cause and link to the evaluation that triggered it and the action ultimately executed." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-ADAPT-06" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ADAPT-02,
        mc:M-AUD-01 ;
    mc:relatedRequirement mc:RF-20,
        mc:RF-44,
        mc:RF-66 .

mc:P-AUD-06 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Complete EvaluationState ticket" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_AUD ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every relevant `EvaluationState` must record, at minimum, the symptom, applied policies, contract, effective consent, evaluated alternatives, AHP scores, external trust criterion, selected tier, justification, decision time and a reference to the executed action." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-AUD-06" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-AUD-01 ;
    mc:relatedRequirement mc:RF-51,
        mc:RF-54,
        mc:RF-66,
        mc:RNF-28,
        mc:RNF-29 .

mc:P-AUD-07 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Causal and temporal decision reconstruction" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_AUD ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Persisted information must allow retrospective reconstruction of the chain user → contract → effective consent → purpose → zone → policy → node state → alternatives/scores → trust → tier → action, identifying which values were valid at the decision time." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-AUD-07" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-AUD-03,
        mc:M-TIME-01 ;
    mc:relatedRequirement mc:RF-67,
        mc:RNF-30,
        mc:RNF-32,
        mc:RNF-33 .

mc:P-CONS-06 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Downstream reception without extending consent" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_CONS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Improved generic models may be received without extending the consent range only when the downstream flow complies with the contract and active policies and contains no personal data, individualized gradients or persistent user-derived identifiers." ;
    mc:hasPolicyType mc:AbstentionPolicyType ;
    mc:policyIdentifier "P-CONS-06" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-02,
        mc:M-FL-02 ;
    mc:relatedRequirement mc:RF-23,
        mc:RF-38 .

mc:P-DATA-05 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Retention at the highest authorized tier" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "When data cannot be transmitted because of connectivity, energy, saturation, zone or authorization constraints, they must be temporarily retained at the highest tier permitted by effective authorization. If external storage is not allowed, they must remain exclusively within the local scope until a safe window or authorized disposal." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-DATA-05" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-BUFFER-01,
        mc:M-CONS-02,
        mc:M-ZONE-01 ;
    mc:relatedRequirement mc:RF-08,
        mc:RF-26,
        mc:RNF-12 .

mc:P-FL-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Federated-session eligibility" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_FL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "A federated session must not start while any required participant fails the eligibility, trust or authorization conditions applicable to the flow. If conditions can recover, the session must be deferred to a valid window." ;
    mc:hasPolicyType mc:AbstentionPolicyType ;
    mc:policyIdentifier "P-FL-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-FL-01,
        mc:M-NODE-02 ;
    mc:relatedRequirement mc:RF-21,
        mc:RF-22,
        mc:RF-25,
        mc:RNF-12 .

mc:P-FL-04 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Epsilon budget accounting" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_FL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "The epsilon budget must be controlled per operation or session according to the purpose, contract and active policy and must not exceed the maximum authorized for that context. The applied value and its consumption rule must be auditable." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-FL-04" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-AUD-01,
        mc:M-FL-04 ;
    mc:relatedRequirement mc:RF-59,
        mc:RNF-18 .

mc:P-GOV-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Explicit governance links" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_GOV ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every governed entity or decision must maintain an explicit relationship to its governing policy or policy set. Every evaluation, migration, degradation, delegation or model selection must record the specific policy applied." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-GOV-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-AUD-01,
        mc:M-GOV-02 ;
    mc:relatedRequirement mc:RF-41,
        mc:RF-44,
        mc:RNF-28,
        mc:RNF-30 .

mc:P-MODEL-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Selection by suitability, not highest tier" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_MODEL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "The system must select the most suitable tier among eligible alternatives, not the highest tier by default. The decision must first apply hard constraints and then optimize among the remaining alternatives." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-MODEL-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-MODEL-01,
        mc:M-NODE-02 ;
    mc:relatedRequirement mc:RF-15,
        mc:RF-52,
        mc:RF-53 .

mc:P-VAL-04 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Unambiguous artifact versioning" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_VAL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every validation campaign must record unambiguous versions of the ontology, policies, queries, scenarios, acceptance profile and dataset. Generic references that do not identify a specific artifact are not valid for reproducibility." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-VAL-04" ;
