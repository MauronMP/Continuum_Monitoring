mc:RF-01 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-01" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-01" ;
    mc:requirementStatement "The system must register and manage wearable devices associated with an individual/agent, including at least smartwatches, smart rings and smart bands." .

mc:RF-02 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-02" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-02" ;
    mc:requirementStatement "The system must identify the agent's approximate location and the architecture node to which the agent is connected: Mist, Edge, Fog or Cloud." .

mc:RF-06 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-06" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-06" ;
    mc:requirementStatement "The system must capture physiological metrics relevant to stress and sleep, including heart rate, HRV, activity, sleep, movement, SpO2, temperature and electrodermal activity when the sensors are available." .

mc:RF-11 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-11" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-11" ;
    mc:requirementStatement "The system must execute personalized inference models on the device or at nearby tiers to estimate stress and sleep quality." .

mc:RF-12 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-12" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-12" ;
    mc:requirementStatement "The system must maintain a global general model trained in the Cloud tier, represented through general model and tier concepts rather than a specific instance." .

mc:RF-13 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-13" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-13" ;
    mc:requirementStatement "The system must allow the general model to be adapted into personalized or degraded models at lower tiers." .

