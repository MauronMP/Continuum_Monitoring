ex:M-CTX-01 a ex:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Detección de cambios de contexto" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Detectar movilidad, cambio de zona, conectividad, carga, batería y otras variaciones capaces de invalidar una decisión."@es ;
    ex:mechanismIdentifier "M-CTX-01" ;
    ex:supportsPolicy ex:P-MODEL-09,
        ex:P-ZONE-04 .

ex:M-FL-04 a ex:MechanismSpecification,
