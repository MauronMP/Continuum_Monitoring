    ex:belongsToPolicyCategory ex:PolicyCategory_DATA ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Raw physiological observations must not leave the local scope. They must not be transmitted to Edge, Fog or Cloud. Any external processing must use explicitly authorized parameterized data or model updates." ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-DATA-01" ;
