comon:M-ADAPT-03 a comon:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Migration executor" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Execute migration as an action separate from delegation and federated learning, retaining a reference to the evaluation that authorized it." ;
    comon:mechanismIdentifier "M-ADAPT-03" ;
    comon:supportsPolicy comon:P-ADAPT-05 .

comon:M-DATA-02 a comon:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Contextual tagging" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Attach or link the minimum operational context needed to interpret each processed data item." ;
    comon:mechanismIdentifier "M-DATA-02" ;
    comon:supportsPolicy comon:P-DATA-04,
        comon:P-DATA-10 .

comon:M-METRIC-01 a comon:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Metrics instrumentation" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Record model, system and user metrics with common temporal/contextual references." ;
    comon:mechanismIdentifier "M-METRIC-01" ;
    comon:supportsPolicy comon:P-MODEL-08,
        comon:P-OPS-05 .

comon:M-REPL-01 a comon:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Controlled idempotent replication" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Identify intentional replicas, version them, detect accidental duplicates and make repeated synchronization executions idempotent." ;
    comon:mechanismIdentifier "M-REPL-01" ;
    comon:supportsPolicy comon:P-ADAPT-08,
        comon:P-DATA-08 .

comon:M-TRUST-01 a comon:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Trust calculation and update" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Update the trust score from the historical window and versioned rule, retaining evidence of the factors used." ;
    comon:mechanismIdentifier "M-TRUST-01" ;
    comon:supportsPolicy comon:P-NODE-03,
        comon:P-NODE-04 .

comon:M-VAL-01 a comon:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "SPARQL validation environment" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Load the dataset and execute the battery on Fuseki as the reference, allowing comparison with equivalent endpoints." ;
    comon:mechanismIdentifier "M-VAL-01" ;
    comon:supportsPolicy comon:P-VAL-01 .

comon:P-ADAPT-04 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Destination and migration-cost criteria" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_ADAPT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "A migration must not target an ineligible node or proceed when estimated time/cost exceeds configured limits and a local or degraded alternative better preserves continuity. The reason for abstention must be recorded." ;
    comon:hasPolicyType comon:AbstentionPolicyType ;
    comon:policyIdentifier "P-ADAPT-04" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-ADAPT-01,
        comon:M-AUD-01,
        comon:M-NODE-02 ;
    comon:relatedRequirement comon:RF-16,
        comon:RF-17,
        comon:RNF-02 .

comon:P-ADAPT-05 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Separation of migration, delegation and federated learning" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_ADAPT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Migration or delegation must not automatically create a federated-learning session or gradient exchange. FL sessions are created only when the operation actually involves federated learning and satisfies its specific policies." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-ADAPT-05" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-ADAPT-03,
        comon:M-FL-01 ;
    comon:relatedRequirement comon:RF-16,
        comon:RF-22,
        comon:RF-25,
        comon:RF-62 .

comon:P-ADAPT-06 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Degradation and executed-action recording" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_ADAPT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Every model or service degradation must record an explicit cause and link to the evaluation that triggered it and the action ultimately executed." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-ADAPT-06" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-ADAPT-02,
        comon:M-AUD-01 ;
    comon:relatedRequirement comon:RF-20,
        comon:RF-44,
        comon:RF-66 .

comon:P-AUD-06 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Complete EvaluationState ticket" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_AUD ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Every relevant `EvaluationState` must record, at minimum, the symptom, applied policies, contract, effective consent, evaluated alternatives, AHP scores, external trust criterion, selected tier, justification, decision time and a reference to the executed action." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-AUD-06" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-AUD-01 ;
    comon:relatedRequirement comon:RF-51,
        comon:RF-54,
        comon:RF-66,
        comon:RNF-28,
        comon:RNF-29 .

comon:P-AUD-07 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Causal and temporal decision reconstruction" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_AUD ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Persisted information must allow retrospective reconstruction of the chain user → contract → effective consent → purpose → zone → policy → node state → alternatives/scores → trust → tier → action, identifying which values were valid at the decision time." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-AUD-07" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-AUD-03,
        comon:M-TIME-01 ;
    comon:relatedRequirement comon:RF-67,
        comon:RNF-30,
        comon:RNF-32,
        comon:RNF-33 .

comon:P-CONS-06 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Downstream reception without extending consent" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_CONS ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Reference federated-learning session reports must expose payload type, required consent range and flags for personal data, individualized gradients and persistent identifiers. Missing fields must remain visible as missing evidence. These records do not authorize a physical model download or extend user consent." ;
    comon:hasPolicyType comon:AbstentionPolicyType ;
    comon:policyIdentifier "P-CONS-06" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-CONS-02,
        comon:M-FL-02 ;
    comon:relatedRequirement comon:RF-23,
        comon:RF-38 .

comon:P-DATA-05 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Retention at the highest authorized tier" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_DATA ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "When data cannot be transmitted because of connectivity, energy, saturation, zone or authorization constraints, they must be temporarily retained at the highest tier permitted by effective authorization. If external storage is not allowed, they must remain exclusively within the local scope until a safe window or authorized disposal." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-DATA-05" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-BUFFER-01,
        comon:M-CONS-02,
        comon:M-ZONE-01 ;
    comon:relatedRequirement comon:RF-08,
        comon:RF-26,
        comon:RNF-12 .

comon:P-FL-01 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Federated-session eligibility" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_FL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "A federated session must not start while any required participant fails the eligibility, trust or authorization conditions applicable to the flow. If conditions can recover, the session must be deferred to a valid window." ;
    comon:hasPolicyType comon:AbstentionPolicyType ;
    comon:policyIdentifier "P-FL-01" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-FL-01,
        comon:M-NODE-02 ;
    comon:relatedRequirement comon:RF-21,
        comon:RF-22,
        comon:RF-25,
        comon:RNF-12 .

comon:P-FL-04 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Epsilon budget accounting" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_FL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "The epsilon budget must be controlled per operation or session according to the purpose, contract and active policy and must not exceed the maximum authorized for that context. The applied value and its consumption rule must be auditable." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-FL-04" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-AUD-01,
        comon:M-FL-04 ;
    comon:relatedRequirement comon:RF-59,
        comon:RNF-18 .

comon:P-GOV-02 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Explicit governance links" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_GOV ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Governance evidence in the reference graph must expose governedBy for semantic contracts and appliedPolicy for evaluations with actions. Missing action-evaluation or evaluation-policy links must be reported. Other declared mechanisms are not evidence of runtime enforcement." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-GOV-02" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-AUD-01,
        comon:M-GOV-02 ;
    comon:relatedRequirement comon:RF-41,
        comon:RF-44,
        comon:RNF-28,
        comon:RNF-30 .

comon:P-MODEL-01 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Selection by suitability, not highest tier" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_MODEL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "The system must select the most suitable tier among eligible alternatives, not the highest tier by default. The decision must first apply hard constraints and then optimize among the remaining alternatives." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-MODEL-01" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-MODEL-01,
        comon:M-NODE-02 ;
    comon:relatedRequirement comon:RF-15,
        comon:RF-52,
        comon:RF-53 .

comon:P-VAL-04 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Unambiguous artifact versioning" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_VAL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Every validation campaign must record unambiguous versions of the ontology, policies, queries, scenarios, acceptance profile and dataset. Generic references that do not identify a specific artifact are not valid for reproducibility." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-VAL-04" ;
    comon:policyVersion "POLICIES-REV-02" ;
