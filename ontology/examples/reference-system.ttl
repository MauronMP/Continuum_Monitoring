    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-16" ;
    mc:requirementStatement "The system must dynamically decide when to migrate inference services between Mist, Edge, Fog and Cloud tiers." ;
