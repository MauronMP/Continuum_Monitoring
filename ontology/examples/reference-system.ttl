comon:RF-01 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-01" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-01" ;
    comon:requirementStatement "The system must register and manage wearable devices associated with an individual/agent, including at least smartwatches, smart rings and smart bands." .

comon:RF-02 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-02" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-02" ;
    comon:requirementStatement "The system must identify the agent's approximate location and the architecture node to which the agent is connected: Mist, Edge, Fog or Cloud." .

comon:RF-06 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-06" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-06" ;
    comon:requirementStatement "The system must capture physiological metrics relevant to stress and sleep, including heart rate, HRV, activity, sleep, movement, SpO2, temperature and electrodermal activity when the sensors are available." .

comon:RF-11 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-11" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-11" ;
    comon:requirementStatement "The system must execute personalized inference models on the device or at nearby tiers to estimate stress and sleep quality." .

comon:RF-12 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-12" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-12" ;
    comon:requirementStatement "The system must maintain a global general model trained in the Cloud tier, represented through general model and tier concepts rather than a specific instance." .

comon:RF-13 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-13" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-13" ;
    comon:requirementStatement "The system must allow the general model to be adapted into personalized or degraded models at lower tiers." .

