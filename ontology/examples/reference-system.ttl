ex:P-DATA-09 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Priorización por criticidad" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_DATA ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "La programación de transmisión debe priorizar datos críticos sobre datos secundarios mediante una clasificación genérica de criticidad. Los datos no transmisibles o redundantes deben permanecer retenidos según la política aplicable y no desplazar a los datos críticos de una ventana limitada."@es ;
