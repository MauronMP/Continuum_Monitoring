comon:DoctorRole a comon:Role,
        owl:NamedIndividual ;
    rdfs:label "Doctor" ;
    comon:hasPermission comon:ReadPhysiologicalData,
        comon:ReadSleepData,
        comon:ReadStressPrediction .

comon:FL_S6_DownloadToEdge a comon:FederatedLearningSession,
        owl:NamedIndividual ;
    rdfs:label "FL Session S6 - Download to Edge" ;
    comon:containsIndividualizedGradients false ;
    comon:containsPersistentIdentifier false ;
    comon:containsPersonalData false ;
    comon:hasPayloadType comon:ImprovedModelParametersPayload ;
    comon:hasProcessingPurpose comon:PurposeLocalPrediction ;
    comon:involvedNode comon:CloudNode1,
        comon:EdgeNode1 ;
    comon:partOfScenario comon:S6 ;
    comon:requiresConsentRange comon:RangeLocalOnly ;
    comon:sessionTime "2026-05-04T04:00:00"^^xsd:dateTime ;
    comon:updatesModel comon:ModelEdge1 .

comon:FL_S6_EdgeToCloud a comon:FederatedLearningSession,
        owl:NamedIndividual ;
    rdfs:label "FL Session S6 - Global Update" ;
    comon:containsIndividualizedGradients true ;
    comon:containsPersistentIdentifier false ;
    comon:containsPersonalData false ;
    comon:hasConsentRange comon:RangeGlobalAgg ;
    comon:hasPayloadType comon:ModelGradientsPayload ;
    comon:hasPrivacyBudget 1.50 ;
    comon:hasPrivacyBudgetAccount comon:PrivacyBudgetAccount_UserA_Global ;
    comon:hasPrivacyMechanism comon:DifferentialPrivacy,
        comon:GaussianNoiseMechanism ;
    comon:hasProcessingPurpose comon:PurposeGlobalFederatedLearning ;
    comon:involvedNode comon:CloudNode1,
        comon:EdgeNode1,
        comon:FogNode1 ;
    comon:noiseLevel 0.20 ;
    comon:partOfScenario comon:S6 ;
    comon:requiresConsentRange comon:RangeGlobalAgg ;
    comon:sessionTime "2026-05-04T03:00:00"^^xsd:dateTime ;
    comon:transfersData comon:GradientUpdate_S6_A ;
    comon:updatesModel comon:ModelCloud1 .

