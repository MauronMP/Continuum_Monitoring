mc:RF-07 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-07" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-07" ;
    mc:requirementStatement "The system must manage preprocessing and energy strategy according to context. When connectivity is limited or effective consent restricts processing to the local scope, data must be preprocessed on the device itself or in the Mist tier. When the battery is low, the system must reduce model complexity and non-critical transmissions; when the battery is critical, it must prioritize offloading to the highest authorized tier only if sufficient connectivity exists and consent, the contract and zone policy allow it. If the battery is critical and transfer is not authorized, it must apply local degradation and temporary retention." ;
    mc:tracedToMechanism mc:M-ADAPT-02,
        mc:M-BUFFER-01,
        mc:M-DEVICE-01 ;
    mc:tracedToPolicy mc:P-ADAPT-02,
        mc:P-DATA-06 .

mc:RF-09 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-09" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-09" ;
    mc:requirementStatement "The system must tag data with operational context: time, location, signal quality, device state, node state, processing level and purpose of use." ;
    mc:tracedToMechanism mc:M-DATA-02,
        mc:M-TIME-01,
        mc:M-TX-01 ;
    mc:tracedToPolicy mc:P-DATA-04,
        mc:P-DATA-10 .

mc:RF-18 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-18" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-18" ;
    mc:requirementStatement "The system must support computation offloading to nearby devices or Edge/Fog nodes when feasible and when it does not violate consent, zone policies or minimum trust requirements." ;
    mc:tracedToMechanism mc:M-ADAPT-01,
        mc:M-CONS-02,
        mc:M-NODE-02,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-ADAPT-01,
        mc:P-NODE-02 .

mc:RF-19 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-19" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-19" ;
    mc:requirementStatement "The system must support controlled replication and synchronization of critical data, models and federated parameters, distinguishing intentional replicas from accidental duplicates and ensuring synchronization versioning and idempotency." ;
    mc:tracedToMechanism mc:M-DELEG-02,
        mc:M-REPL-01,
        mc:M-TX-01,
        mc:M-TX-02 ;
    mc:tracedToPolicy mc:P-ADAPT-08,
        mc:P-DATA-08 .

mc:RF-20 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-20" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-20" ;
    mc:requirementStatement "Every model or service degradation must be recorded with an explicit cause." ;
    mc:tracedToMechanism mc:M-ADAPT-01,
        mc:M-ADAPT-02,
        mc:M-AUD-01,
        mc:M-OPS-02 ;
    mc:tracedToPolicy mc:P-ADAPT-03,
        mc:P-ADAPT-06 .

mc:RF-21 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-21" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-21" ;
    mc:requirementStatement "The system must allow personalized models, parameters or gradients to be sent to higher tiers for additional training when consent, zone and privacy constraints permit it." ;
    mc:tracedToMechanism mc:M-CONS-02,
        mc:M-FL-01,
        mc:M-NODE-02,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-FL-01,
        mc:P-FL-02 .

mc:RF-22 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-22" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-22" ;
    mc:requirementStatement "The system must support federated or hierarchical learning between devices and Edge, Fog and Cloud nodes." ;
    mc:tracedToMechanism mc:M-ADAPT-03,
        mc:M-FL-01,
        mc:M-NODE-02 ;
    mc:tracedToPolicy mc:P-ADAPT-05,
        mc:P-FL-01 .

mc:RF-23 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-23" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-23" ;
    mc:requirementStatement "The system must redistribute updated models to lower tiers without extending the current consent range, provided that the downstream flow complies with the semantic contract and active policies and does not carry personal data or individualized gradients." ;
    mc:tracedToMechanism mc:M-CONS-02,
        mc:M-FL-02,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-CONS-06,
        mc:P-FL-06 .

mc:RF-28 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-28" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-28" ;
    mc:requirementStatement "The system must prioritize critical data over secondary data, retaining redundant or non-transmissible data locally. Criticality must be represented through a generic classification applicable to any data; `StressCritical` may be used for stress but must not be the only prioritization mechanism." ;
    mc:tracedToMechanism mc:M-BUFFER-01,
        mc:M-REPL-01,
        mc:M-TX-01,
        mc:M-TX-03 ;
    mc:tracedToPolicy mc:P-DATA-08,
        mc:P-DATA-09 .

mc:RF-30 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-30" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-30" ;
    mc:requirementStatement "The system must correlate physiological metrics with system metrics to study interactions between human stress, computational load, energy and connectivity, using common temporal and contextual references to determine which states and observations coexisted." ;
    mc:tracedToMechanism mc:M-DATA-02,
        mc:M-METRIC-01,
        mc:M-TIME-01 ;
    mc:tracedToPolicy mc:P-DATA-10,
        mc:P-OPS-05 .

mc:RF-36 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-36" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-36" ;
    mc:requirementStatement "The system must prevent selection of models or processing tiers that exceed the user's active consent range." ;
    mc:tracedToMechanism mc:M-CONS-02,
        mc:M-GOV-03,
        mc:M-NODE-02,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-CONS-04,
        mc:P-ZONE-03 .

mc:RF-38 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-38" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-38" ;
    mc:requirementStatement "Denial or revocation of upstream personal-data transmission must not prevent users from receiving improved generic models downstream, provided that the flow contains no personal data or individualized gradients and complies with the contract and active policies. This requirement complements RF-23 and does not authorize any additional upstream transfer." ;
    mc:tracedToMechanism mc:M-CONS-02,
        mc:M-FL-02,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-CONS-06,
        mc:P-FL-06 .

mc:RF-41 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-41" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-41" ;
    mc:requirementStatement "The system must link users, nodes, zones, contracts or evaluations to specific policies through `governedBy`." ;
    mc:tracedToMechanism mc:M-AUD-01,
        mc:M-CONS-01,
        mc:M-GOV-02 ;
    mc:tracedToPolicy mc:P-CONS-03,
        mc:P-GOV-02 .

mc:RF-43 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-43" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-43" ;
    mc:requirementStatement "The system must block all processing or transfer outside the local scope defined in RF-10 when the source is in a `RestrictedZone`, including selection of Edge, Fog or Cloud tiers, unless an explicitly more restrictive policy imposes even less processing." ;
    mc:tracedToMechanism mc:M-CONS-02,
        mc:M-GOV-03,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-GOV-03,
        mc:P-ZONE-01 .

mc:RF-44 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-44" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-44" ;
    mc:requirementStatement "The system must record the specific policy applied in every evaluation, degradation, migration, delegation or model-selection decision." ;
    mc:tracedToMechanism mc:M-ADAPT-02,
        mc:M-AUD-01,
        mc:M-GOV-02 ;
    mc:tracedToPolicy mc:P-ADAPT-06,
        mc:P-GOV-02 .

mc:RF-46 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-46" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-46" ;
    mc:requirementStatement "Every evaluation that compares nodes must record a queryable trust value or weight used as a criterion external to the AHP calculation. Trust must be used to filter or rank eligible alternatives but must not be mixed with the AHP weights defined in RF-50." ;
    mc:tracedToMechanism mc:M-MODEL-02,
        mc:M-NODE-02,
        mc:M-TRUST-02 ;
    mc:tracedToPolicy mc:P-MODEL-03,
        mc:P-NODE-05 .

mc:RF-49 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-49" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-49" ;
    mc:requirementStatement "The system must update a node's trust score from historical behavior, failures, disconnections, saturation and policy violations using a documented normalized scale, time window and update rule. If latency or load contributes to trust calculation, the subsequent decision must avoid counting the same effect twice as an independent criterion without explicit justification." ;
    mc:tracedToMechanism mc:M-AUD-01,
        mc:M-TRUST-01,
        mc:M-VAL-04 ;
    mc:tracedToPolicy mc:P-NODE-03,
        mc:P-NODE-04 .

mc:RF-50 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-50" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-50" ;
    mc:requirementStatement "Every `EvaluationState` using AHP must record normalized weights for latency, privacy and model quality. Their sum must equal 1 within the configured tolerance. Trust is treated as an external criterion under RF-46 and is not part of this normalization." ;
    mc:tracedToMechanism mc:M-MODEL-02,
        mc:M-TRUST-02 ;
    mc:tracedToPolicy mc:P-MODEL-02,
        mc:P-MODEL-03 .

mc:RF-51 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-51" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-51" ;
    mc:requirementStatement "Every `EvaluationState` must record the AHP score of each evaluated tier alternative, the final selected tier and a justification that makes it possible to reconstruct why the chosen alternative outperformed the others." ;
    mc:tracedToMechanism mc:M-AUD-01,
        mc:M-MODEL-01 ;
    mc:tracedToPolicy mc:P-AUD-06,
        mc:P-MODEL-05 .

mc:RF-52 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-52" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-52" ;
    mc:requirementStatement "The system must favor local or Edge models when the privacy weight is dominant or when consent does not allow global aggregation." ;
    mc:tracedToMechanism mc:M-CONS-02,
        mc:M-MODEL-01,
        mc:M-NODE-02,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-MODEL-01,
        mc:P-MODEL-06 .

mc:RF-54 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-54" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-54" ;
    mc:requirementStatement "The system must detect incomplete evaluations that omit applicable AHP weights, scores of evaluated alternatives, the selected tier, the applied policy, the semantic contract or the justification." ;
    mc:tracedToMechanism mc:M-AUD-01,
        mc:M-MODEL-01 ;
    mc:tracedToPolicy mc:P-AUD-06,
        mc:P-MODEL-05 .

mc:RF-56 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-56" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-56" ;
    mc:requirementStatement "Every federated-learning session carrying gradients must declare a privacy budget and noise level." ;
    mc:tracedToMechanism mc:M-FL-03,
        mc:M-ID-01,
        mc:M-MODEL-01 ;
    mc:tracedToPolicy mc:P-FL-03,
        mc:P-MODEL-07 .

mc:RF-59 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-59" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-59" ;
    mc:requirementStatement "The system must control the differential-privacy epsilon budget according to the processing purpose, semantic contract and active policy." ;
    mc:tracedToMechanism mc:M-AUD-01,
        mc:M-FL-03,
        mc:M-FL-04,
        mc:M-MODEL-01 ;
    mc:tracedToPolicy mc:P-FL-04,
        mc:P-MODEL-07 .

mc:RF-67 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-67" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-67" ;
    mc:requirementStatement "The system must be able to reconstruct the complete decision chain: user → contract → effective consent → purpose → zone → policy → node state → AHP alternatives and scores → external trust → selected tier → executed action, preserving the causal and temporal relationships needed to identify which information was valid at the decision time." ;
    mc:tracedToMechanism mc:M-AUD-02,
        mc:M-AUD-03,
        mc:M-TIME-01 ;
    mc:tracedToPolicy mc:P-AUD-05,
        mc:P-AUD-07 .

mc:RF-68 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-68" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-68" ;
    mc:requirementStatement "The system must generate architecture-wide compliance metrics through SPARQL coverage and validation queries. The set of critical classes and properties must be identified by the specific ontology version loaded and recorded in the traceability matrix; it must not depend on an ambiguous reference such as 'v2.1' without identifying the corresponding artifact." ;
    mc:tracedToMechanism mc:M-GOV-04,
        mc:M-VAL-04,
        mc:M-VAL-07 ;
    mc:tracedToPolicy mc:P-VAL-04,
        mc:P-VAL-08 .

mc:RF-71 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-71" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-71" ;
    mc:requirementStatement "The system must provide violation queries whose zero-row result may be interpreted as compliance only after verifying that the required dataset is loaded, the ontology version is the expected one, minimum coverage data exist and the query executed successfully. An empty result without these preconditions is not sufficient evidence of compliance." ;
    mc:tracedToMechanism mc:M-VAL-02,
        mc:M-VAL-03 ;
    mc:tracedToPolicy mc:P-VAL-02,
        mc:P-VAL-03 .

mc:RNF-03 a mc:NonFunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-03" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RNF-03" ;
    mc:requirementStatement "Peak-load scenarios must maintain service within the limits declared in the acceptance profile and, when degradation, migration, delegation or retention is necessary, degradation must be controlled and auditable." ;
    mc:tracedToMechanism mc:M-ADAPT-01,
        mc:M-ADAPT-02,
        mc:M-NODE-02,
        mc:M-OPS-02 ;
    mc:tracedToPolicy mc:P-ADAPT-01,
        mc:P-ADAPT-03 .

