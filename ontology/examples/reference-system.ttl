    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "No pueden coexistir dos contratos semánticos efectivos para el mismo usuario, propósito e instante. Se permiten contratos históricos o contratos simultáneos para propósitos diferentes siempre que sus intervalos no produzcan ambigüedad para el mismo propósito."@es ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-CONS-02" ;
