        owl:NamedIndividual ;
    rdfs:label "Epsilon accounting" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Accumulate and validate epsilon-budget consumption by purpose, contract, session and policy." ;
    comon:mechanismIdentifier "M-FL-04" ;
    comon:supportsPolicy comon:P-FL-04 .

comon:P-ADAPT-02 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Safe degradation on communication loss or lack of destination" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_ADAPT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "When communication is lost or no eligible destination exists, the system must maintain authorized critical functions locally and degrade processing in a controlled manner before attempting an unauthorized transfer." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-ADAPT-02" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-ADAPT-02,
        comon:M-BUFFER-01 ;
    comon:relatedRequirement comon:RF-07,
        comon:RF-17,
        comon:RNF-12 .

comon:P-ADAPT-07 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Delegation to the highest-trust eligible destination" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_ADAPT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "When delegation is chosen, the preferred destination must be the highest-trust candidate among those already satisfying load, availability, connectivity, residual capacity and active constraints. Its trust score need not exceed the source's if the source degradation has another cause." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-ADAPT-07" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-DELEG-01,
        comon:M-TRUST-02 ;
    comon:relatedRequirement comon:RF-48,
        comon:RF-62,
        comon:RNF-14 .

comon:P-ADAPT-08 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Recovery continuity and idempotency" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_ADAPT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Reference ReplicationEvent and SynchronizationEvent records must declare replicationVersion and idempotencyKey; the validation query must identify missing fields. This metadata contract does not guarantee exactly-once physical delivery, durable buffering or duplicate-free migration." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-ADAPT-08" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-DELEG-02,
        comon:M-REPL-01,
        comon:M-TX-02 ;
    comon:relatedRequirement comon:RF-19,
        comon:RF-26,
        comon:RNF-02,
        comon:RNF-13 .

comon:P-DATA-02 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "External identifier pseudonymization" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_DATA ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "No direct personal identifier may leave the local scope alongside parameterized data, gradients or federated updates. Every authorized flow must use pseudonymous or anonymized identifiers appropriate to its purpose." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-DATA-02" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-ID-01,
        comon:M-TX-01 ;
    comon:relatedRequirement comon:RF-61,
        comon:RNF-17,
        comon:RNF-19 .

comon:P-FL-02 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Upstream federated-flow authorization" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_FL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "No parameter, personalized model or gradient may be sent to higher tiers if effective authorization, the zone or privacy policies do not permit that flow type." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-FL-02" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-CONS-02,
        comon:M-FL-01,
        comon:M-ZONE-01 ;
    comon:relatedRequirement comon:RF-21,
        comon:RF-35,
        comon:RF-42 .

comon:P-OPS-02 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Horizontal scaling compatible with Fog and Cloud" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_OPS ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "The scalability policy must allow horizontal scaling in Cloud and, where supporting Fog infrastructure exists, in Fog as well. Cloud must not be assumed to be the only node type capable of elasticity." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-OPS-02" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-OPS-02 ;
    comon:relatedRequirement comon:RF-17,
        comon:RNF-07 .

comon:P-OPS-06 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Restoration and safe buffer draining" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_OPS ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "A supplied recovery context must be evaluated against its configured rules, producing a fresh monitoring plan rather than automatically restoring the largest resource set or shortest sampling interval. Per-item buffer-drain authorization and physical synchronization are outside this release." ;
    comon:hasPolicyType comon:AbstentionPolicyType ;
    comon:policyIdentifier "P-OPS-06" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-BUFFER-01,
        comon:M-MODEL-04,
        comon:M-TX-02 ;
    comon:relatedRequirement comon:RF-08,
        comon:RF-15,
        comon:RF-26,
        comon:RNF-12 .

comon:P-ZONE-04 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Zone change and reevaluation" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_ZONE ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "For a supplied reference zone assignment, validation must detect a selected external tier or recorded external transfer that violates restricted-zone confinement. This is a graph-validation policy; live mobility detection and automatic invalidation before physical transmission are future work." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-ZONE-04" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-CTX-01,
        comon:M-MODEL-04 ;
    comon:relatedRequirement comon:RF-03,
        comon:RF-15,
        comon:RF-17,
        comon:RNF-21 .

comon:RF-15 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-15" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-15" ;
    comon:requirementStatement "The system must select the most suitable model tier among `LocalModelTier`, `EdgeModelTier`, `FogModelTier` and `CloudModelTier`, first applying hard constraints on consent, contracts, zones, availability and connectivity and then considering latency, privacy, model quality, load and trust among eligible alternatives. The selection must be reevaluated and replaceable when the conditions that made it valid change." ;
    comon:tracedToMechanism comon:M-BUFFER-01,
        comon:M-CONS-02,
        comon:M-CTX-01,
        comon:M-MODEL-01,
        comon:M-MODEL-04,
        comon:M-NODE-02,
        comon:M-TX-02,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-MODEL-01,
        comon:P-MODEL-09,
        comon:P-NODE-02,
        comon:P-OPS-06,
        comon:P-ZONE-03,
        comon:P-ZONE-04 .

comon:RF-42 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-42" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-42" ;
    comon:requirementStatement "The system must apply zone-specific policies: local retention in rural zones, blocking external transfers in restricted zones and aggregation in urban zones only when effective consent and the contract authorize it. When zone, consent and contract impose different constraints, the most restrictive condition must always prevail." ;
    comon:tracedToMechanism comon:M-BUFFER-01,
        comon:M-CONS-02,
        comon:M-FL-01,
        comon:M-GOV-03,
        comon:M-MODEL-01,
        comon:M-NODE-02,
        comon:M-TX-02,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-FL-02,
        comon:P-GOV-03,
        comon:P-MODEL-06,
        comon:P-ZONE-01,
        comon:P-ZONE-02,
        comon:P-ZONE-03 .

comon:RNF-39 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-39" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-39" ;
    comon:requirementStatement "Ontology, policy, query and scenario version identifiers used in a validation campaign must be recorded unambiguously to avoid references such as 'v2.1' without an associated artifact." ;
    comon:tracedToMechanism comon:M-GOV-02,
