    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RNF-13" ;
    mc:requirementStatement "Reconnection, synchronization, migration and delegation processes must not lose critical events or create accidental duplicates; repeated executions must be idempotent where applicable." ;
