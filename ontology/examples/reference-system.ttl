    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RNF-06" ;
    mc:requirementStatement "Device energy consumption under the reference scenario must remain within `E_device_max`, with consumption or its effect on battery life recorded reproducibly. Low-battery strategies must not increase non-critical transmissions relative to normal mode." ;
