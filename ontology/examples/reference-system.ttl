mc:P-GOV-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Unique policy typing" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_GOV ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every formal system policy must be represented as an explicit entity and classified under exactly one of obligation, abstention or prohibition. The types must be mutually distinguishable, and no formal policy may be assigned more than one type." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-GOV-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-GOV-01 ;
    mc:relatedRequirement mc:RF-39,
        mc:RF-40 .

mc:P-INT-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Use of open semantic standards" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_INT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Semantic representation and querying must use open standards compatible with RDF/OWL/Turtle and SPARQL 1.1. An applicable standard vocabulary, including SOSA/SSN, SAREF, FOAF or GeoSPARQL, must be reused or aligned with; any conceptual duplication must be documented and justified." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-INT-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-INT-01,
        mc:M-VAL-01 ;
    mc:relatedRequirement mc:RNF-24,
        mc:RNF-25,
        mc:RNF-26 .

mc:P-INT-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Extensibility without breaking the conceptual core" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_INT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Adding new users, nodes, sensors, models, policies, contracts or wearable types must not require changing central conceptual abstractions already used by reference scenarios, unless an incompatible major-version change is explicitly declared." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-INT-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-INT-02,
        mc:M-VAL-05 ;
    mc:relatedRequirement mc:RNF-10,
        mc:RNF-23,
