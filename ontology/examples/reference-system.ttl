    ex:belongsToPolicyCategory ex:PolicyCategory_DATA ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Pending flows must not resume merely because connectivity returns. Synchronization or transmission may restart only when sufficient connectivity, effective authorization, an eligible destination and compatible energy conditions hold simultaneously." ;
    ex:hasPolicyType ex:AbstentionPolicyType ;
