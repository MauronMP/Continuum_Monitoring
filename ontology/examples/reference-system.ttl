mc:P-ZONE-04 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Zone change and reevaluation" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ZONE ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every zone change that may alter authorization or tier eligibility must invalidate the previous decision and trigger reevaluation before new flows or external processing continue." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
