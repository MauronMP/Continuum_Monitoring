    rdfs:label "Contabilidad epsilon" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Acumular y validar el consumo del presupuesto epsilon por propósito, contrato, sesión y política."@es ;
    ex:mechanismIdentifier "M-FL-04" ;
    ex:supportsPolicy ex:P-FL-04 .

ex:P-ADAPT-02 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Degradación segura ante pérdida de comunicación o falta de destino" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Ante pérdida de comunicación o ausencia de destinos elegibles, el sistema debe mantener las funciones críticas autorizadas localmente y degradar el procesamiento de forma controlada antes de intentar una transferencia no autorizada."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-ADAPT-02" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-ADAPT-02,
        ex:M-BUFFER-01 ;
    ex:relatedRequirement ex:RF-07,
        ex:RF-17,
        ex:RNF-12 .

ex:P-ADAPT-07 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Delegación a destino elegible de mayor confianza" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Cuando se decida delegar, debe elegirse preferentemente el destino con mayor confianza entre los candidatos que ya cumplen carga, disponibilidad, conectividad, capacidad residual y restricciones activas. No se exige que su trust score sea superior al del origen si la degradación del origen tiene otra causa."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-ADAPT-07" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-DELEG-01,
        ex:M-TRUST-02 ;
    ex:relatedRequirement ex:RF-48,
        ex:RF-62,
        ex:RNF-14 .

ex:P-ADAPT-08 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Continuidad e idempotencia de recuperación" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Los procesos de migración, delegación, reconexión y recuperación no pueden producir pérdida de eventos críticos ni duplicados accidentales. Las operaciones reintentables deben disponer de semántica idempotente cuando corresponda."@es ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-ADAPT-08" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-DELEG-02,
        ex:M-REPL-01,
        ex:M-TX-02 ;
    ex:relatedRequirement ex:RF-19,
        ex:RF-26,
        ex:RNF-02,
        ex:RNF-13 .

ex:P-DATA-02 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Pseudonimización de identificadores externos" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_DATA ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Ningún identificador personal directo puede viajar fuera del ámbito local junto con datos parametrizados, gradientes o actualizaciones federadas. Todo flujo autorizado debe utilizar identificadores pseudónimos o anonimizados adecuados a su finalidad."@es ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-DATA-02" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-ID-01,
        ex:M-TX-01 ;
    ex:relatedRequirement ex:RF-61,
        ex:RNF-17,
        ex:RNF-19 .

ex:P-FL-02 a ex:Policy,
        owl:NamedIndividual ;
