ex:RF-08 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-08" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-08" ;
    ex:requirementStatement "The system must temporarily store data at the highest authorized tier when transmission is prevented by connectivity, energy, saturation, zone restrictions or consent. If effective consent or zone policy does not allow external storage, data must be retained exclusively on the device or within the authorized local scope until a safe transmission window becomes available." ;
    ex:tracedToMechanism ex:M-BUFFER-01,
        ex:M-CONS-02,
        ex:M-MODEL-04,
        ex:M-TX-02,
        ex:M-ZONE-01 ;
    ex:tracedToPolicy ex:P-DATA-05,
        ex:P-OPS-06,
        ex:P-ZONE-02 .

