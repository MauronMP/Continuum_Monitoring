mc:P-FL-08 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Model versioning and rollback" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_FL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every model update must produce an identifiable version and record its update date. Rollback to a previous version must remain possible in the event of degradation, errors or policy non-compliance." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-FL-08" ;
