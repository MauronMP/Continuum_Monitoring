comon:AccelSensorA a comon:AccelerometerSensor,
        owl:NamedIndividual ;
    rdfs:label "Accelerometer - Watch A" ;
    sosa:isHostedBy comon:WatchA .

comon:AcceptanceProfile_v3_Draft a comon:AcceptanceProfile,
        owl:NamedIndividual ;
    rdfs:label "Acceptance profile v3 - draft" ;
    comon:T_inference_local 100.0 ;
    comon:artifactIdentifier "ACCEPTANCE-PROFILE-V3-DRAFT" ;
    comon:artifactStatus "draft-incomplete" ;
    rdfs:comment "Only T_inference_local=100 ms is explicitly fixed by the requirements source. Remaining thresholds, including AHP consistency threshold, must be configured before an acceptance campaign; no values are fabricated here." .

comon:AdminRole a comon:Role,
        owl:NamedIndividual ;
    rdfs:label "Administrator" ;
    comon:hasPermission comon:ManageInfrastructure,
        comon:ReadPhysiologicalData,
        comon:ReadSleepData,
        comon:TrainGlobalModel .

