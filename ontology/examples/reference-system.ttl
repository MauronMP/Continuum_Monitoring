mc:P-CONS-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Range-based consent and revocation" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_CONS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Consent must be expressed through processing ranges covering at least local scope, community aggregation, global aggregation and denial/revocation. It must be possible to specify data categories, purpose, validity interval and maximum authorized range." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-CONS-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-01 ;
    mc:relatedRequirement mc:RF-32 .

mc:P-CONS-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Unique effective contract per user and purpose" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_CONS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Two effective semantic contracts must not coexist for the same user, purpose and instant. Historical contracts or simultaneous contracts for different purposes are allowed provided their intervals do not create ambiguity for the same purpose." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-CONS-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-01,
        mc:M-TIME-01 ;
    mc:relatedRequirement mc:RF-33,
        mc:RNF-36 .

mc:P-DATA-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Confinement of raw physiological observations" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Raw physiological observations must not leave the local scope. They must not be transmitted to Edge, Fog or Cloud. Any external processing must use explicitly authorized parameterized data or model updates." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-DATA-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-DATA-01,
        mc:M-TX-01 ;
    mc:relatedRequirement mc:RF-10,
        mc:RF-60,
        mc:RNF-17 .

mc:P-DATA-07 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Safe transmission and reconnection window" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Pending flows must not resume merely because connectivity returns. Synchronization or transmission may restart only when sufficient connectivity, effective authorization, an eligible destination and compatible energy conditions hold simultaneously." ;
    mc:hasPolicyType mc:AbstentionPolicyType ;
    mc:policyIdentifier "P-DATA-07" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-02,
        mc:M-NODE-02,
        mc:M-TX-02 ;
    mc:relatedRequirement mc:RF-26,
