comon:RF-68 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-68" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-68" ;
    comon:requirementStatement "The system must generate architecture-wide compliance metrics through SPARQL coverage and validation queries. The set of critical classes and properties must be identified by the specific ontology version loaded and recorded in the traceability matrix; it must not depend on an ambiguous reference such as 'v2.1' without identifying the corresponding artifact." ;
    comon:tracedToMechanism comon:M-GOV-04,
        comon:M-VAL-04,
        comon:M-VAL-07 ;
    comon:tracedToPolicy comon:P-VAL-04,
        comon:P-VAL-08 .

comon:RF-71 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-71" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-71" ;
    comon:requirementStatement "The system must provide violation queries whose zero-row result may be interpreted as compliance only after verifying that the required dataset is loaded, the ontology version is the expected one, minimum coverage data exist and the query executed successfully. An empty result without these preconditions is not sufficient evidence of compliance." ;
    comon:tracedToMechanism comon:M-VAL-02,
        comon:M-VAL-03 ;
    comon:tracedToPolicy comon:P-VAL-02,
        comon:P-VAL-03 .

comon:RNF-03 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-03" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-03" ;
    comon:requirementStatement "Bounded monitoring experiments must record completion, timeout and failure separately. With keep-going enabled, independent later points must remain eligible for execution under the configured skip rules. These measurements do not guarantee service-level acceptance or automatic physical degradation." ;
    comon:tracedToMechanism comon:M-ADAPT-01,
        comon:M-ADAPT-02,
        comon:M-NODE-02,
        comon:M-OPS-02 ;
    comon:tracedToPolicy comon:P-ADAPT-01,
        comon:P-ADAPT-03 .

comon:RNF-05 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
