    ex:hasPolicyStatement "Persisted information must allow retrospective reconstruction of the chain user → contract → effective consent → purpose → zone → policy → node state → alternatives/scores → trust → tier → action, identifying which values were valid at the decision time." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-AUD-07" ;
