    ex:relatedRequirement ex:RF-33,
        ex:RNF-36 .

ex:P-DATA-01 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Confinamiento de observaciones fisiológicas crudas" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_DATA ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
