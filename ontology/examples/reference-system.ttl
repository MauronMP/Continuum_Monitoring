    comon:requirementIdentifier "RNF-18" ;
    comon:requirementStatement "The differential-privacy budget must be explicit and auditable for all applicable operations, including its links to purpose, contract and policy." ;
    comon:tracedToMechanism comon:M-AUD-01,
        comon:M-FL-04 ;
    comon:tracedToPolicy comon:P-FL-04 .

comon:RNF-20 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-20" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-20" ;
    comon:requirementStatement "Adaptation policies must be configurable or versionable without modifying the ontology's central conceptual structure." ;
    comon:tracedToMechanism comon:M-GOV-02,
        comon:M-GOV-04,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-GOV-04 .

comon:RNF-23 a comon:NonFunctionalRequirement,
