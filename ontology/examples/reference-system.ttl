ex:P-DATA-05 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Retention at the highest authorized tier" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_DATA ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "When data cannot be transmitted because of connectivity, energy, saturation, zone or authorization constraints, they must be temporarily retained at the highest tier permitted by effective authorization. If external storage is not allowed, they must remain exclusively within the local scope until a safe window or authorized disposal." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-DATA-05" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-BUFFER-01,
