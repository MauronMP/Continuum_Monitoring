        owl:NamedIndividual ;
    rdfs:label "RF-60" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-60" ;
    ex:requirementStatement "The system must prevent raw physiological observations from leaving the local scope defined in RF-10; therefore, they must not be transmitted to Edge, Fog or Cloud nodes. Only authorized parameterized data or model updates may leave the local scope." ;
    ex:tracedToMechanism ex:M-DATA-01,
