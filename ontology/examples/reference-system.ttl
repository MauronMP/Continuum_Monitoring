    rdfs:label "RF-48" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-48" ;
    comon:requirementStatement "Every delegation must preferentially select, among eligible destinations, the node with the highest trust compatible with load, availability, connectivity, residual capacity and active constraints. The destination is not required to have a higher trust score than the source node when the source degradation has a cause other than trust." ;
