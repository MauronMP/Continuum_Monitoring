    mc:mechanismIdentifier "M-TRUST-01" ;
    mc:supportsPolicy mc:P-NODE-03,
        mc:P-NODE-04 .

mc:M-VAL-01 a mc:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "SPARQL validation environment" ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:mechanismDescription "Load the dataset and execute the battery on Fuseki as the reference, allowing comparison with equivalent endpoints." ;
    mc:mechanismIdentifier "M-VAL-01" ;
