    ex:hasPolicyStatement "El trust score o peso de confianza no puede incorporarse como cuarto peso dentro de la normalización AHP. Puede utilizarse como filtro, criterio de ordenación o ajuste externo documentado después de establecer la elegibilidad."@es ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
