ex:P-CONS-02 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Unique effective contract per user and purpose" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_CONS ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Two effective semantic contracts must not coexist for the same user, purpose and instant. Historical contracts or simultaneous contracts for different purposes are allowed provided their intervals do not create ambiguity for the same purpose." ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-CONS-02" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-CONS-01,
        ex:M-TIME-01 ;
    ex:relatedRequirement ex:RF-33,
        ex:RNF-36 .

ex:P-DATA-01 a ex:Policy,
        owl:NamedIndividual ;
