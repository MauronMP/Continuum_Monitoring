ex:P-AUD-01 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Delegation as a semantic event" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_AUD ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Every temporary delegation must be materialized as an explicit event, not merely as a static relationship between nodes." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-AUD-01" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-DELEG-01 ;
    ex:relatedRequirement ex:RF-62 .

ex:P-AUD-03 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Effective delegation closure" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_AUD ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "A delegation must close when its recovery condition is met or its planned expiration is reached. Closure must record `validTo` with the effective time and stop any new action based on the ended delegation." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-AUD-03" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-DELEG-02 ;
    ex:relatedRequirement ex:RF-64,
        ex:RNF-36 .

ex:P-AUD-04 a ex:Policy,
