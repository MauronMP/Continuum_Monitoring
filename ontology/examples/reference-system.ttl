mc:RF-35 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-35" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-35" ;
    mc:requirementStatement "The system must detect inconsistencies between the user's active consent and the range declared in the current semantic contract. Effective authorization must correspond to the most restrictive intersection of active consent, the contract and zone policy; while an inconsistency remains unresolved, external processing that could exceed any of those constraints must be blocked." ;
    mc:tracedToMechanism mc:M-CONS-02,
        mc:M-FL-01,
        mc:M-GOV-03,
        mc:M-MODEL-01,
