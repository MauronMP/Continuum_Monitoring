        mc:M-TX-02,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-MODEL-01,
        mc:P-MODEL-09,
        mc:P-NODE-02,
        mc:P-OPS-06,
        mc:P-ZONE-03,
        mc:P-ZONE-04 .

mc:RF-42 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-42" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-42" ;
    mc:requirementStatement "The system must apply zone-specific policies: local retention in rural zones, blocking external transfers in restricted zones and aggregation in urban zones only when effective consent and the contract authorize it. When zone, consent and contract impose different constraints, the most restrictive condition must always prevail." ;
    mc:tracedToMechanism mc:M-BUFFER-01,
        mc:M-CONS-02,
