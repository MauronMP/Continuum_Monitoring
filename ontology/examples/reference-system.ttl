    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-CONS-01 ;
    ex:relatedRequirement ex:RF-32 .

ex:P-CONS-02 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Contrato efectivo único por usuario y propósito" ;
