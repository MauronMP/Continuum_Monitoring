ex:M-INT-02 a ex:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Validador de extensibilidad" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Comprobar que la incorporación de nuevas instancias o especializaciones no altera las abstracciones centrales ni rompe los escenarios de referencia salvo cambio mayor explícito."@es ;
    ex:mechanismIdentifier "M-INT-02" ;
    ex:supportsPolicy ex:P-INT-02 .

ex:M-MODEL-03 a ex:MechanismSpecification,
