    mc:belongsToPolicyCategory mc:PolicyCategory_OPS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "A new Edge or Fog node must be able to register and enter evaluation without stopping the entire system and within the `T_node_join` limit set in the acceptance profile." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
