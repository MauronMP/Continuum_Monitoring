    mc:relatedRequirement mc:RV-04,
        mc:RV-05 .

mc:RF-08 a mc:FunctionalRequirement,
        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-08" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RF-08" ;
    mc:requirementStatement "The system must temporarily store data at the highest authorized tier when transmission is prevented by connectivity, energy, saturation, zone restrictions or consent. If effective consent or zone policy does not allow external storage, data must be retained exclusively on the device or within the authorized local scope until a safe transmission window becomes available." ;
    mc:tracedToMechanism mc:M-BUFFER-01,
        mc:M-CONS-02,
        mc:M-MODEL-04,
        mc:M-TX-02,
        mc:M-ZONE-01 ;
    mc:tracedToPolicy mc:P-DATA-05,
        mc:P-OPS-06,
        mc:P-ZONE-02 .

