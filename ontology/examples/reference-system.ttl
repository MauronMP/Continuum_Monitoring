ex:P-FL-01 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Federated-session eligibility" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_FL ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "A federated session must not start while any required participant fails the eligibility, trust or authorization conditions applicable to the flow. If conditions can recover, the session must be deferred to a valid window." ;
    ex:hasPolicyType ex:AbstentionPolicyType ;
    ex:policyIdentifier "P-FL-01" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-FL-01,
