    mc:belongsToPolicyCategory mc:PolicyCategory_OPS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "During partial failures, critical functions authorized for local execution must remain operational and pending data/events must retain integrity until synchronization or authorized disposal." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-OPS-04" ;
