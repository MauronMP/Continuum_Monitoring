ex:M-ADAPT-03 a ex:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Ejecutor de migración" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Ejecutar la migración como una acción independiente de delegación y de aprendizaje federado, conservando referencia a la evaluación que la autorizó."@es ;
    ex:mechanismIdentifier "M-ADAPT-03" ;
    ex:supportsPolicy ex:P-ADAPT-05 .

