    comon:hasPolicyStatement "The presence of urban infrastructure does not itself authorize Edge/Fog aggregation or selection of higher tiers. Aggregation is permitted only when effective consent, the contract, active policy and destination eligibility allow it." ;
    comon:hasPolicyType comon:AbstentionPolicyType ;
