ex:RF-08 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-08" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-08" ;
    ex:requirementStatement "El sistema debe almacenar temporalmente los datos en la capa más alta autorizada cuando no sea posible transmitirlos por conectividad, energía, saturación, zona o consentimiento. Si el consentimiento efectivo o la política de zona no permiten almacenamiento externo, los datos deben conservarse exclusivamente en el dispositivo o ámbito local autorizado hasta que exista una ventana segura de transmisión."@es ;
    ex:tracedToMechanism ex:M-BUFFER-01,
        ex:M-CONS-02,
        ex:M-MODEL-04,
        ex:M-TX-02,
        ex:M-ZONE-01 ;
