ex:M-OPS-01 a ex:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Gestor de perfil de aceptación" ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Cargar y congelar los umbrales configurables de una campaña de aceptación junto con su versión."@es ;
    ex:mechanismIdentifier "M-OPS-01" ;
    ex:supportsPolicy ex:P-OPS-01 .

ex:P-OPS-01 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Perfil de aceptación versionado" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_OPS ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Antes de una campaña de aceptación deben fijarse y versionarse los umbrales operativos exigidos por los RNF, incluyendo como mínimo latencia local, interrupción máxima de migración, tiempo de monitorización SPARQL, tiempo de decisión, consumo energético, concurrencia, incorporación de nodos, profundidad de delegación y tiempo de reselección."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-OPS-01" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-OPS-01,
        ex:M-VAL-04 ;
    ex:relatedRequirement ex:RNF-01,
        ex:RNF-02,
        ex:RNF-04,
        ex:RNF-05,
        ex:RNF-06,
        ex:RNF-08,
        ex:RNF-09,
        ex:RNF-14,
        ex:RNF-21,
        ex:RNF-39 .

