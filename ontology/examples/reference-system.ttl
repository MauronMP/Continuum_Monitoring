    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "El consentimiento debe expresarse mediante rangos de procesamiento que contemplen al menos ámbito local, agregación comunitaria, agregación global y denegación/revocación. Deben poder especificarse categorías de datos, propósito, intervalo de validez y rango máximo autorizado."@es ;
