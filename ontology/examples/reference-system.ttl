    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-09" ;
    comon:requirementStatement "Onboarding a new Edge or Fog node must not require stopping the entire system, and the node must become available for evaluation within `T_node_join` after registration and validation are complete." ;
