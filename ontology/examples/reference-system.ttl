    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "The trust score or trust weight must not be included as a fourth weight in AHP normalization. It may serve as a filter, ranking criterion or documented external adjustment after eligibility is established." ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-MODEL-03" ;
