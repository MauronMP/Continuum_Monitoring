ex:FL_S6_DownloadToEdge a ex:FederatedLearningSession,
        owl:NamedIndividual ;
    rdfs:label "FL Session S6 - Download to Edge" ;
    ex:containsIndividualizedGradients false ;
    ex:containsPersistentIdentifier false ;
    ex:containsPersonalData false ;
    ex:hasPayloadType ex:ImprovedModelParametersPayload ;
    ex:hasProcessingPurpose ex:PurposeLocalPrediction ;
    ex:involvedNode ex:CloudNode1,
        ex:EdgeNode1 ;
    ex:partOfScenario ex:S6 ;
    ex:requiresConsentRange ex:RangeLocalOnly ;
    ex:sessionTime "2026-05-04T04:00:00"^^xsd:dateTime ;
    ex:updatesModel ex:ModelEdge1 .

ex:FL_S6_EdgeToCloud a ex:FederatedLearningSession,
        owl:NamedIndividual ;
    rdfs:label "FL Session S6 - Global Update" ;
    ex:containsIndividualizedGradients true ;
    ex:containsPersistentIdentifier false ;
    ex:containsPersonalData false ;
    ex:hasConsentRange ex:RangeGlobalAgg ;
    ex:hasPayloadType ex:ModelGradientsPayload ;
    ex:hasPrivacyBudget 1.50 ;
    ex:hasPrivacyBudgetAccount ex:PrivacyBudgetAccount_UserA_Global ;
    ex:hasPrivacyMechanism ex:DifferentialPrivacy,
        ex:GaussianNoiseMechanism ;
    ex:hasProcessingPurpose ex:PurposeGlobalFederatedLearning ;
    ex:involvedNode ex:CloudNode1,
        ex:EdgeNode1,
        ex:FogNode1 ;
    ex:noiseLevel 0.20 ;
    ex:partOfScenario ex:S6 ;
    ex:requiresConsentRange ex:RangeGlobalAgg ;
    ex:sessionTime "2026-05-04T03:00:00"^^xsd:dateTime ;
    ex:transfersData ex:GradientUpdate_S6_A ;
    ex:updatesModel ex:ModelCloud1 .

