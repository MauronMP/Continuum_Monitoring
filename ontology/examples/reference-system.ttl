    comon:requirementStatement "Every tier selection must include a readable semantic justification, the evaluated alternatives and their scores, so that the decision can be explained without inferring missing information." ;
    comon:tracedToMechanism comon:M-AUD-01,
        comon:M-MODEL-01 ;
