comon:M-DATA-01 a comon:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Raw/parameterized data classification" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Classify data before any transfer and block raw physiological observations from leaving the local scope." ;
    comon:mechanismIdentifier "M-DATA-01" ;
    comon:supportsPolicy comon:P-DATA-01 .

comon:M-DELEG-02 a comon:MechanismSpecification,
        owl:NamedIndividual ;
    rdfs:label "Delegation closure" ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:mechanismDescription "Close the delegation when recovery or expiration occurs and record validTo as the effective closure." ;
    comon:mechanismIdentifier "M-DELEG-02" ;
    comon:supportsPolicy comon:P-ADAPT-08,
        comon:P-AUD-03 .

comon:P-ADAPT-03 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Overload-driven degradation" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_ADAPT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Under overload, the system must apply controlled processing degradation, migration or delegation according to eligible alternatives. Scaling to higher tiers is allowed only when consent, zone, capacity and trust policies are satisfied." ;
