mc:P-ADAPT-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Safe degradation on communication loss or lack of destination" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ADAPT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "When communication is lost or no eligible destination exists, the system must maintain authorized critical functions locally and degrade processing in a controlled manner before attempting an unauthorized transfer." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-ADAPT-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ADAPT-02,
        mc:M-BUFFER-01 ;
    mc:relatedRequirement mc:RF-07,
        mc:RF-17,
        mc:RNF-12 .

mc:P-ADAPT-07 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Delegation to the highest-trust eligible destination" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ADAPT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "When delegation is chosen, the preferred destination must be the highest-trust candidate among those already satisfying load, availability, connectivity, residual capacity and active constraints. Its trust score need not exceed the source's if the source degradation has another cause." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-ADAPT-07" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-DELEG-01,
        mc:M-TRUST-02 ;
    mc:relatedRequirement mc:RF-48,
        mc:RF-62,
        mc:RNF-14 .

mc:P-ADAPT-08 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Recovery continuity and idempotency" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_ADAPT ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Migration, delegation, reconnection and recovery processes must not lose critical events or create accidental duplicates. Retryable operations must have idempotent semantics where applicable." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-ADAPT-08" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-DELEG-02,
        mc:M-REPL-01,
        mc:M-TX-02 ;
    mc:relatedRequirement mc:RF-19,
        mc:RF-26,
        mc:RNF-02,
        mc:RNF-13 .

mc:P-DATA-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "External identifier pseudonymization" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "No direct personal identifier may leave the local scope alongside parameterized data, gradients or federated updates. Every authorized flow must use pseudonymous or anonymized identifiers appropriate to its purpose." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-DATA-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ID-01,
        mc:M-TX-01 ;
