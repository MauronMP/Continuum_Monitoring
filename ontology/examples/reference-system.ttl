        mc:RV-02 .

mc:P-VAL-06 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Individual requirement traceability" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_VAL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "The final documentation must maintain an individual matrix linking every RF, RNF and RV to applicable policies, responsible mechanisms, semantic or standard support, queries/validations and acceptance criteria." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
