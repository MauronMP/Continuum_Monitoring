    ex:relatedRequirement ex:RF-27,
        ex:RF-28 .

ex:P-GOV-05 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Ciclo temporal de estados" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_GOV ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Todo estado debe modelarse como una entidad temporal de primera clase. Debe registrar `validFrom` al crearse y `validTo` únicamente cuando finalice. Cuando el estado derive de una observación, debe conservar un enlace explícito a la evidencia de origen. Una expiración planificada no debe reutilizar `validTo` antes del cierre efectivo."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-GOV-05" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-TIME-01 ;
    ex:relatedRequirement ex:RNF-35,
        ex:RNF-36,
        ex:RNF-37 .

