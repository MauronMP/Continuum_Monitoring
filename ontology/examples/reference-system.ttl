        comon:RNF-36 .

comon:P-GOV-01 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Unique policy typing" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_GOV ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Every formal system policy must be represented as an explicit entity and classified under exactly one of obligation, abstention or prohibition. The types must be mutually distinguishable, and no formal policy may be assigned more than one type." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-GOV-01" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-GOV-01 ;
    comon:relatedRequirement comon:RF-39,
        comon:RF-40 .

comon:P-INT-01 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Use of open semantic standards" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_INT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Semantic representation and querying must use open standards compatible with RDF/OWL/Turtle and SPARQL 1.1. An applicable standard vocabulary, including SOSA/SSN, SAREF, FOAF or GeoSPARQL, must be reused or aligned with; any conceptual duplication must be documented and justified." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-INT-01" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-INT-01,
        comon:M-VAL-01 ;
    comon:relatedRequirement comon:RNF-24,
        comon:RNF-25,
        comon:RNF-26 .

comon:P-INT-02 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Extensibility without breaking the conceptual core" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_INT ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Adding new users, nodes, sensors, models, policies, contracts or wearable types must not require changing central conceptual abstractions already used by reference scenarios, unless an incompatible major-version change is explicitly declared." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-INT-02" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-INT-02,
        comon:M-VAL-05 ;
    comon:relatedRequirement comon:RNF-10,
        comon:RNF-23,
        comon:RNF-38 .

comon:P-MODEL-04 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "AHP method consistency" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_MODEL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "An evaluation labeled as AHP must not be considered valid if its weights are not normalized or its consistency ratio exceeds the configured threshold. If pairwise comparisons and consistency checking are not used, the decision must be labeled as weighted multicriteria scoring rather than AHP." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-MODEL-04" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-MODEL-03 ;
    comon:relatedRequirement comon:RF-55,
        comon:RNF-34 .

comon:P-MODEL-06 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Privacy priority" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_MODEL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "When privacy is the dominant criterion or effective consent limits aggregation, the decision must favor local or Edge tiers only if Edge remains authorized. A hard constraint always takes precedence over a quality score." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-MODEL-06" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-CONS-02,
        comon:M-MODEL-01,
        comon:M-ZONE-01 ;
    comon:relatedRequirement comon:RF-35,
        comon:RF-42,
        comon:RF-52 .

comon:P-MODEL-08 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Separation of observed quality and decision weights" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_MODEL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Prediction confidence, estimated error, local feedback and observed model quality must be recorded as independent evaluation metrics. AHP weights must not substitute for these metrics." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-MODEL-08" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-AUD-01,
        comon:M-METRIC-01 ;
    comon:relatedRequirement comon:RF-14,
        comon:RNF-27 .

comon:P-NODE-04 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Trust updates and double counting" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_NODE ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "The trust-update rule may consider failures, disconnections, saturation and policy violations, but must not cause the same latency or load effect to be counted again as an independent criterion in a subsequent decision without explicit justification." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-NODE-04" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-AUD-01,
        comon:M-TRUST-01 ;
    comon:relatedRequirement comon:RF-49,
        comon:RNF-32,
        comon:RNF-33 .

comon:P-NODE-06 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Absence of trustworthy alternatives" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_NODE ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "If no configured resource tier matches the active monitoring rules, the policy engine must return an empty resource selection rather than silently selecting a higher tier. This is a planning boundary, not an operational trust assessment or a physical retention actuator." ;
    comon:hasPolicyType comon:AbstentionPolicyType ;
    comon:policyIdentifier "P-NODE-06" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-ADAPT-02,
        comon:M-AUD-01,
        comon:M-NODE-02 ;
    comon:relatedRequirement comon:RF-47,
        comon:RF-48,
        comon:RF-53 .

comon:P-VAL-05 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Baseline compatibility and major changes" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_VAL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Ontology, policy and query changes must preserve the maintained release checks or explicitly revise the contract and migration documentation. Source and semantic fingerprints must distinguish changed versions from earlier measurements; compatibility with all future integrations is not promised." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-VAL-05" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-VAL-04,
        comon:M-VAL-05 ;
    comon:relatedRequirement comon:RNF-11,
        comon:RNF-38 .

comon:P-VAL-08 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Global compliance coverage" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_VAL ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "The validation campaign must produce coverage and overall compliance metrics for the required minimum areas: consent and contracts, policies and zones, trust, multicriteria decisions, differential privacy, pseudonymization/anonymization, temporary delegation and auditing. Metrics must identify the specific versions of the evaluated artifacts." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-VAL-08" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-VAL-04,
        comon:M-VAL-07 ;
    comon:relatedRequirement comon:RF-68,
        comon:RNF-39,
        comon:RV-05 .

