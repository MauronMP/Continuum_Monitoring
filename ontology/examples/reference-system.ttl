        mc:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-05" ;
    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RNF-05" ;
    mc:requirementStatement "AHP multicriteria score calculation and application of the external trust criterion must complete within `T_decision_max` so as not to exceed the adaptation interval defined by the active policy." ;
    mc:tracedToMechanism mc:M-MODEL-02,
        mc:M-OPS-01,
        mc:M-TRUST-02,
