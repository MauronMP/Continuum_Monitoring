ex:P-CONS-01 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Range-based consent and revocation" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_CONS ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Consent must be expressed through processing ranges covering at least local scope, community aggregation, global aggregation and denial/revocation. It must be possible to specify data categories, purpose, validity interval and maximum authorized range." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-CONS-01" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-CONS-01 ;
