ex:P-AUD-03 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Cierre efectivo de delegaciones" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_AUD ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "La delegación debe cerrarse cuando se cumpla la condición de recuperación o se alcance su expiración planificada. En el cierre debe registrarse `validTo` con el instante efectivo y detenerse cualquier nueva acción basada en la delegación finalizada."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-AUD-03" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-DELEG-02 ;
    ex:relatedRequirement ex:RF-64,
        ex:RNF-36 .

