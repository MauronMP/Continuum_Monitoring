    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Data used beyond their immediate observation must retain the minimum context needed to interpret their use: time, location or applicable zone, signal quality, device state, node state, processing level and purpose." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-DATA-10" ;
