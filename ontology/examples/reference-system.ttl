    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Migration, delegation, reconnection and recovery processes must not lose critical events or create accidental duplicates. Retryable operations must have idempotent semantics where applicable." ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
