    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "When delegation is chosen, the preferred destination must be the highest-trust candidate among those already satisfying load, availability, connectivity, residual capacity and active constraints. Its trust score need not exceed the source's if the source degradation has another cause." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-ADAPT-07" ;
    ex:policyVersion "POLICIES-REV-01" ;
