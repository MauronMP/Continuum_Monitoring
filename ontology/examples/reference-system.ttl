    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Under overload, the system must apply controlled processing degradation, migration or delegation according to eligible alternatives. Scaling to higher tiers is allowed only when consent, zone, capacity and trust policies are satisfied." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-ADAPT-03" ;
