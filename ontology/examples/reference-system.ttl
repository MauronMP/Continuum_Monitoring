    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "The trust score or trust weight must not be included as a fourth weight in AHP normalization. It may serve as a filter, ranking criterion or documented external adjustment after eligibility is established." ;
