    rdfs:label "RF-34" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-34" ;
    ex:requirementStatement "The semantic contract must link the user, consent range, processing purpose and policies governing the processing." ;
    ex:tracedToMechanism ex:M-CONS-01,
        ex:M-GOV-02 ;
    ex:tracedToPolicy ex:P-CONS-03 .

ex:RF-37 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-37" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-37" ;
    ex:requirementStatement "Every resource, policy, permission, model, service or session requiring consent must declare the minimum required range through `requiresConsentRange`." ;
    ex:tracedToMechanism ex:M-CONS-03 ;
    ex:tracedToPolicy ex:P-CONS-05 .

ex:RF-39 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-39" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-39" ;
    ex:requirementStatement "The system must represent policies as explicit, queryable semantic entities." ;
    ex:tracedToMechanism ex:M-GOV-01 ;
    ex:tracedToPolicy ex:P-GOV-01 .

ex:RF-40 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-40" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-40" ;
    ex:requirementStatement "Every formal policy must be classified under exactly one semantic type: obligation, abstention or prohibition. In this model, an obligation requires an action to be performed; an abstention requires an optional action not to be performed unless explicitly enabled; a prohibition declares an action impermissible. The three types must be distinguishable and disjoint in validation." ;
    ex:tracedToMechanism ex:M-GOV-01 ;
    ex:tracedToPolicy ex:P-GOV-01 .

