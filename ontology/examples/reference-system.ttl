ex:P-DATA-03 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Sensitive-information encryption" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_DATA ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "All data classified as sensitive must be protected in transit and at rest according to the deployment's versioned security baseline. This policy also applies to temporary buffers and authorized replicas." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-DATA-03" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-SEC-01,
        ex:M-VAL-04 ;
    ex:relatedRequirement ex:RNF-15,
