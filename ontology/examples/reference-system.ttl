mc:P-DATA-08 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Redundancy, replication and idempotency" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Accidental duplicates or data marked as redundant without a replication purpose must not enter external flows. Controlled replicas are allowed only when explicitly identified, versioned and synchronized idempotently." ;
