ex:P-AUD-07 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Reconstrucción causal y temporal de decisiones" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_AUD ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "La información persistida debe permitir reconstruir a posteriori la cadena usuario → contrato → consentimiento efectivo → propósito → zona → política → estado de nodo → alternativas/puntuaciones → confianza → tier → acción, identificando qué valores estaban vigentes en el instante de la decisión."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-AUD-07" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-AUD-03,
