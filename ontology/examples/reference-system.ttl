    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-05" ;
    comon:requirementStatement "AHP multicriteria score calculation and application of the external trust criterion must complete within `T_decision_max` so as not to exceed the adaptation interval defined by the active policy." ;
    comon:tracedToMechanism comon:M-MODEL-02,
        comon:M-OPS-01,
        comon:M-TRUST-02,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-MODEL-03,
        comon:P-OPS-01 .

comon:RNF-06 a comon:NonFunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-06" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-06" ;
    comon:requirementStatement "Device energy consumption under the reference scenario must remain within `E_device_max`, with consumption or its effect on battery life recorded reproducibly. Low-battery strategies must not increase non-critical transmissions relative to normal mode." ;
    comon:tracedToMechanism comon:M-ADAPT-02,
