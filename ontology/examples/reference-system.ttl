    mc:definedInArtifact mc:RequirementsArtifact_Revised ;
    mc:requirementIdentifier "RNF-08" ;
    mc:requirementStatement "The concurrency target must be expressed through the explicit value `N_agents` rather than ambiguous terms such as 'thousands of agents'; the load campaign must demonstrate concurrent operation with at least that number." ;
    mc:tracedToMechanism mc:M-OPS-01,
        mc:M-VAL-04 ;
    mc:tracedToPolicy mc:P-OPS-01 .

mc:RNF-11 a mc:NonFunctionalRequirement,
