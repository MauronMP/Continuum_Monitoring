    ex:belongsToPolicyCategory ex:PolicyCategory_FL ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Ningún parámetro, modelo personalizado o gradiente puede enviarse hacia capas superiores si la autorización efectiva, la zona o las políticas de privacidad no permiten ese tipo de flujo."@es ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-FL-02" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-CONS-02,
        ex:M-FL-01,
        ex:M-ZONE-01 ;
    ex:relatedRequirement ex:RF-21,
        ex:RF-35,
        ex:RF-42 .

ex:P-OPS-02 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Escalado horizontal compatible con Fog y Cloud" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_OPS ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "La política de escalabilidad debe permitir escalado horizontal en Cloud y, cuando exista infraestructura Fog que lo soporte, también en Fog. No debe asumirse que Cloud es el único tipo de nodo con capacidad de elasticidad."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-OPS-02" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-OPS-02 ;
    ex:relatedRequirement ex:RF-17,
        ex:RNF-07 .

ex:P-OPS-06 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Restauración y vaciado seguro de buffers" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_OPS ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "La recuperación de carga o conectividad no autoriza automáticamente restaurar el nivel máximo de procesamiento ni vaciar todos los buffers. La restauración y sincronización deben realizarse únicamente cuando las condiciones que las habilitan sigan siendo válidas para cada servicio o dato pendiente."@es ;
    ex:hasPolicyType ex:AbstentionPolicyType ;
    ex:policyIdentifier "P-OPS-06" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-BUFFER-01,
        ex:M-MODEL-04,
        ex:M-TX-02 ;
    ex:relatedRequirement ex:RF-08,
        ex:RF-15,
        ex:RF-26,
        ex:RNF-12 .

ex:P-ZONE-04 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Cambio de zona y reevaluación" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_ZONE ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Todo cambio de zona que pueda modificar la autorización o la elegibilidad de una capa debe invalidar la decisión previa y provocar una reevaluación antes de continuar nuevos flujos o procesamiento externo."@es ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-ZONE-04" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-CTX-01,
        ex:M-MODEL-04 ;
    ex:relatedRequirement ex:RF-03,
        ex:RF-15,
        ex:RF-17,
        ex:RNF-21 .

ex:RF-15 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-15" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-15" ;
    ex:requirementStatement "El sistema debe seleccionar el tier de modelo más adecuado entre `LocalModelTier`, `EdgeModelTier`, `FogModelTier` y `CloudModelTier`, aplicando primero las restricciones duras de consentimiento, contrato, zona, disponibilidad y conectividad y, sobre las alternativas elegibles, considerando latencia, privacidad, calidad del modelo, carga y confianza. La selección debe reevaluarse y poder sustituirse cuando cambien las condiciones que la hicieron válida."@es ;
    ex:tracedToMechanism ex:M-BUFFER-01,
        ex:M-CONS-02,
        ex:M-CTX-01,
        ex:M-MODEL-01,
        ex:M-MODEL-04,
        ex:M-NODE-02,
        ex:M-TX-02,
        ex:M-ZONE-01 ;
    ex:tracedToPolicy ex:P-MODEL-01,
        ex:P-MODEL-09,
        ex:P-NODE-02,
        ex:P-OPS-06,
        ex:P-ZONE-03,
        ex:P-ZONE-04 .

ex:RF-42 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-42" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-42" ;
    ex:requirementStatement "El sistema debe aplicar políticas específicas por zona: retención local en zona rural, bloqueo de transferencia externa en zona restringida y agregación en zona urbana únicamente cuando el consentimiento efectivo y el contrato la autoricen. Cuando zona, consentimiento y contrato impongan restricciones diferentes, debe prevalecer siempre la condición más restrictiva."@es ;
    ex:tracedToMechanism ex:M-BUFFER-01,
        ex:M-CONS-02,
        ex:M-FL-01,
        ex:M-GOV-03,
        ex:M-MODEL-01,
        ex:M-NODE-02,
        ex:M-TX-02,
        ex:M-ZONE-01 ;
    ex:tracedToPolicy ex:P-FL-02,
        ex:P-GOV-03,
        ex:P-MODEL-06,
        ex:P-ZONE-01,
        ex:P-ZONE-02,
        ex:P-ZONE-03 .

