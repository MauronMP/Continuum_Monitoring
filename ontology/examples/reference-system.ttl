    mc:belongsToPolicyCategory mc:PolicyCategory_NODE ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "After hard filters are applied, eligible candidates must be ranked or prioritized using trust together with the required operational metrics. Saturated, unstable or historically unreliable nodes must be avoided when a better eligible alternative exists." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-NODE-05" ;
