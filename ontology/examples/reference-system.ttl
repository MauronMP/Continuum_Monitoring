    mc:belongsToPolicyCategory mc:PolicyCategory_MODEL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "When AHP is used, normalized weights must correspond to latency, privacy and model quality. Their sum must equal 1 within the configured tolerance. Trust is not part of this normalization." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-MODEL-02" ;
