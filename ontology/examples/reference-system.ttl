comon:RF-07 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-07" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-07" ;
    comon:requirementStatement "The reference monitoring model must expose device battery, connection status and data readiness, together with the consent context used to interpret local operation. This requirement covers queryable decision inputs; automatic energy management, preprocessing and offloading on physical devices are outside this release." ;
    comon:tracedToMechanism comon:M-ADAPT-02,
        comon:M-BUFFER-01,
        comon:M-DEVICE-01 ;
    comon:tracedToPolicy comon:P-ADAPT-02,
        comon:P-DATA-06 .

comon:RF-09 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-09" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-09" ;
    comon:requirementStatement "The system must tag data with operational context: time, location, signal quality, device state, node state, processing level and purpose of use." ;
    comon:tracedToMechanism comon:M-DATA-02,
        comon:M-TIME-01,
        comon:M-TX-01 ;
    comon:tracedToPolicy comon:P-DATA-04,
        comon:P-DATA-10 .

comon:RF-18 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-18" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-18" ;
    comon:requirementStatement "The system must support computation offloading to nearby devices or Edge/Fog nodes when feasible and when it does not violate consent, zone policies or minimum trust requirements." ;
    comon:tracedToMechanism comon:M-ADAPT-01,
        comon:M-CONS-02,
        comon:M-NODE-02,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-ADAPT-01,
        comon:P-NODE-02 .

comon:RF-19 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-19" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-19" ;
    comon:requirementStatement "The system must support controlled replication and synchronization of critical data, models and federated parameters, distinguishing intentional replicas from accidental duplicates and ensuring synchronization versioning and idempotency." ;
    comon:tracedToMechanism comon:M-DELEG-02,
        comon:M-REPL-01,
        comon:M-TX-01,
        comon:M-TX-02 ;
    comon:tracedToPolicy comon:P-ADAPT-08,
        comon:P-DATA-08 .

comon:RF-20 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-20" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-20" ;
    comon:requirementStatement "Every model or service degradation must be recorded with an explicit cause." ;
    comon:tracedToMechanism comon:M-ADAPT-01,
        comon:M-ADAPT-02,
        comon:M-AUD-01,
        comon:M-OPS-02 ;
    comon:tracedToPolicy comon:P-ADAPT-03,
        comon:P-ADAPT-06 .

comon:RF-21 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-21" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-21" ;
    comon:requirementStatement "The system must allow personalized models, parameters or gradients to be sent to higher tiers for additional training when consent, zone and privacy constraints permit it." ;
    comon:tracedToMechanism comon:M-CONS-02,
        comon:M-FL-01,
        comon:M-NODE-02,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-FL-01,
        comon:P-FL-02 .

