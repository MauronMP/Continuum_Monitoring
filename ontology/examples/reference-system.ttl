mc:P-OPS-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Horizontal scaling compatible with Fog and Cloud" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_OPS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "The scalability policy must allow horizontal scaling in Cloud and, where supporting Fog infrastructure exists, in Fog as well. Cloud must not be assumed to be the only node type capable of elasticity." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-OPS-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-OPS-02 ;
    mc:relatedRequirement mc:RF-17,
        mc:RNF-07 .

mc:P-OPS-06 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Restoration and safe buffer draining" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_OPS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Recovery from load or connectivity problems does not automatically authorize restoring the maximum processing level or draining all buffers. Restoration and synchronization must occur only while their enabling conditions remain valid for each service or pending data item." ;
    mc:hasPolicyType mc:AbstentionPolicyType ;
    mc:policyIdentifier "P-OPS-06" ;
