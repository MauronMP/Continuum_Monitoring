    comon:requirementIdentifier "RNF-23" ;
    comon:requirementStatement "The optional wellbeing module must permit a wearable subtype to specialize the existing Wearable class while retaining inherited user-device relations under RDFS reasoning. This is semantic extensibility; physical device drivers and sensor adapters are outside this release." ;
    comon:tracedToMechanism comon:M-INT-02,
        comon:M-VAL-05 ;
    comon:tracedToPolicy comon:P-INT-02 .

comon:RNF-25 a comon:NonFunctionalRequirement,
        comon:Requirement,
