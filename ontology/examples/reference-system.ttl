    ex:belongsToPolicyCategory ex:PolicyCategory_ADAPT ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "When communication is lost or no eligible destination exists, the system must maintain authorized critical functions locally and degrade processing in a controlled manner before attempting an unauthorized transfer." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-ADAPT-02" ;
    ex:policyVersion "POLICIES-REV-01" ;
