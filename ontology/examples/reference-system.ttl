    ex:belongsToPolicyCategory ex:PolicyCategory_AUD ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "A delegation chain must not exceed `D_delegation_max` or the equivalent stopping condition set in the acceptance profile/active policy." ;
    ex:hasPolicyType ex:ProhibitionPolicyType ;
    ex:policyIdentifier "P-AUD-04" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-DELEG-03 ;
    ex:relatedRequirement ex:RNF-14 .

ex:P-CONS-05 a ex:Policy,
        owl:NamedIndividual ;
    rdfs:label "Required minimum range declaration" ;
    ex:belongsToPolicyCategory ex:PolicyCategory_CONS ;
    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:hasPolicyStatement "Every consent-dependent resource, permission, model, service, session or action must declare the minimum required range before being considered eligible." ;
    ex:hasPolicyType ex:ObligationPolicyType ;
    ex:policyIdentifier "P-CONS-05" ;
    ex:policyVersion "POLICIES-REV-01" ;
    ex:recommendedMechanism ex:M-CONS-03 ;
