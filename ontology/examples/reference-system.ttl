    comon:belongsToPolicyCategory comon:PolicyCategory_ZONE ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "When processing originates in a restricted zone, user data and associated processing must not leave the local scope: Edge, Fog and Cloud are excluded. Receiving a generic model not derived from the user may be allowed only if an explicit zone policy authorizes inbound traffic and no user information is extracted." ;
    comon:hasPolicyType comon:ProhibitionPolicyType ;
    comon:policyIdentifier "P-ZONE-01" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-CONS-02,
