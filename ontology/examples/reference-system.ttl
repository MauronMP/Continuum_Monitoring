    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-24" ;
    ex:requirementStatement "The system must version models, record their update dates and support rollback to previous versions in the event of degradation, errors or policy non-compliance." ;
    ex:tracedToMechanism ex:M-MODEL-05,
        ex:M-VAL-04 ;
    ex:tracedToPolicy ex:P-FL-08 .

ex:RF-29 a ex:FunctionalRequirement,
        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-29" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RF-29" ;
    ex:requirementStatement "The system must collect system metrics for computational stress studies, including resource usage, load, queues, latency, residual capacity and migration cost." ;
    ex:tracedToMechanism ex:M-METRIC-01,
        ex:M-TIME-01 ;
    ex:tracedToPolicy ex:P-OPS-05 .

ex:RF-31 a ex:FunctionalRequirement,
