    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Parameterized data must not be transmitted until marked as ready for transmission and accompanied by the required contextual metadata. This rule must not be used to block other flow types, such as model downloads, which are governed by their own policies." ;
