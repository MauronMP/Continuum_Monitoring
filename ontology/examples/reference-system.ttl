    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-22" ;
    comon:requirementStatement "The system must support federated or hierarchical learning between devices and Edge, Fog and Cloud nodes." ;
    comon:tracedToMechanism comon:M-ADAPT-03,
        comon:M-FL-01,
        comon:M-NODE-02 ;
    comon:tracedToPolicy comon:P-ADAPT-05,
        comon:P-FL-01 .

comon:RF-23 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-23" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-23" ;
    comon:requirementStatement "The system must redistribute updated models to lower tiers without extending the current consent range, provided that the downstream flow complies with the semantic contract and active policies and does not carry personal data or individualized gradients." ;
    comon:tracedToMechanism comon:M-CONS-02,
        comon:M-FL-02,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-CONS-06,
        comon:P-FL-06 .

comon:RF-28 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-28" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-28" ;
    comon:requirementStatement "The system must prioritize critical data over secondary data, retaining redundant or non-transmissible data locally. Criticality must be represented through a generic classification applicable to any data; `StressCritical` may be used for stress but must not be the only prioritization mechanism." ;
    comon:tracedToMechanism comon:M-BUFFER-01,
        comon:M-REPL-01,
        comon:M-TX-01,
        comon:M-TX-03 ;
    comon:tracedToPolicy comon:P-DATA-08,
        comon:P-DATA-09 .

comon:RF-30 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-30" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-30" ;
    comon:requirementStatement "The system must correlate physiological metrics with system metrics to study interactions between human stress, computational load, energy and connectivity, using common temporal and contextual references to determine which states and observations coexisted." ;
    comon:tracedToMechanism comon:M-DATA-02,
        comon:M-METRIC-01,
        comon:M-TIME-01 ;
    comon:tracedToPolicy comon:P-DATA-10,
        comon:P-OPS-05 .

comon:RF-36 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-36" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-36" ;
    comon:requirementStatement "The system must prevent selection of models or processing tiers that exceed the user's active consent range." ;
    comon:tracedToMechanism comon:M-CONS-02,
        comon:M-GOV-03,
        comon:M-NODE-02,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-CONS-04,
        comon:P-ZONE-03 .

comon:RF-38 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-38" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-38" ;
    comon:requirementStatement "Denial or revocation of upstream personal-data transmission must not prevent users from receiving improved generic models downstream, provided that the flow contains no personal data or individualized gradients and complies with the contract and active policies. This requirement complements RF-23 and does not authorize any additional upstream transfer." ;
    comon:tracedToMechanism comon:M-CONS-02,
        comon:M-FL-02,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-CONS-06,
        comon:P-FL-06 .

comon:RF-41 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-41" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-41" ;
    comon:requirementStatement "Reference semantic contracts must expose their governing policies through governedBy. Evaluation and action records must expose the policy justification checked by the audit queries. This requirement does not impose governedBy on every user, node or zone." ;
    comon:tracedToMechanism comon:M-AUD-01,
        comon:M-CONS-01,
        comon:M-GOV-02 ;
    comon:tracedToPolicy comon:P-CONS-03,
        comon:P-GOV-02 .

comon:RF-43 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-43" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-43" ;
    comon:requirementStatement "The system must block all processing or transfer outside the local scope defined in RF-10 when the source is in a `RestrictedZone`, including selection of Edge, Fog or Cloud tiers, unless an explicitly more restrictive policy imposes even less processing." ;
    comon:tracedToMechanism comon:M-CONS-02,
        comon:M-GOV-03,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-GOV-03,
        comon:P-ZONE-01 .

comon:RF-44 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-44" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-44" ;
    comon:requirementStatement "Each reference evaluation that records an adaptation action must identify an applied policy, and each recorded adaptation action must identify its authorizing evaluation. Audit queries must detect missing links; the records do not prove physical execution of migration or degradation." ;
    comon:tracedToMechanism comon:M-ADAPT-02,
        comon:M-AUD-01,
        comon:M-GOV-02 ;
    comon:tracedToPolicy comon:P-ADAPT-06,
        comon:P-GOV-02 .

comon:RF-46 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-46" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-46" ;
    comon:requirementStatement "Every evaluation that compares nodes must record a queryable trust value or weight used as a criterion external to the AHP calculation. Trust must be used to filter or rank eligible alternatives but must not be mixed with the AHP weights defined in RF-50." ;
    comon:tracedToMechanism comon:M-MODEL-02,
        comon:M-NODE-02,
        comon:M-TRUST-02 ;
    comon:tracedToPolicy comon:P-MODEL-03,
        comon:P-NODE-05 .

comon:RF-49 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-49" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-49" ;
    comon:requirementStatement "The system must update a node's trust score from historical behavior, failures, disconnections, saturation and policy violations using a documented normalized scale, time window and update rule. If latency or load contributes to trust calculation, the subsequent decision must avoid counting the same effect twice as an independent criterion without explicit justification." ;
    comon:tracedToMechanism comon:M-AUD-01,
        comon:M-TRUST-01,
        comon:M-VAL-04 ;
    comon:tracedToPolicy comon:P-NODE-03,
        comon:P-NODE-04 .

comon:RF-50 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-50" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-50" ;
    comon:requirementStatement "Every `EvaluationState` using AHP must record normalized weights for latency, privacy and model quality. Their sum must equal 1 within the configured tolerance. Trust is treated as an external criterion under RF-46 and is not part of this normalization." ;
    comon:tracedToMechanism comon:M-MODEL-02,
        comon:M-TRUST-02 ;
    comon:tracedToPolicy comon:P-MODEL-02,
        comon:P-MODEL-03 .

comon:RF-51 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-51" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-51" ;
    comon:requirementStatement "Every `EvaluationState` must record the AHP score of each evaluated tier alternative, the final selected tier and a justification that makes it possible to reconstruct why the chosen alternative outperformed the others." ;
    comon:tracedToMechanism comon:M-AUD-01,
        comon:M-MODEL-01 ;
    comon:tracedToPolicy comon:P-AUD-06,
        comon:P-MODEL-05 .

comon:RF-52 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-52" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-52" ;
    comon:requirementStatement "The reference model must expose privacy and other decision weights, the selected model tier and its justification. A recorded Cloud selection without global consent, a permitted zone and granted authorization must be detectable. Automatic privacy-weight optimization is outside this release." ;
    comon:tracedToMechanism comon:M-CONS-02,
        comon:M-MODEL-01,
        comon:M-NODE-02,
        comon:M-ZONE-01 ;
    comon:tracedToPolicy comon:P-MODEL-01,
        comon:P-MODEL-06 .

comon:RF-54 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-54" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-54" ;
    comon:requirementStatement "The system must detect incomplete evaluations that omit applicable AHP weights, scores of evaluated alternatives, the selected tier, the applied policy, the semantic contract or the justification." ;
    comon:tracedToMechanism comon:M-AUD-01,
        comon:M-MODEL-01 ;
    comon:tracedToPolicy comon:P-AUD-06,
        comon:P-MODEL-05 .

comon:RF-56 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-56" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-56" ;
    comon:requirementStatement "Every federated-learning session carrying gradients must declare a privacy budget and noise level." ;
    comon:tracedToMechanism comon:M-FL-03,
        comon:M-ID-01,
        comon:M-MODEL-01 ;
    comon:tracedToPolicy comon:P-FL-03,
        comon:P-MODEL-07 .

comon:RF-59 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-59" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-59" ;
    comon:requirementStatement "The system must control the differential-privacy epsilon budget according to the processing purpose, semantic contract and active policy." ;
    comon:tracedToMechanism comon:M-AUD-01,
        comon:M-FL-03,
        comon:M-FL-04,
        comon:M-MODEL-01 ;
    comon:tracedToPolicy comon:P-FL-04,
        comon:P-MODEL-07 .

comon:RF-67 a comon:FunctionalRequirement,
        comon:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RF-67" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RF-67" ;
    comon:requirementStatement "The system must be able to reconstruct the complete decision chain: user → contract → effective consent → purpose → zone → policy → node state → AHP alternatives and scores → external trust → selected tier → executed action, preserving the causal and temporal relationships needed to identify which information was valid at the decision time." ;
    comon:tracedToMechanism comon:M-AUD-02,
        comon:M-AUD-03,
        comon:M-TIME-01 ;
    comon:tracedToPolicy comon:P-AUD-05,
