        ex:Requirement,
        owl:NamedIndividual ;
    rdfs:label "RNF-39" ;
    ex:definedInArtifact ex:RequirementsArtifact_Revised ;
    ex:requirementIdentifier "RNF-39" ;
    ex:requirementStatement "Los identificadores de versiones de ontología, políticas, consultas y escenarios utilizados en una campaña de validación deben quedar registrados de forma inequívoca para evitar referencias ambiguas como “v2.1” sin artefacto asociado."@es ;
