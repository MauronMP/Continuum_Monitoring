mc:P-MODEL-04 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "AHP method consistency" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_MODEL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "An evaluation labeled as AHP must not be considered valid if its weights are not normalized or its consistency ratio exceeds the configured threshold. If pairwise comparisons and consistency checking are not used, the decision must be labeled as weighted multicriteria scoring rather than AHP." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-MODEL-04" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-MODEL-03 ;
    mc:relatedRequirement mc:RF-55,
        mc:RNF-34 .

mc:P-MODEL-06 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Privacy priority" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_MODEL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "When privacy is the dominant criterion or effective consent limits aggregation, the decision must favor local or Edge tiers only if Edge remains authorized. A hard constraint always takes precedence over a quality score." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-MODEL-06" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-02,
        mc:M-MODEL-01,
        mc:M-ZONE-01 ;
    mc:relatedRequirement mc:RF-35,
        mc:RF-42,
        mc:RF-52 .

mc:P-MODEL-08 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Separation of observed quality and decision weights" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_MODEL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Prediction confidence, estimated error, local feedback and observed model quality must be recorded as independent evaluation metrics. AHP weights must not substitute for these metrics." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-MODEL-08" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-AUD-01,
        mc:M-METRIC-01 ;
    mc:relatedRequirement mc:RF-14,
        mc:RNF-27 .

mc:P-NODE-04 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Trust updates and double counting" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_NODE ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "The trust-update rule may consider failures, disconnections, saturation and policy violations, but must not cause the same latency or load effect to be counted again as an independent criterion in a subsequent decision without explicit justification." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-NODE-04" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-AUD-01,
        mc:M-TRUST-01 ;
    mc:relatedRequirement mc:RF-49,
        mc:RNF-32,
        mc:RNF-33 .

mc:P-NODE-06 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Absence of trustworthy alternatives" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_NODE ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "If no external node meets minimum eligibility and trust requirements, the system must not force a higher tier. It must prefer retention, local degradation or deferral and record the absence of alternatives." ;
    mc:hasPolicyType mc:AbstentionPolicyType ;
    mc:policyIdentifier "P-NODE-06" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-ADAPT-02,
        mc:M-AUD-01,
        mc:M-NODE-02 ;
    mc:relatedRequirement mc:RF-47,
        mc:RF-48,
        mc:RF-53 .

mc:P-VAL-05 a mc:Policy,
        owl:NamedIndividual ;
