mc:P-AUD-01 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Delegation as a semantic event" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_AUD ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every temporary delegation must be materialized as an explicit event, not merely as a static relationship between nodes." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-AUD-01" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-DELEG-01 ;
    mc:relatedRequirement mc:RF-62 .

mc:P-AUD-03 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Effective delegation closure" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_AUD ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "A delegation must close when its recovery condition is met or its planned expiration is reached. Closure must record `validTo` with the effective time and stop any new action based on the ended delegation." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-AUD-03" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-DELEG-02 ;
    mc:relatedRequirement mc:RF-64,
        mc:RNF-36 .

mc:P-AUD-04 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Delegation cascade limit" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_AUD ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "A delegation chain must not exceed `D_delegation_max` or the equivalent stopping condition set in the acceptance profile/active policy." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-AUD-04" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-DELEG-03 ;
    mc:relatedRequirement mc:RNF-14 .

mc:P-CONS-05 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Required minimum range declaration" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_CONS ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every consent-dependent resource, permission, model, service, session or action must declare the minimum required range before being considered eligible." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-CONS-05" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-CONS-03 ;
    mc:relatedRequirement mc:RF-37 .

mc:P-DATA-03 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Sensitive-information encryption" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "All data classified as sensitive must be protected in transit and at rest according to the deployment's versioned security baseline. This policy also applies to temporary buffers and authorized replicas." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-DATA-03" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-SEC-01,
        mc:M-VAL-04 ;
    mc:relatedRequirement mc:RNF-15,
        mc:RNF-39 .

mc:P-DATA-09 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Criticality-based prioritization" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_DATA ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Transmission scheduling must prioritize critical data over secondary data using a generic criticality classification. Non-transmissible or redundant data must remain retained under the applicable policy and must not displace critical data from a limited transmission window." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-DATA-09" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-BUFFER-01,
        mc:M-TX-03 ;
    mc:relatedRequirement mc:RF-27,
        mc:RF-28 .

mc:P-GOV-05 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Temporal state lifecycle" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_GOV ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every state must be modeled as a first-class temporal entity. It must record `validFrom` upon creation and `validTo` only when it ends. A state derived from an observation must retain an explicit link to its source evidence. Planned expiration must not reuse `validTo` before effective closure." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-GOV-05" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-TIME-01 ;
    mc:relatedRequirement mc:RNF-35,
        mc:RNF-36,
        mc:RNF-37 .

mc:P-VAL-03 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Preconditions for interpreting zero rows" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_VAL ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "A zero-row result from a violation query must not be considered evidence of compliance unless correct dataset loading, the expected ontology version, minimum coverage and successful query execution have been checked first." ;
    mc:hasPolicyType mc:ProhibitionPolicyType ;
    mc:policyIdentifier "P-VAL-03" ;
    mc:policyVersion "POLICIES-REV-01" ;
    mc:recommendedMechanism mc:M-VAL-03 ;
