comon:P-AUD-02 a comon:Policy,
        owl:NamedIndividual ;
    rdfs:label "Temporal delegation content" ;
    comon:belongsToPolicyCategory comon:PolicyCategory_AUD ;
    comon:definedInArtifact comon:PolicyArtifact_POLICIES_REV_01 ;
    comon:hasPolicyStatement "Every delegation must record the source, destination, cause, start of validity and recovery condition. Planned expiration must be stored separately; `validTo` is populated only when the delegation is effectively closed." ;
    comon:hasPolicyType comon:ObligationPolicyType ;
    comon:policyIdentifier "P-AUD-02" ;
    comon:policyVersion "POLICIES-REV-02" ;
    comon:recommendedMechanism comon:M-DELEG-01,
        comon:M-TIME-01 ;
