    rdfs:label "RNF-12" ;
    comon:definedInArtifact comon:RequirementsArtifact_Revised ;
    comon:requirementIdentifier "RNF-12" ;
    comon:requirementStatement "During partial connectivity failures, critical functions authorized for local execution must remain operational and pending data must retain integrity until synchronization or authorized disposal." ;
