mc:P-AUD-02 a mc:Policy,
        owl:NamedIndividual ;
    rdfs:label "Temporal delegation content" ;
    mc:belongsToPolicyCategory mc:PolicyCategory_AUD ;
    mc:definedInArtifact mc:PolicyArtifact_POLICIES_REV_01 ;
    mc:hasPolicyStatement "Every delegation must record the source, destination, cause, start of validity and recovery condition. Planned expiration must be stored separately; `validTo` is populated only when the delegation is effectively closed." ;
    mc:hasPolicyType mc:ObligationPolicyType ;
    mc:policyIdentifier "P-AUD-02" ;
    mc:policyVersion "POLICIES-REV-01" ;
