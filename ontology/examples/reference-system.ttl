    ex:definedInArtifact ex:PolicyArtifact_POLICIES_REV_01 ;
    ex:mechanismDescription "Actualizar el trust score a partir de la ventana histórica y regla versionada, conservando evidencias de los factores utilizados."@es ;
    ex:mechanismIdentifier "M-TRUST-01" ;
