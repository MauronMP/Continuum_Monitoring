<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>org.continuum.monitoring</groupId>
  <artifactId>owl-validation-runtime</artifactId>
  <version>1.0.0</version>
  <packaging>pom</packaging>

  <!-- Common logging dependency for native validation and worker adapters. -->
  <dependencies>
    <dependency>
      <groupId>org.slf4j</groupId>
      <artifactId>slf4j-simple</artifactId>
      <version>1.7.36</version>
      <scope>runtime</scope>
    </dependency>
  </dependencies>

  <!--
    OWL reasoners intentionally live in separate Maven profiles.  Combining
    them in one classpath lets incompatible transitive OWLAPI versions shadow
    one another; the resulting failure typically appears in OWLManager's
    dependency injector before the reasoner is even constructed.
  -->
  <profiles>
    <profile>
      <id>hermit</id>
      <dependencies>
        <dependency>
          <groupId>net.sourceforge.owlapi</groupId>
          <artifactId>org.semanticweb.hermit</artifactId>
          <version>1.4.5.519</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>openllet</id>
      <dependencies>
        <dependency>
          <groupId>com.github.galigator.openllet</groupId>
          <artifactId>openllet-owlapi</artifactId>
          <version>2.6.5</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>jfact</id>
      <dependencies>
        <dependency>
          <groupId>net.sourceforge.owlapi</groupId>
          <artifactId>jfact</artifactId>
          <version>5.0.3</version>
        </dependency>
        <!--
          JFact 5.0.3 transitively selects Guice 4.1.0, whose bundled CGLIB
          initializer is incompatible with Java 17. Guice 5.1.0 is the first
          release with explicit Java 17 class-definition support.
        -->
        <dependency>
          <groupId>com.google.inject</groupId>
          <artifactId>guice</artifactId>
          <version>5.1.0</version>
        </dependency>
        <dependency>
          <groupId>com.google.inject.extensions</groupId>
          <artifactId>guice-assistedinject</artifactId>
          <version>5.1.0</version>
        </dependency>
        <dependency>
          <groupId>com.google.guava</groupId>
          <artifactId>guava</artifactId>
          <version>30.1-jre</version>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>elk</id>
      <dependencies>
        <dependency>
          <groupId>org.semanticweb.elk</groupId>
          <artifactId>elk-owlapi</artifactId>
          <version>0.4.3</version>
        </dependency>
        <!-- ELK 0.4.3 declares OWLAPI as provided; command-line execution
             therefore has to supply the exact compatible OWLAPI runtime. -->
        <dependency>
          <groupId>net.sourceforge.owlapi</groupId>
          <artifactId>owlapi-distribution</artifactId>
          <version>4.1.3</version>
        </dependency>
        <!-- OWLAPI 4.1.3 selects Guice 4/CGLIB, which cannot initialize on
             Java 17. Keep ELK's OWLAPI API level and replace only injection. -->
        <dependency>
          <groupId>com.google.inject</groupId>
          <artifactId>guice</artifactId>
          <version>5.1.0</version>
        </dependency>
        <dependency>
          <groupId>com.google.inject.extensions</groupId>
          <artifactId>guice-assistedinject</artifactId>
          <version>5.1.0</version>
        </dependency>
        <dependency>
          <groupId>com.google.guava</groupId>
          <artifactId>guava</artifactId>
          <version>30.1-jre</version>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
