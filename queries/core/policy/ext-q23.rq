# ================================================================================================

# Síntomas MAPE-K sin política esperada asociada en el ticket de auditoría
# Expectativa: Incumplimiento. Debe devolver 0 filas.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?evaluation ?symptom ?requiredPolicy
WHERE {
  VALUES (?symptom ?requiredPolicy) {
    (ex:SymptomSaturatedWorkload       ex:TrustBasedNodeSelectionPolicy)
    (ex:SymptomCommunicationLoss       ex:TrustBasedNodeSelectionPolicy)
    (ex:SymptomConsentLocalOnly        ex:ConsentAwareProcessingPolicy)
    (ex:SymptomRuralLowConnectivity    ex:RuralLocalRetentionPolicy)
    (ex:SymptomRestrictedZoneBoundary  ex:RestrictedZoneNoExternalTransferPolicy)
  }
  ?evaluation a ex:EvaluationState ;
              ex:hasDetectedSymptom ?symptom .
  FILTER NOT EXISTS { ?evaluation ex:appliesPolicy ?requiredPolicy . }
}
ORDER BY ?evaluation ?symptom

# ------------------------------------------------------------------------------------------------
