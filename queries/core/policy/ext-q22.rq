# ================================================================================================

# EvaluationState que no funciona como ticket de auditoría completo
# Expectativa: Incumplimiento. Debe devolver 0 filas.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?evaluation ?missingField
WHERE {
  ?evaluation a ex:EvaluationState .
  VALUES (?property ?missingField) {
    (ex:hasEvaluationTicketID "hasEvaluationTicketID")
    (ex:hasDetectedSymptom    "hasDetectedSymptom")
    (ex:appliesPolicy         "appliesPolicy")
    (ex:auditsContract        "auditsContract")
    (ex:hasConsentRange       "hasConsentRange")
    (ex:selectedModelTier     "selectedModelTier")
    (ex:hasSelectionJustification "hasSelectionJustification")
  }
  FILTER NOT EXISTS { ?evaluation ?property ?value . }
}
ORDER BY ?evaluation ?missingField

# ------------------------------------------------------------------------------------------------
