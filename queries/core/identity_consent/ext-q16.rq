# Type: violation
# Purpose: Comprobar que el rango activo del usuario coincide con al menos un ConsentRecord vigente asociado.
# Requirements: RF-35
# Policies: P-CONS-01, P-CONS-04
# Current v3.0.0 result: 0 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?user ?activeRange WHERE {
  ?user a :User ; :hasActiveConsentRange ?activeRange .
  FILTER NOT EXISTS {
    ?user :hasConsentRecord ?record .
    ?record :hasConsentRange ?activeRange .
  }
}
ORDER BY ?user
