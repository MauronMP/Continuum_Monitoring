# Type: inventory
# Purpose: Listar recursos que declaran requiresConsentRange para preparar validaciones de autorización.
# Requirements: RF-37
# Policies: P-CONS-05
# Current v3.0.0 result: 11 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?resource ?type ?requiredRange WHERE {
  ?resource :requiresConsentRange ?requiredRange .
  OPTIONAL { ?resource a ?type . FILTER(?type != owl:NamedIndividual) }
}
ORDER BY ?resource ?type
