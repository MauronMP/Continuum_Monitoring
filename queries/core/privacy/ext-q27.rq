# ================================================================================================

# Sesiones FL sin epsilon/noiseLevel o con valores negativos
# Expectativa: Incumplimiento. Debe devolver 0 filas.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?flSession ?problem ?value
WHERE {
  {
    ?flSession a ex:FederatedLearningSession .
    FILTER NOT EXISTS { ?flSession ex:hasPrivacyBudget ?epsilon . }
    BIND("missing hasPrivacyBudget" AS ?problem)
  }
  UNION
  {
    ?flSession a ex:FederatedLearningSession .
    FILTER NOT EXISTS { ?flSession ex:noiseLevel ?noise . }
    BIND("missing noiseLevel" AS ?problem)
  }
  UNION
  {
    ?flSession a ex:FederatedLearningSession ; ex:hasPrivacyBudget ?value .
    FILTER (isNumeric(?value) && ?value < 0)
    BIND("negative hasPrivacyBudget" AS ?problem)
  }
  UNION
  {
    ?flSession a ex:FederatedLearningSession ; ex:noiseLevel ?value .
    FILTER (isNumeric(?value) && ?value < 0)
    BIND("negative noiseLevel" AS ?problem)
  }
}
ORDER BY ?flSession ?problem

# ------------------------------------------------------------------------------------------------
