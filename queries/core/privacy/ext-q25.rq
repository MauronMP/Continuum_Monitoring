# ================================================================================================

# Reporte de privacidad diferencial y flujos de datos en sesiones FL
# Expectativa: Inspección. Muestra epsilon, ruido, mecanismos, datos transferidos y destino.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?flSession ?dataType ?epsilon ?noise ?sessionNoiseApplied ?sessionAnonApplied
       ?transferredData ?destinationNode
       ?privacyMechanism
WHERE {
  ?flSession a ex:FederatedLearningSession .
  OPTIONAL { ?flSession ex:dataType ?dataType . }
  OPTIONAL { ?flSession ex:hasPrivacyBudget ?epsilon . }
  OPTIONAL { ?flSession ex:noiseLevel ?noise . }
  OPTIONAL { ?flSession ex:hasNoiseApplied ?sessionNoiseApplied . }
  OPTIONAL { ?flSession ex:hasAnonymizationApplied ?sessionAnonApplied . }
  OPTIONAL {
    ?flSession ex:hasPrivacyMechanism ?mechanism .
    BIND(STRAFTER(STR(?mechanism), "#") AS ?privacyMechanism)
  }
  OPTIONAL {
    ?flSession ex:transfersData ?transferredData .
    OPTIONAL { ?transferredData ex:sentToNode ?destinationNode . }
  }
}
ORDER BY ?flSession ?transferredData ?privacyMechanism

# ------------------------------------------------------------------------------------------------
