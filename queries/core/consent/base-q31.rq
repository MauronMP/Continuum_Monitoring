# ================================================================================================
# Category: consent

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q31 · Count users per consent status
# Level   : Advanced
# Scenario: All (consent distribution)
# ----------------------------------------------------------------
SELECT ?consentLabel (COUNT(?user) AS ?count)
WHERE {
  ?user a ex:User .
  ?user ex:hasConsent ?c .
  ?c rdfs:label ?consentLabel .
}
GROUP BY ?consentLabel
ORDER BY DESC(?count)
