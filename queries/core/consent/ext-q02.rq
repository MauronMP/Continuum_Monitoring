# ================================================================================================
# Category: consent

# Enumeración de rangos de consentimiento
# Expectativa: Inspección. Deben aparecer LocalOnly, CommunityAgg y GlobalAgg.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?range ?label ?comment
WHERE {
  ?range a ex:ConsentRange .
  OPTIONAL { ?range rdfs:label ?label . }
  OPTIONAL { ?range rdfs:comment ?comment . }
}
ORDER BY ?range

# ------------------------------------------------------------------------------------------------
