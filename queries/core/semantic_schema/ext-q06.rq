# Type: inventory
# Purpose: Inventariar las 12 categorías de gobernanza.
# Requirements: RF-39, RF-40
# Policies: P-GOV-01
# Current v3.0.0 result: 12 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?category ?code ?label WHERE {
  ?category a :PolicyCategory .
  OPTIONAL { ?category :categoryCode ?code }
  OPTIONAL { ?category rdfs:label ?label }
}
ORDER BY ?code
