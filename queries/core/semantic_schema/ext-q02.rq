# Type: dashboard
# Purpose: Comprobar que los requisitos revisados están representados en la ontología.
# Requirements: RV-04, RF-68
# Policies: P-VAL-06
# Current v3.0.0 result: 3 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?requirementType (COUNT(DISTINCT ?r) AS ?count) WHERE {
  VALUES ?requirementType {
    :FunctionalRequirement :NonFunctionalRequirement :ValidationRequirement
  }
  ?r a ?requirementType .
}
GROUP BY ?requirementType
ORDER BY ?requirementType
