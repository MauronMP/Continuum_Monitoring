# ================================================================================================

# Evaluaciones cuyos cuatro pesos de decisión no suman aproximadamente 1.
# Expectativa: Incumplimiento. Debe devolver 0 filas.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?evaluation ?latencyWeight ?privacyWeight ?modelQualityWeight ?trustWeight
       ((?latencyWeight + ?privacyWeight + ?modelQualityWeight + ?trustWeight) AS ?sumWeights)
WHERE {
  ?evaluation a ex:EvaluationState ;
              ex:hasLatencyWeight ?latencyWeight ;
              ex:hasPrivacyWeight ?privacyWeight ;
              ex:hasModelQualityWeight ?modelQualityWeight ;
              ex:hasTrustWeight ?trustWeight .
  FILTER (ABS((?latencyWeight + ?privacyWeight + ?modelQualityWeight + ?trustWeight) - 1.0) > 0.01)
}
ORDER BY ?evaluation

# ------------------------------------------------------------------------------------------------
