# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q19 · Find all nodes eligible for migration (available + low/medium workload)
# Level   : eAdvanced
# Scenario: 2, 3 (migration decision support)
# ----------------------------------------------------------------
SELECT ?node ?nodeType ?workloadLabel ?availLabel ?commLabel ?residualLabel ?trustScore ?resourcePct
WHERE {
  ?node a ?nodeType .
  ?nodeType rdfs:subClassOf+ ex:ComputationalNode .
  ?node ex:hasNodeState ?ns .
  OPTIONAL {
    ?ns ex:hasAvailability ?av .
    ?av rdfs:label ?availLabel .
  }
  OPTIONAL {
    ?ns ex:hasWorkload ?wl .
    ?wl rdfs:label ?workloadLabel .
  }
  OPTIONAL {
    ?ns ex:hasCommunication ?comm .
    ?comm rdfs:label ?commLabel .
  }
  ?ns ex:hasResidualCapacity ?rc ;
      ex:hasTrustScore ?trustScore .
  ?rc rdfs:label ?residualLabel .
  OPTIONAL {
    ?ns ex:resourceUsagePercent ?resourcePct .
  }
  FILTER (?av IN (ex:Available, ex:Partial))
  FILTER (?wl IN (ex:NoWorkload, ex:LowWorkload, ex:MediumWorkload))
  FILTER (?comm IN (ex:StableComm, ex:VariableComm, ex:IntermittentComm))
  FILTER (?rc IN (ex:MediumResidual, ex:HighResidual))
  FILTER (?trustScore >= 0.75)
}
ORDER BY ?resourcePct

# EXPECTED (candidates, sorted by lowest resource usage first):
# | node                 | nodeType   | workload | availability | comm     | residual | trust | resourcePct |
# |----------------------|------------|----------|--------------|----------|----------|-------|-------------|
# | InternalEdgeFacility | EdgeNode   | Low      | Available    | Stable   | High     | 0.91  | 20.0        |
# | CloudNode1           | CloudNode  | Low      | Available    | Stable   | High     | 0.96  | 25.0        |
# | EdgeNode1            | EdgeNode   | Low      | Available    | Stable   | High     | 0.93  | 30.0        |  (S1)
# | MobileC              | MobileDevice | Low    | Partial      | Intermittent | Medium | 0.78 | 40.0     |
# | FogNode1             | FogNode    | Medium   | Available    | Stable   | Medium   | 0.88 | 55.0        |


