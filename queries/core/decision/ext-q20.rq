# ================================================================================================

# Pesos AHP, trustWeight o AHP score fuera del rango [0,1]
# Expectativa: Incumplimiento. Debe devolver 0 filas.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?evaluation ?property ?value
WHERE {
  ?evaluation a ex:EvaluationState ;
              ?property ?value .
  VALUES ?property {
    ex:hasLatencyWeight
    ex:hasPrivacyWeight
    ex:hasModelQualityWeight
    ex:hasTrustWeight
    ex:hasAHPScore
  }
  FILTER (?value < 0 || ?value > 1)
}
ORDER BY ?evaluation ?property

# ------------------------------------------------------------------------------------------------
