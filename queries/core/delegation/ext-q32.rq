# ================================================================================================

# DelegationEvent cuyo estado detonante no está enlazado al nodo delegador mediante hasNodeState
# Expectativa: Incumplimiento. Debe devolver 0 filas si todos los estados históricos están enlazados al nodo correspondiente.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?delegation ?delegatedBy ?triggeredByState
WHERE {
  ?delegation a ex:DelegationEvent ;
              ex:delegatedBy ?delegatedBy ;
              ex:triggeredByState ?triggeredByState .
  FILTER NOT EXISTS { ?delegatedBy ex:hasNodeState ?triggeredByState . }
}
ORDER BY ?delegation

# ------------------------------------------------------------------------------------------------
