# ================================================================================================
# Category: contract_compliance

# Políticas aplicables a usuarios comparadas con su consentimiento activo
# Expectativa: Revisión. Filas con status=BLOCKED_BY_CONSENT indican políticas/acciones que no deberían ejecutarse para ese usuario.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?user ?activeRange ?policy ?policyType ?requiredRange
       (IF(?activeRank >= ?requiredRank, "OK", "BLOCKED_BY_CONSENT") AS ?status)
WHERE {
  ?user a ex:User ;
        ex:hasActiveConsentRange ?activeRange ;
        ex:governedBy ?policy .
  ?policy a ex:Policy ;
          ex:hasPolicyType ?policyType .
  OPTIONAL { ?policy ex:requiresConsentRange ?requiredRange . }

  VALUES (?activeRange ?activeRank) {
    (ex:RangeLocalOnly 1)
    (ex:RangeCommunityAgg 2)
    (ex:RangeGlobalAgg 3)
  }
  BIND(COALESCE(?requiredRange, ex:RangeLocalOnly) AS ?effectiveRequiredRange)
  VALUES (?effectiveRequiredRange ?requiredRank) {
    (ex:RangeLocalOnly 1)
    (ex:RangeCommunityAgg 2)
    (ex:RangeGlobalAgg 3)
  }
}
ORDER BY ?user ?policy

# ------------------------------------------------------------------------------------------------
