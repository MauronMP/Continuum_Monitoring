# ================================================================================================
# Category: contract_compliance

# Contratos semánticos activos por usuario, rango y propósito
# Expectativa: Inspección. Permite comprobar que cada usuario queda vinculado a contrato, rango y propósito.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT DISTINCT ?user ?contract ?activeRange ?contractRange
       ?purpose ?policy ?validFrom ?validTo
WHERE {
  ?user a ex:User ;
        ex:hasSemanticContract ?contract ;
        ex:hasActiveConsentRange ?activeRange .
  ?contract a ex:SemanticContract ;
            ex:contractSubject ?user ;
            ex:hasConsentRange ?contractRange .
  OPTIONAL { ?contract ex:hasProcessingPurpose ?purpose . }
  OPTIONAL { ?contract ex:governedBy ?policy . }
  OPTIONAL { ?contract ex:validFrom ?validFrom . }
  OPTIONAL { ?contract ex:validTo ?validTo . }
}
ORDER BY ?user ?purpose ?policy

# ------------------------------------------------------------------------------------------------
