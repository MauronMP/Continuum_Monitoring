# ================================================================================================
# Category: contract_compliance

# Modelo seleccionado por AHP incompatible con el rango de consentimiento del contrato auditado
# Expectativa: Incumplimiento. Debe devolver 0 filas.

PREFIX ex:   <http://example.org/smartcity#>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

SELECT ?evaluation ?contract ?contractRange ?selectedTier ?contractRank ?tierRequiredRank
WHERE {
  ?evaluation a ex:EvaluationState ;
              ex:auditsContract ?contract ;
              ex:selectedModelTier ?selectedTier .
  ?contract ex:hasConsentRange ?contractRange .

  VALUES (?contractRange ?contractRank) {
    (ex:RangeLocalOnly 1)
    (ex:RangeCommunityAgg 2)
    (ex:RangeGlobalAgg 3)
  }
  VALUES (?selectedTier ?tierRequiredRank) {
    (ex:LocalModelTier 1)
    (ex:EdgeModelTier 2)
    (ex:FogModelTier 2)
    (ex:CloudModelTier 3)
  }
  FILTER (?tierRequiredRank > ?contractRank)
}
ORDER BY ?evaluation

# ------------------------------------------------------------------------------------------------
