# Type: violation
# Purpose: Detectar estados de nodo sin disponibilidad, workload, comunicación, capacidad residual u operational status.
# Requirements: RF-05, RF-47
# Policies: P-NODE-01, P-NODE-02
# Current v3.0.0 result: 0 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?state ?missing WHERE {
  ?state a :NodeState .
  VALUES (?prop ?missing) {
    (:hasAvailability "hasAvailability")
    (:hasWorkload "hasWorkload")
    (:hasCommunication "hasCommunication")
    (:hasResidualCapacity "hasResidualCapacity")
    (:hasOperationalStatus "hasOperationalStatus")
  }
  FILTER NOT EXISTS { ?state ?prop ?v }
}
ORDER BY ?state ?missing
