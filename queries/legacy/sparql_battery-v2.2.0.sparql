# ################################################################################################
# PART A — BASE / LEGACY SCENARIO QUERY BATTERY
# ################################################################################################

# ================================================================================================
# START QUERY BASE-Q01: Q01 · List all users and their consent status
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q01 · List all users and their consent status
# Level   : Simple
# Scenario: All (consent model)
# ----------------------------------------------------------------
SELECT ?user ?name ?consentLabel
WHERE {
  ?user a ex:User .
  ?user foaf:name ?name .
  ?user ex:hasConsent ?consent .
  ?consent rdfs:label ?consentLabel .
}
ORDER BY ?name

# EXPECTED:
# | user    | name          | consentLabel    |
# |---------|---------------|-----------------|
# | UserA   | Participant A | Consent Given   |
# | UserB   | Participant B | Consent Denied  |
# | UserC   | Participant C | Consent Given   |
# | UserD   | Participant D | Consent Given   |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q01: Q01 · List all users and their consent status
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q02: Q02 · List all computational nodes and their type
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q02 · List all computational nodes and their type
# Level   : Simple
# Scenario: All (infrastructure)
# ----------------------------------------------------------------
SELECT ?node ?type ?elasticity
WHERE {
  ?node a ?type .
  ?type rdfs:subClassOf* ex:ComputationalNode .
  OPTIONAL { ?node ex:hasElasticity ?elasticity }
}
ORDER BY ?type

# EXPECTED:
# | node                  | type       | elasticity |
# |-----------------------|------------|------------|
# | CloudNode1            | CloudNode  | true       |
# | EdgeNode1             | EdgeNode   | false      |
# | EdgeNode2             | EdgeNode   | false      |
# | InternalEdgeFacility  | EdgeNode   | false      |
# | MobileA               | MobileDevice | (null)  |
# | MobileC               | MobileDevice | (null)  |
# | FogNode1              | FogNode    | false      |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q02: Q02 · List all computational nodes and their type
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q03: Q03 · List all wearables and their owners
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q03 · List all wearables and their owners
# Level   : Simple
# Scenario: All (device–user relationship)
# ----------------------------------------------------------------
SELECT ?userName ?wearable ?wType
WHERE {
  ?user a ex:User .
  ?user foaf:name ?userName .
  ?user ex:hasWearable ?wearable .
  ?wearable a ?wType .
  ?wType rdfs:subClassOf ex:Wearable .
}
ORDER BY ?userName

# EXPECTED:
# | userName      | wearable | wType      |
# |---------------|----------|------------|
# | Participant A | WatchA   | SmartWatch |
# | Participant B | RingB    | SmartRing  |
# | Participant C | BandC    | SmartBand  |
# | Participant D | WatchD   | SmartWatch |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q03: Q03 · List all wearables and their owners
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q04: Q04 · List all AI models and their tier/layer
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q04 · List all AI models and their tier/layer
# Level   : Simple
# Scenario: All (model hierarchy)
# ----------------------------------------------------------------
SELECT ?model ?version ?tierLabel
WHERE {
  ?model a ex:AIModel .
  ?model ex:modelVersion ?version .
  ?model ex:hasModelTier ?tier .
  ?tier rdfs:label ?tierLabel .
}
ORDER BY ?tierLabel

# EXPECTED:
# | model        | version | tierLabel            |
# |--------------|---------|----------------------|
# | ModelCloud1  | 2.1.0   | Cloud / Global       |
# | ModelEdge1   | 1.2.0   | Edge                 |
# | ModelFog1    | 1.8.0   | Fog / Community      |
# | ModelLocal1  | 0.9.0   | Local (Mist/Device)  |
# | ModelLocalB  | 0.8.0   | Local (Mist/Device)  |
# | ModelLocal_C | 1.0.0   | Local (Mist/Device)  |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q04: Q04 · List all AI models and their tier/layer
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q05: Q05 · List all physiological sensors and the device hosting them
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q05 · List all physiological sensors and the device hosting them
# Level   : Simple
# Scenario: All (sensor layer)
# ----------------------------------------------------------------
SELECT ?sensor ?sensorType ?device
WHERE {
  ?sensor a ?sensorType .
  ?sensorType rdfs:subClassOf* ex:PhysiologicalSensor .
  ?sensor sosa:isHostedBy ?device .
}
ORDER BY ?sensorType

# EXPECTED:
# | sensor       | sensorType        | device |
# |--------------|-------------------|--------|
# | AccelSensorA | AccelerometerSensor | WatchA |
# | EDASensorA   | EDASensor         | WatchA |
# | HRSensorA    | HeartRateSensor   | WatchA |
# | SleepSensorA | SleepSensor       | WatchA |
# | SpO2SensorA  | SpO2Sensor        | WatchA |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q05: Q05 · List all physiological sensors and the device hosting them
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q06: Q06 · List all RBAC roles and their permissions
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q06 · List all RBAC roles and their permissions
# Level   : Simple
# Scenario: All (access control)
# ----------------------------------------------------------------
SELECT ?roleLabel ?permLabel ?requiresConsent
WHERE {
  ?role a ex:Role .
  ?role rdfs:label ?roleLabel .
  ?role ex:hasPermission ?perm .
  ?perm rdfs:label ?permLabel .
  OPTIONAL { ?perm ex:requiresConsent ?requiresConsent }
}
ORDER BY ?roleLabel ?permLabel

# EXPECTED:
# | roleLabel    | permLabel                  | requiresConsent |
# |--------------|----------------------------|-----------------|
# | Administrator| Manage Infrastructure      | false           |
# | Administrator| Read Physiological Data    | true            |
# | Administrator| Read Sleep Data            | true            |
# | Administrator| Train Global Model         | true            |
# | Doctor       | Read Physiological Data    | true            |
# | Doctor       | Read Sleep Data            | true            |
# | Doctor       | Read Stress Prediction     | false           |
# | End User     | Read Stress Prediction     | false           |
# | Researcher   | Read Stress Prediction     | false           |
# | Researcher   | Train Global Model         | true            |


# ================================================================
# BLOCK 2 — STATE QUERIES (Level: Simple–Intermediate)
# ================================================================

# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q06: Q06 · List all RBAC roles and their permissions
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q07: Q07 · Get all node states and their workload
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q07 · Get all node states and their workload
# Level   : Simple
# Scenario: 1,2,3,4,6,7,8
# ----------------------------------------------------------------
SELECT ?node ?workloadLabel ?resourcePct ?queued
WHERE {
  ?node ex:hasNodeState ?ns .
  ?ns ex:hasWorkload ?wl .
  ?wl rdfs:label ?workloadLabel .
  OPTIONAL { ?ns ex:resourceUsagePercent ?resourcePct }
  OPTIONAL { ?ns ex:queuedRequests ?queued }
}
ORDER BY DESC(?resourcePct)

# EXPECTED (sorted by resource usage desc):
# | node        | workloadLabel | resourcePct | queued |
# |-------------|---------------|-------------|--------|
# | EdgeNode2   | Saturated     | 99.0        | 25     |
# | EdgeNode1   | Saturated     | 92.0        | 15     |  (S2)
# | FogNode1    | Medium        | 55.0        | 4      |
# | MobileC     | Low           | 40.0        | 0      |
# | EdgeNode1   | Low           | 30.0        | 1      |  (S1)
# | CloudNode1  | Low           | 25.0        | 0      |
# | InternalEdge| Low           | 20.0        | 2      |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q07: Q07 · Get all node states and their workload
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q08: Q08 · Find nodes in Saturated or Not Available state
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q08 · Find nodes in Saturated or Not Available state
# Level   : Intermediate
# Scenario: 2, 4 (saturation / failure detection)
# ----------------------------------------------------------------
SELECT ?node ?workloadLabel ?availLabel ?opStatusLabel
WHERE {
  ?node ex:hasNodeState ?ns .
  ?ns ex:hasWorkload ?wl .
  ?wl rdfs:label ?workloadLabel .
  ?ns ex:hasAvailability ?av .
  ?av rdfs:label ?availLabel .
  ?ns ex:hasOperationalStatus ?op .
  ?op rdfs:label ?opStatusLabel .
  FILTER (?wl = ex:SaturatedWorkload || ?av = ex:NotAvailable)
}

# EXPECTED:
# | node      | workloadLabel | availLabel   | opStatusLabel |
# |-----------|---------------|--------------|---------------|
# | EdgeNode1 | Saturated     | Partial      | Operational   |  (S2)
# | EdgeNode2 | Saturated     | Not Available| Compute Only  |  (S4)


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q08: Q08 · Find nodes in Saturated or Not Available state
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q09: Q09 · Get user states with predicted stress level and mobility
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q09 · Get user states with predicted stress level and mobility
# Level   : Intermediate
# Scenario: 1,2,4,5,7,8
# ----------------------------------------------------------------
SELECT ?stateLabel ?mobilityLabel ?personStatusLabel ?stressLabel ?feedback
WHERE {
  ?us a ex:UserState .
  ?us rdfs:label ?stateLabel .
  ?us ex:hasMobility ?mob .
  ?mob rdfs:label ?mobilityLabel .
  ?us ex:hasPersonStatus ?ps .
  ?ps rdfs:label ?personStatusLabel .
  ?us ex:hasPredictedStressLevel ?sl .
  ?sl rdfs:label ?stressLabel .
  OPTIONAL { ?us ex:userFeedbackScore ?feedback }
}
ORDER BY ?stressLabel

# EXPECTED:
# | stateLabel            | mobilityLabel | personStatus | stressLabel | feedback |
# |-----------------------|---------------|--------------|-------------|----------|
# | User State S8 - D     | Still         | Asleep       | Low         | (null)   |
# | User State S1 - A     | Still         | Calm         | Low         | 5        |
# | User State S5 - B     | Still         | Calm         | Low         | 4        |
# | User State S7 - C     | Walking       | Calm         | Medium      | 3        |
# | User State S2 - Event | Walking       | Agitated     | High        | 2        |
# | User State S4 - S4    | In Transport  | Agitated     | Critical    | (null)   |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q09: Q09 · Get user states with predicted stress level and mobility
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q10: Q10 · Check device connection status per user
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q10 · Check device connection status per user
# Level   : Intermediate
# Scenario: 1, 4, 5, 7 (connectivity)
# ----------------------------------------------------------------
SELECT ?userName ?wearable ?batteryLabel ?connLabel ?dataReady
WHERE {
  ?user a ex:User .
  ?user foaf:name ?userName .
  ?user ex:hasWearable ?wearable .
  ?wearable ex:hasDeviceState ?ds .
  ?ds ex:hasBatteryLevel ?bat .
  ?bat rdfs:label ?batteryLabel .
  ?ds ex:hasConnectionStatus ?conn .
  ?conn rdfs:label ?connLabel .
  ?ds ex:parametrizedDataReady ?dataReady .
}
ORDER BY ?userName

# EXPECTED:
# | userName      | wearable | batteryLabel | connLabel     | dataReady |
# |---------------|----------|--------------|---------------|-----------|
# | Participant A | WatchA   | High         | Connected     | true      |  (S1)
# | Participant A | WatchA   | Low          | Airplane Mode | false     |  (S4)
# | Participant B | RingB    | Medium       | Connected     | true      |
# | Participant C | BandC    | Medium       | Intermittent  | true      |


# ================================================================
# BLOCK 3 — SCENARIO-SPECIFIC QUERIES (Level: Intermediate)
# ================================================================

# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q10: Q10 · Check device connection status per user
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q11: Q11 · SCENARIO 1 — Verify normal state (all green)
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q11 · SCENARIO 1 — Verify normal state (all green)
# Level   : Intermediate
# Scenario: 1
# ----------------------------------------------------------------
SELECT ?node ?workload ?performance ?availability ?profitability
WHERE {
  ex:Eval_S1 ex:evaluatesNode ?node .
  ex:Eval_S1 ex:hasProfitability ?prof .
  ?prof rdfs:label ?profitability .
  ?node ex:hasNodeState ?ns .
  ?ns ex:hasWorkload ?wl . ?wl rdfs:label ?workload .
  ?ns ex:hasPerformance ?perf . ?perf rdfs:label ?performance .
  ?ns ex:hasAvailability ?av . ?av rdfs:label ?availability .
}

# EXPECTED:
# | node      | workload | performance | availability | profitability |
# |-----------|----------|-------------|--------------|---------------|
# | EdgeNode1 | Low      | Optimal     | Available    | Adequate      |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q11: Q11 · SCENARIO 1 — Verify normal state (all green)
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q12: Q12 · SCENARIO 2 — Detect saturated edges vs available fog
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q12 · SCENARIO 2 — Detect saturated edges vs available fog
# Level   : Intermediate
# Scenario: 2
# ----------------------------------------------------------------
SELECT ?nodeType ?nodeLabel ?workloadLabel ?availLabel ?resourcePct
WHERE {
  ?node ex:hasNodeState ?ns .
  ?node rdfs:label ?nodeLabel .
  ?node a ?nodeType .
  ?nodeType rdfs:subClassOf ex:ComputationalNode .
  ?ns ex:hasWorkload ?wl . ?wl rdfs:label ?workloadLabel .
  ?ns ex:hasAvailability ?av . ?av rdfs:label ?availLabel .
  ?ns ex:resourceUsagePercent ?resourcePct .
  FILTER (?nodeType IN (ex:EdgeNode, ex:FogNode))
}
ORDER BY DESC(?resourcePct)

# EXPECTED:
# | nodeType | nodeLabel               | workload  | availability | resourcePct |
# |----------|-------------------------|-----------|--------------|-------------|
# | EdgeNode | Edge Node 1 - City Ctr  | Saturated | Partial      | 92.0        |
# | FogNode  | Fog Node 1 - Centre     | Medium    | Available    | 55.0        |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q12: Q12 · SCENARIO 2 — Detect saturated edges vs available fog
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q13: Q13 · SCENARIO 3 — Verify migration: Edge delegates to Fog
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q13 · SCENARIO 3 — Verify migration: Edge delegates to Fog
# Level   : Intermediate
# Scenario: 3
# ----------------------------------------------------------------
SELECT ?sourceNode ?targetNode ?flSession ?dataTypeSent
WHERE {
  ?sourceNode ex:delegatesTo ?targetNode .
  ?flSession a ex:FederatedLearningSession .
  ?flSession ex:involvedNode ?sourceNode .
  ?flSession ex:involvedNode ?targetNode .
  ?flSession ex:dataType ?dataTypeSent .
  FILTER (?sourceNode != ?targetNode)
}

# EXPECTED:
# | sourceNode | targetNode | flSession         | dataTypeSent     |
# |------------|------------|-------------------|------------------|
# | EdgeNode1  | FogNode1   | FL_S3_EdgeToFog   | model_gradients  |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q13: Q13 · SCENARIO 3 — Verify migration: Edge delegates to Fog
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q14: Q14 · SCENARIO 4 — Find failed/degraded nodes and their cause
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q14 · SCENARIO 4 — Find failed/degraded nodes and their cause
# Level   : Intermediate
# Scenario: 4
# ----------------------------------------------------------------
SELECT ?node ?opStatusLabel ?commLabel ?model ?degradCause
WHERE {
  ?node ex:hasNodeState ?ns .
  ?ns ex:hasOperationalStatus ?op .
  ?op rdfs:label ?opStatusLabel .
  ?ns ex:hasCommunication ?comm .
  ?comm rdfs:label ?commLabel .
  OPTIONAL {
    ?model ex:hostedOnNode ?node .
    ?model ex:hasDegradationCause ?dc .
    ?dc rdfs:label ?degradCause .
  }
  FILTER (?op IN (ex:ComputeOnly, ex:Inoperative))
}

# EXPECTED:
# | node      | opStatusLabel | commLabel     | model      | degradCause        |
# |-----------|---------------|---------------|------------|--------------------|
# | EdgeNode2 | Compute Only  | No Connection | ModelEdge1 | Communication Loss |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q14: Q14 · SCENARIO 4 — Find failed/degraded nodes and their cause
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q15: Q15 · SCENARIO 5 — Verify users with denied consent use local model
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q15 · SCENARIO 5 — Verify users with denied consent use local model
# Level   : Intermediate
# Scenario: 5
# ----------------------------------------------------------------
SELECT ?userName ?consentLabel ?modelLabel ?tierLabel ?degradCause
WHERE {
  ?user a ex:User .
  ?user foaf:name ?userName .
  ?user ex:hasConsent ?consent .
  ?consent rdfs:label ?consentLabel .
  ?model a ex:AIModel .
  ?model rdfs:label ?modelLabel .
  ?model ex:hasModelTier ?tier .
  ?tier rdfs:label ?tierLabel .
  OPTIONAL {
    ?model ex:hasDegradationCause ?dc .
    ?dc rdfs:label ?degradCause .
  }
  FILTER (?consent = ex:ConsentDenied)
  FILTER (?tierLabel = "Local (Mist/Device)")
}

# EXPECTED:
# | userName      | consentLabel   | modelLabel          | tierLabel          | degradCause      |
# |---------------|----------------|---------------------|--------------------|------------------|
# | Participant B | Consent Denied | Local Model Ring B  | Local (Mist/Device)| No Nearby Nodes  |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q15: Q15 · SCENARIO 5 — Verify users with denied consent use local model
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q16: Q16 · SCENARIO 6 — Verify full federated learning chain
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q16 · SCENARIO 6 — Verify full federated learning chain
# Level   : Intermediate
# Scenario: 6
# ----------------------------------------------------------------
SELECT ?session ?sessionTime ?dataType ?involvedNode ?updatedModel ?modelVersion
WHERE {
  ?session a ex:FederatedLearningSession .
  ?session ex:sessionTime ?sessionTime .
  ?session ex:dataType ?dataType .
  ?session ex:involvedNode ?involvedNode .
  ?session ex:updatesModel ?updatedModel .
  ?updatedModel ex:modelVersion ?modelVersion .
  FILTER (?session IN (ex:FL_S6_EdgeToCloud, ex:FL_S6_DownloadToEdge))
}
ORDER BY ?session ?involvedNode

# EXPECTED (multiple rows per session):
# | session              | sessionTime       | dataType                   | involvedNode | updatedModel | modelVersion |
# |----------------------|-------------------|----------------------------|--------------|--------------|--------------|
# | FL_S6_DownloadToEdge | 04T04:00:00       | improved_model_parameters  | CloudNode1   | ModelEdge1   | 1.2.0        |
# | FL_S6_DownloadToEdge | 04T04:00:00       | improved_model_parameters  | EdgeNode1    | ModelEdge1   | 1.2.0        |
# | FL_S6_EdgeToCloud    | 04T03:00:00       | global_model_parameters    | CloudNode1   | ModelCloud1  | 2.1.0        |
# | FL_S6_EdgeToCloud    | 04T03:00:00       | global_model_parameters    | EdgeNode1    | ModelCloud1  | 2.1.0        |
# | FL_S6_EdgeToCloud    | 04T03:00:00       | global_model_parameters    | FogNode1     | ModelCloud1  | 2.1.0        |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q16: Q16 · SCENARIO 6 — Verify full federated learning chain
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q17: Q17 · SCENARIO 7 — Rural zone: verify retention conditions
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q17 · SCENARIO 7 — Rural zone: verify retention conditions
# Level   : Intermediate
# Scenario: 7
# ----------------------------------------------------------------
SELECT ?userName ?zone ?connLabel ?batteryLabel ?dataReady ?profitability ?migTime
WHERE {
  ?user a ex:User .
  ?user foaf:name ?userName .
  ?user ex:locatedInZone ?zone .
  ?zone a ex:RuralZone .
  ?user ex:hasWearable ?w .
  ?w ex:hasDeviceState ?ds .
  ?ds ex:hasConnectionStatus ?conn . ?conn rdfs:label ?connLabel .
  ?ds ex:hasBatteryLevel ?bat .     ?bat rdfs:label ?batteryLabel .
  ?ds ex:parametrizedDataReady ?dataReady .
  ?eval ex:hasProfitability ?prof .  ?prof rdfs:label ?profitability .
  ?eval ex:hasMigrationTime ?mt .    ?mt rdfs:label ?migTime .
}

# EXPECTED:
# | userName      | zone          | connLabel    | batteryLabel | dataReady | profitability | migTime |
# |---------------|---------------|--------------|--------------|-----------|---------------|---------|
# | Participant C | NorthRuralZone| Intermittent | Medium       | true      | Adequate      | High    |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q17: Q17 · SCENARIO 7 — Rural zone: verify retention conditions
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q18: Q18 · SCENARIO 8 — Restricted zone: internal node covers area
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q18 · SCENARIO 8 — Restricted zone: internal node covers area
# Level   : Intermediate
# Scenario: 8
# ----------------------------------------------------------------
SELECT ?node ?zone ?zoneType ?connLabel ?opStatus ?resourcePct
WHERE {
  ?node ex:coversArea ?zone .
  ?zone a ?zoneType .
  ?zoneType rdfs:subClassOf* ex:CityArea .
  ?node ex:hasNodeState ?ns .
  ?ns ex:hasCommunication ?comm . ?comm rdfs:label ?connLabel .
  ?ns ex:hasOperationalStatus ?op . ?op rdfs:label ?opStatus .
  ?ns ex:resourceUsagePercent ?resourcePct .
  FILTER (?zoneType = ex:RestrictedZone)
}

# EXPECTED:
# | node                  | zone          | zoneType       | connLabel | opStatus    | resourcePct |
# |-----------------------|---------------|----------------|-----------|-------------|-------------|
# | InternalEdgeFacility  | CareFacility1 | RestrictedZone | Stable    | Operational | 20.0        |


# ================================================================
# BLOCK 4 — CROSS-SCENARIO QUERIES (Level: Advanced)
# ================================================================

# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q18: Q18 · SCENARIO 8 — Restricted zone: internal node covers area
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q19: Q19 · Find all nodes eligible for migration (available + low/medium workload)
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q19 · Find all nodes eligible for migration (available + low/medium workload)
# Level   : eAdvanced
# Scenario: 2, 3 (migration decision support)
# ----------------------------------------------------------------
SELECT ?node ?nodeType ?workloadLabel ?availLabel ?commLabel ?residualLabel ?resourcePct
WHERE {
  ?node a ?nodeType .
  ?nodeType rdfs:subClassOf+ ex:ComputationalNode .
  ?node ex:hasNodeState ?ns .
  OPTIONAL {
    ?ns ex:hasAvailability ?av .
    ?av rdfs:label ?availLabel .
  }
  OPTIONAL {
    ?ns ex:hasWorkload ?wl .
    ?wl rdfs:label ?workloadLabel .
  }
  OPTIONAL {
    ?ns ex:hasCommunication ?comm .
    ?comm rdfs:label ?commLabel .
  }
  OPTIONAL {
    ?ns ex:hasResidualCapacity ?rc .
    ?rc rdfs:label ?residualLabel .
  }
  OPTIONAL {
    ?ns ex:resourceUsagePercent ?resourcePct .
  }
  FILTER (?av IN (ex:Available, ex:Partial))
  FILTER (?wl IN (ex:NoWorkload, ex:LowWorkload, ex:MediumWorkload))
  FILTER (?comm IN (ex:StableComm, ex:VariableComm, ex:IntermittentComm))
}
ORDER BY ?resourcePct

# EXPECTED (candidates, sorted by lowest resource usage first):
# | node                 | nodeType   | workload | availability | comm     | residual | resourcePct |
# |----------------------|------------|----------|--------------|----------|----------|-------------|
# | InternalEdgeFacility | EdgeNode   | Low      | Available    | Stable   | High     | 20.0        |
# | CloudNode1           | CloudNode  | Low      | Available    | Stable   | High     | 25.0        |
# | EdgeNode1            | EdgeNode   | Low      | Available    | Stable   | High     | 30.0        |  (S1)
# | MobileC              | MobileDevice | Low    | Partial      | Intermittent | Medium | 40.0     |
# | FogNode1             | FogNode    | Medium   | Available    | Stable   | Medium   | 55.0        |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q19: Q19 · Find all nodes eligible for migration (available + low/medium workload)
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q20: Q20 · Full user profile: consent → device → state → stress → zone
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q20 · Full user profile: consent → device → state → stress → zone
# Level   : Advanced
# Scenario: All (complete profile join)
# ----------------------------------------------------------------
SELECT ?name ?consentLabel ?wearableType ?batteryLabel ?connLabel
       ?mobilityLabel ?stressLabel ?feedback ?zoneName
WHERE {
  ?user a ex:User .
  ?user foaf:name ?name .
  ?user ex:hasConsent ?c .       ?c rdfs:label ?consentLabel .
  ?user ex:hasWearable ?w .
  ?w a ?wearableType .
  ?w ex:hasDeviceState ?ds .
  ?ds ex:hasBatteryLevel ?bat .  ?bat rdfs:label ?batteryLabel .
  ?ds ex:hasConnectionStatus ?conn . ?conn rdfs:label ?connLabel .
  ?user ex:hasUserState ?us .
  ?us ex:hasMobility ?mob .      ?mob rdfs:label ?mobilityLabel .
  ?us ex:hasPredictedStressLevel ?sl . ?sl rdfs:label ?stressLabel .
  OPTIONAL { ?us ex:userFeedbackScore ?feedback }
  OPTIONAL {
    ?user ex:locatedInZone ?zone .
    ?zone rdfs:label ?zoneName .
  }
}
ORDER BY ?name

# EXPECTED:
# | name     | consent       | wearableType | battery | conn          | mobility  | stress   | feedback | zone         |
# |----------|---------------|--------------|---------|---------------|-----------|----------|----------|--------------|
# | Part. A  | Consent Given | SmartWatch   | High    | Connected     | Still     | Low      | 5        | City Centre  |
# | Part. A  | Consent Given | SmartWatch   | Low     | Airplane Mode | InTransport | Critical| (null) | City Centre  |
# | Part. B  | Consent Denied| SmartRing    | Medium  | Connected     | Still     | Low      | 4        | (null)       |
# | Part. C  | Consent Given | SmartBand    | Medium  | Intermittent  | Walking   | Medium   | 3        | North Rural  |
# | Part. D  | Consent Given | SmartWatch   | (null)  | (null)        | Still     | Low      | (null)   | Care Facility|


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q20: Q20 · Full user profile: consent → device → state → stress → zone
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q21: Q21 · Evaluation summary: all scenarios profitability + migration
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q21 · Evaluation summary: all scenarios profitability + migration
# Level   : Advanced
# Scenario: All (cross-evaluation dashboard)
# ----------------------------------------------------------------
SELECT ?eval ?nodeName ?profLabel ?migTimeLabel ?migCostLabel ?validFrom
WHERE {
  ?eval a ex:EvaluationState .
  ?eval rdfs:label ?evalLabel .
  ?eval ex:evaluatesNode ?node .
  ?node rdfs:label ?nodeName .
  ?eval ex:hasProfitability ?prof .    ?prof rdfs:label ?profLabel .
  ?eval ex:hasMigrationTime ?mt .      ?mt rdfs:label ?migTimeLabel .
  ?eval ex:hasMigrationCost ?mc .      ?mc rdfs:label ?migCostLabel .
  OPTIONAL { ?eval ex:validFrom ?validFrom }
}
ORDER BY ?validFrom

# EXPECTED (one row per evaluation state, ordered by time):
# | eval        | nodeName     | profitability | migTime  | migCost  | validFrom        |
# |-------------|--------------|---------------|----------|----------|------------------|
# | Eval_S8     | InternalEdge | Adequate      | Very Low | Very Low | 02:05            |
# | Eval_S6     | CloudNode1   | Adequate      | Very Low | Very Low | 03:10            |
# | Eval_S7     | MobileC      | Adequate      | High     | High     | 10:05 (rural)    |
# | Eval_S1     | EdgeNode1    | Adequate      | Low      | Low      | 09:05            |
# | Eval_S5     | MobileA      | Adequate      | Low      | Low      | 09:05 (local)    |
# | Eval_S2     | EdgeNode1    | Not Adequate  | Medium   | Medium   | 11:05            |
# | Eval_S3     | FogNode1     | Adequate      | Low      | Low      | 11:12            |
# | Eval_S4     | EdgeNode2    | Not Adequate  | Very High| Very High| 12:05            |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q21: Q21 · Evaluation summary: all scenarios profitability + migration
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q22: Q22 · Detect models with degradation causes
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q22 · Detect models with degradation causes
# Level   : Advanced
# Scenario: 4, 5, 7 (degradation analysis)
# ----------------------------------------------------------------
SELECT ?model ?version ?tierLabel ?nodeName ?causeLabel ?lastUpdated
WHERE {
  ?model a ex:AIModel .
  ?model ex:modelVersion ?version .
  ?model ex:hasModelTier ?tier .    ?tier rdfs:label ?tierLabel .
  ?model ex:hasDegradationCause ?dc . ?dc rdfs:label ?causeLabel .
  OPTIONAL { ?model ex:hostedOnNode ?node . ?node rdfs:label ?nodeName }
  OPTIONAL { ?model ex:lastUpdated ?lastUpdated }
}
ORDER BY ?tierLabel

# EXPECTED:
# | model        | version | tierLabel          | nodeName     | causeLabel         | lastUpdated       |
# |--------------|---------|--------------------|--------------|--------------------|-------------------|
# | ModelEdge1   | 1.2.0   | Edge               | Edge Node 1  | Communication Loss | 2026-05-04T10:10  |
# | ModelLocalB  | 0.8.0   | Local (Mist/Device)| (null)       | No Nearby Nodes    | (null)            |
# | ModelLocal_C | 1.0.0   | Local (Mist/Device)| (null)       | No Nearby Nodes    | (null)            |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q22: Q22 · Detect models with degradation causes
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q23: Q23 · Node–User distance matrix across all NodeUserRelations
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q23 · Node–User distance matrix across all NodeUserRelations
# Level   : Advanced
# Scenario: 1, 2, 3 (proximity-based routing)
# ----------------------------------------------------------------
SELECT ?userName ?nodeName ?nodeType ?distLabel ?isPreferred ?validFrom
WHERE {
  ?rel a ex:NodeUserRelation .
  ?rel ex:relatesUser ?user .  ?user foaf:name ?userName .
  ?rel ex:relatesNode ?node .  ?node rdfs:label ?nodeName .
  ?node a ?nodeType . ?nodeType rdfs:subClassOf* ex:ComputationalNode .
  ?rel ex:hasDistance ?dist .  ?dist rdfs:label ?distLabel .
  OPTIONAL { ?rel ex:isPreferredNode ?isPreferred }
  OPTIONAL { ?rel ex:validFrom ?validFrom }
}
ORDER BY ?userName ?distLabel

# EXPECTED:
# | userName      | nodeName              | nodeType | distLabel | isPreferred | validFrom |
# |---------------|-----------------------|----------|-----------|-------------|-----------|
# | Participant A | Edge Node 1 - Centre  | EdgeNode | Close     | true        | 10:01     |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q23: Q23 · Node–User distance matrix across all NodeUserRelations
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q24: Q24 · Federated learning: full chain from device to cloud
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q24 · Federated learning: full chain from device to cloud
# Level   : Advanced
# Scenario: 6 (HFL audit trail)
# ----------------------------------------------------------------
SELECT ?session ?sessionTime ?fromNode ?fromType ?toModel ?modelVersion ?tierLabel
WHERE {
  ?session a ex:FederatedLearningSession .
  ?session ex:sessionTime ?sessionTime .
  ?session ex:involvedNode ?fromNode .
  ?fromNode a ?fromType . ?fromType rdfs:subClassOf* ex:ComputationalNode .
  ?session ex:updatesModel ?toModel .
  ?toModel ex:modelVersion ?modelVersion .
  ?toModel ex:hasModelTier ?tier . ?tier rdfs:label ?tierLabel .
}
ORDER BY ?sessionTime ?fromType

# EXPECTED (all HFL sessions combined):
# | session              | sessionTime | fromNode   | fromType    | toModel      | version | tier           |
# |----------------------|-------------|------------|-------------|--------------|---------|----------------|
# | FL_S3_EdgeToFog      | 11:10       | EdgeNode1  | EdgeNode    | ModelFog1    | 1.8.0   | Fog/Community  |
# | FL_S3_EdgeToFog      | 11:10       | FogNode1   | FogNode     | ModelFog1    | 1.8.0   | Fog/Community  |
# | FL_S6_EdgeToCloud    | 03:00       | CloudNode1 | CloudNode   | ModelCloud1  | 2.1.0   | Cloud/Global   |
# | FL_S6_EdgeToCloud    | 03:00       | EdgeNode1  | EdgeNode    | ModelCloud1  | 2.1.0   | Cloud/Global   |
# | FL_S6_EdgeToCloud    | 03:00       | FogNode1   | FogNode     | ModelCloud1  | 2.1.0   | Cloud/Global   |
# | FL_S6_DownloadToEdge | 04:00       | CloudNode1 | CloudNode   | ModelEdge1   | 1.2.0   | Edge           |
# | FL_S6_DownloadToEdge | 04:00       | EdgeNode1  | EdgeNode    | ModelEdge1   | 1.2.0   | Edge           |


# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q24: Q24 · Federated learning: full chain from device to cloud
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q25: Q25 · Identify users whose data CAN be used for global training
# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q25 · Identify users whose data CAN be used for global training
# Level   : Advanced
# Scenario: 5, 6 (consent + data readiness gate)
# ----------------------------------------------------------------
SELECT ?userName ?anonID ?consentLabel ?dataType ?dataReady ?sendTimestamp
WHERE {
  ?user a ex:User .
  ?user foaf:name ?userName .
  ?user ex:anonymizedID ?anonID .
  ?user ex:hasConsent ?c .     ?c rdfs:label ?consentLabel .
  ?user ex:hasWearable ?w .
  ?w ex:hasDeviceState ?ds .
  ?ds ex:parametrizedDataReady ?dataReady .
  OPTIONAL {
    ?pd a ex:ParametrizedData .
    ?pd ex:generatedBy ?w .
    ?pd a ?dataType .
    ?pd ex:sendTimestamp ?sendTimestamp .
  }
  FILTER (?c = ex:ConsentGiven && ?dataReady = "true"^^xsd:boolean)
}
ORDER BY ?userName

# EXPECTED:
# | userName      | anonID    | consentLabel  | dataType                   | dataReady | sendTimestamp |
# |---------------|-----------|---------------|----------------------------|-----------|---------------|
# | Participant A | USR-A001  | Consent Given | SleepParametrizedData      | true      | 07:15         |
# | Participant A | USR-A001  | Consent Given | PhysiologicalParametrizedData| true    | 22:30         |
# Note: Participant B excluded (ConsentDenied)
# Note: Participant C included only if device connected (intermittent)


# ================================================================
# BLOCK 5 — ASK QUERIES — Boolean verification (Level: Simple)
# ================================================================

# ----------------------------------------------------------------

# ------------------------------------------------------------------------------------------------
# END QUERY BASE-Q25: Q25 · Identify users whose data CAN be used for global training
# ------------------------------------------------------------------------------------------------

# ================================================================================================
# START QUERY BASE-Q26: Q26 · ASK: Is there any saturated node?
