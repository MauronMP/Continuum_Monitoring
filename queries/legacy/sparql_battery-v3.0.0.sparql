# START QUERY EXT-Q01: Version and release artifact inventory
# Type: inventory
# Purpose: Evaluate version and release artifact inventory using the declared query contract.
# Requirements: RF-68, RNF-39, RV-01, RV-03
# Policies: P-VAL-01, P-VAL-04
# Current v3.0.0 result: 6 rows
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?ontology ?versionInfo ?versionIRI ?artifact ?artifactType ?identifier ?artifactVersion ?status WHERE {
  VALUES ?ontology { <http://example.org/smartcity> }
  OPTIONAL { ?ontology owl:versionInfo ?versionInfo }
  OPTIONAL { ?ontology owl:versionIRI ?versionIRI }
  OPTIONAL {
    VALUES ?artifactType {
      :OntologyArtifact :RequirementsArtifact :PolicyArtifact
      :ScenarioArtifact :QueryCatalog :AcceptanceProfile
    }
    ?artifact a ?artifactType .
    OPTIONAL { ?artifact :artifactIdentifier ?identifier }
    OPTIONAL { ?artifact :artifactVersion ?artifactVersion }
    OPTIONAL { ?artifact :artifactStatus ?status }
  }
}
ORDER BY ?artifactType ?artifact
# END QUERY EXT-Q01: Version and release artifact inventory


# START QUERY EXT-Q02: Functional, non-functional and validation requirement coverage
# Type: dashboard
# Purpose: Evaluate functional, non-functional and validation requirement coverage using the declared query contract.
# Requirements: RV-04, RF-68
# Policies: P-VAL-06
# Current v3.0.0 result: 3 rows
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
