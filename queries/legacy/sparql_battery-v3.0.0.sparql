# START QUERY EXT-Q70: Cadena completa de auditoría semántica
# Type: report
# Purpose: Reconstruir usuario→contrato→consentimiento efectivo→propósito→zona→política→nodo→alternativa→trust→tier→acción.
# Requirements: RF-67, RNF-30
# Policies: P-AUD-07
# Current v3.0.0 result: 204 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?evaluation ?user ?contract ?effectiveRange ?purpose ?zone ?policy ?node ?alternative ?altTier ?altScore ?trust ?selectedTier ?action ?from WHERE {
  ?evaluation a :EvaluationState ; :evaluationUser ?user ; :auditsContract ?contract ; :hasAuthorizationDecision/:hasEffectiveConsentRange ?effectiveRange ; :evaluationPurpose ?purpose ; :evaluationZone ?zone ; :selectedModelTier ?selectedTier ; :resultedInAction ?action ; :validFrom ?from .
  OPTIONAL { ?evaluation :appliedPolicy ?policy }
  OPTIONAL { ?evaluation :evaluatesNode ?node . OPTIONAL { ?node :hasNodeState/:hasTrustAssessment/:hasTrustScore ?trust } }
  OPTIONAL { ?evaluation :hasDecisionAlternative ?alternative . ?alternative :alternativeModelTier ?altTier . OPTIONAL { ?alternative :hasAHPScore ?altScore } }
}
ORDER BY ?evaluation ?policy ?altTier
# END QUERY EXT-Q70: Cadena completa de auditoría semántica


# START QUERY EXT-Q71: Incumplimiento — ticket de auditoría incompleto
# Type: violation
# Purpose: Aplicar contenido mínimo de P-AUD-06, incluyendo alternativas y políticas.
# Requirements: RF-54, RF-66, RNF-28, RNF-29
# Policies: P-AUD-06
# Current v3.0.0 result: 0 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?evaluation ?missing WHERE {
  ?evaluation a :EvaluationState .
  {
    VALUES (?prop ?missing) {
      (:hasDetectedSymptom "hasDetectedSymptom")
      (:appliedPolicy "appliedPolicy")
      (:auditsContract "auditsContract")
      (:hasAuthorizationDecision "hasAuthorizationDecision")
      (:hasDecisionAlternative "hasDecisionAlternative")
      (:selectedModelTier "selectedModelTier")
      (:hasSelectionJustification "hasSelectionJustification")
      (:validFrom "validFrom")
      (:resultedInAction "resultedInAction")
    }
    FILTER NOT EXISTS { ?evaluation ?prop ?v }
  }
  UNION
  {
    FILTER NOT EXISTS { ?evaluation :hasAuthorizationDecision/:hasEffectiveConsentRange ?r }
    BIND("effectiveConsentRange" AS ?missing)
  }
}
ORDER BY ?evaluation ?missing
# END QUERY EXT-Q71: Incumplimiento — ticket de auditoría incompleto


# START QUERY EXT-Q72: Incumplimiento — acción sin justificación de evaluación/política
# Type: violation
# Purpose: Detectar acciones adaptativas no autorizadas por EvaluationState o evaluaciones sin política aplicada.
# Requirements: RF-65, RF-66
# Policies: P-AUD-05
# Current v3.0.0 result: 0 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?subject ?reason WHERE {
  {
    ?subject a :AdaptationAction .
    FILTER NOT EXISTS { ?subject :authorizedByEvaluation ?evaluation }
    BIND("action-without-evaluation" AS ?reason)
  }
  UNION
  {
    ?subject a :EvaluationState ; :resultedInAction ?action .
    FILTER NOT EXISTS { ?subject :appliedPolicy ?policy }
    BIND("evaluation-without-policy" AS ?reason)
  }
}
ORDER BY ?subject
# END QUERY EXT-Q72: Incumplimiento — acción sin justificación de evaluación/política


# START QUERY EXT-Q73: Reporte de entidades temporales
# Type: report
# Purpose: Inspeccionar validFrom/validTo y diferenciar cierre real de plannedExpiry.
# Requirements: RNF-35, RNF-36
# Policies: P-GOV-05, P-AUD-02
# Current v3.0.0 result: 79 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?entity ?type ?from ?to ?plannedExpiry WHERE {
  ?entity a ?type .
  ?type rdfs:subClassOf* :TemporalEntity .
  FILTER(?type != :TemporalEntity)
  OPTIONAL { ?entity :validFrom ?from }
  OPTIONAL { ?entity :validTo ?to }
  OPTIONAL { ?entity :plannedExpiry ?plannedExpiry }
}
ORDER BY ?entity ?type
# END QUERY EXT-Q73: Reporte de entidades temporales


# START QUERY EXT-Q74: Incumplimiento — entidad temporal sin validFrom o intervalo inválido
# Type: violation
# Purpose: Detectar temporal entities sin inicio o con validTo anterior a validFrom.
# Requirements: RNF-36
# Policies: P-GOV-05
# Current v3.0.0 result: 0 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?entity ?from ?to ?reason WHERE {
  ?entity a ?type . ?type rdfs:subClassOf* :TemporalEntity . FILTER(?type != :TemporalEntity && ?type != :TrustAssessment)
  OPTIONAL { ?entity :validFrom ?from }
  OPTIONAL { ?entity :validTo ?to }
  BIND(IF(!BOUND(?from), "missing-validFrom", IF(BOUND(?to) && ?to < ?from, "validTo-before-validFrom", "")) AS ?reason)
  FILTER(?reason != "")
}
ORDER BY ?entity
# END QUERY EXT-Q74: Incumplimiento — entidad temporal sin validFrom o intervalo inválido


# START QUERY EXT-Q75: Inventario de shapes SHACL v3
# Type: inventory
# Purpose: Listar shapes y severidades disponibles para validación estructural.
# Requirements: RF-71, RV-01
# Policies: P-VAL-03
# Current v3.0.0 result: 74 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?shape ?targetClass ?path ?minCount ?maxCount ?severity ?message WHERE {
  ?shape a sh:NodeShape .
  OPTIONAL { ?shape sh:targetClass ?targetClass }
  OPTIONAL { ?shape sh:property ?ps . OPTIONAL { ?ps sh:path ?path } OPTIONAL { ?ps sh:minCount ?minCount } OPTIONAL { ?ps sh:maxCount ?maxCount } OPTIONAL { ?ps sh:severity ?severity } OPTIONAL { ?ps sh:message ?message } }
}
ORDER BY ?shape ?path
# END QUERY EXT-Q75: Inventario de shapes SHACL v3


