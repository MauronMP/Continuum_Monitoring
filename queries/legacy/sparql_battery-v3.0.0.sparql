PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?nodeType (AVG(?usage) AS ?avgUsage) (COUNT(?state) AS ?samples) WHERE {
  ?node :hasNodeState ?state ; a ?nodeType .
  ?state :resourceUsagePercent ?usage .
  ?nodeType rdfs:subClassOf* :ComputationalNode .
}
GROUP BY ?nodeType
ORDER BY ?nodeType
# END QUERY BASE-Q33: Uso medio de recursos por tipo de nodo


# START QUERY BASE-Q34: Nodos que cubren zonas restringidas
# Type: report
# Purpose: Inventariar infraestructura geográficamente asociada a RestrictedZone sin asumir que esté autorizada para procesar datos protegidos.
# Requirements: RF-42, RF-43
# Policies: P-ZONE-01
# Current v3.0.0 result: 1 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?node ?zone WHERE {
  ?zone a :RestrictedZone .
  ?node :coversArea ?zone .
}
ORDER BY ?zone ?node
# END QUERY BASE-Q34: Nodos que cubren zonas restringidas


# START QUERY BASE-Q35: Cadena de fallo → evaluación → acción
# Type: report
# Purpose: Reconstruir decisiones asociadas a síntomas/fallos y su acción adaptativa final.
# Requirements: RF-20, RF-65, RF-67
# Policies: P-AUD-05, P-AUD-07
# Current v3.0.0 result: 86 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?evaluation ?scenario ?symptom ?node ?policy ?action ?actionType WHERE {
  ?evaluation a :EvaluationState ; :hasDetectedSymptom ?symptom ; :resultedInAction ?action .
  OPTIONAL { ?evaluation :partOfScenario ?scenario }
  OPTIONAL { ?evaluation :evaluatesNode ?node }
  OPTIONAL { ?evaluation :appliedPolicy ?policy }
  OPTIONAL { ?action a ?actionType . FILTER(?actionType != owl:NamedIndividual) }
}
ORDER BY ?scenario ?evaluation ?policy
# END QUERY BASE-Q35: Cadena de fallo → evaluación → acción


# ==============================================================================
# EXT v3 — Inventario, artefactos y trazabilidad
# ==============================================================================


# START QUERY EXT-Q01: Inventario de versión y artefactos v3
# Type: inventory
# Purpose: Verificar versión de ontología y artefactos versionados asociados.
# Requirements: RF-68, RNF-39, RV-01, RV-03
# Policies: P-VAL-01, P-VAL-04
# Current v3.0.0 result: 6 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?ontology ?versionInfo ?versionIRI ?artifact ?artifactType ?identifier ?artifactVersion ?status WHERE {
  VALUES ?ontology { <http://example.org/smartcity> }
  OPTIONAL { ?ontology owl:versionInfo ?versionInfo }
  OPTIONAL { ?ontology owl:versionIRI ?versionIRI }
  OPTIONAL {
    VALUES ?artifactType {
      :OntologyArtifact :RequirementsArtifact :PolicyArtifact
      :ScenarioArtifact :QueryCatalog :AcceptanceProfile
    }
    ?artifact a ?artifactType .
    OPTIONAL { ?artifact :artifactIdentifier ?identifier }
    OPTIONAL { ?artifact :artifactVersion ?artifactVersion }
    OPTIONAL { ?artifact :artifactStatus ?status }
  }
}
ORDER BY ?artifactType ?artifact
# END QUERY EXT-Q01: Inventario de versión y artefactos v3


# START QUERY EXT-Q02: Cobertura de requisitos RF/RNF/RV
# Type: dashboard
# Purpose: Comprobar que los requisitos revisados están representados en la ontología.
# Requirements: RV-04, RF-68
# Policies: P-VAL-06
# Current v3.0.0 result: 3 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?requirementType (COUNT(DISTINCT ?r) AS ?count) WHERE {
  VALUES ?requirementType {
    :FunctionalRequirement :NonFunctionalRequirement :ValidationRequirement
  }
  ?r a ?requirementType .
}
GROUP BY ?requirementType
ORDER BY ?requirementType
# END QUERY EXT-Q02: Cobertura de requisitos RF/RNF/RV


# START QUERY EXT-Q03: Inventario completo de políticas
# Type: inventory
# Purpose: Listar las 79 políticas v3 con categoría, tipo y versión.
# Requirements: RF-39, RF-40, RF-70
# Policies: P-GOV-01, P-GOV-04
# Current v3.0.0 result: 79 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?policy ?id ?category ?type ?version ?statement WHERE {
  ?policy a :Policy ; :policyIdentifier ?id .
  OPTIONAL { ?policy :belongsToPolicyCategory ?category }
  OPTIONAL { ?policy :hasPolicyType ?type }
  OPTIONAL { ?policy :policyVersion ?version }
  OPTIONAL { ?policy :hasPolicyStatement ?statement }
}
ORDER BY ?id
# END QUERY EXT-Q03: Inventario completo de políticas


# START QUERY EXT-Q04: Inventario completo de mecanismos
# Type: inventory
# Purpose: Listar los 55 mecanismos y las políticas que soportan.
# Requirements: RV-04
# Policies: P-VAL-06
# Current v3.0.0 result: 55 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?mechanism ?id ?description (GROUP_CONCAT(DISTINCT STR(?policy); separator=", ") AS ?policies) WHERE {
  ?mechanism a :MechanismSpecification ; :mechanismIdentifier ?id .
  OPTIONAL { ?mechanism :mechanismDescription ?description }
  OPTIONAL { ?mechanism :supportsPolicy ?policy }
}
GROUP BY ?mechanism ?id ?description
ORDER BY ?id
# END QUERY EXT-Q04: Inventario completo de mecanismos


# START QUERY EXT-Q05: Inventario de escenarios S1–S17
# Type: inventory
# Purpose: Verificar el artefacto versionado de escenarios y su cobertura.
# Requirements: RF-31, RF-72, RV-03
# Policies: P-VAL-07
# Current v3.0.0 result: 17 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?scenario ?id ?artifact
       (GROUP_CONCAT(DISTINCT STR(?policy); separator=", ") AS ?policies)
       (GROUP_CONCAT(DISTINCT STR(?mechanism); separator=", ") AS ?mechanisms) WHERE {
  ?scenario a :Scenario ; :scenarioIdentifier ?id .
  OPTIONAL { ?scenario :definedInArtifact ?artifact }
  OPTIONAL { ?scenario :scenarioPolicy ?policy }
  OPTIONAL { ?scenario :scenarioMechanism ?mechanism }
}
GROUP BY ?scenario ?id ?artifact
ORDER BY ?id
# END QUERY EXT-Q05: Inventario de escenarios S1–S17


# START QUERY EXT-Q06: Categorías de política
# Type: inventory
# Purpose: Inventariar las 12 categorías de gobernanza.
# Requirements: RF-39, RF-40
# Policies: P-GOV-01
# Current v3.0.0 result: 12 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?category ?code ?label WHERE {
  ?category a :PolicyCategory .
  OPTIONAL { ?category :categoryCode ?code }
  OPTIONAL { ?category rdfs:label ?label }
}
ORDER BY ?code
# END QUERY EXT-Q06: Categorías de política


# START QUERY EXT-Q07: Relaciones entre categorías de políticas
# Type: report
# Purpose: Inspeccionar la taxonomía de compatibilidad/conflicto y la estrategia de resolución cuando exista.
# Requirements: RNF-22, RV-04
# Policies: P-GOV-03
# Current v3.0.0 result: 67 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?relation ?source ?target ?relationType ?code ?strategy WHERE {
  ?relation a :PolicyCategoryRelation ; :relationSourceCategory ?source ; :relationTargetCategory ?target ; :hasPolicyRelationType ?relationType .
  OPTIONAL { ?relationType :relationCode ?code }
  OPTIONAL { ?relation :usesResolutionStrategy ?strategy }
}
ORDER BY ?source ?target
# END QUERY EXT-Q07: Relaciones entre categorías de políticas


# START QUERY EXT-Q08: Trazabilidad requisito → política → mecanismo
# Type: report
# Purpose: Mostrar trazabilidad individual de requisitos a políticas y mecanismos.
# Requirements: RV-04, RNF-39
# Policies: P-VAL-06
# Current v3.0.0 result: 1089 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?requirement ?rid ?rtype ?policy ?mechanism WHERE {
  VALUES ?rtype {
    :FunctionalRequirement :NonFunctionalRequirement :ValidationRequirement
  }
  ?requirement a ?rtype ; :requirementIdentifier ?rid .
  OPTIONAL { ?requirement :tracedToPolicy ?policy }
  OPTIONAL { ?requirement :tracedToMechanism ?mechanism }
}
ORDER BY ?rid ?policy ?mechanism
# END QUERY EXT-Q08: Trazabilidad requisito → política → mecanismo


# START QUERY EXT-Q09: Revisión — requisito sin política ni mecanismo explícito
# Type: review
# Purpose: Listar requisitos que no tienen política ni mecanismo explícito; los requisitos puramente estructurales pueden ser válidos y deben trazarse a ontología/consulta en la matriz documental.
# Requirements: RV-04
# Policies: P-VAL-06
# Current v3.0.0 result: 6 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?requirement ?rid WHERE {
  ?requirement a :Requirement ; :requirementIdentifier ?rid .
  FILTER NOT EXISTS { ?requirement :tracedToPolicy ?p }
  FILTER NOT EXISTS { ?requirement :tracedToMechanism ?m }
}
ORDER BY ?rid
# END QUERY EXT-Q09: Revisión — requisito sin política ni mecanismo explícito


# START QUERY EXT-Q10: Incumplimiento — política o mecanismo incompleto
# Type: violation
# Purpose: Detectar políticas/mecanismos sin metadatos mínimos para gobernanza reproducible.
# Requirements: RF-39, RF-40, RNF-20
# Policies: P-GOV-01, P-GOV-04
# Current v3.0.0 result: 0 filas
PREFIX : <http://example.org/smartcity#>
PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.opengis.net/ont/geosparql#>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX saref: <https://saref.etsi.org/core/>
PREFIX sh: <http://www.w3.org/ns/shacl#>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>

SELECT ?resource ?kind ?missing WHERE {
  {
    ?resource a :Policy . BIND("Policy" AS ?kind)
    VALUES (?prop ?missing) {
      (:policyIdentifier "policyIdentifier")
      (:belongsToPolicyCategory "belongsToPolicyCategory")
      (:hasPolicyType "hasPolicyType")
      (:policyVersion "policyVersion")
      (:hasPolicyStatement "hasPolicyStatement")
      (:recommendedMechanism "recommendedMechanism")
    }
    FILTER NOT EXISTS { ?resource ?prop ?v }
  }
  UNION
  {
    ?resource a :MechanismSpecification . BIND("Mechanism" AS ?kind)
    VALUES (?prop ?missing) {
      (:mechanismIdentifier "mechanismIdentifier")
      (:mechanismDescription "mechanismDescription")
      (:supportsPolicy "supportsPolicy")
    }
    FILTER NOT EXISTS { ?resource ?prop ?v }
  }
}
ORDER BY ?kind ?resource ?missing
# END QUERY EXT-Q10: Incumplimiento — política o mecanismo incompleto


# ==============================================================================
# EXT v3 — Consentimiento, contratos y autorización efectiva
