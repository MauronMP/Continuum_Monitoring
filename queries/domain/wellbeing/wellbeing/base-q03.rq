# ================================================================================================

PREFIX ex:   <http://example.org/smartcity#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX sosa: <http://www.w3.org/ns/sosa/>
PREFIX saref:<https://saref.etsi.org/core/>
PREFIX rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX owl:  <http://www.w3.org/2002/07/owl#>
PREFIX xsd:  <http://www.w3.org/2001/XMLSchema#>
PREFIX sh:   <http://www.w3.org/ns/shacl#>

# Q03 · List all wearables and their owners
# Level   : Simple
# Scenario: All (device–user relationship)
# ----------------------------------------------------------------
SELECT ?userName ?wearable ?wType
WHERE {
  ?user a ex:User .
  ?user foaf:name ?userName .
  ?user ex:hasWearable ?wearable .
  ?wearable a ?wType .
  ?wType rdfs:subClassOf ex:Wearable .
}
ORDER BY ?userName
