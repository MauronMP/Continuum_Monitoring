{
  "name": "continuum-container-scale",
  "services": {
    "fog-c1": {
      "image": "continuum-worker:container-scale-v1",
      "build": {
        "context": ".",
        "dockerfile": "Dockerfile",
        "args": {
          "INSTALL_DL": "false"
        }
      },
      "init": true,
      "restart": "no",
      "cpus": 1.0,
      "mem_limit": "1536m",
      "memswap_limit": "1536m",
      "pids_limit": 256,
      "security_opt": [
        "no-new-privileges:true"
      ],
      "cap_drop": [
        "ALL"
      ],
      "ports": [
        "100.93.73.27:8491:8080"
      ],
      "volumes": [
        "./topology.toml:/app/configs/container-topology.toml:ro"
      ],
      "command": [
        "--node-id",
        "fog-c1",
        "--tier",
        "fog",
        "--topology-file",
        "configs/container-topology.toml",
        "--topology-name",
        "container-scale"
      ],
      "logging": {
        "driver": "json-file",
        "options": {
          "max-size": "5m",
          "max-file": "2"
        }
      },
      "healthcheck": {
        "test": [
          "CMD",
          "python",
          "-c",
          "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/health', timeout=3)"
        ],
        "interval": "30s",
        "timeout": "5s",
        "retries": 3
      },
      "labels": {
        "continuum.physical_host": "fog",
        "continuum.tier": "fog"
      }
    }
  }
}
